{"AR-Y1-NN-T1-L01": {"title": "مَرْحَبًا", "body": ["مَرْحَبًا، اسْمِي سَلْمَى.", "صَبَاحُ الْخَيْرِ يَا مُعَلِّمَتِي.", "مَعَ السَّلَامَةِ يَا صَدِيقِي."], "tf": [["اسْمُهَا سَلْمَى", true], ["تَقُولُ: صَبَاحُ الْخَيْرِ", true]], "qs": [["مَا اسْمُهَا؟", "سَلْمَى."]]}, "AR-Y1-NN-T1-L02": {"title": "أَلْوَانِي", "body": ["التُّفَّاحَةُ حَمْرَاءُ.", "الشَّجَرَةُ خَضْرَاءُ.", "السَّمَاءُ زَرْقَاءُ، وَالشَّمْسُ صَفْرَاءُ."], "tf": [["التُّفَّاحَةُ زَرْقَاءُ", false], ["الشَّمْسُ صَفْرَاءُ", true]], "qs": [["مَا لَوْنُ الشَّجَرَةِ؟", "خَضْرَاءُ."]]}, "AR-Y1-NN-T1-L03": {"title": "كَيْفَ حَالُكَ؟", "body": ["أَنَا سَعِيدٌ الْيَوْمَ.", "أَخِي حَزِينٌ قَلِيلًا.", "أُمِّي بِخَيْرٍ، وَالْحَمْدُ لِلَّهِ."], "tf": [["الْكَاتِبُ سَعِيدٌ", true], ["الْأُمُّ حَزِينَةٌ", false]], "qs": [["كَيْفَ حَالُ الْأَخِ؟", "حَزِينٌ قَلِيلًا."]]}, "AR-Y1-NN-T1-L04": {"title": "أَعُدُّ", "body": ["مَعِي قَلَمٌ وَاحِدٌ.", "فِي يَدِي خَمْسَةُ أَصَابِعَ.", "عِنْدِي عَشَرَةُ كُتُبٍ."], "tf": [["فِي الْيَدِ خَمْسَةُ أَصَابِعَ", true], ["مَعَهُ عَشَرَةُ أَقْلَامٍ", false]], "qs": [["كَمْ كِتَابًا عِنْدَهُ؟", "عَشَرَةُ كُتُبٍ."]]}, "AR-Y1-NN-T1-L05": {"title": "أَشْكَالٌ حَوْلِي", "body": ["السَّاعَةُ دَائِرَةٌ.", "النَّافِذَةُ مُرَبَّعٌ.", "قِطْعَةُ الْكَعْكِ مُثَلَّثٌ."], "tf": [["السَّاعَةُ دَائِرَةٌ", true], ["النَّافِذَةُ مُثَلَّثٌ", false]], "qs": [["مَا شَكْلُ قِطْعَةِ الْكَعْكِ؟", "مُثَلَّثٌ."]]}, "AR-Y1-NN-T1-L06": {"title": "أُسْرَتِي", "body": ["هَذَا أَبِي، وَهَذِهِ أُمِّي.", "هَذَا أَخِي، وَهَذِهِ أُخْتِي.", "أُحِبُّ أُسْرَتِي."], "tf": [["يُحِبُّ أُسْرَتَهُ", true], ["لَيْسَ عِنْدَهُ أُخْتٌ", false]], "qs": [["مَنْ يُحِبُّ الْكَاتِبُ؟", "أُسْرَتَهُ."]]}, "AR-Y1-NN-T1-L07": {"title": "جِسْمِي", "body": ["هَذَا رَأْسِي.", "أَرَى بِعَيْنِي.", "أَكْتُبُ بِيَدِي، وَأَمْشِي بِقَدَمِي."], "tf": [["نَرَى بِالْعَيْنِ", true], ["نَمْشِي بِالْيَدِ", false]], "qs": [["بِمَاذَا نَكْتُبُ؟", "بِالْيَدِ."]]}, "AR-Y1-NN-T1-L08": {"title": "فُطُورِي", "body": ["آكُلُ تُفَّاحَةً وَخُبْزًا.", "أَشْرَبُ الْحَلِيبَ.", "فِي الْغَدَاءِ آكُلُ الْأَرُزَّ."], "tf": [["يَشْرَبُ الْحَلِيبَ", true], ["يَأْكُلُ الْأَرُزَّ فِي الْفُطُورِ", false]], "qs": [["مَاذَا يَشْرَبُ؟", "الْحَلِيبَ."]]}, "AR-Y1-NN-T1-L09": {"title": "مِهَنٌ", "body": ["الطَّبِيبُ فِي الْمُسْتَشْفَى.", "الْمُعَلِّمُ فِي الْمَدْرَسَةِ.", "الشُّرْطِيُّ فِي الشَّارِعِ."], "tf": [["الْمُعَلِّمُ فِي الْمَدْرَسَةِ", true], ["الطَّبِيبُ فِي الشَّارِعِ", false]], "qs": [["أَيْنَ الشُّرْطِيُّ؟", "فِي الشَّارِعِ."]]}, "AR-Y1-NN-T1-L10": {"title": "أَيَّامِي", "body": ["الْيَوْمَ أَذْهَبُ إِلَى الْمَدْرَسَةِ.", "أَمْسِ لَعِبْتُ فِي الْحَدِيقَةِ.", "غَدًا أَزُورُ جَدِّي."], "tf": [["أَمْسِ لَعِبَ فِي الْحَدِيقَةِ", true], ["الْيَوْمَ يَزُورُ جَدَّهُ", false]], "qs": [["مَتَى يَزُورُ جَدَّهُ؟", "غَدًا."]]}, "AR-Y1-NN-T2-L01": {"title": "أَرْنَبٌ", "body": ["أَرْنَبٌ أَبْيَضُ.", "الْأَرْنَبُ يَأْكُلُ الْجَزَرَ.", "الْأَرْنَبُ يَقْفِزُ."], "tf": [["الْأَرْنَبُ أَبْيَضُ", true], ["الْأَرْنَبُ يَأْكُلُ اللَّحْمَ", false]], "qs": [["مَاذَا يَأْكُلُ الْأَرْنَبُ؟", "الْجَزَرَ."]]}, "AR-Y1-NN-T2-L02": {"title": "بَطَّةٌ", "body": ["بَطَّةٌ فِي الْمَاءِ.", "الْبَطَّةُ تَسْبَحُ.", "بَابُ الْبَيْتِ بُنِّيٌّ."], "tf": [["الْبَطَّةُ تَسْبَحُ", true], ["الْبَطَّةُ فِي الشَّجَرَةِ", false]], "qs": [["أَيْنَ الْبَطَّةُ؟", "فِي الْمَاءِ."]]}, "AR-Y1-NN-T2-L03": {"title": "تِمْسَاحٌ", "body": ["تِمْسَاحٌ فِي النَّهْرِ.", "التِّمْسَاحُ كَبِيرٌ.", "أَنَا آكُلُ التُّفَّاحَ."], "tf": [["التِّمْسَاحُ فِي النَّهْرِ", true], ["التِّمْسَاحُ صَغِيرٌ", false]], "qs": [["أَيْنَ التِّمْسَاحُ؟", "فِي النَّهْرِ."]]}, "AR-Y1-NN-T2-L04": {"title": "ثَعْلَبٌ", "body": ["ثَعْلَبٌ ذَكِيٌّ.", "الثَّعْلَبُ يَجْرِي.", "الثَّوْبُ ثَوْبِي."], "tf": [["الثَّعْلَبُ ذَكِيٌّ", true], ["الثَّعْلَبُ يَطِيرُ", false]], "qs": [["كَيْفَ الثَّعْلَبُ؟", "ذَكِيٌّ."]]}, "AR-Y1-NN-T2-L05": {"title": "جَمَلٌ", "body": ["جَمَلٌ فِي الصَّحْرَاءِ.", "الْجَمَلُ صَبُورٌ.", "أَرْكَبُ الْجَمَلَ مَعَ جَدِّي."], "tf": [["الْجَمَلُ فِي الصَّحْرَاءِ", true], ["الْجَمَلُ فِي الْبَحْرِ", false]], "qs": [["أَيْنَ الْجَمَلُ؟", "فِي الصَّحْرَاءِ."]]}, "AR-Y1-NN-T2-L06": {"title": "حُوتٌ", "body": ["حُوتٌ فِي الْبَحْرِ.", "الْحُوتُ كَبِيرٌ جِدًّا.", "الْحِصَانُ يَجْرِي."], "tf": [["الْحُوتُ فِي الْبَحْرِ", true], ["الْحُوتُ صَغِيرٌ", false]], "qs": [["كَيْفَ الْحُوتُ؟", "كَبِيرٌ جِدًّا."]]}, "AR-Y1-NN-T2-L07": {"title": "خَرُوفٌ", "body": ["خَرُوفٌ أَبْيَضُ.", "الْخَرُوفُ يَأْكُلُ الْعُشْبَ.", "الْخُبْزُ لَذِيذٌ."], "tf": [["الْخَرُوفُ يَأْكُلُ الْعُشْبَ", true], ["الْخَرُوفُ أَسْوَدُ", false]], "qs": [["مَاذَا يَأْكُلُ الْخَرُوفُ؟", "الْعُشْبَ."]]}, "AR-Y1-NN-T2-L08": {"title": "دُبٌّ وَذِئْبٌ", "body": ["دُبٌّ كَبِيرٌ.", "ذِئْبٌ فِي الْغَابَةِ.", "الدَّلَّةُ فِيهَا قَهْوَةٌ."], "tf": [["الذِّئْبُ فِي الْغَابَةِ", true], ["الدَّلَّةُ فِيهَا حَلِيبٌ", false]], "qs": [["مَاذَا فِي الدَّلَّةِ؟", "قَهْوَةٌ."]]}, "AR-Y1-NN-T2-L09": {"title": "رِيمٌ وَزَرَافَةٌ", "body": ["رِيمٌ يَجْرِي عَلَى الرَّمْلِ.", "زَرَافَةٌ طَوِيلَةٌ.", "الزَّرَافَةُ تَأْكُلُ الْوَرَقَ."], "tf": [["الزَّرَافَةُ طَوِيلَةٌ", true], ["الرِّيمُ يَجْرِي فِي الْمَاءِ", false]], "qs": [["أَيْنَ يَجْرِي الرِّيمُ؟", "عَلَى الرَّمْلِ."]]}, "AR-Y1-NN-T2-L10": {"title": "سِنْجَابٌ وَشِبْلٌ", "body": ["سِنْجَابٌ عَلَى الشَّجَرَةِ.", "سَمَكَةٌ فِي الْمَاءِ.", "الشِّبْلُ يَلْعَبُ تَحْتَ الشَّمْسِ."], "tf": [["السِّنْجَابُ عَلَى الشَّجَرَةِ", true], ["السَّمَكَةُ عَلَى الشَّجَرَةِ", false]], "qs": [["أَيْنَ يَلْعَبُ الشِّبْلُ؟", "تَحْتَ الشَّمْسِ."]]}, "AR-Y1-NN-T3-L01": {"title": "صُوصٌ صَغِيرٌ", "body": ["صُوصٌ صَغِيرٌ أَصْفَرُ.", "الصُّوصُ يَقُولُ: صَوْصَوْ.", "الصَّقْرُ يَطِيرُ عَالِيًا."], "tf": [["الصُّوصُ أَصْفَرُ", true], ["الصَّقْرُ يَسْبَحُ", false]], "qs": [["مَا لَوْنُ الصُّوصِ؟", "أَصْفَرُ."]]}, "AR-Y1-NN-T3-L02": {"title": "ضِفْدَعٌ", "body": ["ضِفْدَعٌ أَخْضَرُ.", "الضِّفْدَعُ يَقْفِزُ فِي الْمَاءِ.", "الضَّبُّ فِي الصَّحْرَاءِ."], "tf": [["الضِّفْدَعُ أَخْضَرُ", true], ["الضَّبُّ فِي الْمَاءِ", false]], "qs": [["أَيْنَ الضَّبُّ؟", "فِي الصَّحْرَاءِ."]]}, "AR-Y1-NN-T3-L03": {"title": "طَاوُوسٌ وَظَبْيٌ", "body": ["طَاوُوسٌ جَمِيلٌ.", "الطَّائِرَةُ فِي السَّمَاءِ.", "ظَبْيٌ يَجْرِي."], "tf": [["الطَّاوُوسُ جَمِيلٌ", true], ["الطَّائِرَةُ فِي الْبَحْرِ", false]], "qs": [["أَيْنَ الطَّائِرَةُ؟", "فِي السَّمَاءِ."]]}, "AR-Y1-NN-T3-L04": {"title": "عُصْفُورٌ وَغُرَابٌ", "body": ["عُصْفُورٌ يُغَرِّدُ.", "غُرَابٌ أَسْوَدُ.", "الْغَزَالُ سَرِيعٌ."], "tf": [["الْغُرَابُ أَسْوَدُ", true], ["الْغَزَالُ بَطِيءٌ", false]], "qs": [["مَاذَا يَفْعَلُ الْعُصْفُورُ؟", "يُغَرِّدُ."]]}, "AR-Y1-NN-T3-L05": {"title": "فَأْرٌ وَقِطٌّ", "body": ["فَأْرٌ صَغِيرٌ.", "الْقِطُّ يَجْرِي وَرَاءَ الْفَأْرِ.", "الْقَمَرُ فِي اللَّيْلِ."], "tf": [["الْقَمَرُ فِي اللَّيْلِ", true], ["الْفَأْرُ يَجْرِي وَرَاءَ الْقِطِّ", false]], "qs": [["مَتَى نَرَى الْقَمَرَ؟", "فِي اللَّيْلِ."]]}, "AR-Y1-NN-T3-L06": {"title": "كَلْبٌ وَلَيْمُونٌ", "body": ["كَلْبٌ وَفِيٌّ.", "اللَّامَةُ حَيَوَانٌ لَطِيفٌ.", "اللَّيْمُونُ أَصْفَرُ."], "tf": [["الْكَلْبُ وَفِيٌّ", true], ["اللَّيْمُونُ أَزْرَقُ", false]], "qs": [["مَا لَوْنُ اللَّيْمُونِ؟", "أَصْفَرُ."]]}, "AR-Y1-NN-T3-L07": {"title": "مَاعِزٌ وَنَحْلَةٌ", "body": ["مَاعِزٌ فِي الْمَزْرَعَةِ.", "نَحْلَةٌ عَلَى الْوَرْدَةِ.", "النَّخْلَةُ فِيهَا تَمْرٌ."], "tf": [["النَّخْلَةُ فِيهَا تَمْرٌ", true], ["النَّحْلَةُ فِي الْمَاءِ", false]], "qs": [["أَيْنَ الْمَاعِزُ؟", "فِي الْمَزْرَعَةِ."]]}, "AR-Y1-NN-T3-L08": {"title": "هُدْهُدٌ وَوَرْدَةٌ", "body": ["هُدْهُدٌ عَلَى الشَّجَرَةِ.", "هَذِهِ هَدِيَّةٌ لِأُمِّي.", "الْوَرْدَةُ حَمْرَاءُ."], "tf": [["الْوَرْدَةُ حَمْرَاءُ", true], ["الْهَدِيَّةُ لِلْمُعَلِّمِ", false]], "qs": [["لِمَنِ الْهَدِيَّةُ؟", "لِأُمِّهِ."]]}, "AR-Y1-NN-T3-L09": {"title": "يَمَامَةٌ", "body": ["يَمَامَةٌ بَيْضَاءُ.", "الْيَمَامَةُ عَلَى يَدِي.", "أُطْعِمُ الْيَمَامَةَ."], "tf": [["الْيَمَامَةُ بَيْضَاءُ", true], ["الْيَمَامَةُ سَوْدَاءُ", false]], "qs": [["أَيْنَ الْيَمَامَةُ؟", "عَلَى يَدِهِ."]]}, "AR-Y1-NN-T3-L10": {"title": "حُرُوفِي", "body": ["أَعْرِفُ الْحُرُوفَ الْعَرَبِيَّةَ.", "بَعْضُ الْحُرُوفِ لَهَا نُقْطَةٌ.", "أَكْتُبُ كَلِمَةً جَمِيلَةً."], "tf": [["بَعْضُ الْحُرُوفِ لَهَا نُقْطَةٌ", true], ["كُلُّ الْحُرُوفِ بِلَا نُقَطٍ", false]], "qs": [["مَاذَا يَكْتُبُ؟", "كَلِمَةً جَمِيلَةً."]]}, "AR-Y2-NN-T1-L01": {"title": "جِسْمِي", "body": ["لِي رَأْسٌ وَعَيْنَانِ وَأُذُنَانِ.", "أَشُمُّ الْوَرْدَةَ بِأَنْفِي.", "أُحَافِظُ عَلَى جِسْمِي نَظِيفًا."], "tf": [["نَشُمُّ بِالْأَنْفِ", true], ["لِلْإِنْسَانِ ثَلَاثُ أَعْيُنٍ", false], ["يُحَافِظُ عَلَى جِسْمِهِ نَظِيفًا", true]], "qs": [["بِمَاذَا يَشُمُّ الْوَرْدَةَ؟", "بِأَنْفِهِ."], ["كَيْفَ يُحَافِظُ عَلَى جِسْمِهِ؟", "نَظِيفًا."]]}, "AR-Y2-NN-T1-L02": {"title": "حَوَاسِّي", "body": ["أَنْظُرُ إِلَى الْقَمَرِ بِعَيْنِي.", "أَسْمَعُ الْعُصْفُورَ بِأُذُنِي.", "أَتَذَوَّقُ التَّمْرَ، وَأَلْمِسُ الْقِطَّةَ."], "tf": [["نَسْمَعُ بِالْأُذُنِ", true], ["نَتَذَوَّقُ بِالْيَدِ", false], ["يَلْمِسُ الْقِطَّةَ", true]], "qs": [["مَاذَا يَسْمَعُ؟", "الْعُصْفُورَ."], ["مَاذَا يَتَذَوَّقُ؟", "التَّمْرَ."]]}, "AR-Y2-NN-T1-L03": {"title": "طَعَامِي الصِّحِّيُّ", "body": ["أَشْرَبُ الْحَلِيبَ كُلَّ صَبَاحٍ.", "آكُلُ طَعَامًا صِحِّيًّا.", "أَلْعَبُ تَمْرِينًا لِيَكُونَ جِسْمِي قَوِيًّا."], "tf": [["يَشْرَبُ الْحَلِيبَ صَبَاحًا", true], ["يَأْكُلُ الْحَلْوَى كَثِيرًا", false], ["التَّمْرِينُ يُقَوِّي الْجِسْمَ", true]], "qs": [["مَتَى يَشْرَبُ الْحَلِيبَ؟", "كُلَّ صَبَاحٍ."], ["لِمَاذَا يَلْعَبُ التَّمْرِينَ؟", "لِيَكُونَ جِسْمُهُ قَوِيًّا."]]}, "AR-Y2-NN-T1-L04": {"title": "عَقْلٌ سَلِيمٌ", "body": ["أَنَامُ مُبَكِّرًا.", "أَشْرَبُ الْمَاءَ وَآكُلُ غِذَاءً مُفِيدًا.", "عَقْلِي السَّلِيمُ فِي جِسْمِي السَّلِيمِ."], "tf": [["يَنَامُ مُبَكِّرًا", true], ["يَشْرَبُ الْعَصِيرَ فَقَطْ", false], ["الْعَقْلُ السَّلِيمُ فِي الْجِسْمِ السَّلِيمِ", true]], "qs": [["مَتَى يَنَامُ؟", "مُبَكِّرًا."], ["مَاذَا يَشْرَبُ؟", "الْمَاءَ."]]}, "AR-Y2-NN-T1-L05": {"title": "مَلَابِسِي", "body": ["أَلْبَسُ قَمِيصًا وَبِنْطَالًا.", "فِي الشِّتَاءِ أَلْبَسُ مِعْطَفًا.", "وَفِي الصَّيْفِ أَلْبَسُ قُبَّعَةً."], "tf": [["يَلْبَسُ الْمِعْطَفَ فِي الشِّتَاءِ", true], ["يَلْبَسُ الْقُبَّعَةَ فِي الشِّتَاءِ", false], ["يَلْبَسُ قَمِيصًا", true]], "qs": [["مَاذَا يَلْبَسُ فِي الشِّتَاءِ؟", "مِعْطَفًا."], ["مَاذَا يَلْبَسُ فِي الصَّيْفِ؟", "قُبَّعَةً."]]}, "AR-Y2-NN-T1-L06": {"title": "أَنَا وَعَائِلَتِي", "body": ["فِي بَيْتِنَا أَبِي وَأُمِّي وَأَخِي وَأُخْتِي.", "جَدِّي يَزُورُنَا يَوْمَ الْجُمُعَةِ.", "نَأْكُلُ الْغَدَاءَ مَعًا."], "tf": [["الْجَدُّ يَزُورُهُمْ يَوْمَ الْجُمُعَةِ", true], ["يَأْكُلُونَ الْغَدَاءَ مُتَفَرِّقِينَ", false], ["فِي الْبَيْتِ أَخٌ وَأُخْتٌ", true]], "qs": [["مَتَى يَزُورُهُمُ الْجَدُّ؟", "يَوْمَ الْجُمُعَةِ."], ["مَاذَا يَأْكُلُونَ مَعًا؟", "الْغَدَاءَ."]]}, "AR-Y2-NN-T1-L07": {"title": "أَصْدِقَائِي", "body": ["صَدِيقِي اسْمُهُ عُمَرُ.", "نَلْعَبُ مَعًا فِي السَّاحَةِ.", "نَتَشَارَكُ الْأَلْعَابَ."], "tf": [["اسْمُ الصَّدِيقِ عُمَرُ", true], ["يَلْعَبَانِ فِي الْبَيْتِ", false], ["يَتَشَارَكَانِ الْأَلْعَابَ", true]], "qs": [["مَا اسْمُ صَدِيقِهِ؟", "عُمَرُ."], ["أَيْنَ يَلْعَبَانِ؟", "فِي السَّاحَةِ."]]}, "AR-Y2-NN-T1-L08": {"title": "جِيرَانِي", "body": ["جَارُنَا لَطِيفٌ.", "قُرْبَ بَيْتِنَا مَسْجِدٌ وَحَدِيقَةٌ.", "أَشْتَرِي الْخُبْزَ مِنَ الْبَقَالَةِ."], "tf": [["الْجَارُ لَطِيفٌ", true], ["يَشْتَرِي الْخُبْزَ مِنَ الْمَسْجِدِ", false], ["قُرْبَ الْبَيْتِ حَدِيقَةٌ", true]], "qs": [["مَاذَا قُرْبَ الْبَيْتِ؟", "مَسْجِدٌ وَحَدِيقَةٌ."], ["مِنْ أَيْنَ يَشْتَرِي الْخُبْزَ؟", "مِنَ الْبَقَالَةِ."]]}, "AR-Y2-NN-T1-L09": {"title": "مَدْرَسَتِي", "body": ["مَدْرَسَتِي كَبِيرَةٌ وَجَمِيلَةٌ.", "فِي صَفِّي عِشْرُونَ طَالِبًا.", "أَقْرَأُ الْقِصَصَ فِي الْمَكْتَبَةِ."], "tf": [["الْمَدْرَسَةُ صَغِيرَةٌ", false], ["فِي الصَّفِّ عِشْرُونَ طَالِبًا", true], ["يَقْرَأُ فِي الْمَكْتَبَةِ", true]], "qs": [["كَمْ طَالِبًا فِي صَفِّهِ؟", "عِشْرُونَ طَالِبًا."], ["أَيْنَ يَقْرَأُ الْقِصَصَ؟", "فِي الْمَكْتَبَةِ."]]}, "AR-Y2-NN-T1-L10": {"title": "بَيْتِي", "body": ["بَيْتِي فِيهِ مَطْبَخٌ وَغُرْفَتَانِ.", "فِي غُرْفَتِي سَرِيرٌ وَكُرْسِيٌّ.", "بَابُ الْبَيْتِ أَزْرَقُ."], "tf": [["فِي الْبَيْتِ غُرْفَتَانِ", true], ["بَابُ الْبَيْتِ أَحْمَرُ", false], ["فِي الْغُرْفَةِ سَرِيرٌ", true]], "qs": [["مَاذَا فِي غُرْفَتِهِ؟", "سَرِيرٌ وَكُرْسِيٌّ."], ["مَا لَوْنُ الْبَابِ؟", "أَزْرَقُ."]]}, "AR-Y2-NN-T2-L01": {"title": "كَمِ السَّاعَةُ؟", "body": ["السَّاعَةُ الْآنَ السَّابِعَةُ.", "الْيَوْمَ الْأَحَدُ.", "غَدًا عِنْدِي دَرْسُ رِيَاضَةٍ."], "tf": [["السَّاعَةُ السَّابِعَةُ", true], ["الْيَوْمَ الْجُمُعَةُ", false], ["غَدًا دَرْسُ رِيَاضَةٍ", true]], "qs": [["كَمِ السَّاعَةُ؟", "السَّابِعَةُ."], ["مَاذَا عِنْدَهُ غَدًا؟", "دَرْسُ رِيَاضَةٍ."]]}, "AR-Y2-NN-T2-L02": {"title": "أَيَّامُ الْأُسْبُوعِ", "body": ["فِي الْأُسْبُوعِ سَبْعَةُ أَيَّامٍ.", "أَذْهَبُ إِلَى الْمَدْرَسَةِ يَوْمَ الِاثْنَيْنِ.", "يَوْمَ الْجُمُعَةِ أَزُورُ جَدِّي."], "tf": [["فِي الْأُسْبُوعِ سَبْعَةُ أَيَّامٍ", true], ["يَزُورُ جَدَّهُ يَوْمَ الِاثْنَيْنِ", false], ["يَذْهَبُ إِلَى الْمَدْرَسَةِ يَوْمَ الِاثْنَيْنِ", true]], "qs": [["كَمْ يَوْمًا فِي الْأُسْبُوعِ؟", "سَبْعَةُ أَيَّامٍ."], ["مَتَى يَزُورُ جَدَّهُ؟", "يَوْمَ الْجُمُعَةِ."]]}, "AR-Y2-NN-T2-L03": {"title": "شَهْرُ مِيلَادِي", "body": ["فِي السَّنَةِ اثْنَا عَشَرَ شَهْرًا.", "عِيدُ مِيلَادِي فِي شَهْرِ دِيسَمْبِرَ.", "أَحْتَفِلُ مَعَ أُسْرَتِي."], "tf": [["فِي السَّنَةِ اثْنَا عَشَرَ شَهْرًا", true], ["عِيدُ مِيلَادِهِ فِي يَنَايِرَ", false], ["يَحْتَفِلُ مَعَ أُسْرَتِهِ", true]], "qs": [["مَتَى عِيدُ مِيلَادِهِ؟", "فِي دِيسَمْبِرَ."], ["مَعَ مَنْ يَحْتَفِلُ؟", "مَعَ أُسْرَتِهِ."]]}, "AR-Y2-NN-T2-L04": {"title": "غُرْفَةُ الْمُوسِيقَى", "body": ["فِي غُرْفَةِ الْمُوسِيقَى طَبْلٌ وَبِيَانُو.", "أَعْزِفُ عَلَى الطَّبْلِ.", "نُنْشِدُ نَشِيدَ الْوَطَنِ مَعًا."], "tf": [["فِي الْغُرْفَةِ طَبْلٌ", true], ["يَعْزِفُ عَلَى الْكَمَانِ", false], ["يُنْشِدُونَ مَعًا", true]], "qs": [["عَلَى مَاذَا يَعْزِفُ؟", "عَلَى الطَّبْلِ."], ["مَاذَا يُنْشِدُونَ؟", "نَشِيدَ الْوَطَنِ."]]}, "AR-Y2-NN-T2-L05": {"title": "فِي السَّاحَةِ", "body": ["فِي السَّاحَةِ زُحْلُوقَةٌ وَأُرْجُوحَةٌ.", "نَجْرِي وَنَلْعَبُ بِالْكُرَةِ.", "نَلْعَبُ بِحَذَرٍ حَتَّى لَا نَقَعَ."], "tf": [["فِي السَّاحَةِ أُرْجُوحَةٌ", true], ["يَلْعَبُونَ بِلَا حَذَرٍ", false], ["يَلْعَبُونَ بِالْكُرَةِ", true]], "qs": [["مَاذَا فِي السَّاحَةِ؟", "زُحْلُوقَةٌ وَأُرْجُوحَةٌ."], ["لِمَاذَا يَلْعَبُونَ بِحَذَرٍ؟", "حَتَّى لَا يَقَعُوا."]]}, "AR-Y2-NN-T2-L06": {"title": "فِي الْحَافِلَةِ", "body": ["أَرْكَبُ الْحَافِلَةَ إِلَى الْمَدْرَسَةِ.", "أَجْلِسُ عَلَى الْمَقْعَدِ وَأَرْبِطُ الْحِزَامَ.", "السَّائِقُ يَقُودُ بِهُدُوءٍ."], "tf": [["يَرْبِطُ الْحِزَامَ", true], ["السَّائِقُ يَقُودُ بِسُرْعَةٍ", false], ["يَجْلِسُ عَلَى الْمَقْعَدِ", true]], "qs": [["مَاذَا يَفْعَلُ بَعْدَ الْجُلُوسِ؟", "يَرْبِطُ الْحِزَامَ."], ["كَيْفَ يَقُودُ السَّائِقُ؟", "بِهُدُوءٍ."]]}, "AR-Y2-NN-T3-L01": {"title": "صَدِيقِي", "body": ["صَدِيقِي لَطِيفٌ وَمَرِحٌ.", "هُوَ كَرِيمٌ يُشَارِكُنِي طَعَامَهُ.", "نَضْحَكُ مَعًا كُلَّ يَوْمٍ."], "tf": [["الصَّدِيقُ مَرِحٌ", true], ["الصَّدِيقُ بَخِيلٌ", false], ["يَضْحَكَانِ مَعًا", true]], "qs": [["كَيْفَ صَدِيقُهُ؟", "لَطِيفٌ وَمَرِحٌ وَكَرِيمٌ."], ["مَاذَا يُشَارِكُهُ؟", "طَعَامَهُ."]]}, "AR-Y2-NN-T3-L02": {"title": "مُخْتَلِفُونَ", "body": ["أَنَا أُحِبُّ الرَّسْمَ.", "هُوَ يُحِبُّ الْكُرَةَ.", "نَحْنُ مُخْتَلِفُونَ، وَلَكِنَّنَا أَصْدِقَاءُ."], "tf": [["هُوَ يُحِبُّ الْكُرَةَ", true], ["كِلَاهُمَا يُحِبُّ الرَّسْمَ", false], ["هُمَا صَدِيقَانِ", true]], "qs": [["مَاذَا يُحِبُّ الْكَاتِبُ؟", "الرَّسْمَ."], ["هَلْ هُمَا مُتَّفِقَانِ فِي كُلِّ شَيْءٍ؟", "لَا، مُخْتَلِفَانِ وَلَكِنَّهُمَا صَدِيقَانِ."]]}, "AR-Y2-NN-T3-L03": {"title": "إِلَى اللِّقَاءِ", "body": ["سَافَرَتْ صَدِيقَتِي سَارَةُ.", "قُلْتُ لَهَا: مَعَ السَّلَامَةِ، إِلَى اللِّقَاءِ.", "اشْتَقْتُ إِلَيْهَا كَثِيرًا."], "tf": [["سَافَرَتْ سَارَةُ", true], ["لَمْ يَشْتَقْ إِلَيْهَا", false], ["قَالَ: إِلَى اللِّقَاءِ", true]], "qs": [["مَنْ سَافَرَتْ؟", "صَدِيقَتُهُ سَارَةُ."], ["مَاذَا قَالَ لَهَا؟", "مَعَ السَّلَامَةِ، إِلَى اللِّقَاءِ."]]}, "AR-Y2-NN-T3-L04": {"title": "فِي بَيْتِ جَدِّي", "body": ["فِي الْعُطْلَةِ نَجْتَمِعُ فِي بَيْتِ جَدِّي.", "نَأْكُلُ وَنَلْعَبُ مَعًا.", "جَدِّي يَحْكِي لَنَا قِصَصًا."], "tf": [["يَجْتَمِعُونَ فِي بَيْتِ الْجَدِّ", true], ["الْجَدُّ لَا يَحْكِي قِصَصًا", false], ["يَلْعَبُونَ مَعًا", true]], "qs": [["أَيْنَ يَجْتَمِعُونَ؟", "فِي بَيْتِ جَدِّهِ."], ["مَاذَا يَحْكِي الْجَدُّ؟", "قِصَصًا."]]}, "AR-Y2-NN-T3-L05": {"title": "عِيدُ الِاتِّحَادِ", "body": ["بِلَادِي فِيهَا سَبْعُ إِمَارَاتٍ.", "فِي عِيدِ الِاتِّحَادِ نَرْفَعُ الْعَلَمَ.", "نَحْتَفِلُ وَنُحِبُّ وَطَنَنَا."], "tf": [["فِي الْإِمَارَاتِ سَبْعُ إِمَارَاتٍ", true], ["يَرْفَعُونَ الْعَلَمَ", true], ["لَا يَحْتَفِلُونَ بِالْعِيدِ", false]], "qs": [["كَمْ إِمَارَةً فِي الْبِلَادِ؟", "سَبْعُ إِمَارَاتٍ."], ["مَاذَا يَرْفَعُونَ؟", "الْعَلَمَ."]]}, "AR-Y2-NN-T3-L06": {"title": "يَوْمٌ لَا يُنْسَى", "body": ["فُزْتُ فِي سِبَاقِ الْمَدْرَسَةِ.", "فَرِحْتُ كَثِيرًا، وَفَرِحَتْ أُمِّي.", "هَذِهِ ذِكْرَى جَمِيلَةٌ."], "tf": [["فَازَ فِي السِّبَاقِ", true], ["حَزِنَتِ الْأُمُّ", false], ["هِيَ ذِكْرَى جَمِيلَةٌ", true]], "qs": [["بِمَاذَا فَازَ؟", "بِسِبَاقِ الْمَدْرَسَةِ."], ["مَنْ فَرِحَ مَعَهُ؟", "أُمُّهُ."]]}, "AR-Y3-NN-T1-L01": {"title": "يَوْمِي الْأَوَّلُ", "body": ["فِي أَوَّلِ يَوْمٍ دَخَلْتُ صَفِّي الْجَدِيدَ.", "رَحَّبَتْ بِي الْمُعَلِّمَةُ بِابْتِسَامَةٍ.", "جَلَسْتُ بِجَانِبِ زَمِيلٍ لَطِيفٍ.", "وَضَعْتُ حَقِيبَتِي تَحْتَ الطَّاوِلَةِ."], "tf": [["رَحَّبَتِ الْمُعَلِّمَةُ بِهِ", true], ["جَلَسَ وَحْدَهُ", false], ["وَضَعَ الْحَقِيبَةَ تَحْتَ الطَّاوِلَةِ", true]], "qs": [["كَيْفَ رَحَّبَتْ بِهِ الْمُعَلِّمَةُ؟", "بِابْتِسَامَةٍ."], ["بِجَانِبِ مَنْ جَلَسَ؟", "بِجَانِبِ زَمِيلٍ لَطِيفٍ."]]}, "AR-Y3-NN-T1-L02": {"title": "صَبَاحِي", "body": ["أَسْتَيْقِظُ فِي السَّاعَةِ السَّادِسَةِ.", "أَغْسِلُ وَجْهِي وَأُصَلِّي.", "أُفْطِرُ مَعَ أُسْرَتِي.", "ثُمَّ أَذْهَبُ إِلَى الْمَدْرَسَةِ."], "tf": [["يَسْتَيْقِظُ فِي السَّادِسَةِ", true], ["يُفْطِرُ وَحْدَهُ", false], ["يَذْهَبُ إِلَى الْمَدْرَسَةِ بَعْدَ الْفُطُورِ", true]], "qs": [["مَتَى يَسْتَيْقِظُ؟", "فِي السَّاعَةِ السَّادِسَةِ."], ["مَعَ مَنْ يُفْطِرُ؟", "مَعَ أُسْرَتِهِ."]]}, "AR-Y3-NN-T1-L03": {"title": "الْجَائِزَةُ", "body": ["شَارَكْتُ فِي مُسَابَقَةِ الرَّسْمِ.", "رَسَمْتُ عَلَمَ بِلَادِي.", "فُزْتُ بِجَائِزَةٍ وَشَهَادَةٍ.", "فَرِحَ أَبِي وَأُمِّي بِي."], "tf": [["شَارَكَ فِي مُسَابَقَةِ الرَّسْمِ", true], ["رَسَمَ وَرْدَةً", false], ["فَازَ بِشَهَادَةٍ", true]], "qs": [["مَاذَا رَسَمَ؟", "عَلَمَ بِلَادِهِ."], ["بِمَاذَا فَازَ؟", "بِجَائِزَةٍ وَشَهَادَةٍ."]]}, "AR-Y3-NN-T1-L04": {"title": "نَشَاطِي الْمُفَضَّلُ", "body": ["فِي الْمَدْرَسَةِ أَنْشِطَةٌ كَثِيرَةٌ.", "أُحِبُّ الرِّيَاضَةَ، وَأُخْتِي تُحِبُّ الْمَسْرَحَ.", "وَصَدِيقِي يَقْرَأُ فِي الْمَكْتَبَةِ.", "النَّشَاطُ يَجْعَلُنَا سُعَدَاءَ."], "tf": [["يُحِبُّ الرِّيَاضَةَ", true], ["الْأُخْتُ تُحِبُّ الرَّسْمَ", false], ["الصَّدِيقُ يَقْرَأُ فِي الْمَكْتَبَةِ", true]], "qs": [["مَاذَا تُحِبُّ الْأُخْتُ؟", "الْمَسْرَحَ."], ["مَاذَا يَجْعَلُنَا النَّشَاطُ؟", "سُعَدَاءَ."]]}, "AR-Y3-NN-T1-L05": {"title": "يَوْمُ الْعِيدِ", "body": ["لَبِسْتُ مَلَابِسَ جَدِيدَةً.", "صَلَّيْنَا صَلَاةَ الْعِيدِ.", "نَزُورُ جَدِّي فَيُعْطِينِي الْعِيدِيَّةَ.", "الْعِيدُ يَوْمُ فَرَحٍ."], "tf": [["لَبِسَ مَلَابِسَ جَدِيدَةً", true], ["الْجَدُّ يُعْطِيهِ الْعِيدِيَّةَ", true], ["الْعِيدُ يَوْمُ حُزْنٍ", false]], "qs": [["مَنْ يُعْطِيهِ الْعِيدِيَّةَ؟", "جَدُّهُ."], ["مَاذَا صَلَّوْا؟", "صَلَاةَ الْعِيدِ."]]}, "AR-Y3-NN-T1-L06": {"title": "مُعَلِّمِي", "body": ["مُعَلِّمِي يَشْرَحُ الدَّرْسَ بِوُضُوحٍ.", "يَكْتُبُ عَلَى السَّبُّورَةِ.", "يُسَاعِدُنَا عِنْدَمَا نَسْأَلُ.", "أُحِبُّ مُعَلِّمِي وَأَحْتَرِمُهُ."], "tf": [["الْمُعَلِّمُ يَشْرَحُ بِوُضُوحٍ", true], ["لَا يُسَاعِدُهُمْ", false], ["يَكْتُبُ عَلَى السَّبُّورَةِ", true]], "qs": [["أَيْنَ يَكْتُبُ الْمُعَلِّمُ؟", "عَلَى السَّبُّورَةِ."], ["مَتَى يُسَاعِدُهُمْ؟", "عِنْدَمَا يَسْأَلُونَ."]]}, "AR-Y3-NN-T1-L07": {"title": "عِنْدَ الطَّبِيبِ", "body": ["شَعَرْتُ بِالْمَرَضِ فَذَهَبْتُ إِلَى الْمُسْتَشْفَى.", "فَحَصَنِي الطَّبِيبُ بِلُطْفٍ.", "أَعْطَانِي دَوَاءً.", "بَعْدَ يَوْمَيْنِ صِرْتُ بِخَيْرٍ."], "tf": [["ذَهَبَ إِلَى الْمُسْتَشْفَى", true], ["الطَّبِيبُ أَعْطَاهُ دَوَاءً", true], ["بَقِيَ مَرِيضًا شَهْرًا", false]], "qs": [["مَاذَا أَعْطَاهُ الطَّبِيبُ؟", "دَوَاءً."], ["مَتَى صَارَ بِخَيْرٍ؟", "بَعْدَ يَوْمَيْنِ."]]}, "AR-Y3-NN-T1-L08": {"title": "الشُّرْطِيُّ صَدِيقِي", "body": ["الشُّرْطِيُّ يَحْفَظُ الْأَمَانَ.", "يَقِفُ عِنْدَ الْإِشَارَةِ لِيُنَظِّمَ السَّيْرَ.", "سَيَّارَةُ الشُّرْطَةِ تُسَاعِدُ النَّاسَ.", "إِذَا ضِعْتُ أَطْلُبُ الْمُسَاعَدَةَ مِنَ الشُّرْطِيِّ."], "tf": [["الشُّرْطِيُّ يَحْفَظُ الْأَمَانَ", true], ["يَقِفُ عِنْدَ الْإِشَارَةِ", true], ["لَا نَطْلُبُ مِنْهُ الْمُسَاعَدَةَ", false]], "qs": [["مَاذَا يَحْفَظُ الشُّرْطِيُّ؟", "الْأَمَانَ."], ["مَاذَا نَفْعَلُ إِذَا ضِعْنَا؟", "نَطْلُبُ الْمُسَاعَدَةَ مِنَ الشُّرْطِيِّ."]]}, "AR-Y3-NN-T1-L09": {"title": "رَجُلُ الْإِطْفَاءِ", "body": ["رَجُلُ الْإِطْفَاءِ شُجَاعٌ.", "يُطْفِئُ الْحَرِيقَ بِالْخُرْطُومِ.", "يُنْقِذُ النَّاسَ مِنَ الْخَطَرِ.", "نَشْكُرُهُ عَلَى عَمَلِهِ."], "tf": [["رَجُلُ الْإِطْفَاءِ شُجَاعٌ", true], ["يُطْفِئُ الْحَرِيقَ بِالرَّمْلِ", false], ["يُنْقِذُ النَّاسَ", true]], "qs": [["بِمَاذَا يُطْفِئُ الْحَرِيقَ؟", "بِالْخُرْطُومِ."], ["مَاذَا يَفْعَلُ لِلنَّاسِ؟", "يُنْقِذُهُمْ مِنَ الْخَطَرِ."]]}, "AR-Y3-NN-T1-L10": {"title": "رَائِدُ الْفَضَاءِ", "body": ["رَائِدُ الْفَضَاءِ يَرْكَبُ الصَّارُوخَ.", "يُسَافِرُ إِلَى الْفَضَاءِ.", "يَرَى النُّجُومَ وَالْكَوَاكِبَ.", "أَحْلُمُ أَنْ أَكُونَ رَائِدَ فَضَاءٍ."], "tf": [["يَرْكَبُ الصَّارُوخَ", true], ["يَرَى النُّجُومَ", true], ["يُسَافِرُ بِالْحَافِلَةِ", false]], "qs": [["مَاذَا يَرَى؟", "النُّجُومَ وَالْكَوَاكِبَ."], ["بِمَاذَا يَحْلُمُ الْكَاتِبُ؟", "أَنْ يَكُونَ رَائِدَ فَضَاءٍ."]]}, "AR-Y3-NN-T2-L01": {"title": "الطَّقْسُ الْيَوْمَ", "body": ["الْيَوْمَ الْجَوُّ مُشْمِسٌ.", "أَمْسِ كَانَ غَائِمًا.", "وَغَدًا سَيَكُونُ مُمْطِرًا.", "أُحِبُّ الْمَطَرَ كَثِيرًا."], "tf": [["الْجَوُّ الْيَوْمَ مُشْمِسٌ", true], ["أَمْسِ كَانَ مُمْطِرًا", false], ["يُحِبُّ الْمَطَرَ", true]], "qs": [["كَيْفَ كَانَ الْجَوُّ أَمْسِ؟", "غَائِمًا."], ["كَيْفَ سَيَكُونُ غَدًا؟", "مُمْطِرًا."]]}, "AR-Y3-NN-T2-L02": {"title": "مَاذَا أَلْبَسُ؟", "body": ["إِذَا كَانَ الْجَوُّ بَارِدًا أَلْبَسُ الْمِعْطَفَ.", "إِذَا كَانَ مُمْطِرًا آخُذُ الْمِظَلَّةَ.", "وَإِذَا كَانَ مُشْمِسًا أَلْبَسُ الْقُبَّعَةَ وَالنَّظَّارَةَ الشَّمْسِيَّةَ."], "tf": [["يَلْبَسُ الْمِعْطَفَ فِي الْبَرْدِ", true], ["يَأْخُذُ الْمِظَلَّةَ فِي الشَّمْسِ", false], ["يَلْبَسُ النَّظَّارَةَ الشَّمْسِيَّةَ", true]], "qs": [["مَاذَا يَأْخُذُ فِي الْمَطَرِ؟", "الْمِظَلَّةَ."], ["مَاذَا يَلْبَسُ فِي الشَّمْسِ؟", "الْقُبَّعَةَ وَالنَّظَّارَةَ."]]}, "AR-Y3-NN-T2-L03": {"title": "أُحَافِظُ عَلَى بِيئَتِي", "body": ["أَرْمِي النُّفَايَاتِ فِي السَّلَّةِ.", "أُعِيدُ تَدْوِيرَ الْوَرَقِ وَالْبِلَاسْتِيكِ.", "أَزْرَعُ شَجَرَةً فِي حَدِيقَةِ الْمَدْرَسَةِ.", "بِيئَتِي نَظِيفَةٌ وَجَمِيلَةٌ."], "tf": [["يَرْمِي النُّفَايَاتِ فِي السَّلَّةِ", true], ["يَزْرَعُ شَجَرَةً فِي الْبَيْتِ", false], ["يُعِيدُ تَدْوِيرَ الْوَرَقِ", true]], "qs": [["أَيْنَ يَزْرَعُ الشَّجَرَةَ؟", "فِي حَدِيقَةِ الْمَدْرَسَةِ."], ["مَاذَا يُعِيدُ تَدْوِيرَهُ؟", "الْوَرَقَ وَالْبِلَاسْتِيكَ."]]}, "AR-Y3-NN-T2-L04": {"title": "فِي الْمَزْرَعَةِ", "body": ["زُرْتُ مَزْرَعَةَ عَمِّي.", "رَأَيْتُ بَقَرَةً وَدَجَاجَةً وَخَرُوفًا.", "الْمُزَارِعُ يُطْعِمُ الْحَيَوَانَاتِ كُلَّ صَبَاحٍ.", "جَمَعْتُ الْبَيْضَ مِنَ الْقُنِّ."], "tf": [["زَارَ مَزْرَعَةَ عَمِّهِ", true], ["رَأَى جَمَلًا", false], ["جَمَعَ الْبَيْضَ", true]], "qs": [["مَاذَا رَأَى فِي الْمَزْرَعَةِ؟", "بَقَرَةً وَدَجَاجَةً وَخَرُوفًا."], ["مَتَى يُطْعِمُ الْمُزَارِعُ الْحَيَوَانَاتِ؟", "كُلَّ صَبَاحٍ."]]}, "AR-Y3-NN-T2-L05": {"title": "فِي النَّهْرِ", "body": ["فِي النَّهْرِ تَسْبَحُ السَّمَكَةُ.", "الضِّفْدَعُ يَقْفِزُ عَلَى الصَّخْرَةِ.", "الْبَطَّةُ تَسْبَحُ مَعَ صِغَارِهَا.", "وَالتِّمْسَاحُ يَنَامُ قُرْبَ الْمَاءِ."], "tf": [["السَّمَكَةُ تَسْبَحُ فِي النَّهْرِ", true], ["الضِّفْدَعُ يَطِيرُ", false], ["الْبَطَّةُ مَعَ صِغَارِهَا", true]], "qs": [["أَيْنَ يَقْفِزُ الضِّفْدَعُ؟", "عَلَى الصَّخْرَةِ."], ["أَيْنَ يَنَامُ التِّمْسَاحُ؟", "قُرْبَ الْمَاءِ."]]}, "AR-Y3-NN-T2-L06": {"title": "فِي الْقُطْبِ", "body": ["الْقُطْبُ بَارِدٌ جِدًّا.", "الْجَلِيدُ يُغَطِّي الْأَرْضَ.", "يَعِيشُ هُنَاكَ الْبِطْرِيقُ وَالدُّبُّ الْقُطْبِيُّ.", "فِرَاءُ الدُّبِّ يَحْمِيهِ مِنَ الْبَرْدِ."], "tf": [["الْقُطْبُ حَارٌّ", false], ["يَعِيشُ هُنَاكَ الْبِطْرِيقُ", true], ["الْفِرَاءُ يَحْمِي الدُّبَّ", true]], "qs": [["مَاذَا يُغَطِّي الْأَرْضَ؟", "الْجَلِيدُ."], ["مَاذَا يَحْمِي الدُّبَّ مِنَ الْبَرْدِ؟", "فِرَاؤُهُ."]]}, "AR-Y3-NN-T3-L01": {"title": "أَخِي الصَّغِيرُ", "body": ["وُلِدَ أَخِي الصَّغِيرُ أَمْسِ.", "يَنَامُ فِي الْمَهْدِ.", "جَاءَ الْأَقَارِبُ لِلتَّهْنِئَةِ.", "وَأَحْضَرُوا لَهُ هَدَايَا جَمِيلَةً."], "tf": [["وُلِدَ الْأَخُ أَمْسِ", true], ["يَنَامُ فِي سَرِيرِ أَبِيهِ", false], ["أَحْضَرَ الْأَقَارِبُ هَدَايَا", true]], "qs": [["أَيْنَ يَنَامُ الْأَخُ؟", "فِي الْمَهْدِ."], ["لِمَاذَا جَاءَ الْأَقَارِبُ؟", "لِلتَّهْنِئَةِ."]]}, "AR-Y3-NN-T3-L02": {"title": "عِيدُ مِيلَادِ أُخْتِي", "body": ["أَرْسَلْنَا الدَّعْوَةَ إِلَى الْأَصْدِقَاءِ.", "زَيَّنَّا الْبَيْتَ بِالْبَالُونَاتِ.", "عَلَى الْكَعْكَةِ ثَمَانِيَةُ شُمُوعٍ.", "غَنَّيْنَا: عِيدُ مِيلَادٍ سَعِيدٌ!"], "tf": [["زَيَّنُوا الْبَيْتَ بِالْبَالُونَاتِ", true], ["عَلَى الْكَعْكَةِ خَمْسُ شُمُوعٍ", false], ["أَرْسَلُوا الدَّعْوَةَ", true]], "qs": [["كَمْ شَمْعَةً عَلَى الْكَعْكَةِ؟", "ثَمَانِيَةُ شُمُوعٍ."], ["بِمَاذَا زَيَّنُوا الْبَيْتَ؟", "بِالْبَالُونَاتِ."]]}, "AR-Y3-NN-T3-L03": {"title": "الْعَالَمُ يَحْتَفِلُ", "body": ["كُلُّ الشُّعُوبِ تُحِبُّ الِاحْتِفَالَ.", "فِي رَأْسِ السَّنَةِ نَرَى الْأَلْعَابَ النَّارِيَّةَ.", "فِي الْيَوْمِ الْوَطَنِيِّ نَرْفَعُ الْعَلَمَ.", "الِاحْتِفَالُ يَجْمَعُ النَّاسَ."], "tf": [["كُلُّ الشُّعُوبِ تَحْتَفِلُ", true], ["فِي الْيَوْمِ الْوَطَنِيِّ نَرْفَعُ الْعَلَمَ", true], ["الِاحْتِفَالُ يُفَرِّقُ النَّاسَ", false]], "qs": [["مَاذَا نَرَى فِي رَأْسِ السَّنَةِ؟", "الْأَلْعَابَ النَّارِيَّةَ."], ["مَاذَا يَفْعَلُ الِاحْتِفَالُ؟", "يَجْمَعُ النَّاسَ."]]}, "AR-Y3-NN-T3-L04": {"title": "عُطْلَةٌ فِي الثَّلْجِ", "body": ["سَافَرْنَا إِلَى بَلَدٍ بَارِدٍ.", "لَبِسْتُ الْقُفَّازَاتِ وَالْمِعْطَفَ.", "تَعَلَّمْتُ التَّزَلُّجَ عَلَى الثَّلْجِ.", "وَصَنَعْتُ رَجُلَ الثَّلْجِ مَعَ أَخِي."], "tf": [["سَافَرُوا إِلَى بَلَدٍ حَارٍّ", false], ["تَعَلَّمَ التَّزَلُّجَ", true], ["صَنَعَ رَجُلَ الثَّلْجِ", true]], "qs": [["مَاذَا لَبِسَ؟", "الْقُفَّازَاتِ وَالْمِعْطَفَ."], ["مَعَ مَنْ صَنَعَ رَجُلَ الثَّلْجِ؟", "مَعَ أَخِيهِ."]]}, "AR-Y3-NN-T3-L05": {"title": "عُطْلَةٌ فِي الْبَرِّ", "body": ["خَيَّمْنَا فِي الصَّحْرَاءِ.", "نَصَبْنَا الْخَيْمَةَ عَلَى الرِّمَالِ.", "أَشْعَلْنَا النَّارَ فِي اللَّيْلِ.", "وَرَكِبْتُ الْجَمَلَ مَعَ أَبِي."], "tf": [["خَيَّمُوا فِي الصَّحْرَاءِ", true], ["أَشْعَلُوا النَّارَ فِي الصَّبَاحِ", false], ["رَكِبَ الْجَمَلَ", true]], "qs": [["أَيْنَ نَصَبُوا الْخَيْمَةَ؟", "عَلَى الرِّمَالِ."], ["مَتَى أَشْعَلُوا النَّارَ؟", "فِي اللَّيْلِ."]]}, "AR-Y3-NN-T3-L06": {"title": "صَيْفِي", "body": ["فِي الْعُطْلَةِ الصَّيْفِيَّةِ سَافَرْتُ إِلَى الْبَحْرِ.", "أَسْبَحُ كُلَّ يَوْمٍ عَلَى الشَّاطِئِ.", "جَمَعْتُ الْأَصْدَافَ الْمُلَوَّنَةَ.", "عِنْدِي ذِكْرَيَاتٌ جَمِيلَةٌ."], "tf": [["سَافَرَ إِلَى الْجَبَلِ", false], ["سَبَحَ كُلَّ يَوْمٍ", true], ["جَمَعَ الْأَصْدَافَ", true]], "qs": [["أَيْنَ سَبَحَ؟", "عَلَى الشَّاطِئِ."], ["مَاذَا جَمَعَ؟", "الْأَصْدَافَ الْمُلَوَّنَةَ."]]}, "AR-Y4-NN-T1-L01": {"title": "زيارة إلى العين", "body": ["زرنا مدينة العين، مدينة الحدائق.", "تجوّلنا في حديقة الحيوان الكبيرة.", "ثمّ زرنا المتحف وتعرّفنا على تاريخ المدينة.", "وفي المساء صعدنا جبل حفيت ورأينا المدينة كلّها."], "tf": [["العين مدينة الحدائق", true], ["زاروا الشاطئ", false], ["صعدوا جبل حفيت", true]], "qs": [["ماذا زاروا بعد الحديقة؟", "المتحف."], ["ماذا رأوا من جبل حفيت؟", "المدينة كلّها."]]}, "AR-Y4-NN-T1-L02": {"title": "جولة في مدرستي", "body": ["في مدرستي مختبر للعلوم.", "وفيها ملعب كبير ومقصف.", "إذا تعبنا نذهب إلى العيادة.", "أحبّ مدرستي لأنها نظيفة ومنظّمة."], "tf": [["في المدرسة مختبر", true], ["ليس في المدرسة عيادة", false], ["المدرسة نظيفة ومنظّمة", true]], "qs": [["أين نذهب إذا تعبنا؟", "إلى العيادة."], ["لماذا يحبّ مدرسته؟", "لأنها نظيفة ومنظّمة."]]}, "AR-Y4-NN-T1-L03": {"title": "ضيف في بيتنا", "body": ["زارنا ضيف في المساء.", "استقبله أبي في المجلس.", "قدّمتُ له القهوة والتمر.", "فرح الضيف وشكرنا على الكرم."], "tf": [["استقبله الأب في المجلس", true], ["قدّم له العصير", false], ["شكرهم الضيف", true]], "qs": [["ماذا قدّم الكاتب للضيف؟", "القهوة والتمر."], ["أين استقبله الأب؟", "في المجلس."]]}, "AR-Y4-NN-T1-L04": {"title": "مدن الإمارات", "body": ["أبوظبي عاصمة دولة الإمارات.", "دبي مدينة الأبراج العالية.", "الشارقة عاصمة الثقافة.", "والفجيرة فيها جبال وبحر جميل."], "tf": [["أبوظبي العاصمة", true], ["الشارقة مدينة الأبراج", false], ["في الفجيرة جبال وبحر", true]], "qs": [["ما عاصمة الإمارات؟", "أبوظبي."], ["ماذا في الفجيرة؟", "جبال وبحر جميل."]]}, "AR-Y4-NN-T1-L05": {"title": "سباقات مشهورة", "body": ["في الإمارات سباقات مشهورة.", "سباق الهجن من تراث الأجداد.", "وسباق الخيل يجذب الزوّار من العالم.", "وفي البحر سباق القوارب الجميل."], "tf": [["سباق الهجن من التراث", true], ["سباق القوارب في الصحراء", false], ["سباق الخيل يجذب الزوّار", true]], "qs": [["ما السباق الذي يكون في البحر؟", "سباق القوارب."], ["ما السباق الذي من تراث الأجداد؟", "سباق الهجن."]]}, "AR-Y4-NN-T1-L06": {"title": "مهرجان الألوان", "body": ["في مهرجان الألوان يرمي الناس المسحوق الملوّن.", "تصبح الوجوه حمراء وصفراء وزرقاء.", "الكلّ يضحك ويرقص بفرح.", "إنه مهرجان مشهور في الهند."], "tf": [["يرمي الناس الماء فقط", false], ["الكلّ يضحك بفرح", true], ["المهرجان في الهند", true]], "qs": [["ماذا يرمي الناس في المهرجان؟", "المسحوق الملوّن."], ["أين يُقام المهرجان؟", "في الهند."]]}, "AR-Y4-NN-T1-L07": {"title": "عيد الحشرات", "body": ["في الحديقة رأيت فراشة ملوّنة.", "النحلة تجمع الرحيق من الزهور.", "والنملة تعمل بجدّ.", "والدعسوقة حمراء فيها نقاط سوداء."], "tf": [["النحلة تجمع الرحيق", true], ["الدعسوقة زرقاء", false], ["النملة تعمل بجدّ", true]], "qs": [["ماذا تجمع النحلة؟", "الرحيق من الزهور."], ["ما لون الدعسوقة؟", "حمراء فيها نقاط سوداء."]]}, "AR-Y4-NN-T1-L08": {"title": "حرب الطماطم", "body": ["في إسبانيا مهرجان غريب.", "يرمي الناس الطماطم بعضهم على بعض في الشارع.", "يصبح الشارع أحمر.", "بعد المهرجان ينظّفون الشارع معًا."], "tf": [["المهرجان في إسبانيا", true], ["يرمون التفّاح", false], ["ينظّفون الشارع بعد المهرجان", true]], "qs": [["ماذا يرمي الناس؟", "الطماطم."], ["ماذا يفعلون بعد المهرجان؟", "ينظّفون الشارع معًا."]]}, "AR-Y4-NN-T1-L09": {"title": "طرق الأبواب", "body": ["في بعض البلاد يطرق الجيران الأبواب في العيد.", "يحملون الهدايا الصغيرة.", "يقولون: «كل عام وأنتم بخير».", "العيد يقرّب الجيران بعضهم من بعض."], "tf": [["يطرق الجيران الأبواب", true], ["لا يحملون شيئًا", false], ["العيد يقرّب الجيران", true]], "qs": [["ماذا يحمل الجيران؟", "هدايا صغيرة."], ["ماذا يقولون؟", "كل عام وأنتم بخير."]]}, "AR-Y4-NN-T1-L10": {"title": "يوم الصمت", "body": ["في جزيرة بالي يوم هادئ جدًّا اسمه يوم الصمت.", "لا ضجيج ولا سيارات في الشوارع.", "يبقى الناس في البيوت للتأمّل.", "الهدوء يريح النفس."], "tf": [["يوم الصمت في جزيرة بالي", true], ["في هذا اليوم ضجيج كثير", false], ["الناس يتأمّلون في البيوت", true]], "qs": [["أين يوم الصمت؟", "في جزيرة بالي."], ["ماذا يفعل الناس؟", "يبقون في البيوت للتأمّل."]]}, "AR-Y4-NN-T2-L01": {"title": "في المطار", "body": ["وصلنا إلى المطار مبكّرين.", "قدّم أبي جوازات السفر.", "وضعنا الحقائب على الميزان.", "ثمّ انتظرنا عند البوّابة رقم خمسة."], "tf": [["وصلوا متأخّرين", false], ["قدّم الأب الجوازات", true], ["انتظروا عند البوّابة خمسة", true]], "qs": [["ماذا قدّم الأب؟", "جوازات السفر."], ["أين انتظروا؟", "عند البوّابة رقم خمسة."]]}, "AR-Y4-NN-T2-L02": {"title": "في الفندق", "body": ["حجزنا غرفة في فندق جميل.", "أعطانا الموظّف المفتاح.", "في الفندق مسبح كبير.", "سبحت فيه مع أخي."], "tf": [["أعطاهم الموظّف المفتاح", true], ["ليس في الفندق مسبح", false], ["سبح الكاتب مع أخيه", true]], "qs": [["ماذا أعطاهم الموظّف؟", "المفتاح."], ["ماذا يوجد في الفندق؟", "مسبح كبير."]]}, "AR-Y4-NN-T2-L03": {"title": "أين المتحف؟", "body": ["سألت الشرطي: أين المتحف؟", "قال: اذهب إلى الأمام.", "عند الإشارة انعطف يمينًا.", "المتحف على اليسار."], "tf": [["سأل الطبيب", false], ["عند الإشارة ينعطف يمينًا", true], ["المتحف على اليسار", true]], "qs": [["من سأل الكاتب؟", "الشرطي."], ["أين المتحف؟", "على اليسار."]]}, "AR-Y4-NN-T2-L04": {"title": "ابن الهيثم", "body": ["ابن الهيثم عالم عربي مسلم.", "درس الضوء والعين.", "أجرى تجارب كثيرة بالعدسة.", "يُسمّى أبا علم البصريات."], "tf": [["ابن الهيثم عالم عربي", true], ["درس الكيمياء", false], ["أجرى تجارب بالعدسة", true]], "qs": [["ماذا درس ابن الهيثم؟", "الضوء والعين."], ["بماذا أجرى تجاربه؟", "بالعدسة."]]}, "AR-Y4-NN-T2-L05": {"title": "توماس إديسون", "body": ["توماس إديسون مخترع مشهور.", "حاول كثيرًا ليصنع المصباح الكهربائي.", "لم ييأس بعد كل محاولة فاشلة.", "وفي النهاية أضاء المصباح."], "tf": [["إديسون مخترع", true], ["يئس بعد المحاولة الأولى", false], ["نجح في صنع المصباح", true]], "qs": [["ماذا صنع إديسون؟", "المصباح الكهربائي."], ["ماذا فعل بعد الفشل؟", "لم ييأس وحاول مرة أخرى."]]}, "AR-Y4-NN-T2-L06": {"title": "عبّاس بن فرناس", "body": ["عبّاس بن فرناس عالم أندلسي شجاع.", "صنع جناحين من الريش.", "حاول الطيران قبل أكثر من ألف عام.", "كان من أوائل من حاولوا الطيران."], "tf": [["صنع جناحين من الريش", true], ["حاول الطيران قبل عشر سنوات", false], ["كان شجاعًا", true]], "qs": [["مم صنع الجناحين؟", "من الريش."], ["متى حاول الطيران؟", "قبل أكثر من ألف عام."]]}, "AR-Y4-NN-T3-L01": {"title": "مطبخ العالم", "body": ["لكلّ شعب طبق مشهور.", "في الإمارات نأكل المجبوس بالأرز والتوابل.", "وفي إيطاليا يأكلون المعكرونة.", "أحبّ أن أتذوّق أطباق العالم."], "tf": [["المجبوس طبق إماراتي", true], ["المعكرونة من الصين", false], ["يحبّ تذوّق أطباق العالم", true]], "qs": [["ما الطبق الإماراتي؟", "المجبوس."], ["ماذا يأكلون في إيطاليا؟", "المعكرونة."]]}, "AR-Y4-NN-T3-L02": {"title": "مسابقة الطبخ", "body": ["في المدرسة مسابقة للطبخ.", "كتبنا الوصفة خطوة خطوة.", "خبزنا الكعك في الفرن.", "قال الحكم: «طعم لذيذ!»."], "tf": [["خبزوا الكعك في الفرن", true], ["لم يكتبوا الوصفة", false], ["قال الحكم: طعم لذيذ", true]], "qs": [["أين خبزوا الكعك؟", "في الفرن."], ["ماذا قال الحكم؟", "طعم لذيذ."]]}, "AR-Y4-NN-T3-L03": {"title": "عاداتي الصحية", "body": ["أمارس الرياضة كل يوم.", "أنام ثماني ساعات.", "أشرب الماء كثيرًا وآكل الخضار.", "هذه العادات تجعلني نشيطًا."], "tf": [["يمارس الرياضة كل يوم", true], ["ينام ساعتين فقط", false], ["يأكل الخضار", true]], "qs": [["كم ساعة ينام؟", "ثماني ساعات."], ["ماذا تفعل العادات الصحية؟", "تجعله نشيطًا."]]}, "AR-Y4-NN-T3-L04": {"title": "قطّتي", "body": ["عندي قطّة أليفة اسمها لولو.", "أقدّم لها الطعام والماء كل يوم.", "أعتني بها وأنظّف مكانها.", "لولو تحبّني وتلعب معي."], "tf": [["القطّة اسمها لولو", true], ["لا يعتني بها", false], ["القطّة تلعب معه", true]], "qs": [["ما اسم القطّة؟", "لولو."], ["ماذا يقدّم لها؟", "الطعام والماء."]]}, "AR-Y4-NN-T3-L05": {"title": "صديقي الوفيّ", "body": ["صديقي يوسف صديق وفيّ.", "يساعدني عندما أحتاج إلى المساعدة.", "نلعب معًا ونذاكر معًا.", "ويحفظ سرّي دائمًا."], "tf": [["يوسف صديق وفيّ", true], ["لا يساعده", false], ["يحفظ سرّه", true]], "qs": [["ما صفة يوسف؟", "وفيّ."], ["ماذا يفعلان معًا؟", "يلعبان ويذاكران."]]}, "AR-Y4-NN-T3-L06": {"title": "العطاء", "body": ["العطاء يجعلنا سعداء.", "تبرّعتُ بملابسي القديمة للمحتاجين.", "وشاركتُ في التطوّع بالمدرسة.", "قال النبيّ ﷺ: «تهادوا تحابّوا»."], "tf": [["العطاء يجعلنا سعداء", true], ["تبرّع بألعابه الجديدة", false], ["شارك في التطوّع", true]], "qs": [["بماذا تبرّع؟", "بملابسه القديمة."], ["ماذا يفعل العطاء؟", "يجعلنا سعداء."]]}, "AR-Y5-NN-T1-L01": {"title": "مباراة الفصل", "body": ["لعب فريقنا مباراة كرة القدم.", "سجّلتُ هدفًا في الدقيقة الأخيرة.", "فاز فريقنا وفرح الجميع.", "أخي يحبّ كرة السلّة أكثر."], "tf": [["سجّل الكاتب هدفًا", true], ["خسر الفريق", false], ["الأخ يحبّ كرة السلّة", true]], "qs": [["متى سجّل الهدف؟", "في الدقيقة الأخيرة."], ["ماذا يحبّ الأخ؟", "كرة السلّة."]]}, "AR-Y5-NN-T1-L02": {"title": "الفارس الصغير", "body": ["أتدرّب على ركوب الخيل في نادي الفروسية.", "أضع السرج على ظهر الحصان.", "الحصان يقفز فوق الحواجز.", "بعد التمرين أعيده إلى الإسطبل."], "tf": [["يتدرّب في نادي الفروسية", true], ["الحصان لا يقفز", false], ["يعيد الحصان إلى الإسطبل", true]], "qs": [["ماذا يضع على ظهر الحصان؟", "السرج."], ["أين يعيد الحصان؟", "إلى الإسطبل."]]}, "AR-Y5-NN-T1-L03": {"title": "سباق الجري", "body": ["شاركتُ في سباق الجري المدرسي.", "كانت المسافة كيلومترًا واحدًا.", "العدّاء الأول وصل بسرعة.", "الجري يقوّي اللياقة ويحسّن الصحة."], "tf": [["المسافة كيلومتر واحد", true], ["الجري يضعف اللياقة", false], ["شارك في السباق", true]], "qs": [["كم كانت المسافة؟", "كيلومترًا واحدًا."], ["ماذا يقوّي الجري؟", "اللياقة."]]}, "AR-Y5-NN-T1-L04": {"title": "معرض الفنون", "body": ["أقامت مدرستنا معرضًا للفنون.", "عرضنا فيه لوحات بالرسم والخطّ العربي.", "وعزف بعض الطلاب الموسيقى.", "زار المعرض أولياء الأمور."], "tf": [["عرضوا لوحات الخطّ العربي", true], ["لم يزر أحد المعرض", false], ["عزف الطلاب الموسيقى", true]], "qs": [["ماذا عرضوا؟", "لوحات بالرسم والخطّ العربي."], ["من زار المعرض؟", "أولياء الأمور."]]}, "AR-Y5-NN-T1-L05": {"title": "في المكتبة", "body": ["أستعير كتابًا من المكتبة كل أسبوع.", "أحبّ القصص المغامرة.", "كاتبي المفضّل يكتب للأطفال.", "القراءة تفتح لي عوالم جديدة."], "tf": [["يستعير كتابًا كل أسبوع", true], ["لا يحبّ القصص", false], ["القراءة تفتح عوالم جديدة", true]], "qs": [["ماذا يستعير؟", "كتابًا كل أسبوع."], ["ماذا تفتح القراءة؟", "عوالم جديدة."]]}, "AR-Y5-NN-T1-L06": {"title": "حقوقي وواجباتي", "body": ["في المدرسة لي حقّ التعلّم.", "وعليّ واجب احترام النظام والمعلّمين.", "أحترم زملائي وأساعدهم.", "الحقّ والواجب يسيران معًا."], "tf": [["لي حقّ التعلّم", true], ["ليس عليّ واجب", false], ["الحقّ والواجب معًا", true]], "qs": [["ما حقّ الطالب؟", "التعلّم."], ["ما واجبه؟", "احترام النظام والمعلّمين."]]}, "AR-Y5-NN-T1-L07": {"title": "أساعد في بيتي", "body": ["أرتّب غرفتي كل صباح.", "أساعد أمّي في ترتيب المائدة.", "أطيع والديّ وأحترمهما.", "البيت يحتاج إلى رعاية الجميع."], "tf": [["يرتّب غرفته كل صباح", true], ["لا يساعد أمّه", false], ["يطيع والديه", true]], "qs": [["متى يرتّب غرفته؟", "كل صباح."], ["ماذا يحتاج البيت؟", "رعاية الجميع."]]}, "AR-Y5-NN-T1-L08": {"title": "غذائي الصحي", "body": ["أتناول ثلاث وجبات في اليوم.", "أختار الغذاء الصحي الغني بالفيتامينات.", "لا أسرف في الطعام.", "وأشرب الماء بدل المشروبات الغازية."], "tf": [["يتناول ثلاث وجبات", true], ["يسرف في الطعام", false], ["يشرب الماء بدل الغازية", true]], "qs": [["كم وجبة يتناول؟", "ثلاث وجبات."], ["ماذا يشرب بدل المشروبات الغازية؟", "الماء."]]}, "AR-Y5-NN-T1-L09": {"title": "ملابسي", "body": ["ملابسي نظيفة ومرتّبة.", "ألبس الزيّ المدرسي بفخر.", "أتبرّع بالملابس الصغيرة للمحتاجين.", "المظهر النظيف يدلّ على الاحترام."], "tf": [["ملابسه نظيفة", true], ["يرمي الملابس الصغيرة", false], ["يلبس الزيّ المدرسي", true]], "qs": [["ماذا يفعل بالملابس الصغيرة؟", "يتبرّع بها للمحتاجين."], ["على ماذا يدلّ المظهر النظيف؟", "على الاحترام."]]}, "AR-Y5-NN-T1-L10": {"title": "وقت المرح", "body": ["في وقت الفراغ أذهب إلى حديقة الألعاب.", "في عطلة نهاية الأسبوع نقوم بنزهة.", "نلعب ونضحك ونأكل معًا.", "المرح يريح العقل بعد الدراسة."], "tf": [["يذهب إلى حديقة الألعاب", true], ["النزهة يوم الاثنين", false], ["المرح يريح العقل", true]], "qs": [["متى يقومون بالنزهة؟", "في عطلة نهاية الأسبوع."], ["ماذا يفعل المرح؟", "يريح العقل بعد الدراسة."]]}, "AR-Y5-NN-T2-L01": {"title": "مدن عربية", "body": ["القاهرة عاصمة مصر، وفيها الأهرامات قريبة.", "ودمشق من أقدم المدن في العالم.", "ومراكش مشهورة بأسواقها الملوّنة.", "لكلّ مدينة تاريخ ومعالم جميلة."], "tf": [["دمشق من أقدم المدن", true], ["مراكش مشهورة بأبراجها", false], ["القاهرة عاصمة مصر", true]], "qs": [["بماذا تشتهر مراكش؟", "بأسواقها الملوّنة."], ["ما عاصمة مصر؟", "القاهرة."]]}, "AR-Y5-NN-T2-L02": {"title": "لندن", "body": ["لندن عاصمة بريطانيا.", "يجري فيها نهر التايمز.", "فوق النهر جسر مشهور.", "وفيها الحافلة الحمراء، والمطر كثير."], "tf": [["لندن عاصمة فرنسا", false], ["فيها نهر التايمز", true], ["الحافلة فيها حمراء", true]], "qs": [["ما اسم النهر في لندن؟", "التايمز."], ["ما لون الحافلة؟", "حمراء."]]}, "AR-Y5-NN-T2-L03": {"title": "شنغهاي", "body": ["شنغهاي مدينة كبيرة في الصين.", "فيها ناطحات سحاب عالية جدًّا.", "وفيها من أكبر الموانئ في العالم.", "والقطار السريع يربطها بالمطار."], "tf": [["شنغهاي في الصين", true], ["ليس فيها ميناء", false], ["القطار السريع يربطها بالمطار", true]], "qs": [["أين شنغهاي؟", "في الصين."], ["ماذا يربطها بالمطار؟", "القطار السريع."]]}, "AR-Y5-NN-T2-L04": {"title": "عجائب الدنيا", "body": ["في العالم عجائب قديمة مدهشة.", "الأهرامات في مصر بُنيت قبل آلاف السنين.", "وسور الصين طويل جدًّا.", "يزورها الناس من كل مكان."], "tf": [["الأهرامات في مصر", true], ["سور الصين قصير", false], ["يزورها الناس من كل مكان", true]], "qs": [["أين الأهرامات؟", "في مصر."], ["كيف سور الصين؟", "طويل جدًّا."]]}, "AR-Y5-NN-T2-L05": {"title": "الشمس والقمر والبحر", "body": ["في الكسوف يغطّي القمر الشمس.", "وفي الخسوف تقع الأرض بين الشمس والقمر.", "والقمر يسبّب المدّ والجزر في البحر.", "في المدّ يرتفع الماء، وفي الجزر ينخفض."], "tf": [["في الكسوف يغطّي القمر الشمس", true], ["في الجزر يرتفع الماء", false], ["القمر يسبّب المدّ والجزر", true]], "qs": [["ماذا يحدث في المدّ؟", "يرتفع الماء."], ["ماذا يسبّب المدّ والجزر؟", "القمر."]]}, "AR-Y5-NN-T2-L06": {"title": "كائنات عجيبة", "body": ["الحرباء تغيّر لونها لتختبئ.", "والأخطبوط له ثماني أذرع.", "والزرافة عنقها طويل لتأكل من الأشجار العالية.", "كلّ كائن يتكيّف مع بيئته."], "tf": [["الحرباء تغيّر لونها", true], ["للأخطبوط أربع أذرع", false], ["الزرافة تأكل من الأشجار العالية", true]], "qs": [["لماذا تغيّر الحرباء لونها؟", "لتختبئ."], ["كم ذراعًا للأخطبوط؟", "ثماني أذرع."]]}, "AR-Y5-NN-T3-L01": {"title": "الحمام الزاجل", "body": ["قديمًا كان الناس يرسلون الرسائل بالحمام الزاجل.", "يربطون الرسالة في رجل الحمامة.", "تطير الحمامة مسافات طويلة.", "ثمّ تعود إلى بيتها ولا تضيع."], "tf": [["الحمام الزاجل ينقل الرسائل", true], ["الحمامة تضيع دائمًا", false], ["تطير مسافات طويلة", true]], "qs": [["أين يربطون الرسالة؟", "في رجل الحمامة."], ["ماذا تفعل الحمامة بعد الرحلة؟", "تعود إلى بيتها."]]}, "AR-Y5-NN-T3-L02": {"title": "الإعلام", "body": ["نعرف الأخبار من التلفاز والإذاعة.", "ونقرأها في الصحيفة.", "اليوم نقرأ الخبر أيضًا على الهاتف.", "يجب أن نتأكّد من صحّة الخبر."], "tf": [["نقرأ الأخبار في الصحيفة", true], ["كلّ خبر صحيح دائمًا", false], ["نتأكّد من صحّة الخبر", true]], "qs": [["من أين نعرف الأخبار؟", "من التلفاز والإذاعة والصحيفة."], ["ماذا يجب أن نفعل؟", "نتأكّد من صحّة الخبر."]]}, "AR-Y5-NN-T3-L03": {"title": "أتواصل بأمان", "body": ["أتّصل بجدّتي بالهاتف كل أسبوع.", "وأرسل البريد الإلكتروني لمعلّمي.", "لا أعطي معلوماتي لشخص غريب.", "التواصل الآمن يحميني."], "tf": [["يتّصل بجدّته كل أسبوع", true], ["يعطي معلوماته للغرباء", false], ["التواصل الآمن يحميه", true]], "qs": [["لمن يرسل البريد الإلكتروني؟", "لمعلّمه."], ["ماذا لا يعطي للغرباء؟", "معلوماته."]]}, "AR-Y5-NN-T3-L04": {"title": "حيوانات ذكية", "body": ["الدلفين حيوان ذكي جدًّا.", "يتعلّم الألعاب ويساعد الصيّادين.", "والغراب يستخدم العصا ليأكل.", "بعض الحيوانات تتعلّم بسرعة."], "tf": [["الدلفين حيوان ذكي", true], ["الغراب لا يستخدم الأدوات", false], ["بعض الحيوانات تتعلّم بسرعة", true]], "qs": [["بماذا يساعد الدلفين؟", "يساعد الصيّادين."], ["ماذا يستخدم الغراب؟", "العصا."]]}, "AR-Y5-NN-T3-L05": {"title": "أنواع الذكاء", "body": ["الذكاء أنواع كثيرة.", "سارة عندها ذكاء لغوي، فهي تكتب القصص.", "وعمر عنده ذكاء رياضي، يحلّ المسائل بسرعة.", "ولكلّ إنسان موهبة خاصة."], "tf": [["سارة تكتب القصص", true], ["عمر لا يحلّ المسائل", false], ["لكلّ إنسان موهبة", true]], "qs": [["ما ذكاء سارة؟", "ذكاء لغوي."], ["ماذا يفعل عمر؟", "يحلّ المسائل بسرعة."]]}, "AR-Y5-NN-T3-L06": {"title": "مدينتي الذكية", "body": ["في المدينة الذكية تعمل الأشياء بالتقنية.", "نستخدم الطاقة الشمسية في البيوت.", "الروبوت يساعد في المستشفى.", "ونطلب الخدمات بتطبيق على الهاتف."], "tf": [["تُستخدم الطاقة الشمسية", true], ["الروبوت يساعد في المستشفى", true], ["لا توجد تطبيقات في المدينة الذكية", false]], "qs": [["ماذا نستخدم في البيوت؟", "الطاقة الشمسية."], ["كيف نطلب الخدمات؟", "بتطبيق على الهاتف."]]}}