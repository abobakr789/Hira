"steps": [
"قالَتْ أُمّي:",
"انْهَضْ مِنْ نَوْمِكَ",
"يا مازِنْ",
"وَاذْهَبْ"
]
}
},
"AR-Y1-N-T1-L13": {
"seq": {
"title": "رَتِّبْ أَسْطُرَ النَّشيدِ",
"steps": [
"لُغَتي الْفُصْحى … ما أَغْلاها",
"تَسْمو روحي … في دُنْياها",
"فيها نَزَلَتْ … آيُ الذِّكْرِ",
"وَبِهِ تَحْيا … طولَ الدَّهْرِ"
]
}
},
"AR-Y1-N-T1-L19": {
"seq": {
"title": "رَتِّبْ أَسْطُرَ النَّشيدِ",
"steps": [
"حينَ تَمُرُّ السَّيّاراتْ",
"قِفْ وَتَنَبَّهْ لِلشّاراتْ",
"لا تَقْطَعْ أَبَدًا إِنْ سارَتْ",
"في الطُّرُقاتِ السَّيّاراتْ"
]
}
},
"AR-Y1-N-T2-L05": {
"seq": {
"title": "رَتِّبْ أَسْطُرَ النَّشيدِ",
"steps": [
"حَطَّتْ عَلى شُبّاكِنا حَمامَةْ",
"فَابْتَسَمَتْ يَمامَةْ",
"حَطَّ عَلى نَخْلَتِنا عُصْفورْ",
"فَمالَ سَعْفُها مَسْرورْ"
]
}
},
"AR-Y1-N-T2-L14": {
"seq": {
"title": "رَتِّبْ أَسْطُرَ النَّشيدِ",
"steps": [
"تَأَمَّلِ النُّجومْ … تُبَدِّدُ الْهُمومْ",
"بِشَكْلِها الْبَديعْ",
"تَلوحُ في السَّماءْ … إِذا مَضى الشِّتاءْ",
"وَأَقْبَلَ الرَّبيعْ"
]
}
},
"AR-Y1-N-T2-L21": {
"seq": {
"title": "رَتِّبْ أَسْطُرَ النَّشيدِ",
"steps": [
