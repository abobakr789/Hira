[["الْوَحْدَةُ الْأُولَى: اصْنَعْ أَحْلَامَكَ","Unit 1: Make Your Dreams",[["الْمُفْرَدَاتُ وَالْمَهَارَةُ: سَرْدُ الْأَحْدَاثِ فِي السِّيرَةِ الْغَيْرِيَّةِ","ص 10–13",1],["قِصَّةُ: مِنَ الْأَرْضِ إِلَى الْفَضَاءِ","ص 14–62",3],["الْمُحَادَثَةُ","ص 63",1],["النَّصُّ الْمَعْلُومَاتِيُّ: رَكِّزْ عَلَى أَهْدَافِكَ","ص 64–77",2],["اعْرِفْ لُغَتَكَ: تَعْزِيزُ الْجُمْلَةِ الِاسْمِيَّةِ وَالْفِعْلِيَّةِ","ص 78–81",1],["الْكِتَابَةُ: كِتَابَةُ نَصٍّ مَعْلُومَاتِيٍّ","ص 82–83",1],["النَّشِيدُ: كُنْ مَسْؤُولًا","ص 84–85",1],["الِاسْتِمَاعُ: وَصْفَةٌ لِلنَّجَاحِ","ص 86–90",1]]],
["الْوَحْدَةُ الثَّانِيَةُ: وَطَنِي الْجَمِيلُ","Unit 2: My Beautiful Country",[["الْمُفْرَدَاتُ وَالْمَهَارَةُ: السَّرْدُ الْمَعْلُومَاتِيُّ","ص 92–96",1],["قِصَّةُ: حُوتٌ عَلَى الشَّاطِئِ","ص 97–132",3],["الْمُحَادَثَةُ","ص 133",1],["النَّصُّ الْمَعْلُومَاتِيُّ: الْمُرْتَفَعَاتُ الْجَبَلِيَّةُ فِي دَوْلَةِ الْإِمَارَاتِ","ص 134–155",2],["اعْرِفْ لُغَتَكَ: أَنْوَاعُ الْخَبَرِ فِي الْجُمْلَةِ الِاسْمِيَّةِ","ص 156–159",1],["الْكِتَابَةُ: كِتَابَةُ نَصٍّ مَعْلُومَاتِيٍّ","ص 160–161",1],["النَّشِيدُ: عِشْقُ الْإِمَارَاتِ","ص 162–163",1],["الِاسْتِمَاعُ: ازْرَعْ جَمِيلًا","ص 164–168",1]]],
["الْوَحْدَةُ الثَّالِثَةُ: بِالْمَحَبَّةِ يَتَّسِعُ الْعَالَمُ","Unit 3: Love Makes the World Wider",[["الْمُفْرَدَاتُ وَالْمَهَارَةُ: تَرَابُطُ الْأَحْدَاثِ","ص 170–173",1],["قِصَّةُ: صَوْتُ الْمَحَبَّةِ","ص 174–198",3],["الْمُحَادَثَةُ","ص 199",1],["النَّصُّ الْمَعْلُومَاتِيُّ: التَّوَازُنُ الْبِيئِيُّ الطَّبِيعِيُّ","ص 200–217",2],["اعْرِفْ لُغَتَكَ: كَانَ وَأَخَوَاتُهَا (أَنْوَاعُ خَبَرِهَا)","ص 218–221",1],["الْكِتَابَةُ: كِتَابَةُ نَصٍّ إِقْنَاعِيٍّ","ص 222–223",1],["النَّشِيدُ: كُنْ بَلْسَمًا","ص 224–225",1],["الِاسْتِمَاعُ: الْأَرْنَبُ وَالْقَمَرُ","ص 226–229",1]]]]
