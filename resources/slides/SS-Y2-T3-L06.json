318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "تَرْشيدُ الِاسْتِهْلاكِ يُؤَدّي إِلى الْحِفاظِ عَلى الْمَوارِدِ الطَّبيعِيَّةِ الْمَوْجودَةِ في الْأَرْضِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أُرَشِّدُ أَمْ أُسْرِفُ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 تَرْشيدُ الِاسْتِهْلاكِ · الْهَدْرُ · حِفْظُ النِّعْمَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g2/SS-Y2-T3-L06/switch.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g2/SS-Y2-T3-L06/donate.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 أُطْفِئُ الْمِصْباحَ… أَتَبَرَّعُ بِالطَّعامِ الزّائِدِ لِحِفْظِ النِّعْمَةِ… كَيْفَ يُرَشِّدُ كُلٌّ مِنْهُما الِاسْتِهْلاكَ؟", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 37–39: أَضَعُ ✓ لِلسُّلوكِ الصَّحيحِ، وَأُكْمِلُ الْجُمَلَ (التَّ