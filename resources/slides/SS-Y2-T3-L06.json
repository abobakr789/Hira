"1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 تَرْشيدُ الِاسْتِهْلاكِ · الْهَدْرُ · حِفْظُ النِّعْمَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L06/kids.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "حَمَدٌ: الْحَمْدُ لِلّٰهِ لَقَدْ شَبِعْتُ. عَلْياءُ: لٰكِنَّكَ لَمْ تُنْهِ طَعامَكَ بَعْدُ. حَمَدٌ: سَأَرْميهِ في سَلَّةِ الْمُهْمَلاتِ. عَلْياءُ: هَلْ تَعْرِفُ كَمْ شَخْصًا عَمِلوا بِجُهْدٍ حَتّى يَصِلَ الطَّعامُ لِطَبَقِكَ؟ وَهَلْ تَعْرِفُ أَيْضًا أَنَّ مِنْ كُلِّ (8) أَشْخاصٍ هُناكَ شَخْصٌ جائِعٌ لا يَسْتَطيعُ تَأْمينَ طَعامِهِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "حَمَدٌ: أَنا آسِفٌ ماذا عَلَيَّ أَنْ أَفْعَلَ بِهٰذا الطَّعامِ؟ عَلْياءُ: ضَعْ في طَبَقِكَ قَدْرَ حاجَتِكَ، وَهٰذا يا حَمَدُ يُسَمّى تَرْشيدَ الِاسْتِهْلاكِ. حَمَدٌ: ماذا يُقْصَدُ بِتَرْشيدِ الِاسْتِهْلاكِ؟ عَلْياءُ: اسْتِهْلاكُ السِّلَعِ بِشَكْلٍ مُعْتَدِلٍ دونَ إِسْرافِ الْمالِ وَهَدْرِهِ. احْفَظِ النِّعْمَةَ حَتّى يَحْفَظَها اللهُ لَكَ.", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 لِماذا نَصَحَتْ عَلْياءُ حَمَدًا؟ وَما تَرْشيدُ الِاسْتِهْلاكِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعو