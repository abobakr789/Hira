d": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "عائِشَةُ قَلِقَةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَمانَةُ · واجِباتي", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 883, "y": 160, "w": 358, "h": 333, "src": "resources/ss/g2/SS-Y2-T2-L16/aisha.webp", "rad": true}, {"k": "text", "x": 38, "y": 160, "w": 819, "h": 96, "text": "😟 «لَمْ أُنْجِزْ واجِبَ اللُّغَةِ الْعَرَبِيَّةِ، وَلا أُريدُ أَنْ أُحْرَجَ أَمامَ زَميلاتي»", "size": 32, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 262, "w": 819, "h": 122, "rv": 1, "text": "ماذا تَفْعَلُ لَوْ عَرَضَتْ عَلَيْكَ صَديقَتُكَ أَنْ تَنْقُلَ واجِبَها؟", "size": 32, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 397, "w": 819, "h": 96, "rv": 2, "text": "💬 أُفَكِّرُ وَحْدي ← أُخْبِرُ زَميلي ← نُشارِكُ الصَّفَّ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 518, "w": 1203, "h": 122, "rv": 3, "text": "الْأَمانَةُ", "size": 36, "color": "B42318", "bold": true, "align": "center", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[التهيئة وإثارة الدافعية] فكّر – زاوج – شارك. لا تكشف الإجابة قبل أن يخمّن الطلاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🎯 وجهتنا اليوم", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "وِجْهَتُنا الْيَوْمَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَمانَةُ · واجِباتي", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 160, "w": 1203, "h": 128, "text": "🎯 أَعْرِفُ أَنَّ الْأَمانَةَ مِنْ مَسْؤولِيّاتي تُجاهَ وَطَني، وَأَسْتَنْتِجُ مِنْ قِصَّةِ عائِشَةَ أَنَّ نَقْلَ جُهْدِ الْغَيْرِ لَيْسَ مِنَ الْأَمانَةِ، وَأُطَبِّقُ الْأَمانَةَ في واجِباتي.", "size": 32, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 307, "w": 388, "h": 333, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 869, "y": 315, "w": 358, "h": 51, "rv": 1, "text": "⭐ مُبْتَدِئٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 869, "y": 369, "w": 358, "h": 261, "rv": 1, "text": "أُعَرِّفُ الْأَمانَةَ بِمِثالٍ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 446, "y": 307, "w": 388, "h": 333, "rv": 2, "fill": "FFFDF8", "line": "5F6C78", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 461, "y": 315, "w": 358, "h": 51, "rv": 2, "text": "⭐⭐ مُتَطَوِّرٌ", "size": 27, "color": "5F6C78", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 461, "y": 369, "w": 358, "h": 261, "rv": 2, "text": "أُمَيِّزُ السُّلوكَ الْأَمينَ مِنْ غَيْرِ الْأَمينِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 307, "w": 388, "h": 333, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 315, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 369, "w": 358, "h": 261, "rv": 3, "text": "أُعَلِّلُ تَصَرُّفَ عائِشَةَ وَأَرْبِطُ الْأَمانَةَ بِحُبِّ الْوَطَنِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[ناتج التعلّم ومعايير النجاح] اقرأ الهدف مع الطلاب، ووضّح ماذا يعني كل مستوى."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🔑 مفاتيح الدرس", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 6 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كَلِماتٌ جَديدَةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَمانَةُ · واجِباتي", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 352, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 1038, "y": 173, "w": 122, "h": 122, "emo": "🤲", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "الْأَمانَةُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "أَلّا آخُذَ جُهْدَ غَيْري وَأَنْسُبَهُ لِنَفْسي", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "📒", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "واجِباتي", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "ما يَجِبُ أَنْ أَقومَ بِهِ بِنَفْسي", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «أَنا أَمينٌ عِنْدَما …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَمانَةُ · واجِباتي", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L16/aisha.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "رَنَّ جَرَسُ الْحِصَّةِ الْأولى وَعائِشَةُ تَبْدو قَلِقَةً؛ لِأَنَّها نَسِيَتْ واجِبَ اللُّغَةِ الْعَرَبِيَّةِ، وَظَلَّتْ عِنْدَ الْبابِ تَنْتَظِرُ الْمُعَلِّمَةَ لِتَطْلُبَ إِلَيْها أَنْ تُسامِحَها وَلا تُحْرِجَها، فَاقْتَرَبَتْ مِنْها صَديقَتُها مَرْيَمُ. مَرْيَمُ: ما بِكِ يا عائِشَةُ، لِمَ أَنْتِ قَلِقَةٌ؟ عائِشَةُ: لَمْ أُنْجِزْ واجِبَ اللُّغَةِ الْعَرَبِيَّةِ. مَرْيَمُ: أَنا كَتَبْتُ وَرَقَتَيْنِ، خُذي واحِدَةً وَانْقُليها إِلى دَفْتَرِكِ. عائِشَةُ: لا لَنْ أَفْعَلَ؛ لِأَنَّهُ لَيْسَ مِنَ الْأَمانَةِ أَنْ أَنْقُلَ جُهْدَ غَيْري وَأَنْسُبَهُ لِنَفْسي. شُكْرًا لِأَنَّكِ تُريدينَ مُساعَدَتي، وَلٰكِنّي تَرَبَّيْتُ عَلى الْأَمانَةِ، وَأَعْلَمُ أَنَّ اللهَ يَراني.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "دَخَلَتِ الْمُعَلِّمَةُ، وَسَأَلَتْ: هَلْ كَتَبْتُنَّ الْواجِبَ؟ اجْمَعْنَ لِيَ الْكُرّاساتِ. فَخافَتْ عائِشَةُ، وَوَقَفَتْ تَنْتَظِرُ سُؤالَ الْمُعَلِّمَةِ. وَفيما هِيَ في خَيالِها، سَمِعَتِ الْمُعَلِّمَةَ تَقولُ: «صَفِّقْنَ لِعائِشَةَ الطّالِبَةِ الْمُبْدِعَةِ الْأَمينَةِ». صَفَّقَتِ الطّالِباتُ، وَعائِشَةُ مُنْدَهِشَةٌ! قالَتِ الْمُعَلِّمَةُ: أَنا كُنْتُ واقِفَةً عِنْدَ الْبابِ، وَسَمِعْتُ دونَ قَصْدٍ حَديثَكِ مَعَ مَرْيَمَ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 لِماذا رَفَضَتْ عائِشَةُ نَقْلَ الْواجِبِ؟ وَلِماذا صَفَّقَتْ لَها الْمُعَلِّمَةُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَمينٌ أَمْ غَيْرُ أَمينٍ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَمانَةُ · واجِباتي", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "✅ أَمينٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "أَعْمَلُ واجِبي بِنَفْسي", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 446, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "✅ أَمينٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 446, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "أُعيدُ ما وَجَدْتُهُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "❌ غَيْرُ أَمينٍ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "أَنْقُلُ جُهْدَ غَيْري", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُفَكِّرُ بِصَوْتٍ عالٍ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "لَوْ نَقَلْتُ الْواجِبَ: سَأَحْصُلُ عَلى دَرَجَةٍ… لٰكِنّي لَمْ أَتَعَلَّمْ، وَخُنْتُ الْأَمانَةَ، وَاللهُ يَراني.\nالْأَفْضَلُ: أَعْتَذِرُ لِلْمُعَلِّمَةِ وَأُنْجِزُهُ بِنَفْسي… هٰكَذا يَفْعَلُ الْمُواطِنُ الصّالِحُ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 أَنا أَتَعَلَّمُ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "الْأَمانَةُ مِنْ صِفاتِ الْمُسْلِمِ، وَهِيَ مِنْ مَسْؤولِيّاتي تُجاهَ وَطَني.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أُطَبِّ