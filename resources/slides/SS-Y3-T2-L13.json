461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُجْتَمَعُ · الْحَيُّ · الْمَسْجِدُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L13/mosque.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "الْمُجْتَمَعُ: هُوَ مَجْموعَةٌ مِنَ الْأَفْرادِ يَعيشونَ عَلى أَرْضٍ واحِدَةٍ، تَرْبِطُهُمْ رَوابِطُ مُتَعَدِّدَةٌ وَهِيَ اللُّغَةُ الْعَرَبِيَّةُ، الدّينُ الْإِسْلامِيُّ، التّاريخُ الْمُشْتَرَكُ، الْعاداتُ وَالتَّقاليدُ، وَيَتَكَوَّنُ الْمُجْتَمَعُ مِنْ عَدَدٍ مِنَ الْأُسَرِ، يَسْكُنونَ أَحْياءً مُتَعَدِّدَةً، وَالْحَيُّ مَجْموعَةٌ مِنَ الْمَنازِلِ الْمُتَجاوِرَةِ وَالْمَرافِقِ الْعامَّةِ وَالْخِدْماتِ. وَمِنْ مُكَوِّناتِ الْمُجْتَمَعِ: الْمَسْجِدُ، وَالْمَدْرَسَةُ، وَالْحَديقَةُ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الْمَسْجِدُ: دارٌ لِلْعِبادَةِ تُقامُ فيهِ الصَّلَواتُ الْخَمْسُ. نَتَعَلَّمُ مِنَ الْمَسْجِدِ: احْتِرامَ الْمَواعيدِ، النَّظافَةَ، كَما يُرَبّي فينا الطُّمَأْنينَةَ. تَكْثُرُ الْمَساجِدُ في أَحْياءِ بِلادي، وَمِنْ أَبْرَزِ هٰذِهِ الْمَساجِدِ مَسْجِدُ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - يَقَعُ في مَدينَةِ أَبوظَبي وَيُعْتَبَرُ صَرْحًا إِسْلامِيًّا بارِزًا في مُجْتَمَعِنا، وَهُوَ مِنْ أَكْبَرِ مَساجِدِ الْعالَمِ، وَكانَ الشَّيْخُ زايِدٌ - رَحِمَهُ اللهُ - قَدْ أَمَرَ بِبِنائِهِ قَبْلَ وَفاتِهِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْمُجْتَمَعُ؟ وَماذا نَتَعَلَّمُ مِنَ الْمَسْجِدِ؟ وَأَيْنَ يَقَعُ مَسْجِدُ الشَّيْخِ زايِدٍ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "ما نَتَعَلَّمُهُ مِنَ الْمَسْجِدِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُجْتَمَعُ · الْحَيُّ · الْمَسْجِدُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "⏰ احْتِرامُ الْمَواعيدِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الصَّلاةُ في وَقْتِها", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "