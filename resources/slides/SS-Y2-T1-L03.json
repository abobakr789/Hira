 "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «فَصْلي الْمُفَضَّلُ … لِأَنَّ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ: أَنا الْأَفْضَلُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْحَرَكَةُ السَّنَوِيَّةُ · الْفُصولُ الْأَرْبَعَةُ · الرَّبيعُ · الصَّيْفُ · الْخَريفُ · الشِّتاءُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T1-L03/court.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "تَدورُ الْأَرْضُ حَوْلَ الشَّمْسِ مِنَ الْغَرْبِ إِلى الشَّرْقِ، وَتَسْتَغْرِقُ هٰذِهِ الدَّوْرَةُ سَنَةً كامِلَةً، لِذٰلِكَ تُسَمّى بِالْحَرَكَةِ السَّنَوِيَّةِ. وَقَفَتِ الْفُصولُ الْأَرْبَعَةُ أَمامَ الْقاضي. قالَ الرَّبيعُ: جَوّي مُعْتَدِلٌ، وَشَمْسي مُشْرِقَةٌ. وَقالَ الصَّيْفُ: يَذْهَبُ النّاسُ في أَيّامي إِلى شَواطِئِ الْبَحْرِ، فَيَسْتَمْتِعونَ، وَيَلْعَبونَ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "قالَ الْخَريفُ: تَتَساقَطُ أَوْراقُ أَشْجاري لِتَنْمُوَ في الرَّبيعِ. وَقالَ الشِّتاءُ: مَطَري غَزيرٌ، وَشَمْسي دافِئَةٌ. قالَ الْقاضي: إِنَّ اللهَ مَيَّزَ كُلَّ فَصْلٍ بِميزَةٍ جَميلَةٍ تَنْفَعُ النّاسَ، فَعَلى الْفُصولِ أَنْ تُحِبَّ بَعْضَها، وَتَشْكُرَ رَبَّها. صاحَتِ الْفُصولُ: شُكْرًا يا رَبَّنا.", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 بِماذا حَكَمَ الْقاضي؟ وَما مِيزَةُ كُلِّ فَصْلٍ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْفُصولُ الْأَرْبَعَةُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْحَرَكَةُ السَّنَوِيَّةُ · الْفُصولُ الْأَرْبَعَةُ · الرَّبيعُ · الصَّيْفُ · الْخَريفُ · الشِّتاءُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "DB2777", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🌸 الرَّبيعُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": fal