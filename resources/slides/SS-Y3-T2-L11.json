, "rv": 3, "text": "أَقْتَرِحُ حَلًّا لِخِلافٍ بَيْنَ الْإِخْوَةِ.\nأَكْتُبُ كَلِمَةَ شُكْرٍ لِأَخي الْكَبيرِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 502, "w": 1203, "h": 141, "rv": 4, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 509, "w": 1172, "h": 51, "rv": 4, "text": "🏆 تَحَدٍّ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 563, "w": 1172, "h": 69, "rv": 4, "text": "🎤 «مَسْرَحُ الْإِخْوَةِ»: نُمَثِّلُ مَوْقِفَ خِلافٍ بَيْنَ أَخَوَيْنِ، ثُمَّ نُعيدُ تَمْثيلَهُ بِالْحِوارِ وَالِاحْتِرامِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[الأنشطة المتمايزة: «أطبّق بنفسي»] وزّع الأوراق الثلاث وورقة أصحاب الهمم. الهدف واحد والمهمة تختلف."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🌱 قيمة نعيشها", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 4 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "حُسْنُ التَّعامُلِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الِاحْتِرامُ · الْمُساعَدَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 282, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 665, "y": 168, "w": 561, "h": 51, "rv": 1, "text": "🇦🇪 مِنْ سَنْعِ بِلادي أَتَعَلَّمُ",