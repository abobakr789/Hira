, "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "أَنا مُحَمَّدٌ في الصَّفِّ الثّالِثِ، لي أَخٌ اسْمُهُ عُبَيْدٌ، وَلي أُخْتٌ اسْمُها مَرْيَمُ، أُحِبُّهُما، وَنُساعِدُ والِدَيْنا مَعًا. يَسودُ بَيْتَنا الْوُدُّ وَالِاحْتِرامُ (وَهُوَ يَعْني إِظْهارَ التَّقْديرِ لِلْآخَرينَ)، يَتَعَجَّبُ أَصْدِقائي مِنّي عِنْدَما أُخْبِرُهُمْ أَنَّهُ لا يَحْدُثُ شِجارٌ وَلا خِصامٌ بَيْني وَبَيْنَ إِخْوَتي، بَلْ حِوارٌ وَتَفاهُمٌ دائِمٌ، وَهٰذا ما عَوَّدَنا والِدايَ عَلَيْهِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "غَرَسا فينا احْتِرامَ الْكَبيرِ وَالْعَطْفَ عَلى الصَّغيرِ، وَالتَّعامُلَ مَعَهُمْ بِمَوَدَّةٍ وَمَحَبَّةٍ. فَأَنا أُساعِدُ أُخْتي في دُروسِها، وَأُساعِدُ أَخي في تَرْتيبِ أَلْعابِهِ، وَأَكونُ مُسْتَعِدًّا لِمُساعَدَتِهِمْ في أَيِّ وَقْتٍ، وَالْمُساعَدَةُ تَعْني تَقْديمَ الْعَوْنِ. وَمِنْ قِيَمِ بِلادي: الْأُسْلوبُ الرّاقي وَحُسْنُ التَّعامُلِ وَطيبُ الْخُلُقِ مَعَ الْآخَرينَ يُحَبِّبُ النّاسَ فيكَ وَيَجْذِبُهُمْ إِلَيْكَ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 لِماذا لا يَحْدُثُ شِجارٌ في بَيْتِ مُحَمَّدٍ؟ وَكَيْفَ يُساعِدُ إِخْوَتَهُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y"