"y": 160, "w": 286, "h": 134, "rv": 1, "fill": "EA580C", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "👶 الصَّغيرُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "أَعْطِفُ عَلَيْهِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أَحُلُّ الْخِلافَ بِالْحِوارِ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "أَخي أَخَذَ لُعْبَتي ← لا أَصْرُخُ وَلا أَضْرِبُ ← أَقولُ بِهُدوءٍ: «أَعِدْها مِنْ فَضْلِكَ، وَلْنَلْعَبْ بِها مَعًا».\nإِذا لَمْ يَنْجَحِ الْحِوارُ ← أَطْلُبُ مُساعَدَةَ والِدَيَّ… فَالْحِوارُ وَالتَّفاهُمُ يَمْنَعانِ الشِّجارَ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 مِنْ قِيَمي", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "أَتَعاوَنُ مَعَ إِخْوَتي وَأَخَواتي بِمَوَدَّةٍ وَاحْتِرامٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h"