4, "y": 315, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 369, "w": 358, "h": 261, "rv": 3, "text": "أُفَسِّرُ: لِماذا الصِّدْقُ مَنْجاةٌ؟ وَلِماذا كانَ اعْتِرافُ عائِشَةَ صَحيحًا؟", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[ناتج التعلّم ومعايير النجاح] اقرأ الهدف مع الطلاب، ووضّح ماذا يعني كل مستوى."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🔑 مفاتيح الدرس", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 6 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كَلِماتٌ جَديدَةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 352, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 1038, "y": 173, "w": 122, "h": 122, "emo": "🛒", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "التَّسَوُّقُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "شِراءُ ما تَحْتاجُ إِلَيْهِ مِنَ الْأَكْلِ وَالْمَلابِسِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "❌", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "الْكَذِبُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "قَوْلُ غَيْرِ الْحَقيقَةِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 352, "rv": 3, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 426, "y": 173, "w": 122, "h": 122, "emo": "✅", "rv": 3}, {"k": "text", "x": 354, "y": 307, "w": 266, "h": 77, "rv": 3, "text": "الصِّدْقُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 354, "y": 390, "w": 266, "h": 109, "rv": 3, "text": "قَوْلُ الْحَقيقَةِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «الصِّدْقُ مَنْجاةٌ لِأَنَّ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L17/p2.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "في فَصْلِ الرَّبيعِ، عِنْدَما كانَ الْجَوُّ بَديعًا، قَرَّرَتِ الْأُمُّ الْخُروجَ لِلتَّسَوُّقِ (أَيْ شِراءِ ما تَحْتاجُ إِلَيْهِ مِنَ الْأَكْلِ وَالْمَلابِسِ)، وَوَصَّتِ ابْنَتَها عائِشَةَ بِأُخْتِها الصَّغيرَةِ مَرْيَمَ. جَلَسَتْ عائِشَةُ تَكْتُبُ واجِباتِها، وَظَلَّتْ مَرْيَمُ تُراقِبُ الْفَراشاتِ. وَفَجْأَةً قَفَزَتْ مَرْيَمُ نَحْوَ الْبابِ تُريدُ الْخُروجَ لِلْإِمْساكِ بِالْفَراشاتِ. هُنا صَرَخَتْ عائِشَةُ قائِلَةً: «لا، يا مَرْيَمُ! هُناكَ وَحْشٌ كَبيرٌ في الْخارِجِ يَأْكُلُ الْبَناتِ الصَّغيراتِ». فَزِعَتْ مَرْيَمُ، وَبَكَتْ، وَظَلَّتْ خائِفَةً ساعاتٍ طَويلَةً.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "دَخَلَتِ الْأُمُّ، فَاقْتَرَبَتْ مِنْ مَرْيَمَ الَّتي كانَتْ تَرْتَجِفُ، فَسَأَلَتْ عائِشَةَ: «ما بِها أُخْتُكِ مَرْيَمُ خائِفَةٌ؟». أَجابَتْ عائِشَةُ: «أَنا آسِفَةٌ يا أُمّي، أَنا كَذَبْتُ عَلَيْها، وَقُلْتُ لَها: إِنَّ هُناكَ وَحْشًا مُخيفًا في الْخارِجِ، لَمْ أَقْصِدْ أَذِيَّتَها». قالَتِ الْأُمُّ: «لِماذا يا عائِشَةُ تُخيفينَ أُخْتَكِ بِكِذْبَةٍ؟ وَالْكَذِبُ مُحَرَّمٌ في دينِنا، وَهُوَ صِفَةٌ سَيِّئَةٌ، أَنْتِ أَخْطَأْتِ، نَعَمْ، وَلٰكِنَّكِ اعْتَرَفْتِ بِخَطَئِكِ، وَكُنْتِ صادِقَةً مَعي، وَتَذَكَّري دائِمًا أَنَّ الصِّدْقَ مَنْجاةٌ، وَأَنَّ اللهَ يُحِبُّ الصّادِقينَ».", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا قالَتْ عائِشَةُ لِمَرْيَمَ؟ وَبِماذا نَصَحَتْها الْأُمُّ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الصِّدْقُ وَالْكَذِبُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "✅ الصِّدْقُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "قَوْلُ الْحَقيقَةِ · مَنْجاةٌ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 446, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "❌ الْكَذِبُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 446, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "قَوْلُ غَيْرِ الْحَقيقَةِ · مُحَرَّمٌ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "💪 الِاعْتِرافُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "بِالْخَطَأِ شَجاعَةٌ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُعَلِّلُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "أَخْطَأَتْ عائِشَةُ عِنْدَما كَذَبَتْ فَخافَتْ مَرْيَمُ، وَلٰكِنَّها أَحْسَنَتْ عِنْدَما اعْتَرَفَتْ وَاعْتَذَرَتْ.\nإِذَنْ: إِذا أَخْطَأْتُ أَقولُ الْحَقيقَةَ وَأَعْتَذِرُ… فَالصِّدْقُ يُنْجيني.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "الصِّدْقُ هُوَ الْإِخْبارُ عَنِ الشَّيْءِ عَلى ما هُوَ عَلَيْهِ، وَالْكَذِبُ هُوَ الْإِخْبارُ عَنِ الشَّيْءِ بِخِلافِ ما هُوَ عَلَيْهِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "صادِقٌ أَمْ كاذِبٌ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g2/SS-Y2-T2-L17/p4.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g2/SS-Y2-T2-L17/p3.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 قالَتْ عائِشَةُ: «هُناكَ وَحْشٌ في الْخارِجِ» ← صِدْقٌ أَمْ كَذِبٌ؟ قالَتْ: «أَنا آسِفَةٌ، كَذَبْتُ» ← ؟", "size": 27, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 84: أَضَعُ ✓ لِلْعِبارَةِ الصَّحيحَةِ، وَأُصَنِّفُ الْمَواقِفَ (صِدْقٌ - كَذِبٌ).", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[الممارسة الموجّهة: «نطبّق معًا»] اعرض الصورتين، وعُدّوا معًا. ثم نفّذوا نشاط الكتاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚦 إشارة الانطلاق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الصِّدْقُ هُوَ:", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 701, "y": 160, "w": 490, "h": 294, "src": "resources/ss/g2/SS-Y2-T2-L17/p4.webp", "rad": true}, {"k": "text", "x": 650, "y": 454, "w": 592, "h": 58, "text": "(أ)", "size": 36, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "pic", "x": 90, "y": 160, "w": 490, "h": 294, "src": "resources/ss/g2/SS-Y2-T2-L17/p2.webp", "rad": true}, {"k": "text", "x": 38, "y": 454, "w": 592, "h": 58, "text": "(ب)", "size": 36, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 521, "w": 1203, "h": 61, "rv": 1, "text": "✅ قَوْلُ الْحَقيقَةِ، وَهُوَ مَنْجاةٌ، وَاللهُ يُحِبُّ الصّادِقينَ.", "size": 28, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 589, "w": 1203, "h": 58, "rv": 2, "text": "🟥 أَحْتاجُ مُساعَدَةً     🟨 أَحْتاجُ قَليلًا     🟩 جاهِزٌ", "size": 27, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[تحقّق قبل العمل المستقل] يرفع كل طالب بطاقة (أ) أو (ب). من يخطئ ينضمّ إلى مجموعة دعم قصيرة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚀 تحدّي المستويات", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 10 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كُلٌّ في مُسْتَواهُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 326, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 869, "y": 168, "w": 358, "h": 51, "rv": 1, "text": "⭐ مُبْتَدِئٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 869, "y": 221, "w": 358, "h": 255, "rv": 1, "text": "أُصَنِّفُ الْعِباراتِ: صِدْقٌ / كَذِبٌ.\nأَتَتَبَّعُ: الصِّدْقُ مَنْجاةٌ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 326, "rv": 2, "fill": "FFFDF8", "line": "5F6C78", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 461, "y": 168, "w": 358, "h": 51, "rv": 2, "text": "⭐⭐ مُتَطَوِّرٌ", "size": 27, "color": "5F6C78", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 461, "y": 221, "w": 358, "h": 255, "rv": 2, "text": "أُرَتِّبُ أَحْداثَ الْقِصَّةِ.\nأُكْمِلُ تَعْريفَيِ الصِّدْقِ وَالْكَذِبِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 326, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 358, "h": 255, "rv": 3, "text": "أُعَلِّلُ: لِماذا كانَ اعْتِرافُ عائِشَةَ صَحيحًا؟\nأَكْتُبُ نِهايَةً أُخْرى لَوْ لَمْ تَكْذِبْ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 502, "w": 1203, "h": 141, "rv": 4, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 509, "w": 1172, "h": 51, "rv": 4, "text": "🏆 تَحَدٍّ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 563, "w": 1172, "h": 69, "rv": 4, "text": "🎤 «لَوْ كُنْتُ عائِشَةَ»: نُمَثِّلُ الْقِصَّةَ بِنِهايَةٍ جَديدَةٍ تَقولُ فيها عائِشَةُ الْحَقيقَةَ مِنَ الْبِدايَةِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[الأنشطة المتمايزة: «أطبّق بنفسي»] وزّع الأوراق الثلاث وورقة أصحاب الهمم. الهدف واحد والمهمة تختلف."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🌱 قيمة نعيشها", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 4 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الصِّدْقُ مَنْجاةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 282, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 665, "y": 168, "w": 561, "h": 51, "rv": 1, "text": "🇦🇪 مِنْ سَنْعِ بِلادي أَتَعَلَّمُ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 665, "y": 221, "w": 561, "h": 210, "rv": 1, "text": "الصِّدْقُ في الْقَوْلِ وَعَدَمُ الْكَذِبِ في الْحَديثِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 160, "w": 592, "h": 282, "rv": 2, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 561, "h": 51, "rv": 2, "text": "🏠 حَقيقَةٌ وَطَنِيَّةٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 561, "h": 210, "rv": 2, "text": "الصِّدْقُ: الْإِخْبارُ عَنِ الشَّيْءِ عَلى ما هُوَ عَلَيْهِ،\nوَالْكَذِبُ: الْإِخْبارُ عَنْهُ بِخِلافِ ما هُوَ عَلَيْهِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 457, "w": 1203, "h": 186, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 465, "w": 1172, "h": 51, "rv": 3, "text": "🤔 ماذا أَفْعَلُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 518, "w": 1172, "h": 114, "rv": 3, "text": "كَسَرْتُ كوبًا في الْبَيْتِ وَلَمْ يَرَني أَحَدٌ… هَلْ أُخْبِرُ أُمّي؟", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[القيمة والسلوك والهوية] ناقش المعضلة: ماذا تفعل؟ ولماذا؟ اربطها بالسَّنع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🎟️ تذكرة الخروج", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 3 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "تَذْكِرَةُ الْخُروجِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 442, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🎟️ أُجيبُ وَحْدي", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 370, "text": "١) الصِّدْقُ هُوَ:  (أ) قَوْلُ الْحَقيقَةِ   (ب) قَوْلُ غَيْرِ الْحَقيقَةِ   (ج) السُّكوتُ\n٢) قالَتِ الْأُمُّ: الصِّدْقُ …:  (أ) مَنْجاةٌ   (ب) خَطَرٌ   (ج) ضَعْفٌ\n٣) أَكْتُبُ ماذا أَفْعَلُ إِذا أَخْطَأْتُ: ……", "size": 34, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 604, "w": 1203, "h": 51, "text": "تُجْمَعُ البِطاقاتُ لِنَبْدَأَ بِها الدَّرْسَ القادِمَ.", "size": 23, "color": "6B7B7E", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[بطاقة الخروج] يجيب كل طالب وحده في البطاقة، ثم يمسح رمز الاستجابة السريعة في الشريحة التالية."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🪞 مرآة التعلّم", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "ماذا تَعَلَّمْتُ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 160, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🪞 تَعَلَّمْتُ الْيَوْمَ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 88, "text": "أَنَّ الصِّدْقَ قَوْلُ الْحَقيقَةِ وَالْكَذِبَ قَوْلُ غَيْرِ الْحَقيقَةِ، وَأَنَّ الْكَذِبَ مُحَرَّمٌ وَصِفَةٌ سَيِّئَةٌ، وَأَنَّ الِاعْتِرافَ بِالْخَطَأِ شَجاعَةٌ، وَالصِّدْقَ مَنْجاةٌ، وَاللهُ يُحِبُّ الصّادِقينَ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 335, "w": 1203, "h": 141, "rv": 1, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 343, "w": 1172, "h": 51, "rv": 1, "text": "❓ أَتَساءَلُ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 397, "w": 1172, "h": 69, "rv": 1, "text": "كَيْفَ نَتَعاوَنُ لِنَبْنِيَ وَطَنًا أَجْمَلَ؟", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 493, "w": 1203, "h": 150, "rv": 2, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 500, "w": 1172, "h": 51, "rv": 2, "text": "🔬 أَرْبِطُ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 554, "w": 1172, "h": 78, "rv": 2, "text": "الْعُلومُ: الْهُطولُ هُوَ الْماءُ الَّذي يَسْقُطُ عَلى الْأَرْضِ مِنَ السُّحُبِ عَلى هَيْئَةِ مَطَرٍ أَوْ ثَلْجٍ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[غلق الدرس والتأمل] اطلب من ثلاثة طلاب إكمال الجمل شفويًّا."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🏠 رسالتي إلى البيت", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رِسالَتي إِلى الْبَيْتِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّسَوُّقُ · الْكَذِبُ · الصِّدْقُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 243, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🏠 مَعَ أُسْرَتي", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 172, "text": "١) أَبْحَثُ: ما فَوائِدُ الصِّدْقِ؟\n٢) أُكْمِلُ كِتابي ص 84.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 420, "w": 1203, "h": 223, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 428, "w": 1172, "h": 51, "rv": 1, "text": "🎯 مُهِمَّةُ أَداءٍ صَغيرَةٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 481, "w": 1172, "h": 151, "rv": 1, "text": "أَكْتُبُ «يَوْمِيّاتِ الصِّدْقِ» أُسْبوعًا: مَوْقِفٌ كُلَّ يَوْمٍ قُلْتُ فيهِ الْحَقيقَةَ،\nوَأَعْرِضُها عَلى أُسْرَتي.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[التكليف ومهمة الأداء] ذكّر الطلاب بالمهمة، وحدّد موعد عرض اللوحة."}]}