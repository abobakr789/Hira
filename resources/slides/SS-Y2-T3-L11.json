 false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[غلق الدرس والتأمل] اطلب من ثلاثة طلاب إكمال الجمل شفويًّا."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🏠 رسالتي إلى البيت", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رِسالَتي إِلى الْبَيْتِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْحَوِيُّ · الْمَخْزَنُ · الْبَخّارُ · الْحُجْرَةُ · اللّيوانُ · الْمَجْلِسُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 243, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🏠 مَعَ أُسْرَتي", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 172, "text": "١) أَبْحَثُ: ما أَهَمِّيَّةُ الْكَهْرَباءِ في حَياتِنا؟\n٢) أُكْمِلُ كِتابي ص 66–70.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 420, "w": 1203, "h": 223, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 428, "w": 1172, "h": 51, "rv": 1, "text": "🎯 مُهِمَّةُ أَداءٍ صَغيرَةٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 481, "w": 1172, "h": 151, "rv": 1, "text": "أَرْسُمُ مُخَطَّطَ «بَيْتِ جَدّي» بِأَقْسامِهِ (الْحَوِيُّ، الْمَجْلِسُ، اللّيوانُ، الْحُجْرَةُ، الْمَطْبَخُ، الْبَخّارُ)،\nوَأُلَوِّنُهُ وَأَعْرِضُهُ عَلى زُمَلائي.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[التكليف ومهمة الأداء] ذكّر الطلاب بالمهمة، وحدّد موعد عرض اللوحة."}]}