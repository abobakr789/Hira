6, "h": 109, "rv": 4, "text": "الْمَكانُ الَّذي نَسْتَقْبِلُ الضُّيوفَ فيهِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «في الْبَيْتِ الْقَديمِ كانَ … لِـ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْحَوِيُّ · الْمَخْزَنُ · الْبَخّارُ · الْحُجْرَةُ · اللّيوانُ · الْمَجْلِسُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L11/tower.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "أَخْبَرَني جَدّي أَنَّ الْمَساكِنَ في دَوْلَتي الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ تَطَوَّرَتْ بَعْدَ قِيامِ الِاتِّحادِ عامَ 1971م. حَيْثُ وَجَّهَ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ، وَالشَّيْخُ راشِدُ بْنُ سَعيدٍ آلِ مَكْتومٍ - رَحِمَهُما اللهُ - اهْتِمامَهُما لِراحَةِ وَرَفاهِيَةِ الْمُواطِنِ. فَبادَرا في تَطْويرِ مَساكِنِ الْمُواطِنينَ، وَالْعَمَلِ عَلى اسْتِقْرارِهِمْ، فَتَغَيَّرَ الْمَسْكَنُ الْإِماراتِيُّ مِنَ الْعَريشِ وَالْخَيْمَةِ وَبَيْتِ الشَّعْرِ إِلى بُيوتٍ مِنْ حِجارَةٍ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "دَخَلْتُ مَعَ جَدّي في بَيْتٍ مِنَ الْبُيوتِ الْقَديمَةِ، وَرَأَيْتُ أَنَّها مُقَسَّمَةٌ إِلى عِدَّةِ أَقْسامٍ مِنْها: الْحَوِيُّ: وَيُحَوِّطُ الدّارَ مِنَ الْخارِجِ. الْبَخّارُ: مَخْزَنٌ لِحِفْظِ مَوادِّ الْمَعيشَةِ. الْمَطْبَخُ: الْمَكانُ الَّذي يُعَدُّ فيهِ الطَّعامُ. الْحُجْرَةُ: وَهِيَ غُرْفَةُ النَّوْمِ. الْمَجْلِسُ: الْمَكانُ الَّذي نَسْتَقْبِلُ الضُّيوفَ فيهِ. اللّيوانُ: الْمَساحَةُ الَّتي تَكونُ أَمامَ غُرْفَةِ الْبَيْتِ. عَرَفْتُ مِنْ جَدّي أَنَّ قادَةَ دَوْلَتي يَعْمَلونَ لِراحَةِ الْمُواطِنينَ؛ فَقَدْ بَنَتِ الدَّوْلَةُ الْمَساكِنَ وَاسْتَقَرَّ السُّكّانُ فيها، وَمُدَّتْ لَها الْكَهْرَباءُ وَالْماءُ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 مَتى تَطَوَّرَتِ الْمَساكِنُ؟ وَما الْبَخّارُ وَاللّيوانُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مِنَ الْعَريشِ إِلى بَيْتِ الْحِجارَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "te