66, "h": 109, "rv": 4, "text": "تَسَلَّمَها عامَ 2022م", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «وُلِدَ الشَّيْخُ مُحَمَّدُ بْنُ زايِدٍ في … عامَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 نَشْأَتُهُ · وِلايَةُ الْعَهْدِ · الْقائِدُ الْأَعْلى لِلْقُوّاتِ الْمُسَلَّحَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L07/youth.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "دَوْلَةُ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ مِنَ الدُّوَلِ الَّتي حَباها اللهُ بِقِيادَةٍ حَكيمَةٍ، سَخَّرَتْ كافَّةَ إِمْكانِيّاتِها في خِدْمَةِ الشَّعْبِ وَالْمُواطِنِ في مُعْظَمِ أُمورِ حَياتِهِ، مُنْطَلِقينَ مِنْ نَهْجِ الْمَغْفورِ لَهُ الْمُؤَسِّسِ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - مُتَقَرِّبينَ مِنْ شَخْصِيَّةٍ أَحَبَّها الصَّغيرُ قَبْلَ الْكَبيرِ. وُلِدَ صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ زايِدٍ آلِ نَهْيانَ - حَفِظَهُ اللهُ - في مَدينَةِ الْعَيْنِ يَوْمَ 11 مارِسَ عامَ 1961م، وَهُوَ الِابْنُ الثّالِثُ لِلْمَغْفورِ لَهُ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - الْباني الْمُؤَسِّسِ لِدَوْلَةِ الْإِماراتِ. وَقَدْ نَشَأَ سُمُوُّهُ تَحْتَ رِعايَةِ والِدِهِ وَوالِدَتِهِ سُمُوِّ الشَّيْخَةِ فاطِمَةَ بِنْتِ مُبارَكٍ - حَفِظَها اللهُ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "حَياةُ صاحِبِ السُّمُوِّ الشَّيْخِ مُحَمَّدِ بْنِ زايِدٍ مَليئَةٌ بِالْمَهامِّ الْوَطَنِيَّةِ وَالْإِنْجازاتِ: 1979م تَخَرَّجَ مِنْ أَكاديمِيَّةِ ساندْهِرْسْتْ الْمَلَكِيَّةِ الْعَسْكَرِيَّةِ. 1993م تَرَأَّسَ أَرْكانَ الْقُوّاتِ الْمُسَلَّحَةِ لِدَوْلَةِ الْإِماراتِ. 2004م تَوَلّى سُمُوُّهُ مَنْصِبَ وِلايَةِ الْعَهْدِ في إِمارَةِ أَبوظَبي. 2005م تَمَّ تَعْيينُهُ نائِبًا لِلْقائِدِ الْأَعْلى لِلْقُوّاتِ الْمُسَلَّحَةِ. 2013م اخْتيرَ سُمُوُّهُ ضِمْنَ أَفْضَلِ عَشْرِ شَخْصِيّاتٍ هِيَ الْأَكْثَرُ نُفوذًا في الْعالَمِ الْإِسْلامِيِّ. 2019م اخْتيرَ سُمُوُّهُ ضِمْنَ أَكْثَرِ قادَةِ الْعالَمِ تَأْثيرًا. 2022م تَسَلَّمَ سُمُوُّهُ رِئاسَةَ دَوْلَةِ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 أَيْنَ وَمَتى وُلِدَ؟ مَنْ والِداهُ؟ وَمَتى تَسَلَّمَ رِئاسَةَ الدَّوْلَةِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5