, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْبَيانُ الِاتِّحادِيُّ · الْيَمينُ الدُّسْتورِيُّ · دارُ الِاتِّحادِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L11/girlflag.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "قَراراتُ الِاتِّحادِ: اخْتِيارُ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - رَئيسًا لِلِاتِّحادِ، وَاخْتِيارُ الشَّيْخِ راشِدِ بْنِ سَعيدٍ آلِ مَكْتومٍ - رَحِمَهُ اللهُ - نائِبًا لِلرَّئيسِ، وَاخْتِيارُ شِعارِ الدَّوْلَةِ، وَاخْتِيارُ أَلْوانِ الْعَلَمِ. نَصُّ الْيَمينِ الدُّسْتورِيِّ: كانَ نَصُّ الْيَمينِ الدُّسْتورِيِّ الَّتي أَدّاها صاحِبُ السُّمُوِّ رَئيسُ الدَّوْلَةِ وَنائِبُهُ بَعْدَ انْتِخابِهِما: «أُقْسِمُ بِاللهِ الْعَظيمِ أَنْ أَكونَ مُخْلِصًا لِلْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ، وَأَنْ أَحْتَرِمَ دُسْتورَها وَقَوانينَها، وَأَنْ أَرْعى مَصالِحَ شَعْبِ الِاتِّحادِ، وَأَنْ أُؤَدِّيَ واجِبي بِأَمانَةٍ وَإِخْلاصٍ، وَأُحافِظَ عَلى اسْتِقْلالِ الِاتِّحادِ وَسَلامَةِ أَراضيهِ».", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "مَراسِمُ رَفْعِ أَوَّلِ عَلَمٍ لِلدَّوْلَةِ: قامَ الْمَغْفورُ لَهُ - بِإِذْنِ اللهِ - الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ بَعْدَ انْتِخابِهِ رَئيسًا لِلدَّوْلَةِ بِرَفْعِ عَلَمِ دَوْلَةِ الْإِماراتِ لِأَوَّلِ مَرَّةٍ عَلى سارِيَةِ الْعَلَمِ الْمَوْجودَةِ في قَصْرِ الضِّيافَةِ بِدُبَيَّ دارِ الِاتِّحادِ، حَيْثُ أُطْلِقَتِ الْمَدافِعُ إِحْدى وَعِشْرينَ طَلْقَةً تَحِيَّةً بِهٰذِهِ الْمُناسَبَةِ. بَعْدَ الْإِعْلانِ عَنْ قِيامِ الدَّوْلَةِ، تَوَجَّهَ الْمَغْفورُ لَهُ الشَّيْخُ خَليفَةُ بْنُ زايِدٍ - رَحِمَهُ اللهُ - إِلى ساحَةِ قَصْرِ الْمَنْهَلِ وَأَمَرَ بِرَفْعِ الْعَلَمِ الِاتِّحادِيِّ عَلى سارِيَةِ الْقَصْرِ، وَرَفَعَ سُمُوُّهُ يَدَهُ بِالتَّحِيَّةِ لِعَلَمِ الِاتِّحادِ الَّذي يُرَفْرِفُ عَلى الْبِلادِ لِأَوَّلِ مَرَّةٍ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما قَراراتُ الِاتِّحادِ؟ وَبِماذا أَقْسَمَ رَئيسُ الدَّوْلَةِ وَنائِبُهُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "قَراراتُ الِاتِّحادِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْبَيانُ الِاتِّحادِيُّ · الْيَمينُ الدُّسْتورِيُّ · دارُ الِاتِّحادِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "DC2626