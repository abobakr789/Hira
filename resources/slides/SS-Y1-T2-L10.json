333, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 315, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 369, "w": 358, "h": 261, "rv": 3, "text": "أَشْرَحُ لِماذا أَحَبَّهُ شَعْبُهُ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[ناتج التعلّم ومعايير النجاح] اقرأ الهدف مع الطلاب، ووضّح ماذا يعني كل مستوى."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🔑 مفاتيح الدرس", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 6 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كَلِماتٌ جَديدَةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُؤَسِّسُ · قَصْرُ الْحِصْنِ · 1918م · الْكُنوزُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 352, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 1038, "y": 173, "w": 122, "h": 122, "emo": "🔮", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "الْمُسْتَقْبَلُ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "ما سَيَحْدُثُ بَعْدَ الْحاضِرِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null