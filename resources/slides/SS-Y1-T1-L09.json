 "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَعُدُّ عَلى أَصابِعي الْإِماراتِ السَّبْعَ مَعَ زَميلي.", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ: أُسْرَتي الْكَبيرَةُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْإِماراتُ السَّبْعُ · 2 دِيسَمْبَرَ 1971م · الِاتِّحادُ · الْقادَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g1/SS-Y1-T1-L09/kids.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "تُمَثِّلُ إِماراتُ دَوْلَتِنا الْحَبيبَةِ أُسْرَتَنا الْكَبيرَةَ، وَتَتَكَوَّنُ دَوْلَتُنا الْحَبيبَةُ مِنْ 7 إِماراتٍ هِيَ: (أَبوظَبي - دُبَيُّ - الشّارِقَةُ - رَأْسُ الْخَيْمَةِ - أُمُّ الْقَيْوَيْنِ - عَجْمانُ - الْفُجَيْرَةُ).", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "تَمَّ إِعْلانُ قِيامِ اتِّحادِ دَوْلَةِ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ في 2 مِنْ دِيسَمْبَرَ عامَ 1971م بِقِيادَةِ الْباني الْمُؤَسِّسِ الشَّيْخِ زايِدِ بْنِ سُلْطانَ - رَحِمَهُ