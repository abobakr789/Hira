"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "لِلْأَرْضِ قَمَرٌ واحِدٌ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "نَهارٌ أَمْ لَيْلٌ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 تَعاقُبٌ · النَّهارُ · الشَّمْسُ · الْقَمَرُ · اللَّيْلُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g2/SS-Y2-T1-L02/sun.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g2/SS-Y2-T1-L02/night.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 تَظْهَرُ الشَّمْسُ بِاللَّيْلِ؟ ✗ · أَبي يَعْمَلُ في النَّهارِ؟ ✓ · الْقَمَرُ يَظْهَرُ في اللَّيْلِ؟ ✓", "size": 32, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 18–20: أَتَتَبَّعُ، وَأَضَعُ ✓ أَمامَ الْإِجابَةِ الصَّحيحَةِ، وَأَصِلُ الْعِباراتِ بِالصُّوَرِ.", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[الممارسة الموجّهة: «نطبّق معًا»] اعرض الص