, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَلْواحُ الشَّمْسِيَّةُ · مُتَجَدِّدَةٌ · غَيْرُ مُتَجَدِّدَةٍ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L05/comic.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "تَحَرَّكَتْ مَرْكَبَةُ (الْغولْفِ) في جَوْلَتِها الْيَوْمِيَّةِ إِلى الْمَدينَةِ الذَّكِيَّةِ. وَفَجْأَةً تَوَقَّفَتِ الْمَرْكَبَةُ عَنِ الْحَرَكَةِ، لِنَفادِ شَحْنِ بَطّارِيَّتِها عِنْدَ مَصْنَعِ الطّاقَةِ الشَّمْسِيَّةِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "قَدَّمَ الْمَصْنَعُ أَلْواحًا شَمْسِيَّةً، فَسَعِدَتِ الشَّمْسُ كَثيرًا لِأَنَّها تَسْتَطيعُ مُساعَدَةَ الْعَرَبَةِ مِنْ خِلالِ إِرْسالِ أَشِعَّتِها إِلى الْأَلْواحِ الشَّمْسِيَّةِ الَّتي تُحَوِّلُ الْأَشِعَّةَ إِلى كَهْرَباءَ، فَتُشْحَنُ الْبَطّارِيَّةُ بِسَخاءٍ. شَكَرَتْ مَرْكَبَةُ (الْغولْفِ) مَصْنَعَ الطّاقَةِ الشَّمْسِيَّةِ، وَعادَتْ في قِمَّةِ نَشاطِها، لِتُكْمِلَ رِحْلَتَها إِلى الْمَدينَةِ الذَّكِيَّةِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 كَيْفَ ساعَدَتِ الشَّمْسُ الْمَرْكَبَةَ؟ وَما دَوْرُ الْأَلْواحِ الشَّمْسِيَّةِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": fa