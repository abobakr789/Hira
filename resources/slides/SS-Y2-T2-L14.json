": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 370, "text": "١) نَصُبُّ الْقَهْوَةَ لِلضُّيوفِ مِنَ:  (أ) الْيَمينِ إِلى الْيَسارِ   (ب) الْيَسارِ إِلى الْيَمينِ   (ج) الْوَسَطِ\n٢) الْفَوالَةُ هِيَ:  (أ) سُفْرَةٌ عَلَيْها فَواكِهُ وَأَطْباقٌ   (ب) نَوْعٌ مِنَ الْقَهْوَةِ   (ج) لُعْبَةٌ\n٣) أَكْتُبُ: آخِرُ خُطْوَةٍ في إِكْرامِ الضَّيْفِ ……", "size": 34, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 604, "w": 1203, "h": 51, "text": "تُجْمَعُ البِطاقاتُ لِنَبْدَأَ بِها الدَّرْسَ القادِمَ.", "size": 23, "color": "6B7B7E", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[بطاقة الخروج] يجيب كل طالب وحده في البطاقة، ثم يمسح رمز الاستجابة السريعة في الشريحة التالية."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🪞 مرآة التعلّم", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "ماذا تَعَلَّمْتُ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 صَبُّ الْقَهْوَةِ · الْفَوالَةُ · تَبْخيرٌ · السَّنْعُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 160, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🪞 تَعَلَّمْتُ الْيَوْمَ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 88, "text": "أَنَّ الْعاداتِ الْإِماراتِيَّةَ جُزْءٌ مِنْ هُوِيَّتِنا، وَأَنَّ إِكْرامَ الضَّيْفِ: تَرْحيبٌ، ثُمَّ قَهْوَةٌ وَتَمْرٌ، ثُمَّ صَبُّ الْقَهْوَةِ مِنَ الْيَمينِ حَتّى يَهُزَّ الْفِنْجانَ، ثُمَّ الْفَوالَةُ، ثُمَّ التَّبْخيرُ، ثُمَّ التَّوْديعُ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 335, "w": 1203, "h": 141, "rv": 1, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 343, "w": 1172, "h": 51, "rv": 1, "text": "❓ أَتَساءَلُ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 397, "w": 1172, "h": 69, "rv": 1, "text": "ما الْأَلْعابُ الشَّعْبِيَّةُ الْإِماراتِيَّةُ؟", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 493, "w": 1203, "h": 150, "rv": 2, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 500, "w": 1172, "h": 51, "rv": 2, "text": "🔬 أَرْبِطُ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 554, "w": 1172, "h": 78, "rv": 2, "text": "الْعُلومُ: تُمَثِّلُ طَبْلَةُ الْأُذُنِ جُزْءًا مِنْ جِسْمِنا، نَسْتَخْدِمُهُ لِسَماعِ الْأَصْواتِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[غلق الدرس والتأمل] اطلب من ثلاثة طلاب إكمال الجمل شفويًّا."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🏠 رسالتي إلى البيت", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رِسالَتي إِلى الْبَيْتِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "ra