, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْإِنْتاجُ · الْمَوارِدُ الطَّبيعِيَّةُ · الْأَيْدي الْعامِلَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L04/workers.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "الْإِنْتاجُ: نَشاطٌ يُمارِسُهُ الْإِنْسانُ؛ لِتَوْفيرِ السِّلَعِ وَالْخَدَماتِ الَّتي يَحْتاجُها مُقابِلَ الْحُصولِ عَلى الْمالِ. يَتَكَوَّنُ الْإِنْتاجُ مِنْ عَناصِرَ عِدَّةٍ: الْأَيْدي الْعامِلَةُ، وَالْمَوارِدُ الطَّبيعِيَّةُ، وَالْمالُ. أَهَمِّيَّةُ الْإِنْتاجِ: تَوْفيرُ ما نَحْتاجُهُ مِنَ السِّلَعِ وَالْخَدَماتِ، وَالْحُصولُ عَلى النُّقودِ، وَتَطْويرُ الصِّناعَةِ في الدَّوْلَةِ، وَمَنْحُ الْإِنْسانِ الصِّحَّةَ وَالنَّشاطَ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "أَمْثِلَةٌ عَلى الْإِنْتاجِ: الْمُزارِعُ يَعْمَلُ في الْمَزْرَعَةِ، وَالنَّجّارُ يَعْمَلُ في الْمِنْجَرَةِ، وَالذُّرَةُ تُصْبِحُ عُلَبًا في الْبِقالَةِ، وَالْكُرْسِيُّ يُباعُ في مَحَلِّ الْأَثاثِ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْإِنْتاجُ؟ وَما عَناصِرُهُ الثَّلاثَةُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف الم