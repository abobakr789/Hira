bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "الزِّراعَةُ الْمائِيَّةُ نَوْعٌ جَديدٌ مِنَ الزِّراعَةِ الَّتي تَنْمو في الْماءِ بَدَلًا مِنَ التُّرْبَةِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أُصَنِّفُ مَعَكُمْ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْجَفافُ · النَّباتُ الْحَوْلِيُّ · النَّباتُ الْمُعَمِّرُ · الزِّراعَةُ الْمائِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g1/SS-Y1-T3-L17/ghaf.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g1/SS-Y1-T3-L17/truffle.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 الْغافُ… الْعَرْيونُ… أَيُّهُما مُعَمِّرٌ؟ وَأَيُّهُما حَوْلِيٌّ؟", "size": 32, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 89–90: أَتَتَبَّعُ «أَنا شَجَرَةُ الْغافِ مِنَ النَّباتاتِ الْمُعَمِّرَةِ»، وَأَصِلُ الصّورَةَ بِالْكَلِمَةِ،