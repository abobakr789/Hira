 "rv": 5, "text": "🗣️ أَقولُ: «ادَّخَرَتِ النَّمْلَةُ … لِلشِّتاءِ».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ: النَّمْلَةُ وَالصُّرْصورُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْعَمَلُ · الِادِّخارُ · مَجالاتُ الْعَمَلِ · الْجِدُّ وَالِاجْتِهادُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g1/SS-Y1-T3-L07/ant2.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "في يَوْمٍ مِنَ الْأَيّامِ رَأى صُرْصورٌ نَمْلَةً تَعْمَلُ بِهِمَّةٍ وَنَشاطٍ، فَسَخِرَ مِنْها، وَقالَ لَها: تَعالَيْ كَيْ نُغَنِّيَ وَنَلْعَبَ، فَالطَّعامُ كَثيرٌ. أَجابَتِ النَّمْلَةُ: لا وَقْتَ لَدَيَّ، فَإِنَّني أَدَّخِرُ الطَّعامَ إِلى الشِّتاءِ، فَضَحِكَ الصُّرْصورُ ساخِرًا مِنْها، وَمُتابِعًا غِناءَهُ وَلَهْوَهُ، بَيْنَما تابَعَتِ النَّمْلَةُ جَمْعَها الطَّعامَ بِجِدٍّ وَنَشاطٍ تارِكَةً الصُّرْصورَ خَلْفَها.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "وَعِنْدَما جاءَ الشِّتاءُ الْبارِدُ لَمْ يَسْتَطِعِ الصُّرْصورُ الْخُروجَ لِلْبَحْثِ عَنِ الطَّعامِ، فَذَهَبَ إِلى النَّمْلَةِ، وَطَلَبَ مِنْها طَعامًا. فَقالَتِ النَّمْلَةُ: لَقَدْ كُنْتَ تُغَنّي، وَتَلْهو في أَيّامِ الْعَمَلِ، اذْهَبْ، وَالْعَبِ الْآنَ، وَتَعَلَّمْ أَنْ تَعْمَلَ في وَقْتِ الْعَمَلِ، وَتَلْهوَ في وَقْتِ اللَّعِبِ. خَجِلَ الصُّرْصورُ مِنْ نَفْسِهِ، وَعادَ حَزينًا إِلى دارِهِ، فَلَحِقَتْهُ النَّمْلَةُ، وَأَعْطَتْهُ جُزْءًا مِنْ طَعامِها بَعْدَ أَنْ تَعَلَّمَ الدَّرْسَ مِنْها.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا فَعَلَتِ النَّمْلَةُ؟ وَماذا تَعَلَّمَ الصُّرْصورُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الدَّرْسُ مِنَ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْعَمَلُ · الِادِّخارُ · مَجالاتُ الْعَمَلِ · الْجِدُّ وَالِاجْتِهادُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🐜 النَّمْلَةُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "عَمِلَتْ وَادَّخَرَتْ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 446, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🦗 الصُّرْصورُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 446, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "لَهَا وَلَعِبَ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🤝 النِّهايَةُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "تَعاوُنٌ وَمُشارَكَةٌ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أَسْتَنْتِجُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "أَعْمَلُ في وَقْتِ الْعَمَلِ، وَأَلْعَبُ في وَقْتِ اللَّعِبِ،\nوَأَدَّخِرُ لِوَقْتِ الْحاجَةِ، وَأُساعِدُ غَيْري مِثْلَ النَّمْلَةِ.", "size": 34, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ اقْتِصادِيَّةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "تَتَنَوَّعُ مَجالاتُ الْعَمَلِ مِثْلَ الْمَجالِ التِّجارِيِّ وَالزِّراعِيِّ وَالصِّناعِيِّ، وَغَيْرِها.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "هَيّا نَسْتَكْشِفُ: أَيُّ صورَةٍ تُمَثِّلُ الْعَمَلَ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْعَمَلُ · الِادِّخارُ · مَجالاتُ الْعَمَلِ · الْجِدُّ وَالِاجْتِهادُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g1/SS-Y1-T3-L07/grocer.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g1/SS-Y1-T3-L07/sleep.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "✓ أَمامَ الصّورَةِ الَّتي تُمَثِّلُ الْعَمَلَ… (الْبائِعُ يَعْمَلُ، وَالطِّفْلُ يَ