: "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «الْوادي هُوَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْوادي · الْمِياهُ السَّطْحِيَّةُ · تَحْلِيَةُ الْمِياهِ · السُّدودُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L01/wadi.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "في يَوْمٍ مِنْ أَيّامِ الشِّتاءِ، ذَهَبَتْ أُسْرَةُ حَمْدانَ لِمُشاهَدَةِ جَرَيانِ أَحَدِ الْأَوْدِيَةِ في الْمِنْطَقَةِ الشَّرْقِيَّةِ لِدَوْلَةِ الْإِماراتِ. حَمْدانُ: ما أَجْمَلَ هٰذا الْمَكانَ يا جَدّي! الْجَدُّ: نُطْلِقُ عَلى هٰذا الْمَكانِ اسْمَ الْوادي يا حَمْدانُ. حَمْدانُ: وَما مَعْنى الْوادي يا جَدّي؟ الْجَدُّ: هُوَ مُنْخَفَضٌ طَبيعِيٌّ عَنْ سَطْحِ الْأَرْضِ تَجْري فيهِ الْمِياهُ في مَواسِمِ الْأَمْطارِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "عَفْراءُ: كَيْفَ تَجَمَّعَتْ هٰذِهِ الْمِياهُ يا جَدّي؟ الْجَدُّ: تَتَجَمَّعُ بَعْدَ سُقوطِ الْأَمْطارِ الْغَزيرَةِ. حَمْدانُ: هَلْ هُناكَ أَوْدِيَةٌ أُخْرى غَيْرُ هٰذا الْوادي في بِلادِنا؟ الْأَبُ: في بِلادِنا أَوْدِيَةٌ جَميلَةٌ، مِنْها وادي شَوْكَةَ في إِمارَةِ رَأْسِ الْخَيْمَةِ، وَوادي حَتّا في إِمارَةِ دُبَيَّ وَغَيْرُها. الْأُمُّ: بِلادُنا جَميلَةٌ بِمَناظِرِها الرّائِعَةِ وَخَيْراتِها الْكَثيرَةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْوادي؟ وَمَتى تَتَجَمَّعُ فيهِ الْمِياهُ؟ اذْكُرْ واديَيْنِ في بِلادي.", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مَصادِرُ الْمِياهِ السَّطْحِيَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْوادي · الْمِياهُ السَّطْحِيَّةُ · تَحْلِيَةُ الْمِياهِ · السُّدودُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "0EA5E9", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🌊 مِياهُ الْبَحْرِ", "size": 36, "color": "FFFFFF", "