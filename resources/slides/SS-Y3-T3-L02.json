ize": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "حالَةُ الْجَوِّ مِنْ حَرارَةٍ وَأَمْطارٍ وَرِياحٍ خِلالَ فَتْرَةٍ زَمَنِيَّةٍ طَويلَةٍ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "〰️", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "دَوائِرُ الْعَرْضِ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "دَوائِرُ وَهْمِيَّةٌ مُتَوازِيَةٌ عَدَدُها (180) دائِرَةً، مِنْها (90) شَمالَ خَطِّ الِاسْتِواءِ وَ(90) جَنوبَهُ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «يَسودُ بِلادي الْمُناخُ … لِأَنَّها تَقَعُ في …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُناخُ · دَوائِرُ الْعَرْضِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L02/world.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "تَقَعُ دَوْلَةُ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ ضِمْنَ الْمِنْطَقَةِ الْمَدارِيَّةِ، وَيَسودُها الْمُناخُ الصَّحْراوِيُّ الْحارُّ. الْمُناخُ: هُوَ حالَةُ الْجَوِّ مِنْ حَرارَةٍ وَأَمْطارٍ وَرِياحٍ خِلالَ فَتْرَةٍ زَمَنِيَّةٍ طَويلَةٍ. الْعَوامِلُ الْمُؤَثِّرَةُ في الْمُناخِ: دَوائِرُ الْعَرْضِ، وَتَوْزيعُ الْيابِسِ وَالْماءِ، وَالتَّضاريسُ. دَوائِرُ الْعَرْضِ: هِيَ دَوائِرُ وَهْمِيَّةٌ مُتَوازِيَةٌ عَدَدُها (180) دائِرَةً، مِنْها (90) شَمالَ خَطِّ الِاسْتِواءِ، وَ(90) جَنوبَ خَطِّ الِاسْتِواءِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "أَوَّلًا: الْمَوْقِعُ بِالنِّسْبَةِ لِدَوائِرِ الْعَرْضِ: تَقَعُ دَوْلَةُ الْإِماراتِ في الْمِنْطَقَةِ الْحارَّةِ، وَتَرْتَفِعُ دَرَجَةُ الْحَرارَةِ صَيْفًا بِسَبَبِ سُقوطِ أَشِعَّةِ الشَّمْسِ بِزاوِيَةٍ عَمودِيَّةٍ. ثانِيًا: تَوْزيعُ الْيابِسِ وَالْماءِ: تَعْتَدِلُ دَرَجَةُ الْحَرارَةِ بِالْقُرْبِ مِنَ الْمَناطِقِ السّاحِلِيَّةِ كَإِمارَةِ رَأْسِ الْخَيْمَةِ، وَتَرْتَفِعُ دَرَجَةُ الْحَرارَةِ كُلَّما اتَّجَهْنا إِلى الدّاخِلِ كَمَدينَةِ الْعَيْنِ. ثالِثًا: التَّضاريسُ: كُلَّما ارْتَفَعْنا عَنْ سَطْحِ الْأَرْضِ تَقِلُّ دَرَجَةُ الْحَرارَةِ وَتَزْدادُ الْأَمْطارُ. وَمِنْ ذٰلِكَ أَنَّهُ في شَهْرِ يَنايِرَ 2020م غَطَّتِ الثُّلوجُ قِمَّةَ جَبَلِ جَيْسٍ بِرَأْسِ الْخَيْمَةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْمُناخُ؟ وَما الْعَوامِلُ الثَّلاثَةُ الْمُؤَثِّرَةُ فيهِ؟ وَلِماذا تَساقَطَتِ الثُّلوجُ عَلى جَبَلِ جَيْسٍ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْعَوامِلُ الْمُؤَثِّرَةُ في الْمُناخِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُناخُ · دَوائِرُ الْعَرْضِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🌍 دَوائِرُ الْعَرْضِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "الْمِنْطَقَةُ الْحارَّةُ ← صَيْفٌ حارٌّ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "0EA5E9", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 446, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🌊 الْيابِسُ وَالْماءُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill":