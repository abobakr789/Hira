": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رِحْلَةُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 مَضيقُ هُرْمُزَ · جَزيرَةٌ · شِبْهُ جَزيرَةٍ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T1-L16/map.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "تَخَيَّلْ أَنَّكَ في الطّائِرَةِ، وَتُحَلِّقُ بِاتِّجاهِ السَّهْلِ السّاحِلِيِّ الْغَرْبِيِّ في دَوْلَةِ الْإِماراتِ، هُناكَ تَرى أَسْفَلَ مِنْكَ رَأْسًا في الْيابِسَةِ، يَمْتَدُّ لِيَصِلَ بَيْنَ بَحْرِ عُمانَ وَالْخَليجِ الْعَرَبِيِّ. هٰذا الرَّأْسُ عَلى شَكْلِ مَضيقٍ صَغيرٍ وَيُسَمّى: مَضيقَ هُرْمُزَ، لِيَسْمَحَ لِلْماءِ بِالتَّدَفُّقِ بَيْنَهُما.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "وَأَنْتَ تُطِلُّ مِنْ نافِذَةِ الطّائِرَةِ سَتَرى تِباعًا إِماراتِ الْعِزِّ، وَسَتَرى مُقابِلَها بِقاعَ أَرْضٍ يابِسَةٍ تُزَيِّنُ سَطْحَ الْماءِ الْأَزْرَقِ. إِنَّها الْجُزُرُ الْجَميلَةُ. وَالْجَزيرَةُ: جُزْءٌ مِنَ الْيابِسَةِ، تُحيطُ بِها الْمِياهُ مِنَ الْجِهاتِ جَميعِها. أَمّا شِبْهُ الْجَزيرَةِ فَهِيَ: جُزْءٌ مِنَ الْيابِسَةِ، تُحيطُ بِهِ الْمِياهُ مِنْ ثَلاثِ جِهاتٍ. وَمِنْ جُزُرِ الْإِماراتِ الشَّهيرَةِ: طُنْبُ الْكُبْرى، وَطُنْبُ الصُّغْرى، وَأَبو موسى، وَتَقَعُ جَميعُها في الْخَليجِ الْعَرَبِيِّ، وَهِيَ بِمَثابَةِ مَحَطّاتٍ لِلسُّفُنِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْفَرْقُ بَيْنَ الْجَزيرَةِ وَشِبْهِ الْجَزيرَةِ؟ وَأَيْنَ تَقَعُ جُزُرُ الْإِماراتِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "جَزيرَةٌ أَمْ شِبْهُ جَزيرَةٍ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 مَضيقُ هُرْمُزَ · جَزيرَةٌ · شِبْهُ جَزيرَةٍ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "0EA5E9", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🏝️ جَزيرَةٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "ماءٌ مِنْ 4 جِهاتٍ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 446, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🗺️ شِبْهُ جَزيرَةٍ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x"