{"code": "AR-Y10-IG-T3-L01", "en": false, "slides": [{"bg": "EAF5F4", "els": [{"k": "text", "x": 390, "y": 13, "w": 500, "h": 46, "text": "🎓 ⁦International GCSE⁩ العربية · ⁦4AA1⁩", "size": 22, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 330, "y": 92, "w": 911, "h": 50, "text": "المراجعة النهائية · السنة الثانية", "size": 22, "color": "EA580C", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 330, "y": 150, "w": 911, "h": 130, "text": "الورقة 1 كاملة تحت الوقت", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 330, "y": 286, "w": 911, "h": 44, "text": "مواصفات ⁦Pearson Edexcel 4AA1⁩ · العربية لغةً أولى", "size": 22, "color": "0F6E72", "bold": false, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "pic", "x": 48, "y": 96, "w": 260, "h": 260, "src": "art/girlbook.webp", "rad": true, "shadow": "soft"}, {"k": "shape", "x": 38, "y": 400, "w": 1203, "h": 220, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 60, "y": 412, "w": 1160, "h": 196, "text": "🎯 هدف الحصة: أتدرّب على الورقة 1 كاملة بشروط الامتحان، وأصحّح إجاباتي بمعايير التصحيح، وأبني سجلّ أخطاء وخطّة علاج.", "size": 26, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "المصادر: ورقة الامتحان 1 (يونيو 2025)؛ تقارير الممتحنين (يونيو 2023 و2024)؛ ورش حراء للورقة 1."}, {"bg": "FDF1DC", "els": [{"k": "text", "x": 390, "y": 13, "w": 500, "h": 46, "text": "🗺️ خريطة الورقة", "size": 22, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 3 دقائق", "size": 22, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 70, "text": "الورقة 1: ساعتان وربع · 75 درجة", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 180, "y": 664, "w": 1061, "h": 44, "text": "🎯 القراءة · المقارنة · التلخيص · القواعد", "size": 19, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 954, "y": 150, "w": 287, "h": 170, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5, "rv": 1}, {"k": "text", "x": 954, "y": 154, "w": 287, "h": 76.5, "text": "س1–س8", "size": 26, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "text", "x": 954, "y": 231.6, "w": 287, "h": 81.6, "text": "نصّان: 1 · 2 · 4 · 10\nلكل نص (34)", "size": 20, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "shape", "x": 648, "y": 150, "w": 287, "h": 170, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5, "rv": 1}, {"k": "text", "x": 648, "y": 154, "w": 287, "h": 76.5, "text": "س9", "size": 26, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "text", "x": 648, "y": 231.6, "w": 287, "h": 81.6, "text": "المقارنة بين النصين\n15 درجة", "size": 20, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "shape", "x": 343, "y": 150, "w": 287, "h": 170, "fill": "EA580C", "line": null, "rad": true, "oval": false, "lw": 1.5, "rv": 1}, {"k": "text", "x": 343, "y": 154, "w": 287, "h": 76.5, "text": "س10", "size": 26, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "text", "x": 343, "y": 231.6, "w": 287, "h": 81.6, "text": "التلخيص 100–150 كلمة\n6 درجات", "size": 20, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "shape", "x": 38, "y": 150, "w": 287, "h": 170, "fill": "7C3AED", "line": null, "rad": true, "oval": false, "lw": 1.5, "rv": 1}, {"k": "text", "x": 38, "y": 154, "w": 287, "h": 76.5, "text": "س11–س14", "size": 26, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "text", "x": 38, "y": 231.6, "w": 287, "h": 81.6, "text": "القواعد\n5 × 4 = 20", "size": 20, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "text", "x": 38, "y": 340, "w": 1203, "h": 120, "text": "📌 الأسئلة الكبرى: س9 (15)، وس4 وس8 (10 لكلٍّ منهما): 35 درجة من 75 في ثلاثة أسئلة تحليلية.", "size": 23, "color": "FFFFFF", "bold": true, "align": "right", "fill": "0F6E72", "rad": true, "va": "middle", "rv": 2}, {"k": "text", "x": 38, "y": 474, "w": 1203, "h": 170, "text": "⏱ اقتراح حراء لـ 135 دقيقة: النص الأول نحو 27 · النص الثاني نحو 27 · س9 نحو 25 · س10 نحو 15 · القواعد نحو 30 · مراجعة نحو 11.", "size": 22, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFFFF", "rad": true, "va": "top", "rv": 3}], "n": "من المواصفات وورقة الامتحان. اسأل: أين أكثر الدرجات؟ وأين أكثر الوقت؟"}, {"bg": "F3E9FB", "els": [{"k": "text", "x": 390, "y": 13, "w": 500, "h": 46, "text": "🧩 أنواع الأسئلة", "size": 22, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 22, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 70, "text": "ماذا يُطلب في كل سؤال؟", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 180, "y": 664, "w": 1061, "h": 44, "text": "🎯 القراءة · المقارنة · التلخيص · القواعد", "size": 19, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 1001, "y": 150, "w": 240, "h": 115, "text": "س1، س2، س5، س6", "size": 20, "color": "FFFFFF", "bold": true, "align": "center", "fill": "2563EB", "rad": true, "va": "middle"}, {"k": "text", "x": 641, "y": 150, "w": 350, "h": 115, "text": "فهم مباشر", "size": 19, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFFFF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 150, "w": 593, "h": 115, "text": "💡 في سؤال الدرجتين: الإجابة + عبارة قصيرة بين علامتي تنصيص.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FEF3C7", "rad": true, "va": "middle", "rv": 1}, {"k": "text", "x": 1001, "y": 275, "w": 240, "h": 115, "text": "س4، س8", "size": 20, "color": "FFFFFF", "bold": true, "align": "center", "fill": "16A34A", "rad": true, "va": "middle"}, {"k": "text", "x": 641, "y": 275, "w": 350, "h": 115, "text": "تحليل اللغة والأسلوب (10)", "size": 19, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFFFF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 275, "w": 593, "h": 115, "text": "💡 سمِّ الأسلوب، واذكر الشاهد، واشرح أثره؛ لا تعريفات عامة.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FEF3C7", "rad": true, "va": "middle", "rv": 2}, {"k": "text", "x": 1001, "y": 400, "w": 240, "h": 115, "text": "س9", "size": 20, "color": "FFFFFF", "bold": true, "align": "center", "fill": "EA580C", "rad": true, "va": "middle"}, {"k": "text", "x": 641, "y": 400, "w": 350, "h": 115, "text": "مقارنة (15)", "size": 19, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFFFF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 400, "w": 593, "h": 115, "text": "💡 قارن ولا تلخّص: بينما، في حين، كلا الكاتبين.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FEF3C7", "rad": true, "va": "middle", "rv": 3}, {"k": "text", "x": 1001, "y": 525, "w": 240, "h": 115, "text": "س10–س14", "size": 20, "color": "FFFFFF", "bold": true, "align": "center", "fill": "7C3AED", "rad": true, "va": "middle"}, {"k": "text", "x": 641, "y": 525, "w": 350, "h": 115, "text": "تلخيص وقواعد", "size": 19, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFFFF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 525, "w": 593, "h": 115, "text": "💡 بأسلوبك في التلخيص؛ و«استخرج» تعني انقل كما ورد.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FEF3C7", "rad": true, "va": "middle", "rv": 4}], "n": "اكشف صفًّا صفًّا، واسأل: ما الخطأ المتوقّع في هذا النوع؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 390, "y": 13, "w": 500, "h": 46, "text": "👩‍🏫 شاهدني أخطّط", "size": 22, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 6 دقائق", "size": 22, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 70, "text": "استراتيجية كل قسم", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 180, "y": 664, "w": 1061, "h": 44, "text": "🎯 القراءة · المقارنة · التلخيص · القواعد", "size": 19, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 648, "y": 150, "w": 592, "h": 236, "fill": "FFFDF8", "line": "2563EB", "rad": true, "oval": false, "lw": 2, "rv": 1}, {"k": "text", "x": 660, "y": 156, "w": 568, "h": 44, "text": "الفهم المباشر", "size": 23, "color": "2563EB", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "text", "x": 660, "y": 204, "w": 568, "h": 174, "text": "انتقِ الدليل بدقة: عبارة قصيرة لا فقرة، وأجب عن المطلوب بعينه.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top", "rv": 1}, {"k": "shape", "x": 38, "y": 150, "w": 592, "h": 236, "fill": "FFFDF8", "line": "16A34A", "rad": true, "oval": false, "lw": 2, "rv": 2}, {"k": "text", "x": 50, "y": 156, "w": 568, "h": 44, "text": "التحليل (س4، س8)", "size": 23, "color": "16A34A", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle", "rv": 2}, {"k": "text", "x": 50, "y": 204, "w": 568, "h": 174, "text": "ثلاث فقرات: أسلوب ← شاهد ← أثر في المعنى والقارئ، من النص نفسه.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top", "rv": 2}, {"k": "shape", "x": 648, "y": 400, "w": 592, "h": 236, "fill": "FFFDF8", "line": "EA580C", "rad": true, "oval": false, "lw": 2, "rv": 3}, {"k": "text", "x": 660, "y": 406, "w": 568, "h": 44, "text": "المقارنة (س9)", "size": 23, "color": "EA580C", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle", "rv": 3}, {"k": "text", "x": 660, "y": 454, "w": 568, "h": 174, "text": "خطّط نقاطًا: الغرض، والجمهور، والنبرة، واللغة؛ وشاهد من النصين لكل نقطة.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top", "rv": 3}, {"k": "shape", "x": 38, "y": 400, "w": 592, "h": 236, "fill": "FFFDF8", "line": "7C3AED", "rad": true, "oval": false, "lw": 2, "rv": 4}, {"k": "text", "x": 50, "y": 406, "w": 568, "h": 44, "text": "التلخيص والقواعد", "size": 23, "color": "7C3AED", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle", "rv": 4}, {"k": "text", "x": 50, "y": 454, "w": 568, "h": 174, "text": "4 نقاط رئيسة بكلماتك، بلا أمثلة ولا رأي؛ ثم القواعد: لا تضف كلمات ولا تحذف.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top", "rv": 4}], "n": "نمذج بصوت مسموع: ماذا أفعل في أول دقيقتين من كل قسم؟"}, {"bg": "E9F3E6", "els": [{"k": "text", "x": 390, "y": 13, "w": 500, "h": 46, "text": "⚠️ من تقارير الممتحنين", "size": 22, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 4 دقائق", "size": 22, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 70, "text": "الورقة 1: يونيو 2023 و2024", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 180, "y": 664, "w": 1061, "h": 44, "text": "🎯 القراءة · المقارنة · التلخيص · القواعد", "size": 19, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 648, "y": 150, "w": 592, "h": 440, "fill": "FFFDF8", "line": "16A34A", "rad": true, "oval": false, "lw": 2, "rv": 1}, {"k": "text", "x": 660, "y": 156, "w": 568, "h": 44, "text": "✅ ما فعله الأقوياء", "size": 24, "color": "16A34A", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle", "rv": 1}, {"k": "text", "x": 660, "y": 204, "w": 568, "h": 378, "text": "• انتقت الدليل بدقة ووضعته بين علامتي تنصيص.\n• قارنت في س9 بأدوات مقارنة وشواهد من النصين.\n• حلّلت أثر الأسلوب في هذا النص بعينه.\n• لخّصت الأفكار الرئيسة بأسلوبها.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top", "rv": 1}, {"k": "shape", "x": 38, "y": 150, "w": 592, "h": 440, "fill": "FFFDF8", "line": "C9553A", "rad": true, "oval": false, "lw": 2, "rv": 2}, {"k": "text", "x": 50, "y": 156, "w": 568, "h": 44, "text": "❌ ما أضعف الإجابات", "size": 24, "color": "C9553A", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle", "rv": 2}, {"k": "text", "x": 50, "y": 204, "w": 568, "h": 378, "text": "• لخّصت النصين في س9 بدل المقارنة.\n• خلطت بين الاستعارة والكناية، وبين الطباق والمقابلة.\n• نقلت حرفيًّا في التلخيص: صفر لجودة الكتابة.\n• لم تغيّر الكلمة في س12، وأضافت كلمات في س14.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top", "rv": 2}], "n": "من تقرير الممتحنين الرسمي. اسأل كل طالب: أيّ نقطة تخصّني؟"}, {"bg": "FCE8E4", "els": [{"k": "text", "x": 390, "y": 13, "w": 500, "h": 46, "text": "📏 أصحّح بنفسي", "size": 22, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 4 دقائق", "size": 22, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 70, "text": "كيف تُقدَّر الأسئلة الكبرى؟", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 180, "y": 664, "w": 1061, "h": 44, "text": "🎯 القراءة · المقارنة · التلخيص · القواعد", "size": 19, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 852, "y": 150, "w": 389, "h": 70, "text": "س9 · المقارنة", "size": 21, "color": "FFFFFF", "bold": true, "align": "center", "fill": "2563EB", "rad": true, "va": "middle"}, {"k": "text", "x": 852, "y": 228, "w": 389, "h": 50, "text": "15", "size": 24, "color": "2563EB", "bold": true, "align": "center", "fill": "FFFFFF", "rad": true, "va": "middle", "rv": 1}, {"k": "text", "x": 852, "y": 288, "w": 389, "h": 350, "text": "جدول من خمسة مستويات: عدد المقارنات وجودتها، وشرح أفكار الكاتبين ولغتهما، والشواهد من النصين.", "size": 19, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFFFF", "rad": true, "va": "top", "rv": 2}, {"k": "text", "x": 445, "y": 150, "w": 389, "h": 70, "text": "س4 وس8 · التحليل", "size": 21, "color": "FFFFFF", "bold": true, "align": "center", "fill": "16A34A", "rad": true, "va": "middle"}, {"k": "text", "x": 445, "y": 228, "w": 389, "h": 50, "text": "10", "size": 24, "color": "16A34A", "bold": true, "align": "center", "fill": "FFFFFF", "rad": true, "va": "middle", "rv": 1}, {"k": "text", "x": 445, "y": 288, "w": 389, "h": 350, "text": "جدول من خمسة مستويات: جودة الشرح والتحليل، ودقّة الشاهد ودعمه 