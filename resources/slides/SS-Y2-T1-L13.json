lse, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «تَأَسَّسَتْ دَوْلَةُ الْإِماراتِ عامَ … بِقِيادَةِ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الِاتِّحادُ · الْعُرْقوبُ · يَوْمُ عَهْدِ الِاتِّحادِ · 1971م", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T1-L13/arqoub.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "تَأَسَّسَتْ دَوْلَةُ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ عامَ 1971م بِقِيادَةِ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - حَيْثُ كانَ يَقولُ: (إِنَّ الِاتِّحادَ يَعيشُ في نَفْسي وَفي قَلْبي، وَأَعَزُّ ما في وُجودي، وَلا يُمْكِنُ أَنْ أَتَصَوَّرَ في يَوْمٍ مِنَ الْأَيّامِ أَنْ أَسْمَحَ بِالتَّفْريطِ بِهِ أَوِ التَّهاوُنِ نَحْوَ مُسْتَقْبَلِهِ).", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "عُرْقوبُ السَّديرَةِ يَقَعُ بَيْنَ أَبوظَبي وَدُبَيَّ، اجْتَمَعَ فيهِ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ وَالشَّيْخُ راشِدُ بْنُ سَعيدٍ آلِ مَكْتومٍ - رَحِمَهُما اللهُ. ثُمَّ كانَ اجْتِماعُ دُبَيَّ الْأَوَّلُ، ثُمَّ اجْتِماعُ دُبَيَّ الثّاني يَوْمَ عَهْدِ الِاتِّحادِ، ثُمَّ إِعْلانُ الِاتِّحادِ عامَ 1971م. وَانْتُخِبَ الشَّيْخُ زايِدٌ رَئيسًا لِلدَّوْلَةِ، وَالشَّيْخُ راشِدٌ نائِبًا لِرَئيسِ الدَّوْلَةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 أَيْنَ يَقَعُ عُرْقوبُ السَّديرَةِ؟ وَمَنِ اجْتَمَعَ فيهِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مَراحِلُ قِيامِ الِاتِّحادِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الِاتِّحادُ · الْعُرْقوبُ · يَوْمُ عَهْدِ الِاتِّحادِ · 1971م", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "1", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "اجْتِماعُ عُرْقوبِ السَّديرَةِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "2", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 650, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "اجْتِماعُ دُبَيَّ الْأَوَّلُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "7C3AED", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 344, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "3", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 344, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "اجْتِماعُ دُبَيَّ الثّاني", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "4", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "إِعْلانُ الِاتِّحادِ 1971م", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُرَتِّبُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "أَوَّلًا الْتَقى الشَّيْخانِ زايِدٌ وَراشِدٌ في عُرْقوبِ السَّديرَةِ، ثُمَّ اجْتَمَعَ الْحُكّامُ في دُبَيَّ مَرَّتَيْنِ،\nوَفي الثّانِيَةِ يَوْمُ عَهْدِ الِاتِّحادِ (18 يولْيو)، ثُمَّ أُعْلِنَ الِاتِّحادُ عامَ 1971م.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ تاريخِيَّةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "يَوْمُ عَهْدِ الِاتِّحادِ: أَعْلَنَ فيهِ الْباني الْمُؤَسِّسُ وَإِخْوانُهُ الْحُكّامُ قِيامَ الِاتِّحادِ وَدُسْتورَ الدَّوْلَةِ في 18 يولْيو 1971م.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الِاتِّحادُ في صُوَرٍ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الِاتِّحادُ · الْعُرْقوبُ · يَوْمُ عَهْدِ الِاتِّحادِ · 1971م", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g2/SS-Y2-T1-L13/arqoub.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g2/SS-Y2-T1-L13/founders.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 ما هٰذا التَّلُّ؟ (عُرْقوبُ السَّديرَةِ) وَماذا تَعْني صورَةُ الْحُكّامِ وَالْعَلَمِ؟ (إِعْلانُ الِاتِّحادِ)", "size": 27, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 70–71: أُرَتِّبُ أَحْداثَ قِيامِ الِاتِّحادِ، وَأَصِلُ الصُّوَرَ بِالْعِباراتِ، وَأُلَوِّنُ خَريطَةَ بِلادي.", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[الممارسة الموجّهة: «نطبّق معًا»] اعرض الصورتين، وعُدّوا معًا. ثم نفّذوا نشاط الكتاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚦 إشارة الانطلاق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَيْنَ الْتَقى الشَّيْخُ زايِدٌ وَالشَّيْخُ راشِدٌ أَوَّلَ مَرَّةٍ لِلِاتِّحادِ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الِاتِّحادُ · الْعُرْقوبُ · يَوْمُ عَهْدِ الِاتِّحادِ · 1971م", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 701, "y": 160, "w": 490, "h": 294, "src": "resources/ss/g2/SS-Y2-T1-L13/arqoub.webp", "rad": true}, {"k": "text", "x": 650, "y": 454, "w": 592, "h": 58, "text": "(أ)", "size": 36, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "pic", "x": 90, "y": 160, "w": 490, "h": 294, "src": "resources/ss/g2/SS-Y2-T1-L13/sign.webp", "rad": true}, {"k": "text", "x": 38, "y": 454, "w": 592, "h": 58, "text": "(ب)", "size": 36, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 521, "w": 1203, "h": 61, "rv": 1, "text": "✅ (أ) في عُرْقوبِ السَّديرَةِ بَيْنَ أَبوظَبي وَدُبَيَّ.", "size": 28, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 589, "w": 1203, "h": 58, "rv": 2, "text": "🟥 أَحْتاجُ مُساعَدَةً     🟨 أَحْتاجُ قَليلًا     🟩 جاهِزٌ", "size": 27, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[تحقّق قبل العمل المستقل] يرفع كل طالب بطاقة (أ) أو (ب). من يخطئ ينضمّ إلى مجموعة دعم قصيرة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚀 تحدّي المستويات", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 10 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كُلٌّ في مُسْتَواهُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الِاتِّحادُ · الْعُرْقوبُ · يَوْمُ عَهْدِ الِاتِّحادِ · 1971م", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 326, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 869, "y": 168, "w": 358, "h": 51, "rv": 1, "text": "⭐ مُبْتَدِئٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 869, "y": 221, "w": 358, "h": 255, "rv": 1, "text": "أُرَتِّبُ صُوَرَ الْمَراحِلِ (1–4).\nأَتَتَبَّعُ: الِاتِّحادُ 1971م.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 326, "rv": 2, "fill": "FFFDF8", "line": "5F6C78", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 461, "y": 168, "w": 358, "h": 51, "rv": 2, "text": "⭐⭐ مُتَطَوِّرٌ", "size": 27, "color": "5F6C78", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 461, "y": 221, "w": 358, "h": 255, "rv": 2, "text": "أُكْمِلُ: انْتُخِبَ … رَئيسًا وَ … نائِبًا.\nأُعَرِّفُ الْعُرْقوبَ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 326, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 358, "h": 255, "rv": 3, "text": "أُفَسِّرُ قَوْلَ الشَّيْخِ زايِدٍ.\nأَكْتُبُ لِماذا يَوْمُ عَهْدِ الِاتِّحادِ مُهِمٌّ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 502, "w": 1203, "h": 141, "rv": 4, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 509, "w": 1172, "h": 51, "rv": 4, "text": "🏆 تَحَدٍّ", "size": 27, "color": "A35E24", "bold": true,