"center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 السُّدَيْرَةُ · الِاتِّحادُ · الِاتِّحادُ التُّساعِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L10/zayedrashid.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "في أَحَدِ أَيّامِ الشِّتاءِ، كانَتْ عائِلَةُ ماجِدٍ مُجْتَمِعَةً في بَيْتِ الْجَدِّ، سَأَلَ ماجِدٌ عَنْ سِرِّ حُبِّهِ لِلصّورَةِ الْمُعَلَّقَةِ في الْمَنْزِلِ، وَالَّتي جَمَعَتْ بَيْنَ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ وَالشَّيْخِ راشِدِ بْنِ سَعيدٍ آلِ مَكْتومٍ - رَحِمَهُما اللهُ - فَرِحَ الْجَدُّ بِسُؤالِ ماجِدٍ وَأَجابَهُ: (هٰذِهِ الصّورَةُ تَحْمِلُ ذِكْرى عَزيزَةً عَلى قَلْبِ كُلِّ إِماراتِيٍّ؛ في 18 فِبْرايِرَ 1968م اجْتَمَعَ الشَّيْخُ زايِدٌ وَالشَّيْخُ راشِدٌ - رَحِمَهُما اللهُ - في مِنْطَقَةِ عَرْقوبِ السُّدَيْرَةِ؛ لِتَوْقيعِ وَثيقَةٍ تَنُصُّ عَلى اتِّحادٍ بَيْنَ إِمارَتَيْهِما (أَبوظَبي وَدُبَيَّ)، عُرِفَتْ هٰذِهِ الْوَثيقَةُ بِاسْمِ اتِّفاقِ الْوَحْدَةِ، وَكانَتِ الْخُطْوَةَ الْأولى نَحْوَ تَحْقيقِ الِاتِّحادِ).", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "خُطُواتُ قِيامِ الِاتِّحادِ: 1. اجْتِماعُ عَرْقوبِ السُّدَيْرَةِ 18 فِبْرايِرَ 1968م. 2. اجْتِماعُ دُبَيَّ الْأَوَّلِ: عَقَدَ حُكّامُ الْإِماراتِ السَّبْعِ مَعَ حاكِمَيْ قَطَرَ وَالْبَحْرَيْنِ في 25 فِبْرايِرَ 1968م اجْتِماعًا، أَعْلَنوا فيهِ اتِّحادًا تُساعِيًّا، وَلٰكِنْ لَمْ يَتَحَقَّقْ هٰذا الِاتِّحادُ. 3. اجْتِماعُ دُبَيَّ الثّاني يَوْمُ عَهْدِ الِاتِّحادِ: عَقَدَ حُكّامُ الْإِماراتِ السِّتِّ في 18 يوليو 1971م اجْتِماعًا، وَقَرَّروا إِقامَةَ دَوْلَةٍ اتِّحادِيَّةٍ وَتَمَّ فيهِ التَّوْقيعُ عَلى الدُّسْتورِ الْمُؤَقَّتِ. 4. إِعْلانُ الِاتِّحادِ: تَمَّ في 2 دِيسَمْبَرَ 1971م الْإِعْلانُ الرَّسْمِيُّ عَنْ قِيامِ اتِّحادِ دَوْلَةِ الْإِماراتِ في إِمارَةِ دُبَيَّ - قَصْرِ الضِّيافَةِ - (مُتْحَفُ الِاتِّحادِ حالِيًّا).", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْخُطْوَةُ الْأولى نَحْوَ الِاتِّحادِ؟ وَلِماذا لَمْ يَتَحَقَّقِ الِاتِّحادُ التُّساعِيُّ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "خُطُواتُ قِيامِ الِاتِّحادِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 السُّدَيْرَةُ · الِاتِّحادُ · الِاتِّحادُ التُّساعِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "tex