"text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الشَّبَكَةُ · الْقُرْقورُ · الثَّرْوَةُ السَّمَكِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L09/grandpa.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "حَمْدانُ: ماذا تَفْعَلُ يا جَدّي؟ الْجَدُّ: أُجَهِّزُ أَدَواتِ صَيْدِ السَّمَكِ يا حَمْدانُ. حَمْدانُ: ما هِيَ الْأَدَواتُ الَّتي تَسْتَخْدِمُها لِصَيْدِ الْأَسْماكِ يا جَدّي؟ الْجَدُّ: مِنْ أَدَواتِ الصَّيْدِ: السِّنّارَةُ وَالشَّبَكَةُ، وَهِيَ: (مَجْموعَةٌ مِنَ الْخُيوطِ الْمَنْسوجَةِ عَلى شَكْلِ شَبَكَةٍ)، وَالْقُرْقورُ: (قَفَصٌ مِنَ الْأَسْلاكِ الْمَعْدِنِيَّةِ عَلى شَكْلِ نِصْفِ كُرَةٍ، وَلَهُ فَتْحَةٌ مِنَ الْوَسَطِ).", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "حَمْدانُ: سَأَذْهَبُ مَعَكَ يا جَدّي في رِحْلَةِ الصَّيْدِ. الْجَدُّ: ماذا تُحِبُّ أَنْ تَصيدَ مِنَ السَّمَكِ يا حَمْدانُ؟ حَمْدانُ: أُحِبُّ سَمَكَ الْهامورِ وَالصّافي يا جَدّي. تُطِلُّ دَوْلَةُ الْإِماراتِ عَلى الْخَليجِ الْعَرَبِيِّ وَبَحْرِ عُمانَ، وَهِيَ مَناطِقُ غَنِيَّةٌ بِالثَّرْوَةِ السَّمَكِيَّةِ، مِثْلَ: الْهامورِ وَالْكَنْعَدِ وَالشَّعْرِيِّ وَالصّافي.", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما أَدَواتُ الصَّيْدِ؟ وَما الْأَسْماكُ الَّتي يُحِبُّها حَمْدانُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "خِدْماتُ الدَّوْلَةِ لِلصَّيّادينَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الشَّبَكَةُ · الْقُرْقورُ · الثَّرْوَةُ السَّمَكِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "1", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "تَوْفيرُ أَدَواتِ الصَّيْدِ الْحَديثَةِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 446, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "2", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 446, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "تَقْديمُ الْمُساعَداتِ الْمالِيَّةِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "3", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "إِقامَةُ الْأَسْواقِ الْمُتَخَصِّصَةِ لِبَيْعِ الْأَسْماكِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُفَسِّرُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "لِماذا تَمْنَعُ الدَّوْلَةُ الصَّيْدَ في بَعْضِ الْأَوْقاتِ؟\nلِأَنَّهُ وَقْتُ تَكاثُرِ الْأَسْماكِ… فَإِذا تَرَكْناها تَتَكاثَرُ، بَقِيَتِ الثَّرْوَةُ السَّمَكِيَّةُ لَنا وَلِأَبْنائِنا.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 مِنْ سَنْعِ بِلادي أَتَعَلَّمُ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "الِامْتِثالُ لِتَوْجيهاتِ الْحُكومَةِ في أَوْقاتِ مَنْعِ الصَّيْدِ (وَقْتِ تَكاثُرِ الْأَسْماكِ).", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَسْماكُ بِلادي", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الشَّبَكَةُ · الْقُرْقورُ · الثَّرْوَةُ السَّمَكِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g2/SS-Y2-T2-L09/hamour.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g2/SS-Y2-T2-L09/safi.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 الْهامورُ… الصّافي… نَتَعَرَّفُ شَكْلَ كُلِّ سَمَكَةٍ وَنَكْتُبُ اسْمَها.", "size": 32, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 48–51: أُكْمِلُ الْجُمَلَ، وَأُلْصِقُ صُوَرًا لِلْمُنْتَجاتِ، وَأُنَفِّذُ «مَشْروعي الصَّغيرَ» عَنْ ثَرَواتِ بِلادي.", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[الممارسة الموجّهة: «نطبّق معًا»] اعرض الصورتين، وعُدّوا معًا. ثم نفّذوا نشاط الكتاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚦 إشارة الانطلاق", "size": 23, "color": "FFFFFF", "bold": true, 