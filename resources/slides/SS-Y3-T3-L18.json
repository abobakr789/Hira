 مَجْلِسِ الْوُزَراءِ: مُراقَبَةُ سَيْرِ الْإِداراتِ وَالْمَصالِحِ الْعامَّةِ الِاتِّحادِيَّةِ. مُتابَعَةُ تَنْفيذِ السِّياسَةِ الْعامَّةِ لِحُكومَةِ الِاتِّحادِ. الْإِشْرافُ عَلى تَنْفيذِ الْقَوانينِ وَالْقَراراتِ الِاتِّحادِيَّةِ. إِعْدادُ مَشْروعِ الْميزانِيَّةِ السَّنَوِيَّةِ الْعامَّةِ لِلِاتِّحادِ. ابْتِكارٌ: الْخَلَواتُ الْوِزارِيَّةُ هِيَ جَلَساتٌ اسْتِثْنائِيَّةٌ لِمَجْلِسِ الْوُزَراءِ يَتِمُّ فيها اسْتِعْراضُ أَهَمِّ الْقَضايا الْوَطَنِيَّةِ، وَمُناقَشَتُها في أَجْواءٍ أَكْثَرَ تَحَرُّرًا مِنْ قُيودِ الْعَمَلِ الْمَكْتَبِيِّ. وَمِنْ سَنْعِ بِلادي: أَنْ يَدْخُلَ الضَّيْفُ كَبيرُ السِّنِّ أَوَّلًا، ثُمَّ بَقِيَّةُ الزُّوّارِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما مَجْلِسُ الْوُزَراءِ؟ مِمَّ يَتَكَوَّنُ؟ وَما اخْتِصاصاتُهُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْمَجْلِسانِ: مُقارَنَةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 مَجْلِسُ الْوُزَراءِ الِاتِّحادِيُّ · وَزيرٌ · هَيْئَةٌ تَنْفيذِيَّةٌ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160,