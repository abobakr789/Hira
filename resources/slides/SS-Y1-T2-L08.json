ْدَأَ بِها الدَّرْسَ القادِمَ.", "size": 23, "color": "6B7B7E", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[بطاقة الخروج] يجيب كل طالب وحده في البطاقة، ثم يمسح رمز الاستجابة السريعة في الشريحة التالية."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🪞 مرآة التعلّم", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "ماذا تَعَلَّمْتُ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التّاجِرُ · الْآثارُ · دُوَلُ الْعالَمِ · رائِدُ الْفَضاءِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 160, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🪞 تَعَلَّمْتُ الْيَوْمَ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 88, "text": "أَنَّ النّاسَ في دُوَلِ الْعالَمِ يَعْمَلونَ في مِهَنٍ مُخْتَلِفَةٍ: الزِّراعَةِ وَالتِّجارَةِ وَالْآثارِ وَالصِّناعَةِ، وَأَنَّ التّاجِرَ يَبيعُ وَيَشْتَري.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 335, "w": 1203, "h": 141, "rv": 1, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 343, "w": 1172, "h": 51, "rv": 1, "text": "❓ أَتَساءَلُ", "size": 27, "color": "6B46A8", "bold": true, "ali