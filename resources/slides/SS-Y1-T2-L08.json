"fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَصْدِقائي مِنْ دُوَلِ الْعالَمِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التّاجِرُ · الْآثارُ · دُوَلُ الْعالَمِ · رائِدُ الْفَضاءِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 883, "y": 160, "w": 358, "h": 333, "src": "resources/ss/g1/SS-Y1-T2-L08/khadija.webp", "rad": true}, {"k": "text", "x": 38, "y": 160, "w": 819, "h": 96, "text": "🌍 «أُعَرِّفُكُمْ بِأَصْدِقائي مِنْ دُوَلِ الْعالَمِ»", "size": 32, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 262, "w": 819, "h": 122, "rv": 1, "text": "في أَيِّ دَوْلَةٍ يَعيشُ كُلُّ صَديقٍ؟ وَماذا يَعْمَلُ والِداهُ؟", "size": 32, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 397, "w": 819, "h": 96, "rv": 2, "text": "💬 أُفَكِّرُ وَحْدي ← أُخْبِرُ زَميلي ← نُشارِكُ الصَّفَّ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 518, "w": 1203, "h": 122, "rv": 3, "text": "مِهَنٌ مِنَ الْعالَمِ", "size": 36, "color": "B42318", "bold": true, "align": "center", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[التهيئة وإثارة الدافعية] فكّر – زاوج – شارك. لا تكشف الإجابة قبل أن يخمّن الطلاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🎯 وجهتنا اليوم", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "وِجْهَتُنا الْيَوْمَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التّاجِرُ · الْآثارُ · دُوَلُ الْعالَمِ · رائِدُ الْفَضاءِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 160, "w": 1203, "h": 128, "text": "🎯 أَتَعَرَّفُ مِهَنًا مِنْ دُوَلِ الْعالَمِ، وَأَعْرِفُ مَعْنى التّاجِرِ وَالْآثارِ، وَأُقارِنُ بَيْنَ الْمِهَنِ في بِلادي وَدُوَلٍ أُخْرى.", "size": 32, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 307, "w": 388, "h": 333, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 869, "y": 315, "w": 358, "h": 51, "rv": 1, "text": "⭐ مُبْتَدِئٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 869, "y": 369, "w": 358, "h": 261, "rv": 1, "text": "أَذْكُرُ مِهْنَةً مِنْ دَوْلَةٍ أُخْرى.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 446, "y": 307, "w": 388, "h": 333, "rv": 2, "fill": "FFFDF8", "line": "5F6C78", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 461, "y": 315, "w": 358, "h": 51, "rv": 2, "text": "⭐⭐ مُتَطَوِّرٌ", "size": 27, "color": "5F6C78", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 461, "y": 369, "w": 358, "h": 261, "rv": 2, "text": "أُكْمِلُ الْجُمَلَ بِالْكَلِماتِ الْمُناسِبَةِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 307, "w": 388, "h": 333, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": fa