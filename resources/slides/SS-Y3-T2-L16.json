"x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L16/tree.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "التُّراثُ: هُوَ كُلُّ ما تَرَكَهُ الْأَجْدادُ لَنا مِنْ عاداتٍ وَتَقاليدَ وَقِيَمٍ وَأَماكِنَ قَديمَةٍ، وَهُوَ يُمَثِّلُ جُزْءًا مُهِمًّا مِنْ تاريخِ وَثَقافَةِ الشُّعوبِ. وَيَبْقى تُراثُنا الْإِماراتِيُّ رافِدًا مُسْتَمِرًّا في تَعْزيزِ هُوِيَّتِنا الْوَطَنِيَّةِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "هَيّا تَعالَ نَتَعَرَّفْ بَعْضَ الْأَنْشِطَةِ التُّراثِيَّةِ الَّتي نُشاهِدُها حَيَّةً مُتَدَفِّقَةً أَمامَنا: سِباقُ الْهُجُنِ، صَيْدُ الصُّقورِ، صِناعَةُ السُّفُنِ، الْيوَلَةُ، وَالْفُروسِيَّةُ: وَتَعْني رِياضَةً قائِمَةً عَلى فَنِّ رُكوبِ الْفَرَسِ وَالتَّمَكُّنِ مِنِ اجْتِيازِ الْحَواجِزِ. قالَ الْباني الْمُؤَسِّسُ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ -: «مَنْ لَيْسَ لَهُ ماضٍ فَلَيْسَ لَهُ حاضِرٌ وَلا مُسْتَقْبَلٌ».", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما التُّراثُ؟ اذْكُرْ ثَلاثَةَ أَنْشِطَةٍ تُراثِيَّةٍ. وَماذا يَعْني قَوْلُ الشَّيْخِ زايِدٍ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 2