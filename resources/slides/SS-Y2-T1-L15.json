هُ، وَنَحْنُ نُطيعُ وَنَتَعاوَنُ.", "size": 34, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ تاريخِيَّةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "الْآباءُ الْمُؤَسِّسونَ هُمُ الْحُكّامُ الَّذينَ أَعْلَنوا قِيامَ الِاتِّحادِ، وَهُمْ روحُ الِاتِّحادِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَقْرَأُ مَقولَةَ الشَّيْخِ خَليفَةَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 رَئيسُ الدَّوْلَةِ · التَّرابُطُ · روحُ الِاتِّحادِ · الْآباءُ الْمُؤَسِّسونَ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g2/SS-Y2-T1-L13/founders.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g2/SS-Y2-T1-L09/map.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 قالَ الشَّيْخُ خَليفَةُ - رَحِمَهُ اللهُ - عَنِ الْآباءِ الْمُؤَسِّسينَ: «إِنَّهُمْ روحُ الِاتِّحادِ». مَنْ هُمْ؟", "size": 27, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 80–83: أُجيبُ عَنِ الْأَسْئِلَةِ، وَأَصِلُ الْحاكِمَ بِإِمارَتِهِ، وَأَكْتُبُ أَسْماءَ الْإِماراتِ عَلى الْخَريطَةِ.", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[الممارسة الموجّهة: «نطبّق معًا»] اعرض الصورتين، وعُدّوا معًا. ثم نفّذوا نشاط الكتاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚦 إشارة الانطلاق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مَنْ رَئيسُ دَوْلَةِ الْإِماراتِ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 رَئيسُ الدَّوْلَةِ · التَّرابُطُ · روحُ الِاتِّحادِ · الْآباءُ الْمُؤَسِّسونَ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 701, "y": 160, "w": 490, "h": 294, "src": "resources/ss/g2/SS-Y2-T1-L15/rulers.webp", "rad": true}, {"k": "text", "x": 650, "y": 454, "w": 592, "h": 58, "text": "(أ)", "size": 36, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "pic", "x": 90, "y": 160, "w": 490, "h": 294, "src": "resources/ss/g2/SS-Y2-T1-L15/hall.webp", "rad": true}, {"k": "text", "x": 38, "y": 454, "w": 592, "h": 58, "text": "(ب)", "size": 36, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 521, "w": 1203, "h": 61, "rv": 1, "text": "✅ صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ زايِدٍ آلِ نَهْيانَ - حَفِظَهُ اللهُ - حاكِمُ أَبوظَبي.", "size": 28, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 589, "w": 1203, "h": 58, "rv": 2, "text": "🟥 أَحْتاجُ مُساعَدَةً     🟨 أَحْتاجُ قَليلًا     🟩 جاهِزٌ", "size": 27, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[تحقّق قبل العمل المستقل] يرفع كل طالب بطاقة (أ) أو (ب). من يخطئ ينضمّ إلى مجموعة دعم قصيرة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚀 تحدّي المستويات", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 10 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كُلٌّ في مُسْتَواهُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 رَئيسُ الدَّوْلَةِ · التَّرابُطُ · روحُ الِاتِّحادِ · الْآباءُ الْمُؤَسِّسونَ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 326, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 869, "y": 168, "w": 358, "h": 51, "rv": 1, "text": "⭐ مُبْتَدِئٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 869, "y": 221, "w": 358, "h": 255, "rv": 1,