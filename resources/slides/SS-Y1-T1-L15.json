 5, "text": "🗣️ أَقولُ: «أَنا أَحْمِلُ الْهُوِيَّةَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ: ما بِطاقَةُ الْهُوِيَّةِ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 بِطاقَةُ الْهُوِيَّةِ · بَياناتي · الْهَيْئَةُ الِاتِّحادِيَّةُ لِلْهُوِيَّةِ · شِعارُ الدَّوْلَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g1/SS-Y1-T1-L15/idcard.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "راشِدٌ: ما اسْمُ هٰذِهِ الْبِطاقَةِ يا جَدّي؟ الْجَدُّ: تُسَمّى بِطاقَةَ الْهُوِيَّةِ. راشِدٌ: ما أَهَمِّيَّتُها؟ الْجَدُّ: مِنَ الْمُسْتَنَداتِ الَّتي تَدُلُّ عَلى هُوِيَّةِ الْفَرْدِ وَجِنْسِيَّتِهِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "راشِدٌ: ما اسْمُ الْجِهَةِ الَّتي تُصْدِرُها يا جَدّي؟ الْجَدُّ: تَصْدُرُ عَنِ الْهَيْئَةِ الِاتِّحادِيَّةِ لِلْهُوِيَّةِ وَالْجِنْسِيَّةِ وَتَتَضَمَّنُ بِطاقَةُ الْهُوِيَّةِ بَياناتٍ خاصَّةً بِحامِلِها. راشِدٌ: أَنا أَحْمِلُ الْهُوِيَّةَ الْإِماراتِيَّةَ. الْجَدُّ: نَع