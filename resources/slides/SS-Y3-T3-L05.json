واعِ التِّكْنولوجْيا …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْهَواتِفُ الذَّكِيَّةُ · الْإِنْتَرْنِتْ · الذَّكاءُ الِاصْطِناعِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L05/types.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "تولي دَوْلَةُ الْإِماراتِ اهْتِمامًا كَبيرًا بِمُواكَبَةِ التَّقَدُّمِ التِّكْنولوجِيِّ بِاعْتِبارِهِ الْقاطِرَةَ الَّتي تَقودُ اقْتِصادَها نَحْوَ الْمُسْتَقْبَلِ. أَنْواعُ التِّكْنولوجْيا: الْهَواتِفُ الذَّكِيَّةُ، وَالْإِنْتَرْنِتْ، وَالْحَواسيبُ، وَالسَّيّاراتُ، وَالْأَجْهِزَةُ الطِّبِّيَّةُ. الْهَواتِفُ الذَّكِيَّةُ: هِيَ الْهَواتِفُ الْمَحْمولَةُ الْحَديثَةُ الَّتي تَسْتَخْدِمُ نِظامَ تَشْغيلٍ مُتَطَوِّرٍ، وَمُعْظَمُها يَتَمَتَّعُ بِخاصِّيَّةِ اللَّمْسِ عَلى الشّاشَةِ. الْإِنْتَرْنِتْ: شَبَكَةُ اتِّصالاتٍ عالَمِيَّةٌ تَسْمَحُ بِتَبادُلِ الْمَعْلوماتِ بِاسْتِخْدامِ الْحَواسيبِ وَغَيْرِها مِنَ الْأَجْهِزَةِ حَوْلَ الْعالَمِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "التِّكْنولوجْيا في إِمارَةِ دُبَيَّ: 1. الْإِنْتَرْنِتْ: طَمَحَتْ إِمارَةُ دُبَيَّ إِلى تَغْطِيَةِ الْمَدينَةِ كامِلَةً بِالْإِنْتَرْنِتْ الْمَجّانِيِّ؛ لِتَتَحَوَّلَ إِلى مَدينَةٍ ذَكِيَّةٍ. 2. وَسائِلُ النَّقْلِ: تَوْفيرُ مَحَطّاتِ نَقْلٍ عامَّةٍ ذاتِ خِدْماتٍ كامِلَةٍ مُكَيَّفَةٍ وَبِها مَقاعِدُ جُلوسٍ، وَتَتَوَفَّرُ فيها شَبَكَةٌ (إِنْتَرْنِتْ) لاسِلْكِيَّةٌ مَجّانِيَّةٌ، وَمِنْطَقَةٌ لِشَحْنِ الْهَواتِفِ. 3. شُرْطَةُ دُبَيَّ: تَمَّ تَشْغيلُ أَوَّلِ شُرْطِيٍّ آلِيٍّ، يَجوبُ الْأَماكِنَ الْعامَّةَ لِمُساعَدَةِ الْجُمْهورِ. 4. مِصْباحُ دُبَيَّ: يُوَفِّرُ مِصْباحُ دُبَيَّ (90%) مِنَ الطّاقَةِ مُقارَنَةً بِالْمَصابيحِ الْعادِيَّةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما أَنْواعُ التِّكْنولوجْيا؟ وَما الْأَمْثِلَةُ عَلى التِّكْنولوجْيا في دُبَيَّ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "التِّكْنولوجْيا في دُبَيَّ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْهَواتِفُ الذَّكِيَّةُ · الْإِنْتَرْنِتْ · الذَّكاءُ الِاصْطِناعِيُّ", "size": 21, "color": "0F6E72", "bold": true, "al