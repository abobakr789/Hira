90, "w": 266, "h": 109, "rv": 1, "text": "مَكانٌ مُخَصَّصٌ لِحَرَكَةِ السَّيّاراتِ وَالْمَرْكَباتِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "🏠", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "الْمَساكِنُ الْحَديثَةُ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "بُيوتٌ فيها الْكَهْرَباءُ وَالْماءُ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 352, "rv": 3, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 426, "y": 173, "w": 122, "h": 122, "emo": "📅", "rv": 3}, {"k": "text", "x": 354, "y": 307, "w": 266, "h": 77, "rv": 3, "text": "1966م", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 354, "y": 390, "w": 266, "h": 109, "rv": 3, "text": "سَنَةُ تَوَلّي زايِدٍ حُكْمَ أَبوظَبي", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «في عَهْدِ زايِدٍ أُنْشِئَتْ في أَبوظَبي …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الطُّرُقُ · الْمَساكِنُ الْحَديثَةُ · 1966م", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L11/family.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "ميثاءُ: حَدَّثَتْنا الْمُعَلِّمَةُ الْيَوْمَ عَنِ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - وَحُكْمِهِ إِمارَةَ أَبوظَبي. الْأُمُّ: نَعَمْ يا ابْنَتي، فَفي عامِ 1966م انْتَقَلَ الشَّيْخُ زايِدٌ مِنْ حُكْمِهِ لِمِنْطَقَةِ الْعَيْنِ إِلى حُكْمِ إِمارَةِ أَبوظَبي. الْجَدَّةُ: نَعَمْ، وَقَدْ سَعى مُنْذُ بِدايَةِ حُكْمِهِ إِلى خِدْمَةِ النّاسِ، وَوَضَعَ أَساسَ الْوَحْدَةِ وَالْأَمْنِ وَالِاسْتِقْرارِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "الْجَدَّةُ: الشَّيْخُ زايِدٌ عَمِلَ عَلى نُمُوِّ وَتَقَدُّمِ إِمارَةِ أَبوظَبي، فَاهْتَمَّ بِإِنْشاءِ الْمَدارِسِ الْحَديثَةِ، وَالْمُسْتَشْفَياتِ، وَالطُّرُقِ وَهِيَ مَكانٌ مُخَصَّصٌ لِحَرَكَةِ السَّيّاراتِ وَالشّاحِناتِ تَنْتَقِلُ بِواسِطَتِها مِنْ مَكانٍ إِلى آخَرَ. وَاهْتَمَّ بِالْمَساكِنِ الْحَديثَةِ الَّتي أَمَدَّها بِالْكَهْرَباءِ وَالْماءِ لِإِسْعادِ شَعْبِهِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 مَتى تَوَلّى زايِدٌ حُكْمَ أَبوظَبي؟ وَما 