 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كُلٌّ في مُسْتَواهُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْجِهاتُ الْأَصْلِيَّةُ · الشَّمالُ · الْجَنوبُ · الشَّرْقُ · الْغَرْبُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 326, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 869, "y": 168, "w": 358, "h": 51, "rv": 1, "text": "⭐ مُبْتَدِئٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 869, "y": 221, "w": 358, "h": 255, "rv": 1, "text": "أَكْتُبُ الْجِهاتِ عَلى الْبوصَلَةِ.\nأَتَتَبَّعُ: الْجِهاتُ الْأَصْلِيَّةُ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 326, "rv": 2, "fill": "FFFDF8", "line": "5F6C78", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 461, "y": 168, "w": 358, "h": 51, "rv": 2, "text": "⭐⭐ مُتَطَوِّرٌ", "size": 27, "color": "5F6C78", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 461, "y": 221, "w": 358, "h": 255, "rv": 2, "text": "أُحَدِّدُ الْجِهاتِ بِالنِّسْبَةِ لِجِسْمي.\nأَصِفُ مَواقِعَ أَماكِنَ في الصّورَةِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 326, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 358, "h": 255, "rv": 3, "text": "أَرْسُمُ خَريطَةَ صَفّي وَأُحَدِّدُ الْجِهاتِ فيها.\nأَصِفُ طَريقي مِنْ بَيْتي إِلى الْمَدْرَسَةِ بِالْجِهاتِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 502, "w": 1203, "h": 141, "rv": 4, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 509, "w": 1172, "h": 51, "rv": 4, "text": "🏆 تَحَدٍّ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 563, "w": 1172, "h": 69, "rv": 4, "text": "🎤 «بوصَلَةُ الصَّفِّ»: نُلْصِقُ بِطاقاتِ الْجِهاتِ الْأَرْبَعِ عَلى جُدْرانِ الصَّفِّ، وَيَقولُ الْمُعَلِّمُ «شَمالٌ!» فَنَلْتَفِتُ إِلَيْهِ بِسُرْعَةٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[الأنشطة المتمايزة: «أطبّق بنفسي»] وزّع الأوراق الثلاث وورقة أصحاب الهمم. الهدف واحد والمهمة تختلف."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🌱 قيمة نعيشها", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 4 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مِنْ قِيَمِ بِلادي", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْجِهاتُ الْأَصْلِيَّةُ · الشَّمالُ · الْجَنوبُ · الشَّرْقُ · الْغَرْبُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 282, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 665, "y": 168, "w": 561, "h": 51, "rv": 1, "text": "🇦🇪 مِنْ سَنْعِ بِلادي أَتَعَلَّمُ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 665, "y": 221, "w": 561, "h": 210, "rv": 1, "text": "أُحافِظُ عَلى أَداءِ واجِباتي، وَمِنْها: الْحِفاظُ عَلى صَلاتي، وَالذَّهابُ إِلى الْمَدْرَسَةِ، وَطاعَةُ الْوالِدَيْنِ، وَأَداءُ واجِباتي الْمَدْرَسِيَّةِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 160, "w": 592, "h": 282, "rv": 2, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 561, "h": 51, "rv": 2, "text": "🏠 حَقيقَةٌ وَطَنِيَّةٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 561, "h": 210, "rv": 2, "text": "الْجِهاتُ الْأَصْلِيَّةُ أَرْبَعٌ:\nالشَّمالُ وَالْجَنوبُ وَالشَّرْقُ وَالْغَرْبُ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 457, "w": 1203, "h": 186, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 465, "w": 1172, "h": 51, "rv": 3, "text": "🤔 ماذا أَفْعَلُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 518, "w": 1172, "h": 114, "rv": 3, "text": "ضَيْفٌ يَسْأَلُني عَنْ طَريقِ الْمَسْجِدِ الْقَريبِ… كَيْفَ أَصِفُهُ لَهُ بِالْجِهاتِ؟", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[القيمة والسلوك والهوية] ناقش المعضلة: ماذا تفعل؟ ولماذا؟ اربطها بالسَّنع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🎟️ تذكرة الخروج", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 3 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "تَذْكِرَةُ الْخُروجِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْجِهاتُ الْأَصْلِيَّةُ · الشَّمالُ · الْجَنوبُ · الشَّرْقُ · الْغَرْبُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 442, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🎟️ أُجيبُ وَحْدي", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 370, "text": "١) الْجِهَةُ الَّتي تَغيبُ فيها الشَّمْسُ:  (أ) الْغَرْبُ   (ب) الشَّرْقُ   (ج) الشَّمالُ\n٢) عَدَدُ الْجِهاتِ الْأَصْلِيَّةِ:  (أ) أَرْبَعٌ   (ب) اثْنَتانِ   (ج) ثَمانٍ\n٣) أَكْتُبُ: إِذا كانَ أَمامي الشَّمالُ فَخَلْفي ……", "size": 34, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 604, "w": 1203, "h": 51, "text": "تُجْمَعُ البِطاقاتُ لِنَبْدَأَ بِها الدَّرْسَ القادِمَ.", "size": 23, "color": "6B7B7E", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[بطاقة الخروج] يجيب كل طالب وحده في البطاقة، ثم يمسح رمز الاستجابة السريعة في الشريحة التالية."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🪞 مرآة التعلّم", "size": 23, "color": "FFFFFF", "bold": tru