": 266, "h": 109, "rv": 4, "text": "يُقابِلُهُ الْجَنوبُ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «تُشْرِقُ الشَّمْسُ مِنْ … وَتَغيبُ في …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْجِهاتُ الْأَصْلِيَّةُ · الشَّمالُ · الْجَنوبُ · الشَّرْقُ · الْغَرْبُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L01/house.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "مَعَ بِدايَةِ يَوْمٍ جَديدٍ اسْتَيْقَظَتْ ميثاءُ مِنْ فِراشِها بِنَشاطٍ وَسَعادَةٍ، تَوَضَّأَتْ وَصَلَّتْ وَرَتَّبَتْ سَريرَها، ثُمَّ أَشْرَقَتِ الشَّمْسُ بِتَباشيرِها مِنْ جِهَةِ الشَّرْقِ قادِمَةً بِنورِها، لِيَعُمَّ أَرْجاءَ الْبِلادِ. ارْتَدَتْ ميثاءُ مَلابِسَها مُسْرِعَةً كَيْ لا تَتَأَخَّرَ عَنْ مَدْرَسَتِها. تَناوَلَتْ فُطورَها وَحَمَلَتْ حَقيبَتَها، وَخَرَجَتْ مِنْ مَنْزِلِها سَيْرًا عَلى الْأَقْدامِ لِقُرْبِ مَدْرَسَتِها مِنْ مَنْزِلِها، فَهِيَ تَقَعُ جِهَةَ الشَّمالِ. تَعَلَّمَتْ ميثاءُ الْيَوْمَ دَرْسَ الْجِهاتِ الْأَصْلِيَّةِ، وَأَخْبَرَتْ مُعَلِّمَتَها أَنَّها حينَ تَعودُ إِلى مَنْزِلِها بِالِاتِّجاهِ الثّاني يَكونُ مَوْقِعُ مَنْزِلِها في جِهَةِ الْجَنوبِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "عادَتْ ميثاءُ إِلى مَنْزِلِها سَعيدَةً، أَخَذَتْ قِسْطًا مِنَ الرّاحَةِ، وَمِنْ ثَمَّ الْتَقَتْ صَديقَتَها حَمْدَةَ، وَأَخَذَتا في تَجاذُبِ أَطْرافِ الْحَديثِ وَاللَّهْوِ، وَفَجْأَةً نَظَرَتْ ميثاءُ إِلى جِهَةِ الْغَرْبِ لِتَرى الشَّمْسَ تَغيبُ مُشَكِّلَةً في ذٰلِكَ لَوْحَةً جَميلَةً مُتَناسِقَةَ الْأَلْوانِ، حينَها تَبادَلَتْ ميثاءُ وَحَمْدَةُ الْحَديثَ، وَتَذَكَّرَتا دَرْسَ الْيَوْمِ عَنِ الْجِهاتِ الْأَصْلِيَّةِ، وَهِيَ: الشَّمالُ وَالْجَنوبُ وَالشَّرْقُ وَالْغَرْبُ، وَابْتَسَمَتا، وَذَهَبَتْ كُلٌّ مِنْهُما إِلى مَنْزِلِها فَرِحَةً مَسْرورَةً.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 في أَيِّ جِهَةٍ تَقَعُ مَدْرَسَةُ ميثاءَ مِنْ مَنْزِلِها؟ وَأَيْنَ رَأَتِ الشَّمْسَ تَغيبُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كَيْفَ أُحَدِّدُ الْجِهاتِ بِجِسْمي؟", "size": 46, "color": "1E3A3F", "bold": true, "align