"}, {"k": "text", "x": 49, "y": 390, "w": 266, "h": 109, "rv": 4, "text": "مَسْؤولٌ يَقودُ وِزارَةً في الدَّوْلَةِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «كانَ سَيْفُ بْنُ غُباشٍ أَوَّلَ وَزيرٍ لِـ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَدْرَسَةُ الْأَحْمَدِيَّةُ · الْمَعيريضُ · الشَّهيدُ · الْوَزيرُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L15/ghobash.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "سَيْفُ بْنُ سَعيدِ بْنِ غُباشٍ الْعِلْمُ وَالسِّياسَةُ: وُلِدَ سَيْفُ بْنُ سَعيدِ بْنِ غُباشٍ في 21 أُكْتوبَرَ 1932م بِإِمارَةِ رَأْسِ الْخَيْمَةِ. بَدَأَ مَسيرَتَهُ التَّعْليمِيَّةَ في الْمَدْرَسَةِ الْأَحْمَدِيَّةِ وَدَرَسَ أُصولَ الدّينِ وَاللُّغَةِ الْعَرَبِيَّةِ وَسافَرَ إِلى الْبَحْرَيْنِ طَلَبًا لِلْعِلْمِ وَالْمَعْرِفَةِ، غادَرَها إِلى الْعِراقِ بَعْدَ تَخَرُّجِهِ مِنَ الثّانَوِيَّةِ الْعامَّةِ لِيَبْدَأَ رِحْلَتَهُ الْجامِعِيَّةَ في دِراسَةِ الْهَنْدَسَةِ في جامِعَةِ بَغْدادَ، ثُمَّ اتَّجَهَ إِلى مِصْرَ وَمِنْها إِلى الْكُوَيْتِ لِيَعْمَلَ هُناكَ بِوَظيفَةِ مُساعِدِ مُهَنْدِسٍ. سافَرَ بَعْدَها إِلى عِدَّةِ عَواصِمَ أوروبِّيَّةٍ لِاسْتِكْمالِ دِراسَتِهِ الْجامِعِيَّةِ، وَتَمَكَّنَ مِنْ تَعَلُّمِ خَمْسِ لُغاتٍ وَالتَّحَدُّثِ بِها بِطَلاقَةٍ، وَبَعْدَ نَحْوِ 20 عامًا مِنَ الْغُرْبَةِ عادَ إِلى مَسْقَطِ رَأْسِهِ في رَأْسِ الْخَيْمَةِ مَمْلوءًا بِالْحَماسِ لِلْعَمَلِ في خِدْمَةِ وَطَنِهِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الْمَناصِبُ: وَزيرُ الْخارِجِيَّةِ 1971م، وَوَزيرُ دَوْلَةٍ لِلشُّؤونِ الْخارِجِيَّةِ 1973م. اسْتِشْهادُهُ: في يَوْمِ الثُّلاثاءِ 25 أُكْتوبَرَ 1977م، كانَ سَيْفُ غُباشٍ - رَحِمَهُ اللهُ - يُرافِقُ أَحَدَ ضُيوفِ دَوْلَةِ الْإِماراتِ إِلى مَطارِ أَبوظَبي الدَّوْلِيِّ لِوَداعِهِ، وَعِنْدَ دُخولِهِ الْمَطارَ أَصابَتِ الْوَزيرَ سَيْفَ غُباشٍ رَصاصَةُ غَدْرٍ وَاسْتُشْهِدَ مُتَأَثِّرًا بِجِراحِهِ. قالَ الشَّيْخُ زايِدٌ - رَحِمَهُ اللهُ - عَنْهُ: «إِنَّهُ مِثالٌ لِلرَّجُلِ الْمَسْؤولِ، وَواحِدٌ مِنْ خيرَةِ الشَّبابِ مِمَّنْ جاهَدوا وَسَعَوْا إِلى خَيْرِ الْعَرَبِ وَوَحْدَةِ كَلِمَتِهِمْ وَتَضامُنِهِمْ».", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 أَيْنَ وُلِدَ سَيْفُ بْنُ غُباشٍ؟ وَما مَناصِبُهُ؟ وَماذا قالَ عَنْهُ الشَّيْخُ زايِدٌ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"