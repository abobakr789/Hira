": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 صَلاةُ التَّراويحِ · الْهَريسُ · الثَّريدُ · مِدْفَعُ الْإِفْطارِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g1/SS-Y1-T2-L13/ramadan.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "يَسْتَعِدُّ النّاسُ كُلَّ سَنَةٍ لِاسْتِقْبالِ ضَيْفٍ عَزيزٍ عَلَيْهِمْ بِتَزْيينِ الْمَنازِلِ وَالشَّوارِعِ بِالْإِضاءاتِ الْجَميلَةِ. يَصومُ النّاسُ فيهِ عَنِ الْأَكْلِ وَالشُّرْبِ، وَتُقامُ فيهِ صَلاةُ التَّراويحِ الَّتي تُؤَدّى بَعْدَ صَلاةِ الْعِشاءِ. في رَمَضانَ يَشْعُرُ الْجَميعُ بِالْفَرَحِ وَالسَّعادَةِ حَيْثُ تَكْثُرُ أَعْمالُ الْخَيْرِ وَمُساعَدَةُ الْآخَرينَ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "كَما نَسْتَقْبِلُ في رَمَضانَ عَلى مائِدَةِ الْإِفْطارِ الْأَهْلَ وَالْأَصْدِقاءَ. وَمِنْ أَشْهَرِ أَطْباقِ رَمَضانَ الْهَريسُ الَّذي يُصْنَعُ مِنَ الْقَمْحِ، وَالثَّريدُ الَّذي يُصْنَعُ مِنَ الْخُبْزِ وَاللَّحْمِ. وَبَعْدَ سَماعِ أَذانِ الْمَغْرِبِ وَصَوْتِ الْمِدْفَعِ نَتَناوَلُ الْإِفْطارَ، وَيُخْتَتَمُ رَمَضانُ بِعيدِ الْفِطْرِ السَّعيدِ، وَهُوَ بِمَثابَةِ الْجائِزَةِ لِكُلِّ الصّائِمينَ.", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا نَفْعَلُ في رَمَضانَ؟ وَمَتى نُفْطِرُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "يَوْمٌ في رَمَضانَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 صَلاةُ التَّراويحِ · الْهَريسُ · الثَّريدُ · مِدْفَعُ الْإِفْطارِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🌅 الصِّيامُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "مِنَ الْفَجْرِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"},