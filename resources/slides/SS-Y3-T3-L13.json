, "lw": 2}, {"k": "img", "x": 1038, "y": 173, "w": 122, "h": 122, "emo": "✨", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "الْحَضارَةُ الذَّهَبِيَّةُ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "فَتْرَةٌ ازْدَهَرَتْ فيها الْعُلومُ في الْحَضارَةِ الْإِسْلامِيَّةِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "👁️", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "طِبُّ الْكِحالَةِ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "طِبُّ الْعُيونِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «وُلِدَ ابْنُ الْهَيْثَمِ في … وَدَرَسَ الطِّبَّ في …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْحَضارَةُ الذَّهَبِيَّةُ · طِبُّ الْكِحالَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L13/iraq.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "الْمُعَلِّمُ: لَفَتَ نَظَرَنا شارِعُ الْحَسَنِ بْنِ الْهَيْثَمِ في إِمارَةِ عَجْمانَ، وَأَطْلُبُ إِلَيْكُمُ الْآنَ تَحْضيرَ بِطاقاتٍ تَحْتَوي عَلى مَعْلوماتٍ عَنْ هٰذا الْعالِمِ؛ لِنَتَوَصَّلَ إِلى سَبَبِ تَسْمِيَةِ الشّارِعِ بِاسْمِهِ. أَحْمَدُ: اعْلَمْ يا مُعَلِّمَنا الْفاضِلَ، أَنَّنا اسْتَمْتَعْنا بِالْقِراءَةِ عَنْ هٰذا الْعالِمِ، وَأَنَّنا نَفْخَرُ بِجُهودِ عُلَمائِنا الْمُسْلِمينَ. راشِدٌ: وُلِدَ ابْنُ الْهَيْثَمِ وَاسْمُهُ الْكامِلُ (أَبو عَلِيٍّ الْحَسَنُ بْنُ الْحَسَنِ بْنُ الْهَيْثَمِ) في مَدينَةِ الْبَصْرَةِ في الْقَرْنِ الْعاشِرِ الْميلادِيِّ، وَعاشَ في فَتْرَةٍ ذَهَبِيَّةٍ مِنْ فَتَراتِ الْحَضارَةِ الْإِسْلامِيَّةِ، وَكانَ مُطَّلِعًا عَلى الْكُتُبِ الْعِلْمِيَّةِ في الْعُلومِ وَالرِّياضِيّاتِ، وَقَدْ دَرَسَ الطِّبَّ في بَغْدادَ، وَتَخَصَّصَ في طِبِّ الْكِحالَةِ (الْعُيونِ) وَكانَ أَهْلُ بَغْدادَ يَقْصِدونَهُ في عُلومٍ عِدَّةٍ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "عَبْدُ اللهِ: انْتَقَلَ ابْنُ الْهَيْثَمِ إِلى مِصْرَ، وَحاوَلَ تَأْسيسَ مَشْروعٍ لِلسَّيْطَرَةِ عَلى ماءِ نَهْرِ النّيلِ، وَتُوُفِّيَ وَدُفِنَ فيها عِنْدَما كانَ عُمُرُهُ يُقارِبُ (75) عامًا. خَصَّصَتْ هَيْئَةُ الْأُمَمِ الْمُتَّحِدَةِ عامَ 2015م سَنَةً دَوْلِيَّةً لِلضَّوْءِ وَتِكْنولوجْيا الضَّوْءِ، تَحْتَفِلُ فيها بِذِكْرى رُموزٍ عِلْمِيَّةٍ ساهَمَتْ في فَهْمِ الْإِنْسانِيَّةِ لِلضَّوْءِ، وَاحْتَفَلَتْ بِالْحَسَنِ ابْنِ الْهَيْثَمِ بِاعْتِبارِهِ قَدْ حَقَّقَ إِنْجازاتٍ كَبيرَةً في مَجالاتِ الْبَصَرِيّاتِ وَالرِّياضِيّاتِ، وَعِلْمِ الْفَلَكِ. حَقيقَةٌ تاريخِيَّةٌ: الْحَضارَةُ الْإِسْلامِيَّةُ هِيَ نِتاجُ ما قَدَّمَهُ الْمُسْلِمونَ في الْعالَمِ مِنِ ابْتِكاراتٍ وَإِبْداعاتٍ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 أَيْنَ وُلِدَ ابْنُ الْهَيْثَمِ؟ وَأَيْنَ دَرَسَ الطِّبَّ؟ وَلِماذا احْتَفَلَتْ بِهِ الْأُمَمُ الْمُتَّحِدَةُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رِحْلَةُ ابْنِ الْهَيْثَمِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْحَضارَةُ الذَّهَبِيَّةُ · طِبُّ الْكِحالَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🏙️ الْبَصْرَةُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الْوِلادَةُ (الْقَرْن