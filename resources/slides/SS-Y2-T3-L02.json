iddle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْخَدَماتُ · مَجّانِيَّةٌ · غَيْرُ مَجّانِيَّةٍ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L02/school.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "الْخَدَماتُ: هِيَ ما تُقَدِّمُهُ الدَّوْلَةُ لِلْمُواطِنينَ، وَالْمُقيمينَ؛ لِتَسْهيلِ حَياتِهِمْ. يُمْكِنُ الْحُصولُ عَلى هٰذِهِ الْخَدَماتِ بِطَريقَتَيْنِ: خَدَماتٌ مَجّانِيَّةٌ: دونَ دَفْعِ النُّقودِ، مِثْلُ: التَّعْليمِ، الصِّحَّةِ، الطُّرُقِ. خَدَماتٌ غَيْرُ مَجّانِيَّةٍ: بِدَفْعِ النُّقودِ، مِثْلُ: الْحَدائِقِ التَّرْفيهِيَّةِ، الْمُواصَلاتِ، الِاتِّصالاتِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "الْخَدَماتُ الَّتي تُوَفِّرُها بِلادي: الْخَدَماتُ التَّعْليمِيَّةُ، وَخِدْمَةُ الْكَهْرَباءِ، وَخَدَماتُ الْمُواصَلاتِ، وَالْخَدَماتُ الصِّحِّيَّةُ، وَالْخَدَماتُ الْأَمْنِيَّةُ، وَالْخَدَماتُ التَّرْفيهِيَّةُ. وَمِنْ أَنْواعِها: خَدَماتٌ أَساسِيَّةٌ: إِنارَةُ الشَّوارِعِ، الدِّفاعُ الْمَدَنِيُّ، شَبَكاتُ الْمِياهِ. وَخَدَماتٌ غَيْرُ أَساسِيَّةٍ: الْحَدائِقُ، الْمَطاراتُ، الْمُدُنُ التَّرْفيهِيَّةُ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْخَدَماتُ؟ اذْكُرْ خِدْمَةً مَجّانِيَّةً وَأُخْرى غَيْرَ مَجّانِيَّةٍ.", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "سِلْعَةٌ أَمْ خِدْمَةٌ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْخَدَماتُ · مَجّانِيَّةٌ · غَيْرُ مَجّانِيَّةٍ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 592, "h": 64, "rv": 1, "text": "🛍️ سِلْعَةٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 650, "y": 227, "w": 592, "h": 58, "rv": 1, "text": "شَيْءٌ نَشْتَريهِ وَنَحْمِلُهُ: كِتابٌ، حِذاءٌ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 592, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 592, "h": 64, "rv": 1, "text": "🏛️ خِدْمَةٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 592, "h": 58, "rv": 1, "text": "عَمَلٌ يُقَدَّمُ لَنا: تَعْليمٌ، عِلاجٌ، نَقْلٌ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُفَرِّقُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "الدَّواءُ سِلْعَةٌ (أَحْمِلُهُ)… وَالطَّبيبُ الَّذي يَفْحَصُني يُقَدِّمُ خِدْمَةً صِحِّيَّةً.\nتَذْكِرَةُ الْمِتْرو أَدْفَعُ ثَمَنَها، وَالرِّحْلَةُ نَفْسُها خِدْمَةُ مُواصَلاتٍ غَيْرُ مَجّانِيَّةٍ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ وَطَنِيَّةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "مِتْرو دُبَيَّ شَبَكَةٌ مِنَ السِّكَكِ الْحَديدِيَّةِ الْآلِيَّةِ دونَ سائِقٍ، وَهِيَ تُعَدُّ الْأَطْوَلَ في الْعالَمِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A