}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التِّكْنولوجْيا · الْقِطارُ الْكَهْرَبائِيُّ · الْبَحْثُ الْعِلْمِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L04/mancomp.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "الْمُعَلِّمَةُ: دَرْسُنا الْيَوْمَ عَنِ التِّكْنولوجْيا. أَحْمَدُ: وَما مَعْنى كَلِمَةِ تِكْنولوجْيا؟ الْمُعَلِّمَةُ: التِّكْنولوجْيا كَلِمَةٌ يونانِيَّةٌ تَتَكَوَّنُ مِنْ مَقْطَعَيْنِ (تِكْنو Techn) وَتَعْني حِرْفَةً أَوْ مَهارَةً، وَ(لوجْيا Logy) وَتَعْني عِلْمًا. راشِدٌ: وَما الْمَقْصودُ بِمَفْهومِ التِّكْنولوجْيا؟ الْمُعَلِّمَةُ: هِيَ الِاسْتِخْدامُ الْأَفْضَلُ لِلْمَعْرِفَةِ وَتَطْويرُها لِخِدْمَةِ الْإِنْسانِيَّةِ. عَلِيٌّ: أَيْ كَاسْتِخْدامِ الْحاسِبِ الْآلِيِّ وَالْهَواتِفِ الذَّكِيَّةِ. الْمُعَلِّمَةُ: نَعَمْ، هٰذا صَحيحٌ. أَحْسَنْتُمْ يا أَبْنائي.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "أَهَمِّيَّةُ التِّكْنولوجْيا في حَياتِنا: تَسْهيلُ عَمَلِيَّةِ التَّنَقُّلِ بِاسْتِخْدامِ وَسائِلِ النَّقْلِ الْحَديثَةِ كَالطّائِراتِ وَالْقِطاراتِ الْكَهْرَبائِيَّةِ. تَسْهيلُ عَمَلِيَّةِ الْبَحْثِ الْعِلْمِيِّ، حَيْثُ وَفَّرَتْ شَبَكَةُ الْإِنْتَرْنِتْ مَصادِرَ الْحُصولِ عَلى الْمَعْرِفَةِ. وَتُرْبِطُ أَنْظِمَةُ الِاتِّصالاتِ النّاسَ بَعْضَهُمْ بَعْضًا. حَقيقَةٌ حَضارِيَّةٌ: مِتْرو دُبَيَّ هُوَ شَبَكَةُ مِتْرو آلِيٍّ دونَ سائِقٍ تَمَّ افْتِتاحُهُ في 9 سِبْتَمْبَرَ 2009م.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 مِنْ أَيِّ لُغَةٍ كَلِمَةُ تِكْنولوجْيا؟ وَما مَفْهومُها؟ وَما أَهَمِّيَّتُها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَهَمِّيَّةُ التِّكْنولوجْيا", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التِّكْنولوجْيا · الْقِطارُ الْكَهْرَبائِيُّ · الْبَحْثُ الْعِلْمِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🚆 التَّنَقُّلُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad":