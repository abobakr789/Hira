 القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْبيئَةُ · الْعَريشُ · بَيْتُ الشَّعْرِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L10/grandpa.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "أَحْمَدُ: حَدِّثْني يا جَدّي عَنْ مَساكِنِكُمُ الَّتي سَكَنْتُموها في الْماضي، كَيْفَ كانَتْ؟ الْجَدُّ: لا بُدَّ أَنْ أُخْبِرَكَ في الْبِدايَةِ أَنَّ الْمَساكِنَ تَخْتَلِفُ بِاخْتِلافِ الْبيئَةِ الَّتي نَعيشُ فيها. أَحْمَدُ: ماذا تَعْني يا جَدّي الْحَبيبُ بِالْبيئَةِ؟ الْجَدُّ: الْبيئَةُ هِيَ الْمَكانُ الَّذي نَعيشُ فيهِ، فَدَوْلَتُنا فيها ثَلاثُ بيئاتٍ: جَبَلِيَّةٌ، ساحِلِيَّةٌ، صَحْراوِيَّةٌ. أَحْمَدُ: إِذَنْ الْمَساكِنُ مُخْتَلِفَةٌ حَسَبَ الْبيئَةِ الَّتي نَعيشُ فيها. الْجَدُّ: نَعَمْ يا بُنَيَّ فَالْبيئَةُ الْجَبَلِيَّةُ بُيوتُها مِنَ الْأَحْجارِ، وَالْبيئَةُ السّاحِلِيَّةُ بُيوتُها مِنَ الطّينِ أَوِ الْعَريشِ الَّتي تُبْنى مِنْ سَعَفِ النَّخيلِ الْجافِّ، أَمّا الْبيئَةُ الصَّحْراوِيَّةُ فَبُيوتُها عِبارَةٌ عَنْ بَيْتِ الشَّعْرِ الَّذي يُصْنَعُ مِنْ شَعْرِ الْماعِزِ، وَصوفِ الْغَنَمِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "أَحْمَدُ: لِماذا يا جَدّي هٰذا الِاخْتِلافُ في نَوْعِيَّةِ بِناءِ الْمَساكِنِ؟ الْجَدُّ: يَرْجِعُ هٰذا الِاخْتِلافُ إِلى الْبيئَةِ وَما يوجَدُ فيها مِنْ مَوادَّ تُساعِدُ في عَمَلِيَّةِ بِناءِ الْمَسْكَنِ الَّذي يُؤْوينا، فَلَقَدِ اسْتَطَعْنا أَنْ نَتَحَدّى الصِّعابَ، وَنَسْتَخْدِمَ الْمَوارِدَ الَّتي أُتيحَتْ لَنا، فَبَنَيْنا مَساكِنَنا، وَأَكْثَرُ شَجَرَةٍ اعْتَمَدْنا عَلَيْها هِيَ شَجَرَةُ النَّخْلَةِ فَثِمارُها لِلْغِذاءِ، وَجِذْعُها وَسَعَفُها لِلْبِناءِ، وَخوصُها وَليفُها يُسْتَعْمَلُ في صِناعاتٍ يَدَوِيَّةٍ عَديدَةٍ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْبيئاتُ الثَّلاثُ في بِلادي؟ وَمِمَّ بُنِيَتْ بُيوتُ كُلٍّ مِنْها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْبيئَةُ تَبْني الْمَسْكَنَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْبيئَةُ · الْعَريشُ · بَيْتُ الشَّعْرِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "⛰️ الْجَبَلِيَّةُ", "size": 36, "color": "FFFFFF", "bold": true, "align