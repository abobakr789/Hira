"y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «تَعاوَنْتُ مَعَ … عِنْدَما …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّعاوُنُ · الْيَرْبوعُ (الْجَرْبوعُ) · الْغافَةُ · سَفينَةُ الصَّحْراءِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L18/jerboa.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "في الصَّحْراءِ حَيْثُ الْكُثْبانُ الرَّمْلِيَّةُ النّاعِمَةُ، وَأَشْجارُ الْغافِ الشّامِخَةُ، عاشَ يَرْبوعٌ (وَهُوَ حَيَوانٌ يُشْبِهُ الْفَأْرَ) تَحْتَ شَجَرَةِ الْغافِ الْجَميلَةِ (وَهِيَ الشَّجَرَةُ الْعِمْلاقَةُ الَّتي تَمُدُّ الظِّلَّ وَالْغِذاءَ لِلْإِنْسانِ وَالْحَيَوانِ). كانَ الْيَرْبوعُ قَدْ حَفَرَ جُحْرَهُ بِسَلامٍ قَريبًا مِنْها، فَهُوَ يَخْرُجُ كُلَّ يَوْمٍ ساعِيًا لِيُوَفِّرَ الطَّعامَ لِصِغارِهِ، وَكانَتْ صَديقَتُهُ الْحَمامَةُ تُحَيّيهِ مِنْ فَوْقِ غُصْنِ الشَّجَرَةِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "وَفي يَوْمٍ مِنَ الْأَيّامِ هَبَّتْ ريحٌ قَوِيَّةٌ أَسْقَطَتْ جِذْعًا كَبيرًا مِنَ الشَّجَرَةِ، فَسَدَّ جُحْرَ الْيَرْبوعِ وَصِغارُهُ في داخِلِهِ، فَطَلَبَتِ الْحَمامَةُ الْمُساعَدَةَ مِنَ الْأَرْنَبِ وَالثَّعْلَبِ. تَعاوَنوا جَميعًا: الْيَرْبوعُ وَالْأَرْنَبُ يَحْفِرانِ، وَالثَّعْلَبُ يَدْفَعُ، وَمَرَّ أَكْثَرُ مِنْ ساعَتَيْنِ وَالْعَمَلُ قائِمٌ، حَتّى مَرَّ الْجَمَلُ، فَصاحَ الْجَميعُ: «أَهْلًا بِسَفينَةِ الصَّحْراءِ»، فَساعَدَهُمْ بِقُوَّتِهِ حَتّى أُزيحَ الْجِذْعُ وَنَجا الصِّغارُ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا حَدَثَ لِجُحْرِ الْيَرْبوعِ؟ وَمَنْ ساعَدَهُ؟ وَما دَوْرُ كُلِّ صَديقٍ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "لِكُلٍّ دَوْرٌ في التَّعاوُنِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّعاوُنُ · الْيَرْبوعُ (الْجَرْبوعُ) · الْغافَةُ · سَفينَةُ الصَّحْراءِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🕊️ الْحَمامَةُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "طَلَبَتِ الْمُساعَدَةَ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🐰 الْأَرْنَبُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 650, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "حَفَرَ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "EA580C", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 344, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🦊 الثَّعْلَبُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 344, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "دَفَعَ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🐪 الْجَمَلُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "ساعَدَ بِقُوَّتِهِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُوَضِّحُ دَوْري أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "في مَشْروعِ الصَّفِّ: أَنا أَكْتُبُ، وَزَميلي يَرْسُمُ، وَآخَرُ يُلَوِّنُ، وَرابِعٌ يَعْرِضُ…\nكُلٌّ مِنّا يُؤَدّي دَوْرَهُ، فَيَنْجَحُ الْمَشْروعُ، مِثْلَ أَصْدِقاءِ الْيَرْبوعِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ وَطَنِيَّةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "تَعاوُنُنا مَعًا يَبْني وَطَنًا أَجْمَلَ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَحْداثُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّعاوُنُ · الْيَرْبوعُ (الْجَر