, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «قَديمًا كانَ … يُعَلِّمُ، وَالْيَوْمَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُطَوِّعُ · الْمُداوي · خَدَماتٌ تَعْليمِيَّةٌ · خَدَماتٌ صِحِّيَّةٌ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L03/dialog.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "حَمْدانُ: جَدّي تَعَلَّمْتُ الْيَوْمَ في الْمَدْرَسَةِ أَنَّ مِنْ أَهَمِّ الْخَدَماتِ في بِلادي خَدَماتِ التَّعْليمِ وَالصِّحَّةِ. الْجَدُّ: نَعَمْ يا حَمْدانُ، وَهُناكَ تَطَوُّرٌ كَبيرٌ في التَّعْليمِ وَالصِّحَّةِ في وَقْتِنا الْحاضِرِ. حَمْدَةُ: كَيْفَ كانَ التَّعْليمُ في الْماضي يا جَدّي؟ الْجَدُّ: كانَ التَّعْليمُ بَسيطًا، وَيَهْتَمُّ بِتَحْفيظِ الْقُرْآنِ الْكَريمِ، وَالْأَحاديثِ النَّبَوِيَّةِ الشَّريفَةِ. حَمْدانُ: مَنْ كانَ يَقومُ بِالتَّعْليمِ في الْماضي، وَأَيْنَ؟ الْجَدُّ: الْمُطَوِّعُ لِلْأَوْلادِ في مَكانٍ يُسَمّى «الْكَتاتيبَ»، وَالْمُطَوِّعَةُ لِلْبَناتِ في بَيْتِها.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "حَمْدَةُ: وَماذا عَنِ الْعِلاجِ قَديمًا يا جَدّي؟ الْجَدُّ: في الْماضي كانوا يَعْتَمِدونَ عَلى الْأَدْوِيَةِ الشَّعْبِيَّةِ. حَمْدانُ: وَمَنْ كانَ يَقومُ بِعِلاجِ الْمَرْضى؟ الْجَدُّ: الْمُعالِجُ وَيُسَمّى الْمُداوي. حَمْدَةُ: الْحَمْدُ لِلّٰهِ الَّذي أَنْعَمَ عَلَيْنا بِالْخَيْرِ الْوَفيرِ، وَالْعِلْمِ، وَالصِّحَّةِ، وَالْعافِيَةِ. وَقَدْ وَفَّرَتْ بِلادي لَنا خَدَماتٍ تَعْليمِيَّةً: الْمَدارِسَ وَالْكُتُبَ وَالْحافِلاتِ الْمَدْرَسِيَّةَ، وَخَدَماتٍ صِحِّيَّةً مَجّانِيَّةً: الدَّواءَ وَالتَّطْعيمَ وَعِلاجَ الْأَسْنانِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 مَنْ كانَ يُعَلِّمُ قَديمًا؟ وَمَنْ كانَ يُعالِجُ؟ وَماذا وَفَّرَتْ بِلادي الْيَوْمَ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْماضي وَالْحاضِرُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُطَوِّعُ · الْمُداوي · خَدَماتٌ تَعْليمِيَّةٌ · خَدَماتٌ صِحِّيَّةٌ", "size": 21, "c