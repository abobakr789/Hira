َّفَقِ أَنَّ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْجُسورُ · الْأَنْفاقُ · الْبِنْيَةُ التَّحْتِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L09/bridge.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "اهْتَمَّ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - مُنْذُ بِدايَةِ حُكْمِهِ بِتَشْييدِ الْبِنْيَةِ التَّحْتِيَّةِ: وَهِيَ مَجْموعَةٌ مِنَ الْوَسائِلِ وَالْأَدَواتِ الَّتي اسْتُخْدِمَتْ في تَصْميمِ الْمَرافِقِ الَّتي تَتَكَوَّنُ مِنْها الْأَحْياءُ مِنْ مِثْلِ الطُّرُقِ وَتَشْييدِ الْجُسورِ وَالْأَنْفاقِ، فَانْتَشَرَتْ عَلى أَرْضِ الدَّوْلَةِ مَشْروعاتٌ هَنْدَسِيَّةٌ تَعْكِسُ مَدى التَّقَدُّمِ وَالتَّحَضُّرِ الَّذي وَصَلَتْ إِلَيْهِ دَوْلَةُ الْإِماراتِ، فَجُسورُ الْمُشاةِ بُنِيَتْ بِمُواصَفاتٍ عالَمِيَّةٍ في إِماراتِ الدَّوْلَةِ الْمُخْتَلِفَةِ، وَالْأَنْفاقُ كَذٰلِكَ الَّتي روعِيَ فيها الْجانِبُ الْمِعْمارِيُّ الْجَميلُ، وَزُوِّدَتْ بِالْإِضاءَةِ وَاللَّوْحاتِ الْفَنِّيَّةِ الْبَديعَةِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "الْجُسورُ: هِيَ مُنْشَآتٌ يَتِمُّ اسْتِخْدامُها لِلْعُبورِ مِنْ مَكانٍ لِآخَرَ، وَتُصْنَعُ مِنَ الْخَرَسانَةِ الْمُسَلَّحَةِ وَالْخَشَبِ وَالْمَعادِنِ. أَهَمِّيَّتُها: تَسْهيلُ حَرَكَةِ الْمُرورِ، وَالرَّبْطُ بَيْنَ أَجْزاءِ الْمَدينَةِ، وَضَمانُ سَلامَةِ الْمُشاةِ. أَمْثِلَتُها: جِسْرُ الْمَقْطَعِ في أَبوظَبي، وَالْجِسْرُ الْعائِمُ في دُبَيَّ، وَجِسْرُ الْقَرْهودِ في دُبَيَّ. الْأَنْفاقُ: هِيَ مَمَرّاتٌ تَحْتَ سَطْحِ الْأَرْضِ مُغْلَقَةٌ مِنَ الْجِهاتِ جَميعِها ما عَدا بِدايَتِها وَنِهايَتِها، وَتُحْفَرُ أَيْضًا خِلالَ التِّلالِ أَوِ الْجِبالِ وَتَحْتَ الْمُدُنِ وَالطُّرُقِ الْمائِيَّةِ. أَهَمِّيَّتُها: تَسْهيلُ حَرَكَةِ الْمُرورِ وَنَقْلِ الْأَفْرادِ وَالْبَضائِعِ، وَأَنْفاقُ الْأَعْمالِ الْعامَّةِ لِنَقْلِ الْمِياهِ وَالصَّرْفِ الصِّحِّيِّ وَأَنابيبِ الْغازِ. أَمْثِلَتُها: نَفَقُ الشِّنْدَغَةِ في دُبَيَّ، وَنَفَقُ الْمَطارِ في دُبَيَّ، وَنَفَقُ وادي الْحِلْوِ في الشّارِقَةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْجُسورُ؟ وَما الْأَنْفاقُ؟ اذْكُرْ مِثالًا لِكُلٍّ مِنْهُما.", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْجُسورُ وَالْأَنْفاقُ", "siz