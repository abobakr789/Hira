72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "وِجْهَتُنا الْيَوْمَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْجُسورُ · الْأَنْفاقُ · الْبِنْيَةُ التَّحْتِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 160, "w": 1203, "h": 128, "text": "🎯 أَعْرِفُ اهْتِمامَ الشَّيْخِ زايِدٍ - رَحِمَهُ اللهُ - بِتَشْييدِ الْبِنْيَةِ التَّحْتِيَّةِ، وَأُقارِنُ بَيْنَ الْجُسورِ (مُنْشَآتٌ لِلْعُبورِ تُصْنَعُ مِنَ الْخَرَسانَةِ وَالْخَشَبِ وَالْمَعادِنِ) وَالْأَنْفاقِ (مَمَرّاتٌ تَحْتَ سَطْحِ الْأَرْضِ) مِنْ حَيْثُ التَّعْريفُ وَالْأَهَمِّيَّةُ وَالْأَمْثِلَةُ.", "size": 25, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 307, "w": 388, "h": 333, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 869, "y": 315, "w": 358, "h": 51, "rv": 1, "text": "⭐ مُبْتَدِئٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 869, "y": 369, "w": 358, "h": 261, "rv": 1, "text": "أُعَرِّفُ الْبِنْيَةَ التَّحْتِيَّةَ وَالْجُسورَ وَالْأَنْفاقَ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 446, "y": 307, "w": 388, "h": 333, "rv": 2, "fill": "FFFDF8", "line": "5F6C78", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 461, "y": 315, "w": 358, "h": 51, "rv": 2, "text": "⭐⭐ مُتَطَوِّرٌ", "size": 27, "color": "5F6C78", "bold": true, "align": "right", "fill"