َضْعِ الْمَحارِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «كانَ الْغَوّاصُ يَضَعُ … عَلى أَنْفِهِ».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْبَحْرُ · الْغَوْصُ · الْفِطامُ · الدّيّينُ · الْمَحارُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L13/dialog.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "جَلَسَ الْجَدُّ وَحَوْلَهُ أَحْفادُهُ، وَكانَ شارِدَ الذِّهْنِ. سالِمٌ: ما بالُكَ يا جَدّي، وَفيمَ تُفَكِّرُ؟ الْجَدُّ: أُفَكِّرُ يا أَبْنائي في زَمَنِ الْغَوْصِ وَرِحْلاتِهِ. أَحْمَدُ: حَدِّثْنا يا جَدّي عَنْ زَمَنِ الْغَوْصِ. الْجَدُّ: كانَ سُكّانُ الْخَليجِ الْعَرَبِيِّ قَديمًا يَعْتَمِدونَ في رِزْقِهِمْ عَلى الْبَحْرِ، وَهُوَ تَجَمُّعٌ كَبيرٌ لِلْمِياهِ الْمالِحَةِ، وَكانوا يَصيدونَ الْأَسْماكَ، وَيَبْحَثونَ عَنِ اللُّؤْلُؤِ في أَعْماقِ الْبَحْرِ، وَكانَتْ هٰذِهِ الْمِهْنَةُ تُسَمّى مِهْنَةَ الْغَوْصِ، حَيْثُ يَغوصُ الْغَوّاصُ في الْبَحْرِ لِجَمْعِ الْمَحارِ. فَمِهْنَةُ الْغَوْصِ مِهْنَةٌ أَبْرَزَتْ أَصالَةَ الْإِنْسانِ الْإِماراتِيِّ، وَأَظْهَرَتْ قُوَّةَ رِجالِ الْخَليجِ الْعَرَبِيِّ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "حِصَّةُ: ما الْوَسيلَةُ الَّتي كانوا يَسْتَخْدِمونَها في مِهْنَةِ الْغَوْصِ عَلى اللُّؤْلُؤِ يا جَدّي؟ الْجَدُّ: كانوا يَسْتَخْدِمونَ السُّفُنَ الشِّراعِيَّةَ الَّتي تَعْتَمِدُ في حَرَكَتِها عَلى قُوَّةِ دَفْعِ الرِّياحِ. أَحْمَدُ: وَما الْأَدَواتُ الَّتي يَحْتاجُ إِلَيْها الْغَوّاصُ في رِحْلَتِهِ؟ الْجَدُّ: الْغَوّاصُ يَحْتاجُ إِلى: الْفِطامِ: وَهُوَ مِشْبَكٌ يَضَعُهُ الْغَوّاصُ عَلى أَنْفِهِ لِمَنْعِ دُخولِ الْماءِ إِلَيْهِ. الدّيّينِ: كيسٌ مَصْنوعٌ مِنَ الْخُيوطِ يُعَلِّقُهُ الْغَوّاصُ في رَقَبَتِهِ لِيَضَعَ فيهِ الْمَحارَ الَّذي يَجْمَعُهُ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْغَوْصُ؟ وَما فائِدَةُ الْفِطامِ وَالدّيّينِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَدَواتُ الْغَوّاصِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 