ما نَحْتاجُ إِلَيْهِ مِنْ مُنْتَجاتٍ، وَتُنافِسُ السِّلَعَ الْمُسْتَوْرَدَةَ. مَرْيَمُ: كَيْفَ يا أُمّي؟ الْأُمُّ: بِلادُنا تَبْني الْمَصانِعَ الْحَديثَةَ. عَلْياءُ: وَماذا تَصْنَعُ دَوْلَتي؟", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الْأُمُّ: تَصْنَعُ الْمُنْتَجاتِ الْغِذائِيَّةَ، مِثْلَ: مُنْتَجاتِ الْأَلْبانِ وَالْحَليبِ، وَالْبَيْضِ وَالزَّيْتِ وَغَيْرِها. مَرْيَمُ: وَهَلْ هُناكَ مُنْتَجاتٌ غَيْرُ الْمُنْتَجاتِ الْغِذائِيَّةِ؟ الْأُمُّ: نَعَمْ، لَقَدْ أَصْبَحَتْ دَوْلَتُنا الْحَبيبَةُ تُنافِسُ الدُّوَلَ الْأُخْرى في الصِّناعاتِ الْكَبيرَةِ، مِثْلَ: صِناعَةِ الْإِسْمَنْتِ وَالزُّجاجِ وَالْأَلومِنْيومِ، كَذٰلِكَ صِناعَةِ الْأَقْمارِ الصِّناعِيَّةِ، مِثْلَ (دُبَيّ سات) وَ(خَليفَةُ سات). عَلْياءُ: الْحَمْدُ لِلّٰهِ يا أُمّي وَإِلى الْأَمامِ لِنَرْتَقِيَ بِصِناعاتِنا الْوَطَنِيَّةِ الَّتي تُنافِسُ الصِّناعاتِ الْعالَمِيَّةَ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 لِماذا تَشْتَري الْأُمُّ الْمُنْتَجَ الْوَطَنِيَّ؟ اذْكُرْ صِناعَتَيْنِ وَطَنِيَّتَيْنِ.", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مُنْتَجاتٌ وَطَنِيَّةٌ", "size": 46, "color": "1E3A3F", "b