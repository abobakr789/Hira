 "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «أُرَشِّدُ اسْتِهْلاكَ الْماءِ عِنْدَما …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّلَوُّثُ · تَرْشيدُ الِاسْتِهْلاكِ · الرَّيُّ بِالتَّنْقيطِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L03/carwash.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "تُواجِهُ دَوْلَةُ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ تَحَدِّيًا في مُشْكِلَةِ نَقْصِ الْمِياهِ، وَذٰلِكَ لِلْأَسْبابِ الْآتِيَةِ: التَّلَوُّثُ، وَسوءُ الِاسْتِخْدامِ وَالْإِسْرافُ، وَعَدَدُ السُّكّانِ. إِنَّ أَفْضَلَ وَسيلَةٍ لِحَلِّ مُشْكِلَةِ نَقْصِ الْمِياهِ هُوَ تَرْشيدُ اسْتِهْلاكِ الْمِياهِ، وَيَعْني اسْتِخْدامَ الْمَوارِدِ الْمُتاحَةِ الِاسْتِخْدامَ الْأَمْثَلَ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "طَرائِقُ الْمُحافَظَةِ عَلى مَوارِدِ الْمِياهِ في دَوْلَةِ الْإِماراتِ: إِغْلاقُ صُنْبورِ الْمِياهِ، وَالْمُحافَظَةُ عَلى نَظافَةِ الْمِياهِ مِنَ التَّلَوُّثِ، وَالرَّيُّ بِالتَّنْقيطِ. قالَ الشَّيْخُ زايِدٌ - رَحِمَهُ اللهُ -: «مُنْذُ الْبِدايَةِ اعْتَبَرَتْ دَوْلَةُ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ حِمايَةَ الْبيئَةِ هَدَفًا رَئيسًا لِسِياسَتِها التَّنْمَوِيَّةِ».", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما أَسْبابُ نَقْصِ الْمِياهِ؟ وَما أَفْضَلُ حَلٍّ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْمُشْكِلَةُ وَالْحَلُّ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّلَوُّثُ · تَرْشيدُ الِاسْتِهْلاكِ · الرَّيُّ بِالتَّنْقيطِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🏭 التَّلَوُّثُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "