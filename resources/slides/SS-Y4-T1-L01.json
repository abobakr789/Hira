يدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ: الْجُزْءُ الْأَوَّلُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَوْقِعُ النِّسْبِيُّ · الْقارّاتُ · الْمُحيطاتُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g4/SS-Y4-T1-L01/solar.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "اسْتَلْقى مَنْصورٌ بِجَسَدِهِ الصَّغيرِ عَلى سَريرِهِ النّاعِمِ، وَعَيْنُهُ تَجولُ في سَقْفِ غُرْفَتِهِ مُرَدِّدًا: «يا لَهُ مِنْ يَوْمٍ دِراسِيٍّ مُمْتِعٍ، طِرْنا فيهِ إِلى الْفَضاءِ..» تَقَلَّبَ مَنْصورٌ في فِراشِهِ، مُتَخَيِّلًا طَيَرانَهُ في الْأُفُقِ الْعالي، فَنامَ وَطارَ فِعْلًا في حُلْمِهِ بِصُحْبَةِ مُعَلِّمِ الدِّراساتِ الِاجْتِماعِيَّةِ راكِبًا مَكوكَ فَضاءٍ، صاعِدًا لِيَرى كَوْكَبَنا الْأَرْضَ، فَلَفَتَتْ أَنْظارَهُ صُوَرًا جَميلَةً مُتَسائِلًا عَنْها قائِلًا: «ما هٰذِهِ الْكُرَةُ الْجَميلَةُ الَّتي تَسْبَحُ في الْفَضاءِ».", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الْمُعَلِّمُ: إِنَّهُ كَوْكَبُنا الْأَرْضُ، وَهُوَ أَحَدُ كَواكِبِ الْمَجْموعَةِ الشَّمْسِيَّةِ وَالْكَوْكَبُ الْوَحيدُ الْمَعْروفُ بِدَعْمِهِ لِلْحَياةِ فَوْقَ سَطْحِهِ. مَنْصورٌ: «مُعَلِّمي، ما هٰذِهِ الْأَلْوانُ الَّتي أَراها؟!» الْمُعَلِّمُ: الْأَخْضَرُ يا بُنَيَّ يُمَثِّلُ الْيابِسَةَ، وَالْأَزْرَقُ لَوْنُ الْبِحارِ وَالْمُحيطاتِ، تُساعِدُنا هٰذِهِ الْأَلْوانُ في تَحْديدِ الْمَوْقِعِ النِّسْبِيِّ (أَيْ مَوْقِعِ الْمَكانِ بِالنِّسْبَةِ لِلْيابِسَةِ وَالْماءِ). وَالْمَجْموعَةُ الشَّمْسِيَّةُ هِيَ جَميعُ الْأَجْسامِ الَّتي تَدورُ حَوْلَ الشَّمْسِ، وَالْجِهاتُ الْأَصْلِيَّةُ أَرْبَعُ جِهاتٍ وَهِيَ الشَّمالُ وَالْجَنوبُ وَالشَّرْقُ وَالْغَرْبُ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا يُمَثِّلُ اللَّوْنُ الْأَخْضَرُ وَالْأَزْرَقُ؟ وَما الْمَوْقِعُ النِّسْبِيُّ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَصِفُ الْمَوْقِعَ النِّسْبِيَّ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَوْقِعُ النِّسْبِيُّ · الْقارّاتُ · الْمُحيطاتُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🟩 