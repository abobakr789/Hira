F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "وِجْهَتُنا الْيَوْمَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الصّورَةُ · الْخَريطَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 160, "w": 1203, "h": 128, "text": "🎯 أُمَيِّزُ بَيْنَ الصّورَةِ (نُسْخَةٌ طِبْقَ الْأَصْلِ لِما نَراهُ في الطَّبيعَةِ) وَالْخَريطَةِ (رَسْمٌ مُصَغَّرٌ لِلظَّواهِرِ عَلى سَطْحِ الْأَرْضِ بِمِقْياسِ رَسْمٍ مُعَيَّنٍ)، وَأَعْرِفُ أَنَّهُما تُساعِدانِنا في تَعَرُّفِ الْأَماكِنِ.", "size": 25, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 307, "w": 388, "h": 333, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 869, "y": 315, "w": 358, "h": 51, "rv": 1, "text": "⭐ مُبْتَدِئٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 869, "y": 369, "w": 358, "h": 261, "rv": 1, "text": "أُعَرِّفُ الصّورَةَ وَالْخَريطَةَ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 446, "y": 307, "w": 388, "h": 333, "rv": 2, "fill": "FFFDF8", "line": "5F6C78", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 461, "y": 315, "w": 358, "h": 51, "rv": 2, "text": "⭐⭐ مُتَطَوِّرٌ", "size": 27, "color": "5F6C78", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 461, "y": 369, "w": 358, "h": 261, "rv": 2, "text": "أُمَيِّزُ الصّورَةَ مِنَ الْخَريطَةِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 307, "w": 388, "h": 333, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 315, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 369, "w": 358, "h": 261, "rv": 3, "text": "أَرْسُمُ خَريطَةً مُبَسَّطَةً لِمَكانٍ أَعْرِفُهُ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[ناتج التعلّم ومعايير النجاح] اقرأ الهدف مع الطلاب، ووضّح ماذا يعني كل مستوى."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🔑 مفاتيح الدرس", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 6 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كَلِماتٌ جَديدَةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الصّورَةُ · الْخَريطَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 352, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 1038, "y": 173, "w": 122, "h": 122, "emo": "📷", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "الصّورَةُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "نُسْخَةٌ طِبْقَ الْأَصْلِ لِما نَراهُ في الطَّبيعَةِ كَما هُوَ في الْحَقيقَةِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "🗺️", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "الْخَريطَةُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "رَسْمٌ مُصَغَّرٌ لِلظَّواهِرِ الْمَوْجودَةِ عَلى سَطْحِ الْأَرْضِ بِمِقْياسِ رَسْمٍ مُعَيَّنٍ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «الْفَرْقُ بَيْنَ الصّورَةِ وَالْخَريطَةِ أَنَّ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الصّورَةُ · الْخَريطَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L04/teacher.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "دَخَلَتِ الْمُعَلِّمَةُ عَلى طُلّابِ الصَّفِّ الثّالِثِ، وَوَزَّعَتْ أَوْراقًا مُلَوَّنَةً، تَحْتَوي عَلى مَعْلوماتٍ شائِقَةٍ، وَطَلَبَتْ إِلَيْهِمْ أَنْ يَقْرَؤوا هٰذِهِ الْمَعْلوماتِ لِمُدَّةِ دَقيقَتَيْنِ، وَبَعْدَها بَدَأَ النِّقاشُ بَيْنَهُمْ. مُحَمَّدٌ: ماذا تَعْني كَلِمَةُ خَريطَةٍ يا مُعَلِّمَتي؟ سالِمٌ: وَما الْفَرْقُ بَيْنَ الْخَريطَةِ وَالصّورَةِ؟ الْمُعَلِّمَةُ: سَتُخْبِرُكُمُ الصّورَةُ وَالْخَريطَةُ ما الْفَرْقُ بَيْنَهُما؟", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "أَنا الصّورَةُ: نُسْخَةٌ طِبْقَ الْأَصْلِ لِما نَراهُ حَوْلَنا في الطَّبيعَةِ كَما هُوَ في الْحَقيقَةِ (مِثْلُ الْإِنْسانِ، الْحَيَوانِ، النَّباتِ، الْجَمادِ). أَنا الْخَريطَةُ: رَسْمٌ مُصَغَّرٌ لِلظَّواهِرِ الْمَوْجودَةِ عَلى سَطْحِ الْأَرْضِ، بِمِقْياسِ رَسْمٍ مُعَيَّنٍ. الْمُعَلِّمَةُ: هَلْ عَرَفْتُمُ الْفَرْقَ بَيْنَهُما؟ إِذَنْ هَيّا يا أَحِبّائي نَرْسُمُ خَريطَةً مُبَسَّطَةً لِدَوْلَتِنا الْحَبيبَةِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الصّورَةُ؟ وَما الْخَريطَةُ؟ وَما الْفَرْقُ بَيْنَهُما؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "