لْمَجالُ الَّذي يُمارِسُ فيهِ الْإِنْسانُ حَياتَهُ وَنَشاطاتِهِ الْمُخْتَلِفَةَ. مَفْهومُ النِّظامِ الْبيئِيِّ: هُوَ تَفاعُلُ الْمَخْلوقاتِ الْحَيَّةِ مَعَ بَعْضِها وَمَعَ الْعَوامِلِ غَيْرِ الْحَيَّةِ في بيئَتِها لِاسْتِمْرارِ الْحَياةِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "تَشْهَدُ دَوْلَةُ الْإِماراتِ الْكَثيرَ مِنَ التَّوَسُّعِ الْعُمْرانِيِّ وَالنُّمُوِّ السُّكّانِيِّ وَتَنْويعِ مَصادِرِ الِاقْتِصادِ، إِلّا أَنَّ حِمايَةَ الْبيئَةِ وَالْحِفاظَ عَلى الْمَوارِدِ الطَّبيعِيَّةِ مِنْ أَهَمِّ الْأَوْلَوِيّاتِ. السَّبَبُ في ذٰلِكَ وُجودُ رَغْبَةٍ لَدى الْقِيادَةِ الْإِماراتِيَّةِ لا سِيَّما مُؤَسِّسِ الدَّوْلَةِ وَأَحَدِ رُوّادِ الْحِمايَةِ الْبيئِيَّةِ - الْمَغْفورِ لَهُ بِإِذْنِ اللهِ - الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ، الَّذي رَأى أَنَّ حِمايَةَ الْبيئَةِ مَطْلَبٌ أَساسِيٌّ لِتَحْقيقِ نُمُوٍّ مُسْتَدامٍ وَمُتَوازِنٍ. وَمِنْ مُكَوِّناتِ النِّظامِ الْبيئِيِّ وَفَوائِدِها: الْهَواءُ (تَتَنَفَّسُ بِهِ الْكائِناتُ الْحَيَّةُ، النَّباتُ)، وَالْماءُ (الشُّرْبُ، النَّظافَةُ، الطَّبْخُ)، وَالتُّرْبَةُ (الزِّراعَةُ، السَّكَنُ).", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْبيئَةُ؟ وَكَيْفَ أَثَّرَ النَّشاطُ الْبَشَرِيُّ فيها؟ وَلِماذا اهْتَمَّ زايِدٌ بِحِمايَتِها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size"