ض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ (بِتَصَرُّفٍ)", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْقائِدانِ الْبَطَلانِ · روحُ الِاتِّحادِ · الِاتِّحادُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L18/tent.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "مِنْ كِتابِ «الْقائِدانِ الْبَطَلانِ» لِصاحِبِ السُّمُوِّ الشَّيْخِ مُحَمَّدِ بْنِ راشِدٍ آلِ مَكْتومٍ: قَبْلَ سَنَواتٍ طَويلَةٍ كانَ هُناكَ قائِدٌ بَطَلٌ مِنْ أَبوظَبي اسْمُهُ الشَّيْخُ زايِدٌ، وَقائِدٌ بَطَلٌ مِنْ دُبَيَّ اسْمُهُ الشَّيْخُ راشِدٌ، يُحِبُّهُما النّاسُ كَثيرًا. حَلَمَ الْقائِدانِ بِدَوْلَةٍ جَميلَةٍ يَعيشُ فيها النّاسُ بِسَعادَةٍ، وَيَلْعَبُ أَطْفالُها في الْحَدائِقِ الْخَضْراءِ. اجْتَمَعا في خَيْمَةٍ في الصَّحْراءِ، وَبَعْدَ الْقَهْوَةِ وَالتَّمْرِ فَكَّرا كَيْفَ يُحَقِّقانِ الْحُلْمَ، فَقالَ زايِدٌ: لا بُدَّ أَنْ نَتَّحِدَ جَميعًا؛ «لِأَنَّ الِاتِّحادَ قُوَّةٌ وَالتَّفَرُّقَ ضَعْفٌ». وَوافَقَهُ راشِدٌ، وَقَرَّرا أَنْ يَتَّحِدا مَعَ خَمْسَةِ قادَةٍ آخَرينَ لِتَكونَ الدَّوْلَةُ مِنْ سَبْعِ إِماراتٍ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "صافَحَ زايِدٌ صَديقَهُ راشِدًا: الْيَوْمَ نَبْدَأُ بِوَضْعِ الْأَساسِ لِتَحْقيقِ حُلْمِنا. ثُمَّ اجْتَمَعَ النّاسُ وَالْقادَةُ السَّبْعَةُ في «دارِ الِاتِّحادِ» وَاحْتَفَلوا لِأَنَّهُمْ أَصْبَحوا أَقْوِياءَ مُتَّحِدينَ. وَعَمِلَ الْقائِدانِ وَإِخْوانُهُما بِجِدٍّ لِبِناءِ الْبُيوتِ وَالْحَدائِقِ وَالْمَدارِسِ وَالْأَسْواقِ، وَجاءَ النّاسُ مِنْ كُلِّ مَكانٍ لِلْمُساعَدَةِ، فَفَرِحَتِ الْأُسَرُ وَلَعِبَ الْأَطْفالُ. وَفي النِّهايَةِ قالَ راشِدٌ: الْحَمْدُ لِلّٰهِ حَقَّقْنا الْحُلْمَ بِالْعَمَلِ وَالِاجْتِهادِ، فَقالَ زايِدٌ: نُريدُ مِنْ جَميعِ الْأَطْفالِ أَنْ يُحافِظوا عَلى دَوْلَتِنا الْجَميلَةِ وَيُحَقِّقوا أَحْلامَهُمْ عِنْدَما يَكْبَرونَ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما حُلْمُ الْقائِدَيْنِ؟ وَكَيْفَ حَقَّقاهُ؟ وَماذا طَلَبَ زايِدٌ مِنَ الْأَطْفالِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَحْداثُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْقائِدانِ الْبَطَلانِ · روحُ الِاتِّحادِ · الِاتِّحادُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, 