, "w": 266, "h": 109, "rv": 4, "text": "3%: الْأَنْهارُ وَالْبُحَيْراتُ، لا مِلْحَ فيها", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «الْماءُ الْعَذْبُ هُوَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْغِلافُ الْمائِيُّ · الْغِلافُ الْأَرْضِيُّ · الْمِياهُ الْمالِحَةُ · الْمِياهُ الْعَذْبَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T1-L06/pie.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "عِنْدَما نَنْظُرُ مِنَ الْفَضاءِ إِلى الْأَرْضِ فَإِنَّنا نَرى اللَّوْنَ الْأَزْرَقَ هُوَ اللَّوْنَ الْغالِبَ عَلى سَطْحِ الْأَرْضِ. يَتَكَوَّنُ سَطْحُ الْأَرْضِ مِنْ يابِسَةٍ وَماءٍ، وَيُسَمّى الْقِسْمُ الَّذي تُغَطّيهِ الْمِياهُ (الْغِلافَ الْمائِيَّ) وَالْقِسْمُ الَّذي تُغَطّيهِ الْيابِسَةُ (الْغِلافَ الْأَرْضِيَّ). تُغَطّي الْمِياهُ الْقِسْمَ الْأَكْبَرَ مِنْ سَطْحِ الْأَرْضِ (71%)، وَتُمَثِّلُ الْيابِسَةُ حَوالَيْ 29% وَتوجَدُ عَلى شَكْلِ قارّاتٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الْماءُ الْعَذْبُ: هُوَ ماءٌ لا يَحْتَوي عَلى مِلْحٍ. الْمِياهُ الْعَذْبَةُ تُمَثِّلُ حَوالَيْ 3% فَقَطْ مِنَ الْغِلافِ الْمائِيِّ، وَتَشْمَلُ الْأَنْهارَ وَالْبُحَيْراتِ وَالْبِرَكَ الْعَذْبَةَ. الْمِياهُ الْمالِحَةُ تُمَثِّلُ حَوالَيْ 97% مِنَ الْغِلافِ الْمائِيِّ، وَتَتَكَوَّنُ مِنَ الْمُحيطاتِ وَالْبِحارِ وَالْخُلْجانِ وَالْبُحَيْراتِ الْمالِحَةِ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 كَمْ نِسْبَةُ الْماءِ؟ وَكَمْ نِسْبَةُ الْمِياهِ الْعَذْبَةِ مِنْها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَقْرَأُ الدّائِرَةَ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْغِلافُ الْمائِيُّ · الْغِلافُ الْأَرْضِيُّ · الْمِياهُ الْمالِحَةُ · الْمِياهُ الْعَذْبَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "0EA5E9", "line": nu