 "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 49, "y": 390, "w": 266, "h": 109, "rv": 4, "text": "يُحَدِّدُ الشَّمالَ وَالْجَنوبَ وَالشَّرْقَ وَالْغَرْبَ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «الرُّموزُ تُوضَعُ في …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 عُنْوانُ الْخَريطَةِ · مِفْتاحُ الْخَريطَةِ · إِطارُ الْخَريطَةِ · مُبَيِّنُ الْجِهاتِ · مِقْياسُ الرَّسْمِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L05/elements.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "الْخَريطَةُ رَسْمَةٌ مُصَغَّرَةٌ لِمَكانٍ ما (قَرْيَةٌ - مَدينَةٌ - دَوْلَةٌ) تَعْرِضُ مَعْلوماتٍ مُتَنَوِّعَةً وَمُفيدَةً، لِذا تُعَدُّ الْخَريطَةُ ضَرورِيَّةً لِجَميعِ النّاسِ. وَلِلْخَريطَةِ عَناصِرُ رَئيسَةٌ لا بُدَّ أَنْ نَتَعَلَّمَها لِنُصْبِحَ قارِئًا جَيِّدًا لِلْخَريطَةِ، هِيَ: مُبَيِّنُ الْجِهاتِ الْأَصْلِيَّةِ: وَهِيَ الشَّمالُ وَالْجَنوبُ وَالشَّرْقُ وَالْغَرْبُ. مِفْتاحُ الْخَريطَةِ: الَّذي تُوضَعُ فيهِ الرُّموزُ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "إِطارُ الْخَريطَةِ: وَهِيَ أَرْبَعَةُ خُطوطٍ مُسْتَقيمَةٍ تُحيطُ بِالْخَريطَةِ. عُنْوانُ الْخَريطَةِ: مِثْلُ «تَضاريسُ دَوْلَةِ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ». مِقْياسُ الرَّسْمِ: يُبَيِّنُ كَمْ صَغَّرْنا الْمَسافاتِ الْحَقيقِيَّةَ. حَقيقَةٌ جُغْرافِيَّةٌ: يُساعِدُنا مِفْتاحُ الْخَريطَةِ عَلى فَهْمِ مُحْتَوى الْخَريطَةِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما عَناصِرُ الْخَريطَةِ؟ وَأَيْنَ تُوضَعُ الرُّموزُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "عَناصِرُ الْخَريطَةِ الْخَمْسَةُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 عُنْوانُ الْخَريطَةِ · مِفْتاحُ الْخَريطَةِ · إِطارُ الْخَريطَةِ · مُبَيِّنُ الْجِهاتِ · مِقْياسُ الرَّسْمِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true,