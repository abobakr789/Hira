": 1, "text": "مُبَيِّنُ الْجِهاتِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 225, "h": 134, "rv": 1, "fill": "7C3AED", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 225, "h": 64, "rv": 1, "text": "📏 الْمِقْياسُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 225, "h": 58, "rv": 1, "text": "نِسْبَةُ التَّصْغيرِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أَقْرَأُ الْخَريطَةَ بِالتَّرْتيبِ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "1. أَقْرَأُ الْعُنْوانَ ← عَنْ ماذا الْخَريطَةُ؟ 2. أَنْظُرُ إِلى مُبَيِّنِ الْجِهاتِ ← أَيْنَ الشَّمالُ؟\n3. أَقْرَأُ الْمِفْتاحَ ← ماذا تَعْني الرُّموزُ وَالْأَلْوانُ؟ 4. أَبْحَثُ عَنِ الْأَماكِنِ عَلى الْخَريطَةِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 بيئَتي مَسْؤولِيَّتي", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "عِنْدَما أَنْتَهي مِنْ رَسْمِ خَريطَةٍ ما أُحافِظُ عَلى نَظافَةِ الْمَكانِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": nu