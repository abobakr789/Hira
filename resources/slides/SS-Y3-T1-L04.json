. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأوزونُ · دَوْرَةُ الْمِياهِ في الطَّبيعَةِ · السِّلْسِلَةُ الْغِذائِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L04/indus.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "التَّقَدُّمُ الْعِلْمِيُّ وَالتِّكْنولوجِيُّ الَّذي حَقَّقَهُ الْإِنْسانُ أَدّى إِلى تَطَوُّرِ حَياتِهِ في مَجالاتٍ مُخْتَلِفَةٍ. مَجالاتُ التَّقَدُّمِ الَّتي حَقَّقَها الْإِنْسانُ في اسْتِغْلالِ مَوارِدِ الْبيئَةِ: التَّقَدُّمُ الْعُمْرانِيُّ، وَالتَّقَدُّمُ الزِّراعِيُّ، وَالتَّقَدُّمُ الصِّناعِيُّ، وَالتَّقَدُّمُ التِّقْنِيُّ. وَفي الطَّبيعَةِ دَوْرَةٌ لِلْمِياهِ: تَبَخُّرٌ ثُمَّ تَكَثُّفٌ ثُمَّ هُطولٌ ثُمَّ انْتِقالٌ، وَسِلْسِلَةٌ غِذائِيَّةٌ لِلْكائِناتِ الْحَيَّةِ: النَّباتُ يَأْخُذُ طاقَتَهُ مِنَ الشَّمْسِ، وَالْغَزالُ وَالْأَرْنَبُ يَأْكُلانِ النَّباتَ، وَالذِّئْبُ وَالثَّعْلَبُ يَأْكُلانِهِما.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "ما طَبَقَةُ الْأوزونِ؟ طَبَقَةُ الْأوزونِ: جُزْءٌ مِنَ الْغِلافِ الْجَوِّيِّ لِكَوْكَبِ الْأَرْضِ وَالَّذي يَحْتَوي بِشَكْلٍ مُكَثَّفٍ عَلى غازِ الْأوزونِ، وَتَعْمَلُ طَبَقَةُ الْأوزونِ عَلى حِمايَةِ الْأَرْضِ مِنَ الْأَشِعَّةِ الضّارَّةِ. مُسَبِّباتُ ثَقْبِ الْأوزونِ: يُسَبِّبُ الدُّخانُ الَّذي يَتَصاعَدُ إِلى الْهَواءِ تَدْميرَ طَبَقَةِ (الْأوزونِ) في الْجَوِّ. قالَ الشَّيْخُ زايِدٌ: «حِمايَةُ الْبيئَةِ جُزْءٌ لا يَتَجَزَّأُ مِنْ تاريخِنا وَتُراثِنا وَنَمَطِ حَياتِنا».", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما مَجالاتُ التَّقَدُّمِ؟ وَما وَظيفَةُ طَبَقَةِ الْأوزونِ؟ وَما الَّذي يُدَمِّرُها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مَجالاتُ التَّقَدُّمِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأوزونُ · دَوْرَةُ الْمِياهِ في الطَّبيعَةِ · السِّلْسِلَةُ الْغِذائِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "64748B", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🏙️ الْعُمْرانِيُّ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "r