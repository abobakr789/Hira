, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَجْلِسُ الْأَعْلى لِلِاتِّحادِ · الِانْتِخابُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L17/zayedold.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "الْمَجْلِسُ الْأَعْلى لِلِاتِّحادِ هُوَ السُّلْطَةُ الْعُلْيا في دَوْلَةِ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ، وَيَتَشَكَّلُ مِنْ أَصْحابِ السُّمُوِّ حُكّامِ الْإِماراتِ السَّبْعِ، وَقَدْ تَوَلّى الْمَغْفورُ لَهُ - بِإِذْنِ اللهِ - الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ رِئاسَةَ الْمَجْلِسِ حَتّى وَفاتِهِ - رَحِمَهُ اللهُ - في الثّاني مِنْ نوفَمْبَرَ 2004م. انْتَخَبَ الْمَجْلِسُ الْأَعْلى لِلِاتِّحادِ بِالْإِجْماعِ الشَّيْخَ خَليفَةَ بْنَ زايِدٍ آلِ نَهْيانَ - رَحِمَهُ اللهُ - رَئيسًا لِلدَّوْلَةِ، وَرَئيسًا لِلْمَجْلِسِ الْأَعْلى لِلِاتِّحادِ. وَبَعْدَ وَفاتِهِ تَوَلّى صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ زايِدٍ آلِ نَهْيانَ - حَفِظَهُ اللهُ - رِئاسَةَ الدَّوْلَةِ وَالْمَجْلِسِ الْأَعْلى لِلِاتِّحادِ في 14 مايو 2022م.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "مِنْ مَهامِّ الْمَجْلِسِ الْأَعْلى لِلِاتِّحادِ في دَوْلَةِ الْإِماراتِ: انْتِخابُ رَئيسِ الدَّوْلَةِ وَنائِبِهِ، وَالْمُوافَقَةُ عَلى تَعْيينِ رَئيسِ مَجْلِسِ الْوُزَراءِ الِاتِّحادِيِّ، وَالتَّصْديقُ عَلى الْمُعاهَداتِ وَالِاتِّفاقِيّاتِ الدَّوْلِيَّةِ، وَرَسْمُ السِّياسَةِ الْعامَّةِ لِلدَّوْلَةِ. حَقيقَةٌ: يُعَدُّ الْمَجْلِسُ الْأَعْلى أَعْلى سُلْطَةٍ اتِّحادِيَّةٍ في دَوْلَةِ الْإِماراتِ. وَمِنْ سَنْعِ بِلادي: في مَجْلِسِ الرِّجالِ يَقومُ الْأَصْغَرُ سِنًّا مِنْ حاضِري الْمَجْلِسِ بِتَقْديمِ الْقَهْوَةِ لِلضُّيوفِ، وَيَبْدَأُ بِالْأَكْبَرِ سِنًّا.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْمَجْلِسُ الْأَعْلى لِلِاتِّحادِ؟ مَنْ تَوَلّى رِئاسَتَهُ؟ وَما مَهامُّهُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُؤَساءُ الدَّوْلَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَجْلِسُ الْأَعْلى لِلِاتِّحادِ · الِانْتِخابُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "1", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "الشَّيْخُ زايِدُ بْنُ سُلْطانَ (1971–2004)", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "2563EB",