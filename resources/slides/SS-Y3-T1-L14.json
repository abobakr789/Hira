: "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 يَوْمُ الْعَلَمِ · مَقاليدُ الْحُكْمِ · مُبادَرَةٌ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L14/mbrkids.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "اعْتَمَدَ صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ راشِدٍ آلِ مَكْتومٍ نائِبُ رَئيسِ الدَّوْلَةِ رَئيسُ مَجْلِسِ الْوُزَراءِ حاكِمُ دُبَيَّ - رَعاهُ اللهُ - يَوْمَ الْعَلَمِ كَمُناسَبَةٍ وَطَنِيَّةٍ سَنَوِيَّةٍ في الثّالِثِ مِنْ نوفَمْبَرَ 2013م. يَحْتَفِلُ الْمُواطِنونَ وَالْمُقيمونَ عَلى أَرْضِ دَوْلَةِ الْإِماراتِ بِيَوْمِ الْعَلَمِ؛ لِتُجَسِّدَ هٰذِهِ الْمُناسَبَةُ الْوَطَنِيَّةُ مَشاعِرَ التَّلاحُمِ وَالسَّلامِ، وَالْوَحْدَةِ بَيْنَ أَبْناءِ الْإِماراتِ وَالْمُقيمينَ عَلى أَرْضِها الطَّيِّبَةِ، وَتَعْكِسُ اعْتِزازَ الْجَميعِ بِرَمْزِ سِيادَةِ الدَّوْلَةِ، وَحُبَّهُمْ وَتَقْديرَهُمْ لَها.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "مَظاهِرُ احْتِفالِ الْمُواطِنينَ وَالْمُقيمينَ بِرَفْعِ عَلَمِ دَوْلَةِ الْإِماراتِ عَلى: الْبُيوتِ وَالْمَنازِلِ (فَوْقَ بَيْتِنا عَلَمٌ)، وَالْمُؤَسَّساتِ. وَمِنْ فِكْرِ قِيادَتِنا قالَ صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ راشِدٍ: «عَلَمُنا رَمْزُ وَحْدَتِنا وَعِزَّتِنا وَعَزيمَتِنا». وَمِنْ مَعاني أَلْوانِ الْعَلَمِ: يَرْمُزُ إِلى النَّماءِ وَالِازْدِهارِ، وَإِلى الْخَيْرِ وَالْعَطاءِ، وَإِلى قُوَّةِ أَبْناءِ الدَّوْلَةِ، وَيَرْمُزُ الْأَحْمَرُ إِلى تَضْحِياتِ الْأَجْيالِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 مَنْ أَطْلَقَ يَوْمَ الْعَلَمِ؟ وَمَتى؟ وَأَيْنَ يُرْفَعُ الْعَلَمُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مَعاني أَلْوانِ عَلَمي", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 يَوْمُ الْعَلَمِ · مَقاليدُ الْحُكْمِ · مُبادَرَةٌ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🟥 الْأَحْمَرُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "تَضْحِياتُ الْأَجْيالِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "16A34A", "line": n