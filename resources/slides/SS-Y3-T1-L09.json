4, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الشَّهيدُ · يَوْمُ الشَّهيدِ · الْعَلاقاتُ الْأَخَوِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L09/saudi.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "داخِلَ دَوْلَةِ الْإِماراتِ: يُسانِدُ صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ زايِدٍ آلِ نَهْيانَ رَئيسُ الدَّوْلَةِ - حَفِظَهُ اللهُ - أُسَرَ الشُّهَداءِ وَيَزورُهُمْ وَيُلاطِفُ أَبْناءَهُمْ، وَتَحْتَفِلُ دَوْلَةُ الْإِماراتِ في 30 مِنْ نوفَمْبَرَ مِنْ كُلِّ عامٍ بِيَوْمِ الشَّهيدِ، وَيَزورُ سُمُوُّهُ مَراكِزَ التَّدْريبِ كَمَرْكَزِ تَدْريبِ الْمَنامَةِ. وَمِنْ أَقْوالِهِ: «إِنَّ التَّنْمِيَةَ تَحْتاجُ إِلى قُوَّةٍ تَحْميها وَتُحَصِّنُ مُكْتَسَباتِها».", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "خارِجَ دَوْلَةِ الْإِماراتِ: صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ زايِدٍ يُشيدُ بِالْعَلاقاتِ الْإِماراتِيَّةِ - السُّعودِيَّةِ وَالتَّعاوُنِ الْمُشْتَرَكِ بَيْنَهُما. وَفي عَلاقَةِ الْإِماراتِ مَعَ مِصْرَ قالَ سُمُوُّهُ: «لَوْ كانَتْ هُناكَ لُقْمَةُ خُبْزٍ لَاقْتَسَمْتُها الْإِماراتُ مَعَ مِصْرَ». وَمِنْ أَقْوالِ الشَّيْخِ زايِدٍ - رَحِمَهُ اللهُ -: «نَهْضَةُ مِصْرَ مِنْ نَهْضَةِ الْعَرَبِ كُلِّهِمْ، أَوْصَيْتُ أَبْنائي بِأَنْ يَكونوا دائِمًا إِلى جانِبِ مِصْرَ». وَقُدْوَتُنا صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ زايِدٍ بِظُهورِهِ بِالزِّيِّ الْوَطَنِيِّ وَإِبْرازِ الْهُوِيَّةِ الْوَطَنِيَّةِ في الْمَحافِلِ الدَّوْلِيَّةِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 كَيْفَ يُسانِدُ سُمُوُّهُ أُسَرَ الشُّهَداءِ؟ وَماذا قالَ عَنْ مِصْرَ؟ وَبِماذا أَوْصى الشَّيْخُ زايِدٌ أَبْناءَهُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مَواقِفُ قائِدي", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الشَّهيدُ · يَوْمُ الشَّهيدِ · الْعَلاقاتُ الْأَخَوِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🏠 داخِلَ الدَّوْلَةِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "أُسَرُ الشُّهَداءِ · مَراكِزُ التَّدْريبِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 38