k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «ابْنُ بَطّوطَةَ مِنْ بِلادِ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الرَّحّالَةُ · السُّفُنُ الشِّراعِيَّةُ · الْمَغْرِبُ · 40 دَوْلَةً", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g1/SS-Y1-T3-L13/ib.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "مَرْحَبًا يا أَصْدِقائي.. أَنا صَديقُكُمُ الرَّحّالَةُ ابْنُ بَطّوطَةَ، وُلِدْتُ في الْمَغْرِبِ، وَأَحْبَبْتُ السَّفَرَ كَثيرًا في الْبُلْدانِ، لِذٰلِكَ عُرِفْتُ بِالرَّحّالَةِ، فَتَنَقَّلْتُ في رِحْلاتي بَرًّا عَلى جَمَلٍ أَوْ حِصانٍ، وَبَحْرًا بِالسُّفُنِ الْكَبيرَةِ أَوِ السُّفُنِ الشِّراعِيَّةِ الَّتي تَعْتَمِدُ في حَرَكَتِها عَلى قُوَّةِ الرِّياحِ، وَزُرْتُ أَكْثَرَ مِنْ أَرْبَعينَ دَوْلَةً.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "وَفي أَثْناءِ سَفَري كُنْتُ أُسَجِّلُ ما أُشاهِدُهُ مِنْ عاداتِ وَتَقاليدِ الشُّعوبِ، وَما أَراهُ مِنْ أَنْواعٍ جَديدَةٍ مِنَ النَّباتاتِ وَالْحَيَواناتِ. كانَ ابْنُ بَطّوطَةَ مِنَ الْمُغامِرينَ الَّذينَ دَفَعَهُمْ حُبُّ الِاسْتِطْلاعِ لِلسَّفَرِ إِلى دُوَلٍ جَديدَةٍ. وَاسْمُهُ الْحَقيقِيُّ: مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدٍ الطَّنْجِيُّ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 أَيْنَ وُلِدَ ابْنُ بَطّوطَةَ؟ وَكَيْفَ تَنَقَّلَ؟ وَماذا كانَ يُسَجِّلُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كَيْفَ سافَرَ ابْنُ بَطّوطَةَ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الرَّحّالَةُ · السُّفُنُ الشِّراعِيَّةُ · الْمَغْرِبُ · 40 دَوْلَةً", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "EAB308", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🐪 بَرًّا", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv":