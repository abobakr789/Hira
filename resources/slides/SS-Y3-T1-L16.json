olor": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 صَيْدُ الصُّقورِ · الْفُروسِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L16/oldad.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "وُلِدَ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - في أَبوظَبي عامَ 1918م. والِدُهُ الشَّيْخُ سُلْطانُ بْنُ زايِدِ بْنِ خَليفَةَ آلِ نَهْيانَ - رَحِمَهُ اللهُ -، وَأُمُّهُ الشَّيْخَةُ سَلامَةُ بِنْتُ بُطي بْنِ خادِمٍ - رَحِمَها اللهُ -، وَقَدْ سُمِّيَ عَلى اسْمِ جَدِّهِ الشَّيْخِ زايِدٍ - رَحِمَهُ اللهُ -، وَهُوَ الِابْنُ الْأَصْغَرُ بَيْنَ أَرْبَعَةِ إِخْوَةٍ. نَشَأَ الشَّيْخُ زايِدٌ - رَحِمَهُ اللهُ - بَعْدَ رَحيلِ والِدِهِ في الْعَيْنِ، حَيْثُ تَلَقّى فيها عُلومَهُ وَمَعارِفَهُ الَّتي تَرَكَتْ بَصَماتٍ واضِحَةً عَلى حَياتِهِ وَشَخْصِيَّتِهِ، وَغَرَسَتِ الْقِيَمَ التَّقْليدِيَّةَ في نَفْسِهِ. بَدَأَ رِحْلَةَ التَّعْليمِ في الْخامِسَةِ مِنْ عُمُرِهِ، وَدَرَسَ الْقُرْآنَ الْكَريمَ وَالْحَديثَ الشَّريفَ وَأُصولَ الدّينِ وَاللُّغَةَ الْعَرَبِيَّةَ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "أَحَبَّ الشَّيْخُ زايِدٌ - رَحِمَهُ اللهُ - الشِّعْرَ، وَرِياضَةَ الْفُروسِيَّةِ وَسِباقَ الْهُجُنِ، وَحَرَصَ عَلى مُمارَسَةِ هِواياتِهِ الْمُحَبَّبَةِ في أَوْقاتِ الْفَراغِ الْقَليلَةِ، وَكانَ يَرى في هٰذِهِ الرِّياضَةِ تُراثًا شَعْبِيًّا يَجِبُ الْمُحافَظَةُ عَلَيْهِ. كَما أَحَبَّ الشَّيْخُ زايِدٌ رِياضَةَ الْقَنْصِ بِالصُّقورِ؛ لِأَنَّها تُعَلِّمُ الصَّبْرَ وَالْقُدْرَةَ عَلى تَحَمُّلِ الصِّعابِ. كانَ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - ابْنَ بيئَتِهِ. وَمِنْ أَقْوالِهِ: «عَلى شَعْبِنا أَلّا يَنْسى ماضِيَهُ وَأَسْلافَهُ… وَكُلَّما أَحَسَّ النّاسُ بِماضيهِمْ أَكْثَرَ، وَعَرَفوا تُراثَهُمْ، أَصْبَحوا أَكْثَرَ اهْتِمامًا بِبِلادِهِمْ».", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 أَيْنَ وُلِدَ الشَّيْخُ زايِدٌ؟ وَأَيْنَ نَشَأَ؟ وَلِماذا أَحَبَّ الْقَنْصَ بِالصُّقورِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "هِواياتُهُ وَما تُعَلِّمُهُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 صَيْدُ الصُّقورِ · الْفُروسِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, 