k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَسْكَنُ · الْبُيوتُ الشَّعْبِيَّةُ · الْفِلَلُ السَّكَنِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L12/hood.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "ما زِلْتُ مَعَكُمْ يا أَصْدِقائي، فَأَنا حَمَدٌ وَسَأُخْبِرُكُمْ عَنِ الْمَسْكَنِ وَهُوَ الْمَكانُ الَّذي يَعيشُ فيهِ الْإِنْسانُ في بِلادي. فَالْمَساكِنُ تَطَوَّرَتْ، وَتَنَوَّعَتْ وَهٰذا يَدُلُّ عَلى اهْتِمامِ قادَتِنا بِالْمُواطِنينَ، وَتَوْفيرِ كافَّةِ أَساليبِ الرّاحَةِ وَالِاسْتِقْرارِ، حَيْثُ عَمِلوا عَلى تَوْفيرِ الْمَساكِنِ الْآمِنَةِ وَالْمُريحَةِ، وَمِنْها: الْبُيوتُ الشَّعْبِيَّةُ: مَجْموعَةٌ مِنَ الْبُيوتِ تَبْنيها الدَّوْلَةُ بِالْقُرْبِ مِنْ بيئاتِهِمْ؛ لِيَسْكُنَها الْمُواطِنونَ بِراحَةٍ وَسَعادَةٍ. وَالْفِلَلُ السَّكَنِيَّةُ: هِيَ مَنازِلُ سَكَنِيَّةٌ تَتَكَوَّنُ مِنْ طابِقَيْنِ، وَبِها حَديقَةٌ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "وَبَعْدَ أَنْ بَنَتِ الدَّوْلَةُ الْمَساكِنَ أَصْبَحَ لَدَيْنا جيرانٌ طَيِّبونَ يَعْرِفُ بَعْضُنا بَعْضًا، وَيَزورونا وَنَزورُهُمْ، وَأَصْبَحَ لي حَيٌّ شَعْبِيٌّ جَميلٌ، فيهِ الطُّرُقُ وَالشَّوارِعُ الْمُعَبَّدَةُ الْمُزَيَّنَةُ بِالْأَزْهارِ. وَأَنْشَأَتِ الدَّوْلَةُ في حَيِّنا حَديقَةً جَميلَةً، وَمَسْجِدًا، وَمَحَلّاتٍ تِجارِيَّةً لِلشِّراءِ، وَمَدارِسَ لِلتَّعْليمِ، وَمَرْكَزًا صِحِّيًّا لِلْعِلاجِ. فَشُكْرًا لِقِيادَتِنا الرَّشيدَةِ عَلى ما وَفَّرَتْهُ لَنا مِنْ حاجِيّاتٍ أَساسِيَّةٍ لِلْعَيْشِ فيها، فَكُلُّ ما نَحْتاجُ إِلَيْهِ أَصْبَحَ بِالْقُرْبِ مِنْ مَسْكَني.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْفَرْقُ بَيْنَ الْبُيوتِ الشَّعْبِيَّةِ وَالْفِلَلِ السَّكَنِيَّةِ؟ وَماذا يوجَدُ في الْحَيِّ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْمَسْكَنُ: قَديمًا وَحَديثًا", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَسْكَنُ · الْبُيوتُ الشَّعْبِيَّةُ · الْفِلَلُ السَّكَنِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🌴 قَديمًا", "size": 36, "color": "FFFFFF", "bold": true, "a