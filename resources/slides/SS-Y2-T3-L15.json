 "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 أَسَدُ الْبِحارِ · الْبوصَلَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L15/portrait.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "شِهابُ الدّينِ أَحْمَدُ بْنُ ماجِدٍ مِنْ أَهالي (جِلْفارَ) الَّذينَ اهْتَمّوا بِالْبَحْرِ وَالْبَحّارَةِ، وَقَدْ كانَ دائِمَ الِاسْتِماعِ لِجَدِّهِ الَّذي يَقُصُّ عَلَيْهِ قِصَصَهُ وَمُغامَراتِهِ في الْبَحْرِ؛ مِمّا جَعَلَهُ يَنْشَأُ عَلى حُبِّ الْبَحْرِ. نَسَبُهُ وَنَشْأَتُهُ: وُلِدَ في جِلْفارَ مِنْ أُسْرَةٍ كانَ رِجالُها مِنْ أَشْهَرِ رَبابِنَةِ الْبَحْرِ، تَعَلَّمَ في طُفولَتِهِ الْقِراءَةَ وَالْكِتابَةَ، وَحَفِظَ الْقُرْآنَ الْكَريمَ. عِلْمُهُ: نَهَلَ مِنَ الْعِلْمِ مِنْ خِلالِ التَّنَقُّلِ وَالتَّرْحالِ في الْعَديدِ مِنَ الْمُدُنِ، وَكانَ يَقْرَأُ كُتُبَ الْجُغْرافْيا وَالْفَلَكِ وَالشِّعْرِ وَالْأَدَبِ، وَيُدَوِّنُ مُلاحَظاتِهِ عَلَيْها.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "رِحْلاتُهُ وَصِفاتُهُ: عُرِفَ بِأَسَدِ الْبِحارِ، وَهُوَ مِنْ أَعْظَمِ شَخْصِيّاتِ مِنْطَقَةِ الْإِماراتِ قَديمًا. كانَ يُصاحِبُ والِدَهُ في رِحْلاتِهِ الْبَحْرِيَّةِ وَهُوَ في سِنِّ الْعاشِرَةِ، وَقادَ تَحْتَ إِشْرافِ والِدِهِ أَوَّلَ رِحْلَةٍ وَهُوَ في سِنِّ السّابِعَةَ عَشْرَةَ، كانَ يَتَمَيَّزُ بِصِفاتٍ عَرَبِيَّةٍ أَصيلَةٍ، مِثْلِ: الشَّهامَةِ، الذَّكاءِ، النَّجْدَةِ. إِنْجازاتُهُ: بَرَعَ في عُلومِ الْبِحارِ، فَطَوَّرَ الْبوصَلَةَ، وَوَضَعَ عَلَيْها إِبْرَةً مِغْناطيسِيَّةً، وَأَلَّفَ كِتابَ (الْفَوائِدُ في عِلْمِ الْبَحْرِ وَالْقَواعِدِ).", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 لِماذا أَحَبَّ ابْنُ ماجِدٍ الْبَحْرَ؟ وَما أَبْرَزُ إِنْجازاتِهِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "سيرَةُ أَسَدِ الْبِحارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 أَسَدُ الْبِحارِ · الْبوصَلَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "1 النَّشْأَةُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "جِلْفارُ · حَفِظَ الْقُرْآنَ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "2 الْعِلْمُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 650, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الْجُغْرافْيا وَالْفَلَكُ وَالْأَدَبُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 344, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "3 الرِّحْلاتُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 344, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "أَوَّلُ رِحْلَةٍ في 17", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "7C3AED", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "4 الْإِنْجازاتُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الْبوصَلَةُ وَكِتابُ الْفَوائِدِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أَسْتَنْتِجُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "الْبوصَلَةُ بِإِبْرَتِها الْمِغْناطيسِيَّةِ تُشيرُ دائِمًا إِلى الشَّمالِ ← فَيَعْرِفُ الْبَحّارُ طَريقَهُ في الْبَحْرِ\nحَتّى في اللَّيْلِ وَالْغُيومِ… لِذٰلِكَ أَفادَتِ الْبَحّارَةَ إِلى الْيَوْمِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ تاريخِيَّةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "(أَدْميرال) مُشْتَقَّةٌ مِنَ الْمُصْطَلَحِ أَميرِ الْبَحْرِ، وَتَعْني قائِدًا بَحْرِيًّا.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "سيرَتي الذّاتِيَّةُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 أَسَدُ الْبِحارِ · الْبوصَلَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g2/SS-Y2-T3-L15/study.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g2/SS-Y2-T3-L15/book.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 نُكْمِلُ سيرَةَ ابْنِ ماجِدٍ: وُلِدْتُ في مَدينَةِ… · اطَّلَعْتُ عَلى كُتُبِ… · مِنْ صِفاتي… · أَوَّلُ رِحْلَةٍ في سِنِّ…", "size": 27, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 94–97: أُكْمِلُ «سيرَتي الذّاتِيَّةَ»، وَأَسْتَعينُ بِالْكَلِماتِ (الْبوصَلَةُ - الْمُحيطُ - رَأْسُ الْخَيْمَةِ - الْكِتابَةُ)، وَأُصَنِّفُ الصُّوَرَ.", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[الممارسة الموجّهة: «نطبّق معًا»] اعرض الصورتين، وعُدّوا معًا. ثم نفّذوا نشاط الكتاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚦 إشارة الانطلاق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مِنْ أَبْرَزِ إِنْجازاتِ ابْنِ ماجِدٍ:", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 أَسَدُ الْبِحارِ · الْبوصَلَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 701, "y": 160, "w": 490, "h": 294, "src": "resources/ss/g2/SS-Y2-T3-L15/book.webp", "rad": true}, {"k": "text", "x": 650, "y": 454, "w": 592, "h": 58, "text": "(أ)", "size": 36, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "pic", "x": 90, "y": 160, "w": 490, "h": 294, "src"