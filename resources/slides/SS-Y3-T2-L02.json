َنوبُ وَالشَّرْقُ وَالْغَرْبُ، وَلٰكِنَّ مَعْرِفَتي رُبَّما لا تَكْفي لِتَحْديدِ الْمَواقِعِ بِدِقَّةٍ؛ أَنْظُرُ مَعي إِلى هٰذا الشَّكْلِ وَأَتَعَرَّفُ عَلى الْجِهاتِ الْأَصْلِيَّةِ وَالْفَرْعِيَّةِ. هٰذِهِ الْكُرَةُ تَقَعُ بَيْنَ الشَّمالِ وَالشَّرْقِ، تُسَمّى هٰذِهِ الْجِهَةُ الشَّمالَ الشَّرْقِيَّ. وَهٰذِهِ الطّائِرَةُ الْوَرَقِيَّةُ تَقَعُ بَيْنَ الشَّمالِ وَالْغَرْبِ، تُسَمّى هٰذِهِ الْجِهَةُ الشَّمالَ الْغَرْبِيَّ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "هٰذا الْكِتابُ يَقَعُ بَيْنَ الْجَنوبِ وَالشَّرْقِ، تُسَمّى هٰذِهِ الْجِهَةُ الْجَنوبَ الشَّرْقِيَّ. وَهٰذِهِ الدَّرّاجَةُ تَقَعُ بَيْنَ الْجَنوبِ وَالْغَرْبِ، تُسَمّى هٰذِهِ الْجِهَةُ الْجَنوبَ الْغَرْبِيَّ. حَقيقَةٌ جُغْرافِيَّةٌ: الْجِهَةُ الَّتي تَقَعُ بَيْنَ جِهَتَيْنِ أَصْلِيَّتَيْنِ تُسَمّى الْجِهاتِ الْفَرْعِيَّةَ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 أَيْنَ تَقَعُ الْكُرَةُ؟ وَالدَّرّاجَةُ؟ وَماذا نُسَمّي الْجِهَةَ بَيْنَ جِهَتَيْنِ أَصْلِيَّتَيْنِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْجِهاتُ الْفَرْعِيَّةُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", 