lse, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "✈️", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "الطّائِرَةُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "وَسيلَةُ نَقْلٍ حَديثَةٌ لِلْوُصولِ إِلى الْأَماكِنِ الْبَعيدَةِ في وَقْتٍ قَصيرٍ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «الطّائِرَةُ أَسْرَعُ مِنَ … لِأَنَّ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 السَّفَرُ · الطّائِرَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L16/family.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "مَرْيَمُ: ماذا تَفْعَلُ يا أَبي؟ الْأَبُ: أُجَهِّزُ أَمْتِعَتي لِلسَّفَرِ يا بِنْتي. مَرْيَمُ: وَماذا يَعْني السَّفَرُ يا والِدي؟ الْأَبُ: انْتِقالُ الْأَشْخاصِ مِنْ بَلَدٍ إِلى بَلَدٍ آخَرَ بِوَسائِلَ مُتَعَدِّدَةٍ مِثْلِ الطّائِرَةِ. راشِدٌ: أَبي هَلْ هٰذِهِ وَسيلَةٌ قَديمَةٌ؟ الْأَبُ: لا يا بُنَيَّ، فَالطّائِرَةُ وَسيلَةُ نَقْلٍ حَديثَةٌ لِلْوُصولِ إِلى الْأَماكِنِ الْبَعيدَةِ في وَقْتٍ قَصيرٍ. راشِدٌ: هَلِ الطّائِرَةُ تَنْقُلُ الرُّكّابَ فَقَطْ؟ الْأَبُ: الطّائِراتُ الْحَديثَةُ تَنْقَسِمُ إِلى عِدَّةِ أَنْواعٍ: طائِراتٌ لِنَقْلِ الْأَشْخاصِ، وَطائِراتٌ لِنَقْلِ الْبَضائِعِ التِّجارِيَّةِ، وَطائِراتٌ عَسْكَرِيَّةٌ، وَطائِراتٌ لِأَغْراضٍ شَخْصِيَّةٍ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "مَرْيَمُ: إِذَنْ لِلطّائِراتِ أَهَمِّيَّةٌ كُبْرى يا والِدي فَهِيَ: تَنْقُلُ الْأَشْخاصَ، وَأَمْتِعَتَهُمْ. تَصِلُ إِلى أَماكِنَ بَعيدَةٍ. تَخْتَصِرُ الْمَسافَةَ في وَقْتٍ قَصيرٍ. الْأَبُ: نَعَمْ يا مَرْيَمُ كَذٰلِكَ لَها أَهَمِّيَّةٌ كَبيرَةٌ في التِّجارَةِ، وَالسِّياحَةِ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما السَّفَرُ؟ وَما أَنْواعُ الطّائِراتِ الْحَديثَةِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَنْواعُ الطّائِراتِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 السَّفَرُ · الطّائِرَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🧑‍🤝‍🧑", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "لِنَقْلِ الْأَشْخاصِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "📦", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 650, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "لِنَقْلِ الْبَضائِعِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "64748B", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 344, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🛡️", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 344, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "عَسْكَرِيَّةٌ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🛩️", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "لِأَغْراضٍ شَخْصِيَّةٍ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُقارِنُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "قَديمًا: سافَرَ أَجْدادُنا عَلى الْجِمالِ وَبِالسُّفُنِ الشِّراعِيَّةِ أَيّامًا وَأَشْهُرًا.\nالْيَوْمَ: الطّائِرَةُ تَخْتَصِرُ الْمَسافَةَ فَنَصِلُ إِلى أَبْعَدِ الْبُلْدانِ في ساعاتٍ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ مُذْهِلَةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "تُحَلِّقُ الطّائِرَةُ في الْهَواءِ الَّذي يُسَمّى ريحًا عِنْدَما يَهُبُّ بِقُوَّةٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49