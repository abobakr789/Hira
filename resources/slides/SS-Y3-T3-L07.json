ِ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "عَمَلٌ مُسْتَمِرٌّ لِحِمايَةِ الطُّرُقِ مِنَ الْأَضْرارِ وَإِصْلاحِ الْعُيوبِ فيها", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "⚫", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "الْقارُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "مادَّةٌ لَزِجَةٌ تُسْتَخْرَجُ مِنَ النِّفْطِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «مِنْ أَسْبابِ تَلَفِ الطُّرُقِ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 صِيانَةُ الطُّرُقِ · الْقارُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L07/road2.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "أَحْمَدُ: ماذا يَفْعَلُ الْعُمّالُ في الشّارِعِ؟ الْأَبُ: يَعْمَلونَ عَلى صِيانَةِ الطُّرُقِ. أَحْمَدُ: ماذا تَعْني صِيانَةُ الطُّرُقِ؟ الْأَبُ: هُوَ عَمَلٌ مُسْتَمِرٌّ لِحِمايَةِ الطُّرُقِ مِنَ الْأَضْرارِ وَإِصْلاحِ الْعُيوبِ فيها. خَليفَةُ: وَما الْأَسْبابُ الَّتي تُؤَدّي إِلى تَلَفِ الطُّرُقِ؟ الْأَبُ: الْحُمولَةُ الزّائِدَةُ في الشّاحِناتِ، وَكَثافَةُ الْحَرَكَةِ الْمُرورِيَّةِ، وَارْتِفاعُ دَرَجَةِ الْحَرارَةِ، وَالْأَمْطارُ الْغَزيرَةُ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "خَليفَةُ: ما هِيَ أَعْمالُ الصِّيانَةِ الَّتي يَقومونَ بِها؟ الْأَبُ: يَتِمُّ فَحْصُ الطُّرُقِ وَما تَحْتاجُ إِلَيْهِ مِنْ تَنْظيفِ أَنابيبِ تَصْريفِ مِياهِ الْأَمْطارِ، وَإِصْلاحِ الْحَواجِزِ وَالْإِشاراتِ الْمُرورِيَّةِ، وَتَعْبِئَةِ التَّشَقُّقاتِ بِالْقارِ وَهُوَ مادَّةٌ لَزِجَةٌ تُسْتَخْرَجُ مِنَ النِّفْطِ. خَليفَةُ: وَهَلْ هُوَ مُكَلِّفٌ يا أَبي؟ الْأَبُ: نَعَمْ يا بُنَيَّ، تَرْصُدُ الدَّوْلَةُ ميزانِيَّةً خاصَّةً لِهٰذا الْغَرَضِ، لِأَنَّ الطُّرُقاتِ هِيَ شِرْيانُ الْحَياةِ، كَما أَنَّ الطُّرُقاتِ الْجَميلَةَ وَالنَّظيفَةَ دَليلُ حَضارَةٍ وَتَقَدُّمٍ. خَليفَةُ: أَنا أُحِبُّ بِلادي؛ لِأَنَّها تُوَفِّرُ سُبُلَ الْحَياةِ الْكَريمَةِ لَنا.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما صِيانَةُ الطُّرُقِ؟ وَما أَسْبابُ تَلَفِها؟ وَلِماذا تُخَصِّصُ الدَّوْلَةُ ميزانِيَّةً لَها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[است