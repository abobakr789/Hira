fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 4 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "شَرايينُ الْحَياةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 صِيانَةُ الطُّرُقِ · الْقارُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 883, "y": 160, "w": 358, "h": 333, "src": "resources/ss/g3/SS-Y3-T3-L07/interchange.webp", "rad": true}, {"k": "text", "x": 38, "y": 160, "w": 819, "h": 96, "text": "🛣️ جُسورٌ وَطُرُقٌ مُتَشابِكَةٌ… تَحْمِلُ آلافَ السَّيّاراتِ كُلَّ يَوْمٍ!", "size": 32, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 262, "w": 819, "h": 122, "rv": 1, "text": "ماذا يَحْدُثُ لَوْ لَمْ يَعْتَنِ أَحَدٌ بِهٰذِهِ الطُّرُقِ؟", "size": 32, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 397, "w": 819, "h": 96, "rv": 2, "text": "💬 أُفَكِّرُ وَحْدي ← أُخْبِرُ زَميلي ← نُشارِكُ الصَّفَّ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 518, "w": 1203, "h": 122, "rv": 3, "text": "خِدْماتُ الطُّرُقِ في بِلادي", "size": 36, "color": "B42318", "bold": true, "align": "center", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[التهيئة وإثارة الدافعية] فكّر – زاوج – شارك. لا تكشف الإجابة قبل أن يخمّن الطلاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🎯 وجهتنا اليوم", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"},