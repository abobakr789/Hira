le"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L03/sundiag.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "عَلَيْنا أَنْ نَتَعَلَّمَ الطَّرائِقَ الَّتي تُساعِدُنا لِتَحْديدِ الْجِهاتِ الْأَصْلِيَّةِ لَيْلًا وَنَهارًا. أَوَّلًا الشَّمْسُ: نُحَدِّدُ الْجِهاتِ نَهارًا بِواسِطَةِ الشَّمْسِ الَّتي تُشْرِقُ دائِمًا مِنْ جِهَةِ الشَّرْقِ، وَتَغيبُ مِنْ جِهَةِ الْغَرْبِ. ثانِيًا الْبوصَلَةُ: نُحَدِّدُ الْجِهاتِ لَيْلًا وَنَهارًا بِواسِطَةِ الْبوصَلَةِ وَهِيَ جِهازٌ نَسْتَخْدِمُهُ في السُّفُنِ وَالطّائِراتِ، وَيُشيرُ مُؤَشِّرُ الْبوصَلَةِ دائِمًا إِلى جِهَةِ الشَّمالِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "أَهَمِّيَّةُ مَعْرِفَةِ الْجِهاتِ: تَحْديدُ جِهَةِ الْقِبْلَةِ (هِيَ الْجِهَةُ الَّتي يَتَوَجَّهُ إِلَيْها الْمُسْلِمونَ لِأَداءِ الصَّلاةِ). وَتَعَرُّفُ مَواقِعِ الْأَماكِنِ، مِثْلَ: مَوْقِعِ الْمَكانِ الَّذي نَعيشُ فيهِ، وَمَواقِعِ الْأَماكِنِ الَّتي نَحْتاجُها في حَياتِنا الْيَوْمِيَّةِ (الْمَسْجِدُ - الْمَدْرَسَةُ - الْعِيادَةُ …). وَيُعَدُّ اسْتِقْبالُ الْقِبْلَةِ شَرْطًا مِنْ شُروطِ صِحَّةِ الصَّلاةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الطَّريقَتانِ لِتَحْديدِ الْجِهاتِ؟ وَلِماذا نَحْتاجُ مَعْرِفَةَ الْجِهاتِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173,