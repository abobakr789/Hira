": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 دَوْلَةٌ · الِاتِّحادُ · سَبْعُ إِماراتٍ · عُرْقوبُ السُّدَيْرَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 275, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 665, "y": 168, "w": 561, "h": 51, "rv": 1, "text": "🇦🇪 كَمْ إِمارَةً؟", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 665, "y": 221, "w": 561, "h": 204, "rv": 1, "text": "تَتَكَوَّنُ دَوْلَتُنا مِنْ … إِماراتٍ.", "size": 36, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 160, "w": 592, "h": 275, "rv": 2, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 561, "h": 51, "rv": 2, "text": "🎆 مَتى؟", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 561, "h": 204, "rv": 2, "text": "قامَ الِاتِّحادُ في … دِيسَمْبَرَ 1971م.", "size": 36, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 461, "w": 1203, "h": 166, "rv": 3, "text": "الْيَوْمَ: كَيْفَ قامَ الِاتِّحادُ؟ وَمَنْ بانيهِ؟", "size": 32, "color": "0F6E72", "bold": true, "align": "right", "fill": "E2F0EF", "rad": true, "va": "middle"}], "n": "[استرجاع التعلّم السابق] اسأل شفويًّا، واستمع لثلاث إجابات، ثم اكشف الجملة الأخيرة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "✨ لحظة فضول", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 4 دقائق", 