لِاتِّحادُ في 2 دِيسَمْبَرَ 1971م».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ: زايِدٌ باني الِاتِّحادِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 دَوْلَةٌ · الِاتِّحادُ · سَبْعُ إِماراتٍ · عُرْقوبُ السُّدَيْرَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g1/SS-Y1-T1-L10/zayed.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "في فَجْرِ يَوْمٍ جَميلٍ أَشْرَقَتْ شَمْسُ قَصْرِ الْحِصْنِ في مَدينَةِ أَبوظَبي عَلى ميلادِ طِفْلٍ اسْمُهُ زايِدٌ، عاشَ في كَنَفِ والِدَيْهِ الشَّيْخِ سُلْطانَ آلِ نَهْيانَ وَالشَّيْخَةِ سَلامَةَ بِنْتِ بُطّي. تَعَلَّمَ قِراءَةَ الْقُرْآنِ الْكَريمِ، وَبَدَتْ عَلَيْهِ مُنْذُ صِباهُ عَلاماتُ الذَّكاءِ وَالشَّجاعَةِ. قادَ دَوْلَةَ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ لِلِاتِّحادِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الْوالِدُ: نَحْنُ نَعيشُ لَحَظاتٍ جَميلَةً يا حَمَدُ. حَمَدٌ: ما سَبَبُ هٰذِهِ السَّعادَةِ وَالْفَرْحَةِ يا أَبي؟ الْوالِدُ: إِعْلانُ قِيامِ دَوْلَةِ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ في الثّاني مِنْ دِيسَمْبَرَ عامَ 1971م. حَمَدٌ: نَعَمْ يا والِدي، دَوْلَتُنا دَوْلَةٌ اتِّحادِيَّةٌ، تَضُمُّ سَبْعَ إِماراتٍ جَميلَةٍ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 أَيْنَ وُلِدَ زايِدٌ؟ وَما صِفاتُهُ؟ وَمَتى قامَ الِاتِّحادُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "خُطُواتُ قِيامِ الِاتِّحادِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 دَوْلَةٌ · الِاتِّحادُ · سَبْعُ إِماراتٍ · عُرْقوبُ السُّدَيْرَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "1", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "اجْتِماعُ عُرْقوبِ السُّدَيْرَةِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center",