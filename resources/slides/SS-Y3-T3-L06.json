ِأَمانٍ عِنْدَما …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 جيتِكْس · التِّجارَةُ الْإِلِكْتْرونِيَّةُ · الِاسْتِخْدامُ الْآمِنُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L06/expo.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "الْأَبُ: دَوْلَةُ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ مِنْ أَكْثَرِ دُوَلِ الْعالَمِ اعْتِمادًا عَلى التِّكْنولوجْيا، وَتَحَوُّلًا نَحْوَ اقْتِصادٍ قائِمٍ عَلى الْمَعْرِفَةِ وَالِابْتِكارِ. الْأُمُّ: إِذًا، فَلْنَذْهَبْ لِزِيارَةِ مَعْرِضِ (جيتِكْس) الَّذي يُقامُ في مَرْكَزِ دُبَيَّ التِّجارِيِّ الْعالَمِيِّ. راشِدٌ: ماذا يَعْرِضُ الْمَعْرِضُ يا أُمّي؟ الْأُمُّ: يَعْرِضُ أَحْدَثَ ما تَوَصَّلَتْ إِلَيْهِ التِّكْنولوجْيا في مَجالاتِ الذَّكاءِ الِاصْطِناعِيِّ وَالرّوبوتاتِ وَالْأَجْهِزَةِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "اسْتِخْداماتُ التِّكْنولوجْيا في بِلادي: 1. في مَجالِ التَّعْليمِ: مُبادَرَةُ صاحِبِ السُّمُوِّ الشَّيْخِ مُحَمَّدِ بْنِ راشِدٍ لِلتَّعْليمِ الذَّكِيِّ لِتَوْفيرِ صُفوفٍ ذَكِيَّةٍ مُزَوَّدَةٍ بِسَبّوراتٍ ذَكِيَّةٍ وَأَجْهِزَةٍ لَوْحِيَّةٍ لِلطُّلّابِ. 2. في مَجالِ الِاتِّصالاتِ: تَنْتَشِرُ وَسائِلُ التَّواصُلِ بِالْمُكالَماتِ الْهاتِفِيَّةِ وَالْبَريدِ الْإِلِكْتْرونِيِّ. 3. التِّجارَةُ الْإِلِكْتْرونِيَّةُ: الْقِيامُ بِعَمَلِيّاتِ الْبَيْعِ وَالشِّراءِ عَبْرَ مَواقِعِ الْبَيْعِ الْإِلِكْتْرونِيِّ. 4. مُبادَرَةُ الْحُكومَةِ الذَّكِيَّةِ: مِنْ أَجْلِ تَوْفيرِ خِدْماتٍ حُكومِيَّةٍ بِمُواصَفاتٍ عالَمِيَّةٍ. 5. في مَجالِ الصِّناعَةِ: اسْتِخْدامُ الْحاسوبِ في تَصْميمِ السَّيّاراتِ وَالطّائِراتِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما جيتِكْس؟ وَما مَجالاتُ اسْتِخْدامِ التِّكْنولوجْيا في بِلادي؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَسْتَخْدِمُ التِّكْنولوجْيا بِأَمانٍ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 جيتِكْس · التِّجارَةُ الْإِلِكْتْرونِيَّةُ · الِاسْتِخْدامُ الْآمِنُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 16