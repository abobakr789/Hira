 "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 قِطارُ الِاتِّحادِ · السِّكَكُ الْحَديدِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L08/highway.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "اهْتَمَّتِ الْحُكومَةُ في دَوْلَةِ الْإِماراتِ مُنْذُ قِيامِ الِاتِّحادِ بِتَطْويرِ شَبَكاتِ الطُّرُقِ عَلى مُسْتَوى مَناطِقِ الدَّوْلَةِ جَميعِها، وَلَقَدْ خَصَّصَتِ الْحُكومَةُ مِلْياراتِ الدَّراهِمِ في سَبيلِ الْحُصولِ عَلى طُرُقٍ آمِنَةٍ تَخْتَصِرُ الْمَسافاتِ بَيْنَ الْمُدُنِ وَالْقُرى، وَالْيَوْمَ تَرْتَبِطُ دَوْلَةُ الْإِماراتِ بِشَبَكَةِ طُرُقٍ بَرِّيَّةٍ حَديثَةٍ مُعَبَّدَةٍ وَمُضاءَةٍ، فيما اتَّجَهَتِ الدَّوْلَةُ لِبِناءِ خُطوطٍ لِلْقِطاراتِ عَلى مُسْتَوى دَوْلَةِ الْإِماراتِ كَكُلٍّ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "قِطارُ الِاتِّحادِ هُوَ شَبَكَةٌ مِنَ السِّكَكِ الْحَديدِيَّةِ تَمْتَدُّ لِمَسافَةِ (1200) كم، تَرْبِطُ مَناطِقَ الدَّوْلَةِ لِنَقْلِ الْبَضائِعِ وَالرُّكّابِ. الْمُنَفِّذُ لِلْمَشْروعِ: شَرِكَةُ الِاتِّحادِ لِلْقِطاراتِ، وَالتَّكْلِفَةُ (40) مِلْيارَ دِرْهَمٍ، وَمِنَ الْمَوادِّ الَّتي يَنْقُلُها: السِّلَعُ وَالصُّخورُ وَالْمَعادِنُ. فَوائِدُهُ: اقْتِصادِيَّةٌ (اخْتِصارُ الْوَقْتِ وَقِلَّةُ التَّكاليفِ وَزِيادَةُ الْإِنْتاجِ)، وَبيئِيَّةٌ (انْخِفاضُ نِسْبَةِ الْغازاتِ الدَّفيئَةِ وَالْحِفاظُ عَلى الطّاقَةِ)، وَاجْتِماعِيَّةٌ (زِيادَةُ عَدَدِ سُكّانِ مِنْطَقَةِ الظَّفْرَةِ وَتَوْفيرُ فُرَصِ عَمَلٍ). حَقيقَةٌ تاريخِيَّةٌ: تَأَسَّسَتْ شَرِكَةُ الِاتِّحادِ لِلْقِطاراتِ عامَ 2009م.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما قِطارُ الِاتِّحادِ؟ كَمْ طولُ شَبَكَتِهِ؟ وَما فَوائِدُهُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "فَوائِدُ قِطارِ الِاتِّحادِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 قِطارُ الِاتِّحادِ · السِّكَكُ الْحَديدِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "EAB308", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "💰 اقْتِصادِيَّةٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "اخْتِصارُ الْوَقْتِ · قِلَّةُ التَّكاليفِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 446, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🌿 بيئِيَّةٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 446, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "غازاتٌ دَفيئَةٌ أَقَلُّ · تَوْفيرُ الطّاقَةِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "👨‍👩‍👧 اجْتِماعِيَّةٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "فُرَصُ عَمَلٍ · تَنْمِيَةُ الظَّفْرَةِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُقارِنُ: الْقِطارُ أَمِ الشّاحِناتُ؟", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "الْقِطارُ يَسْتَخْدِمُ رُبْعَ الْوَقودِ الَّذي تَسْتَخْدِمُهُ الشّاحِناتُ لِنَقْلِ الْكَمِّيَّةِ نَفْسِها ← تَلَوُّثٌ أَقَلُّ\n← شاحِناتٌ أَقَلُّ عَلى الطُّرُقِ ← حَوادِثُ أَقَلُّ وَتَلَفٌ أَقَلُّ لِلطُّرُقِ (رَبْطًا بِالْحِصَّةِ السّابِقَةِ).", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ عِلْمِيَّةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "تَمْتَدُّ الْمَرْحَلَةُ الْأولى إِلى (264) كيلوم