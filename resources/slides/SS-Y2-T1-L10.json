l, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «كانَ الْأَطْفالُ قَديمًا يَلْعَبونَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُجْتَمَعُ · السَّنْعُ · الْغُمَيْضَةُ · الْمُريحانَةُ · الصَّقْلَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T1-L10/grandma.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "مَرْيَمُ: حَدِّثيني يا جَدَّتي عَنْ حَياتِكُمْ في الْماضي. الْجَدَّةُ: كانَتْ حَياتُنا بَسيطَةً يا بُنَيَّتي، وَكُنّا وَجَميعُ أَفْرادِ الْأُسْرَةِ نَتَعاوَنُ مَعًا لِإِنْجازِ الْأَعْمالِ. مَرْيَمُ: ماذا كُنْتِ تَعْمَلينَ يا جَدَّتي؟ الْجَدَّةُ: كُنْتُ أَقومُ بِرِعايَةِ أَبْنائي وَتَرْبِيَتِهِمْ، وَأَقُصُّ عَلَيْهِمْ أَجْمَلَ الْقِصَصِ. مَرْيَمُ: وَماذا كانَ يَعْمَلُ جَدّي؟ الْجَدَّةُ: كانَ يَذْهَبُ أَشْهُرًا عَديدَةً لِلْغَوْصِ عَلى اللُّؤْلُؤِ، فَأَقومُ بِجَميعِ أَعْمالِ الْمَنْزِلِ بِمُساعَدَةِ أَبْنائي وَالْجيرانِ حَتّى يَعودَ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "وَمُنْذُ الْقِدَمِ تَمَيَّزَ مُجْتَمَعُ الْإِماراتِ بِالتَّلاحُمِ وَالتَّرابُطِ بَيْنَ أَبْنائِهِ. مَرْيَمُ: وَكَيْفَ كانَ الْأَطْفالُ يَقْضونَ أَوْقاتَهُمْ في الْماضي؟ الْجَدَّةُ: كانَ الْأَطْفالُ مِنَ الْبَناتِ وَالْبَنينَ يَقْضونَ أَوْقاتَ فَراغِهِمْ في أَلْعابٍ مُخْتَلِفَةٍ، مِثْلِ (الصَّقْلَةِ وَالْغُمَيْضَةِ وَالْمُريحانَةِ). مَرْيَمُ: الْحَمْدُ لِلّٰهِ الَّذي أَنْعَمَ عَلَيْنا بِنِعْمَةِ الِاتِّحادِ، وَقِيادَةِ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - لِتُصْبِحَ دَوْلَةُ الْإِماراتِ دَوْلَةً مُتَقَدِّمَةً.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا كانَتْ تَعْمَلُ الْجَدَّةُ؟ وَماذا كانَ يَلْعَبُ الْأَطْفالُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الْماضي وَالْحاضِرُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمُجْتَمَعُ · السَّنْعُ · الْغُمَيْضَةُ · الْمُريحانَةُ · الصَّقْلَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "👵 أَعْمالُ الْمَرْأَةِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الْخوصُ · التَّلّي", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "0EA5E9", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🦪 أَعْمالُ الرَّجُلِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 650, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الْغَوْصُ عَلى اللُّؤْلُؤِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 344, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🙈 أَلْعابُ الْأَطْفالِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 344, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الصَّقْلَةُ · الْغُمَيْضَةُ · الْمُريحانَةُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "7C3AED", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🤝 الْمُجْتَمَعُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "التَّلاحُمُ وَالتَّرابُطُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُقارِنُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "قَديمًا: يَغيبُ الْأَبُ لِلْغَوْصِ فَيَتَعاوَنُ الْجيرانُ وَالْأَبْناءُ في أَعْمالِ الْبَيْتِ.\nالْيَوْمَ: الْحَياةُ أَسْهَلُ بِفَضْلِ اللهِ ثُمَّ الِاتِّحادِ… وَيَبْقى التَّعاوُنُ مِنْ سَنْعِنا.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 لَهْجَتُنا الْمَحَلِّيَّةُ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "السَّنْعُ: كَلِمَةٌ إِماراتِيَّةٌ مَحَلِّيَّةٌ يُقْصَدُ بِها السُّلوكُ وَالْآدابُ الَّتي يَجِبُ الِالْتِزامُ بِها في حَياتِنا.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A