"x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "تَحَمُّلُ الْفَرْدِ كُلَّ ما يَصْدُرُ عَنْهُ مِنْ تَصَرُّفاتٍ وَأَفْعالٍ وَالْقِيامُ بِواجِباتِهِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «أَتَحَمَّلُ مَسْؤولِيَّتي عِنْدَما …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَسْؤولِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L11/bus.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "قَرَّرَتْ إِدارَةُ الْمَدْرَسَةِ تَنْظيمَ رِحْلَةٍ إِلى مُتْحَفِ دُبَيَّ لِلصَّفِّ الثّالِثِ، وَفي الْيَوْمِ الْمُحَدَّدِ رَكِبَ الطَّلَبَةُ الْحافِلَةَ في الصَّباحِ الْباكِرِ وَقَضَوْا ساعَةً في الطَّريقِ حَتّى وَصَلوا إِلى الْمُتْحَفِ، حَيْثُ اسْتَمْتَعوا بِالْآثارِ الْمُتَنَوِّعَةِ وَالتُّراثِ الْأَصيلِ، وَتَعَرَّفوا مَعْلوماتٍ كَثيرَةً عَنْ ماضي دَوْلَةِ الْإِماراتِ وَرَجَعوا في نِهايَةِ الرِّحْلَةِ مَسْرورينَ، وَلٰكِنَّ مُشْرِفي الرِّحْلَةِ أَبْدَوُا اسْتِياءَهُمْ مِنْ تَصَرُّفِ بَعْضِ الطَّلَبَةِ في الْحافِلَةِ، حَيْثُ لَمْ يَتَحَمَّلوا مَسْؤولِيَّةَ نَظافَةِ الْحافِلَةِ وَأَلْقَوْا بِالْمُهْمَلاتِ في كُلِّ مَكانٍ. أَبْدى هٰؤُلاءِ الطَّلَبَةُ نَدَمَهُمْ عَلى هٰذا التَّصَرُّفِ وَبادَروا إِلى تَنْظيفِ الْحافِلَةِ، وَتَجْميعِ الْقُمامَةِ، وَوَعَدوا الْمُشْرِفينَ بِعَدَمِ تَكْرارِ التَّصَرُّفِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "أَنْواعُ الْمَسْؤولِيَّةِ: 1- الدّينِيَّةُ: أَداءُ الْعِباداتِ كَالصَّلاةِ وَالصَّوْمِ. 2- الِاجْتِماعِيَّةُ: الِالْتِزامُ بِقَوانينِ مُجْتَمَعِنا، وَتَقاليدِنا الْأَصيلَةِ. 3- الْأَخْلاقِيَّةُ: تَحَمُّلُ الْفَرْدِ كُلَّ ما يَصْدُرُ عَنْهُ مِنْ تَصَرُّفاتٍ وَأَفْعالٍ. وَتُقَدِّمُ الدَّوْلَةُ لِلْفَرْدِ: الصِّحَّةَ وَالتَّعْليمَ وَالْأَمْنَ، وَيُقَدِّمُ الْفَرْدُ لِأُسْرَتِهِ: الرِّعايَةَ وَالتَّرْبِيَةَ، وَالْمَسْكَنَ، وَالْغِذاءَ وَالْمَلابِسَ. حَقيقَةٌ: الْحافِلاتُ مُمْتَلَكاتٌ عامَّةٌ تُوَفِّرُها الدَّوْلَةُ لِلسُّكّانِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْخَطَأُ الَّذي ارْتَكَبَهُ بَعْضُ الطُّلّابِ؟ وَكَيْفَ أَصْلَحوهُ؟ وَما أَنْواعُ الْمَسْؤولِيَّةِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "mi