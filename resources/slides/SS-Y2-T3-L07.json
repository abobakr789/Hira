", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمِنْشارُ · الْمَنْدوسُ · الصِّناعَةُ · الْمادَّةُ الْخامُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L07/boat.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "أَبي نَجّارٌ ماهِرٌ.. يَصْنَعُ السُّفُنَ الْبَحْرِيَّةَ. جَلَسَ أَبي أَمامَ قِطْعَةٍ كَبيرَةٍ مِنَ الْخَشَبِ.. يَحْمِلُ بِيَدِهِ الْمِنْشارَ (أَداةٌ تُسْتَخْدَمُ لِقَطْعِ الْخَشَبِ). ماذا يَصْنَعُ أَبي؟ يَسْتَخْدِمُ أَبي الْمَساميرَ وَالْمِطْرَقَةَ.. هَلْ يَصْنَعُ قارِبًا؟ لا.. الْقارِبُ كَبيرٌ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "يَطْرُقُ.. يَطْرُقُ بِالْمِطْرَقَةِ.. هَلْ يَصْنَعُ مَنْدوسًا (صُنْدوقٌ مِنَ الْخَشَبِ)؟ لا.. الْمَنْدوسُ عَلَيْهِ نُقوشٌ. يَنْشُرُ وَيَنْشُرُ بِالْمِنْشارِ.. هَلْ يَصْنَعُ أَبي سَريرًا؟ لا.. السَّريرُ لَهُ أَرْجُلٌ.. ماذا يَصْنَعُ أَبي؟ آه.. أَبي يَصْنَعُ لي سَيّارَةً صَغيرَةً مِنَ الْخَشَبِ؛ لِأَلْعَبَ بِها.. شُكْرًا لَكَ يا أَبي.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا صَنَعَ الْأَبُ في النِّهايَةِ؟ وَما الْمادَّةُ الْخامُ الَّتي اسْتَخْدَمَها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتا