o": "〰️", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "دَوائِرُ الْعَرْضِ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "خُطوطٌ وَهْمِيَّةٌ تُرْسَمُ عَلى نَموذَجِ الْكُرَةِ الْأَرْضِيَّةِ وَتَبْدو عَلى شَكْلِ دَوائِرَ تامَّةِ الِاسْتِدارَةِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "🟥", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "خَطُّ الِاسْتِواءِ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "دائِرَةُ الْعَرْضِ الرَّئيسَةُ (الصِّفْرُ) تُقَسِّمُ الْعالَمَ إِلى نِصْفَيْنِ شَمالِيٍّ وَجَنوبِيٍّ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «يَقَعُ مَدارُ السَّرَطانِ عِنْدَ دائِرَةِ عَرْضِ … شَمالًا».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ: الْجُزْءُ الثّالِثُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 دَوائِرُ الْعَرْضِ · خَطُّ الِاسْتِواءِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g4/SS-Y4-T1-L03/latglobe.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "مَنْصورٌ: وَلٰكِنْ هُناكَ خُطوطٌ أُخْرى عَرْضِيَّةٌ مُتَوازِيَةٌ. ما هِيَ يا تُرى؟ الْمُعَلِّمُ: نَعَمْ يا صَغيري إِنَّها دَوائِرُ الْعَرْضِ. وَهِيَ عِبارَةٌ عَنْ خُطوطٍ وَهْمِيَّةٍ تُرْسَمُ عَلى نَموذَجِ الْكُرَةِ الْأَرْضِيَّةِ وَتَبْدو عَلى شَكْلِ دَوائِرَ تامَّةِ الِاسْتِدارَةِ. لاحِظْ يا بُنَيَّ في الْوَسَطِ عِنْدَ الصِّفْرِ (خَطَّ الِاسْتِواءِ) وَهُوَ دائِرَةُ الْعَرْضِ الرَّئيسَةُ، وَتُقَسِّمُ الْعالَمَ إِلى نِصْفَيْنِ مُتَساوِيَيْنِ (شَمالِيٍّ وَجَنوبِيٍّ)، في شَمالِ خَطِّ الِاسْتِواءِ عِنْدَ دائِرَةِ عَرْضِ (23.5°) شَمالًا (مَدارُ السَّرَطانِ) وَجَنوبَها (مَدارُ الْجَدْيِ) عِنْدَ دائِرَةِ عَرْضِ (23.5°) جَنوبًا، وَهُناكَ (قُطْبانِ) شَمالِيٌّ وَجَنوبِيٌّ عِنْدَ دائِرَتَيْ عَرْضِ (90°) شَمالًا وَجَنوبًا.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "مَنْصورٌ: سُبْحانَ الْخالِقِ فَخَطُّ الِاسْتِواءِ يُقَسِّمُ الْكُرَةَ الْأَرْضِيَّةَ إِلى قِسْمَيْنِ مُتَساوِيَيْنِ شَمالِيٍّ وَجَنوبِيٍّ. وَما هِيَ أَهَمِّيَّةُ دَوائِرِ الْعَرْضِ الْجَميلَةِ؟ الْمُعَلِّمُ: مِنْ خِلالِها يا بُنَيَّ نَسْتَطيعُ أَنْ نُحَدِّدَ مَواقِعَ الدُّوَلِ وَالْمَناطِقِ الْمُخْتَلِفَةِ، وَنَتَعَرَّفُ عَلى الْمُناخِ وَالنَّباتِ الطَّبيعِيِّ. مَنْصورٌ: مُعَلِّمي، وَلٰكِنَّني لا أَرى هٰذِهِ الْخُطوطَ مِنَ النّافِذَةِ!! أَيْنَ ذَهَبَتْ؟! الْمُعَلِّمُ: إِنَّها خُطوطٌ وَهْمِيَّةٌ تُرْسَمُ فَقَطْ عَلى الْخَرائِطِ. مَنْصورٌ: مُعَلِّمي إِنَّكَ إِنْسانٌ رائِعٌ، أَنَرْتَ بَصيرَتي بِكُلِّ ما هُوَ مُفيدٌ وَمُمْتِعٌ، فَلَكَ شُكْري وَتَقْديري. وَيَرِنُّ جَرَسُ الْمُنَبِّهِ مُعْلِنًا نِهايَةَ حُلْمٍ جَميلٍ في فَضاءِ عالَمِنا الْواسِعِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما دَوائِرُ الْعَرْضِ؟ أَيْنَ يَقَعُ مَدارُ السَّرَطانِ؟ وَما أَهَمِّيَّةُ دَوائِرِ الْعَرْضِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "خُطوطُ الطّولِ وَدَوائِرُ الْعَرْضِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 دَوائِرُ الْعَرْضِ · خَطُّ الِاسْتِواءِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🌐 خُطوطُ الطّولِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "أَنْصافُ دَوائ