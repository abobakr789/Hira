كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْعَدَساتُ · الْبُحوثُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L15/eye.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "لِلْحَسَنِ بْنِ الْهَيْثَمِ الْكَثيرُ مِنَ الدِّراساتِ في الْمَجالاتِ الْمُخْتَلِفَةِ، وَمِنْها: أَوَّلُ مَنْ شَرَحَ الْعَيْنَ وَبَيَّنَ أَعْضاءَها وَوَظائِفَها. اهْتَمَّ بِالْفَلَكِ وَبَيَّنَ أَنَّ الْقَمَرَ يَعْكِسُ ضَوْءَ الشَّمْسِ مِنْ جَميعِ النِّقاطِ عَلى سَطْحِهِ. وَضَعَ بُحوثًا قَيِّمَةً في مَسْأَلَةِ تَكْبيرِ الْعَدَساتِ. حَقيقَةٌ عِلْمِيَّةٌ: يَرى الْإِنْسانُ الضَّوْءَ الْمُنْبَعِثَ مِنَ الْقَمَرِ بَعْدَ انْبِعاثِهِ بِحَوالَيْ ثانِيَةٍ واحِدَةٍ وَثُلُثِ الثّانِيَةِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "أَثَرُهُ الْعِلْمِيُّ: 1. ساعَدَتْ أَعْمالُ ابْنِ الْهَيْثَمِ عُلَماءَ آخَرينَ عَلى تَطْويرِ اخْتِراعاتٍ حَديثَةٍ مِنْ مِثْلِ: النَّظّاراتِ الطِّبِّيَّةِ وَ(التِّلِسْكوبِ) وَأَجْهِزَةِ عَرْضِ الْأَفْلامِ. 2. ابْتَكَرَ (الْكاميرا) وَأَسْماها الْبَيْتَ الْمُظْلِمَ. 3. تَعَلَّمَ عَلى أَفْكارِهِ كَثيرٌ مِنَ الْعُلَماءِ الْمَعْروفينَ، كَما يَذْكُرُ الْكِتابُ أَنَّ إِسْحاقَ نْيوتُنَ دَرَسَ أَفْكارَهُ قَبْلَ أَنْ يَتَوَصَّلَ إِلى أَفْكارٍ جَديدَةٍ عَنْ كَيْفِيَّةِ عَمَلِ الْجاذِبِيَّةِ الْأَرْضِيَّةِ. وَمِنْ سَنْعِ بِلادي: (اللّي ما عِنْدَهْ عَمَلْ يِكاري لَهْ جَمَلْ) مَثَلٌ يَدْعو إِلى الْعَمَلِ. وَأَوَّلُ صورَةٍ عَرَفَها الْعالَمُ الْتُقِطَتْ في فَرَنْسا عامَ 1827م.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما إِنْجازاتُ ابْنِ الْهَيْثَمِ؟ وَما الِاخْتِراعاتُ الَّتي ساعَدَتْ أَعْمالُهُ في تَطْويرِها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مِنِ ابْنِ الْهَيْثَمِ إِلى عالَمِنا", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْعَدَساتُ · الْبُحوثُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "👓 النَّظّاراتُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y"