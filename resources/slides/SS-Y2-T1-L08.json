": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 358, "h": 255, "rv": 3, "text": "أُلَوِّنُ الْمَظاهِرَ عَلى الْخَريطَةِ بِمِفْتاحٍ.\nأُفَسِّرُ: لِماذا تَكْثُرُ الْمُدُنُ عَلى السُّهولِ؟", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 502, "w": 1203, "h": 141, "rv": 4, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 509, "w": 1172, "h": 51, "rv": 4, "text": "🏆 تَحَدٍّ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 563, "w": 1172, "h": 69, "rv": 4, "text": "🎤 «مُجَسَّمُ بِلادي»: نَصْنَعُ بِالرَّمْلِ وَالصَّلْصالِ جَبَلًا وَسَهْلًا وَصَحْراءَ وَواحَةً عَلى لَوْحٍ واحِدٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[الأنشطة المتمايزة: «أطبّق بنفسي»] وزّع الأوراق الثلاث وورقة أصحاب الهمم. الهدف واحد والمهمة تختلف."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🌱 قيمة نعيشها", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 4 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الصَّبْرُ مِنَ الصَّحْراءِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 السُّهولُ السّاحِلِيَّةُ · الْجِبالُ · الصَّحْراءُ · الْواحَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 282, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 665, "y": 168, "w": 561, "h": 51, "rv": 1, "text": "🇦🇪 مِنْ سَنْعِ بِلادي أَتَعَلَّمُ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 665, "y": 221, "w": 561, "h": 210, "rv": 1, "text": "الْباني الْمُؤَسِّسُ: «عَلَّمَتْنا الصَّحْراءُ أَنْ نَصْبِرَ طَويلًا حَتّى يَنْبُتَ الْخَيْرُ».\nبِلادي جَميلَةٌ بِتَنَوُّعِ تَضاريسِها.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 160, "w": 592, "h": 282, "rv": 2, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 561, "h": 51, "rv": 2, "text": "🏠 حَقيقَةٌ وَطَنِيَّةٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 561, "h": 210, "rv": 2, "text": "الْجَبَلُ أَعْلى أَشْكالِ الْيابِسَةِ، وَأَشْهَرُ قِمَمِ\nبِلادي جَبَلُ جَيْسٍ وَجَبَلُ حَفيتٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 457, "w": 1203, "h": 186, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 465, "w": 1172, "h": 51, "rv": 3, "text": "🤔 ماذا أَفْعَلُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 518, "w": 1172, "h": 114, "rv": 3, "text": "في رِحْلَةٍ إِلى الْجَبَلِ، أَرادَ زَميلي أَنْ يَصْعَدَ وَحْدَهُ بَعيدًا عَنِ الْمَجْموعَةِ… ماذا أَقولُ؟", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[القيمة والسلوك والهوية] ناقش المعضلة: ماذا تفعل؟ ولماذا؟ اربطها بالسَّنع."}, {"bg": "FBF6EC", "els":