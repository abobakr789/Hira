"color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمِهْنَةُ · اللِّيخُ · الْميدارُ · الْغَوْصُ عَلى اللُّؤْلُؤِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g1/SS-Y1-T2-L04/fish.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "حَمَدٌ: مِنْ أَيْنَ لَكَ هٰذا السَّمَكُ يا والِدي؟ الْوالِدُ: مِنَ الْبَحْرِ يا بُنَيَّ. حَمَدٌ: وَكَيْفَ أَحْضَرْتَهُ؟ الْوالِدُ: عَنْ طَريقِ الصَّيْدِ. يُعْتَبَرُ صَيْدُ السَّمَكِ يا وَلَدي مِهْنَتي وَمِهْنَةَ أَجْدادي فَهِيَ مِهْنَةٌ قَديمَةٌ جِدًّا، يَعْتَمِدُ عَلَيْها النّاسُ في غِذائِهِمْ وَرِزْقِهِمْ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "وَمِنْ أَدَواتِ الصَّيْدِ الَّتي كانوا يَسْتَخْدِمونَها قَديمًا اللِّيخُ، وَيُسَمّى في وَقْتِنا الْحاضِرِ (شِباكَ الصَّيْدِ)، وَالْقَرْقورُ، وَالْميدارُ وَيُسَمّى الْيَوْمَ (بِالسِّنّارَةِ). كانَتْ رِحْلَةُ الْغَوْصِ عَلى اللُّؤْلُؤِ تَسْتَغْرِقُ وَقْتًا طَويلًا، يَصِلُ إِلى سِتَّةِ أَشْهُرٍ، وَقَدْ يَتَعَرَّضُ الْغَوّاصُ لِأَخْطارٍ كَثيرَةٍ، فَالْحَمْدُ لِلّٰهِ عَلى النِّعَمِ.", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما أَدَواتُ الصَّيْدِ قَديمًا؟ وَكَمْ كانَتْ تَسْتَغْرِقُ رِحْلَةُ الْغَوْصِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "قَديمًا وَحَديثًا", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمِهْنَةُ · اللِّيخُ · الْميدارُ · الْغَوْصُ عَلى اللُّؤْلُؤِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🕸️ اللِّيخُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "= شِباكُ الصَّيْدِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv"