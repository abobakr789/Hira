, "oval": false, "lw": 2}, {"k": "text", "x": 665, "y": 168, "w": 561, "h": 51, "rv": 1, "text": "🇦🇪 مِنْ سَنْعِ بِلادي أَتَعَلَّمُ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 665, "y": 221, "w": 561, "h": 210, "rv": 1, "text": "أُحافِظُ عَلى مُمْتَلَكاتِ أُسْرَتي.\nأُرَتِّبُ غُرْفَتي، وَأُحافِظُ عَلى نَظافَتِها.\nلا أَكْذِبُ، وَلا أُخْفي خَطَأً ارْتَكَبْتُهُ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 160, "w": 592, "h": 282, "rv": 2, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 561, "h": 51, "rv": 2, "text": "🏠 حَقيقَةٌ وَطَنِيَّةٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 561, "h": 210, "rv": 2, "text": "الْحُقوقُ: كُلُّ ما يُقَدِّمُهُ لي وَطَني\nمِنْ تَعْليمٍ، وَصِحَّةٍ، وَسَكَنٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 457, "w": 1203, "h": 186, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 465, "w": 1172, "h": 51, "rv": 3, "text": "🤔 ماذا أَفْعَلُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 518, "w": 1172, "h": 114, "rv": 3, "text": "كَسَرْتُ كوبًا في الْمَطْبَخِ، وَلَمْ يَرَني أَحَدٌ… ماذا أَفْعَلُ؟", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[القيمة والسلوك والهوية] ناقش المعضلة: ماذا تفعل؟ ولماذا؟ اربطها بالسَّنع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🎟️ تذكرة الخروج", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "