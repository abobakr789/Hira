", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ: ما واجِباتي؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 واجِباتي · الاحْتِرامُ · التَّعاوُنُ · جَدّي وَجَدَّتي", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g1/SS-Y1-T1-L02/grandparents.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "واجِباتي: هِيَ ما يَجِبُ أَنْ أَقومَ بِهِ نَحْوَ أُسْرَتي. واجِباتي تِجاهَ والِدَيَّ الاحْتِرامُ وَالسَّعْيُ لِإِرْضائِهِما؛ لِأَنَّهُما رَبَّياني صَغيرًا. لا أَرْفَعُ صَوْتي أَمامَهُما، وَلا أُقاطِعُهُما أَثْناءَ الْحَديثِ، بَلْ أَدْعو لَهُما، وَأُقَدِّمُ لَهُما الْمُساعَدَةَ إِذا طَلَبا مِنّي ذٰلِكَ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "أَتَعاوَنُ مَعَ إِخْوَتي وَأَخَواتي بِمَوَدَّةٍ وَأَتَجَنَّبُ الْمُشاجَرَةَ مَعَهُمْ. الْجُلوسُ مَعَ جَدّي وَجَدَّتي يُعَلِّمُني الْكَثيرَ لِأَسْتَفيدَ مِنْهُ في حَياتي.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va