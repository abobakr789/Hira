ue, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 10 دقائق", "size": 22, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 70, "text": "مهام المجموعات", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 180, "y": 664, "w": 1061, "h": 44, "text": "🎯 الاستماع · القراءة · الترجمة إلى الإنجليزية", "size": 19, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 852, "y": 150, "w": 389, "h": 54, "text": "مبتدئ", "size": 26, "color": "FFFFFF", "bold": true, "align": "center", "fill": "2563EB", "rad": true, "va": "middle"}, {"k": "text", "x": 852, "y": 212, "w": 389, "h": 190, "text": "استمع إلى زميلك يقرأ إعلانًا قصيرًا مرتين، وأجب عن 3 أسئلة بالإنجليزية.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFFFF", "rad": true, "va": "top"}, {"k": "text", "x": 852, "y": 412, "w": 389, "h": 232, "text": "✅ المعيار: هل وصلت المعلومة بلا لبس؟ الإملاء لا يهمّ.", "size": 19, "color": "FFFFFF", "bold": true, "align": "right", "fill": "2563EB", "rad": true, "va": "top", "rv": 1}, {"k": "text", "x": 445, "y": 150, "w": 389, "h": 54, "text": "متطوّر", "size": 26, "color": "FFFFFF", "bold": true, "align": "center", "fill": "16A34A", "rad": true, "va": "middle"}, {"k": "text", "x": 445, "y": 212, "w": 389, "h": 190, "text": "صحّح ترجمة زميلك إلى الإنجليزية: ضع دائرة على كل زمن خاطئ وكل كلمة محذوفة.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFFFF", "rad": true, "va": "top"}, {"k": "text", "x": 445, "y": 412, "w": 389, "h": 232, "text": "✅ مثال: «كنّا نذهب» ← we used to go، لا we go.", "size": 19, "color": "FFFFFF", "bold": true, "align": "right", "fill": "16A34A", "rad": true, "va": "top", "rv": 1}, {"k": "text", "x": 38, "y": 150, "w": 389, "h": 54, "text": "متمكّن", "size": 26, "color": "FFFFFF", "bold": true, "align": "center", "fill": "7C3AED", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 212, "w": 389, "h": 190, "text": "صحّح ترجمة كاملة بمستويات المعيار، وأعطها درجة من 7 مع تعليل.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFFFF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 412, "w": 389, "h": 232, "text": "✅ مثال: 5 من 7: المعنى أغلبه منقول، وفيه زمن خاطئ في الجملة الأخيرة.", "size": 19, "color": "FFFFFF", "bold": true, "align": "right", "fill": "7C3AED", "rad": true, "va": "top", "rv": 1}], "n": "وزّع المستويات حسب نتائج التدريب الكامل."}, {"bg": "E9F3E6", "els": [{"k": "text", "x": 390, "y": 13, "w": 500, "h": 46, "text": "🎟️ تذكرة الخروج", "size": 22, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 3 دقائق", "size": 22, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 70, "text": "ثلاثة أسئلة قبل الجرس", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 180, "y": 664, "w": 1061, "h": 44, "text": "🎯 الاستماع · القراءة · الترجمة إلى الإنجليزية", "size": 19, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 150, "w": 1203, "h": 66, "text": "1) بأيّ لغة تجيب في القسم ب من الورقة 3H؟", "size": 22, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFFFF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 224, "w": 1203, "h": 70, "text": "✅ بالعربية", "size": 20, "color": "FFFFFF", "bold": true, "align": "right", "fill": "16A34A", "rad": true, "va": "middle", "rv": 1}, {"k": "text", "x": 38, "y": 315, "w": 1203, "h": 66, "text": "