: 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّنْمِيَةُ الْبَشَرِيَّةُ · التَّعْليمُ · الْحَياةُ الْبَرِّيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L08/school.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "قالَ صاحِبُ السُّمُوِّ الشَّيْخُ مُحَمَّدُ بْنُ زايِدٍ آلِ نَهْيانَ رَئيسُ الدَّوْلَةِ - حَفِظَهُ اللهُ -: «إِنَّهُ لَيْسَ أَمامَنا خِيارٌ إِلّا الِاعْتِمادُ عَلى النَّوْعِيَّةِ، وَسِلاحُنا الْحَقيقِيُّ هُوَ الْعِلْمُ.. وَنُريدُ أَنْ نُنافِسَ بِكُمْ دُوَلَ الْعالَمِ»، فَطُموحُنا أَنْ نُنافِسَ دُوَلَ الْعالَمِ الْمُتَقَدِّمَةَ الَّتي حَقَّقَتْ نَجاحاتٍ في التَّنْمِيَةِ الْبَشَرِيَّةِ وَالتَّعْليمِ وَالِاقْتِصادِ مِثْلَ فِنْلَنْدا وَنْيوزيلَنْدا وَكوريا الْجَنوبِيَّةِ وَسِنْغافورَةَ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "داعِيًا سُمُوُّهُ إِلى قِراءَةِ تاريخِ هٰذِهِ الدُّوَلِ وَكَيْفِيَّةِ نُهوضِها مِنْ أَوْضاعِها حَتّى أَصْبَحَتْ نَموذَجًا في التَّقَدُّمِ وَالتَّطَوُّرِ. وَمِنْ مَجالاتِ اهْتِمامِ صاحِبِ السُّمُوِّ الشَّيْخِ مُحَمَّدِ بْنِ زايِدٍ: التَّعْليمُ وَالطُّلّابُ، وَالْهُوِيَّةُ وَالتُّراثُ الْوَطَنِيُّ، وَالْبيئَةُ وَالْحَياةُ الْبَرِّيَّةُ.", "size": 