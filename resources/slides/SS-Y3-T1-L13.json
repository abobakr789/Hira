"h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْيَوْمُ الْوَطَنِيُّ · الِاتِّحادُ · اللَّوْحاتُ الشَّعْبِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L10/raise.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "مَرْيَمُ: أَراكَ الْيَوْمَ تَحْمِلُ عَلَمَ دَوْلَةِ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ يا راشِدُ. راشِدٌ: الْعَلَمُ مَصْدَرُ فَخْري وَاعْتِزازي؛ إِنَّهُ يُمَثِّلُ الْيَوْمَ الْوَطَنِيَّ لِدَوْلَتِنا الْحَبيبَةِ. مَرْيَمُ: ماذا يَعْني الْيَوْمُ الْوَطَنِيُّ؟ راشِدٌ: الْيَوْمُ الْوَطَنِيُّ هُوَ الْيَوْمُ الَّذي اتَّحَدَتْ فيهِ إِماراتُنا الْحَبيبَةُ. مَرْيَمُ: وَماذا أَيْضًا؟ راشِدٌ: وَهُوَ الْيَوْمُ الَّذي أَصْبَحَ فيهِ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - أَوَّلَ رَئيسٍ لِلِاتِّحادِ، يُعَبِّرُ فيهِ النّاسُ عَنْ فَرْحَتِهِمْ بِمَظاهِرَ احْتِفالِيَّةٍ مُخْتَلِفَةٍ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "الْيَوْمُ الْوَطَنِيُّ: قِيامُ الِاتِّحادِ أَهَمُّ حَدَثٍ في حَياةِ الشَّيْخِ زايِدِ بْنِ سُلْطانَ آلِ نَهْيانَ وَالشَّيْخِ راشِدِ بْنِ سَعيدٍ آلِ مَكْتومٍ - رَحِمَهُما اللهُ - وَفي حَياةِ الْمِنْطَقَةِ بِأَسْرِها. دَوْلَةُ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ دَوْلَةٌ اتِّحادِيَّةٌ مُسْتَقِلَّةٌ ذاتُ سِيادَةٍ تَضُمُّ سَبْعَ إِماراتٍ. وَيُمَثِّلُ «يَوْمُ عَهْدِ الِاتِّحادِ» يَوْمًا وَطَنِيًّا في تاريخِ دَوْلَةِ الْإِماراتِ، حَيْثُ يُحْتَفى بِالِاجْتِماعِ الَّذي عُقِدَ في 18 يوليو 1971م، وَالَّذي وَقَّعَ فيهِ الْوالِدُ الْمُؤَسِّسُ الشَّيْخُ زايِدٌ وَإِخْوانُهُ الْحُكّامُ إِعْلانَ الِاتِّحادِ وَدُسْتورَ الدَّوْلَةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْيَوْمُ الْوَطَنِيُّ؟ وَما يَوْمُ عَهْدِ الِاتِّحادِ؟ وَكَيْفَ نَحْتَفِلُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مَظاهِرُ الِاحْتِفالِ بِالْيَوْمِ الْوَطَنِيِّ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْيَوْمُ الْوَطَنِيُّ · الِاتِّحادُ · اللَّوْحاتُ الشَّعْبِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🇦🇪", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fil