 "bold": false, "align": "right", "fill": "FFFFFF", "rad": true, "va": "top", "rv": 3}], "n": "من المواصفات وورقة الامتحان. اسأل: أين أكثر الدرجات؟ وأين أكثر الوقت؟"}, {"bg": "F3E9FB", "els": [{"k": "text", "x": 390, "y": 13, "w": 500, "h": 46, "text": "🧩 أنواع الأسئلة", "size": 22, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 22, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 70, "text": "ماذا يُطلب في كل سؤال؟", "size": 38, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 180, "y": 664, "w": 1061, "h": 44, "text": "🎯 الورقتان · سجلّ الأخطاء · خطة المراجعة", "size": 19, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "text", "x": 1001, "y": 150, "w": 240, "h": 115, "text": "الفهم والدليل", "size": 20, "color": "FFFFFF", "bold": true, "align": "center", "fill": "2563EB", "rad": true, "va": "middle"}, {"k": "text", "x": 641, "y": 150, "w": 350, "h": 115, "text": "س1–س3، س5–س7", "size": 19, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFFFF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 150, "w": 593, "h": 115, "text": "💡 الإجابة + عبارة قصيرة بين علامتي تنصيص.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FEF3C7", "rad": true, "va": "middle", "rv": 1}, {"k": "text", "x": 1001, "y": 275, "w": 240, "h": 115, "text": "التحليل والمقارنة", "size": 20, "color": "FFFFFF", "bold": true, "align": "center", "fill": "16A34A", "rad": true, "va": "middle"}, {"k": "text", "x": 641, "y": 275, "w": 350, "h": 115, "text": "س4، س8، س9", "size": 19, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FFFFFF", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 