F", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَوارِدُ الطَّبيعِيَّةُ · التَّرْشيدُ · الِاسْتِدامَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L06/mountain.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "تَرْشيدُ اسْتِهْلاكِ الْمَوارِدِ الطَّبيعِيَّةِ وَتَقْليلُ كَمِّيَّةِ اسْتِخْدامِها يُساعِدُ عَلى تَحْقيقِ الِاسْتِدامَةِ وَتَوْفيرِ الْمَوارِدِ الطَّبيعِيَّةِ لِلْأَجْيالِ الْقادِمَةِ. سَخَّرَ اللهُ عَزَّ وَجَلَّ الْأَرْضَ لِنَعيشَ عَلَيْها وَنُحافِظَ عَلى مُكَوِّناتِها: أَلْتَزِمُ بِتَعاليمِ ديني الَّتي تَدْعو إِلى الْمُحافَظَةِ عَلى الْبيئَةِ. أَسْتَخْدِمُ مِنَ الْمَوارِدِ بِقَدْرِ ما أَحْتاجُ. أُعيدُ اسْتِخْدامَ الْأَشْياءِ بِطَريقَةٍ صَحيحَةٍ. أَتَعَلَّمُ التَّعايُشَ مَعَ الْآخَرينَ لِضَمانِ سَلامَةِ الْبيئَةِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الِاسْتِدامَةُ: مَفْهومٌ يُطْلَقُ عَلى الْبيئَةِ الْحَيَوِيَّةِ مُتَنَوِّعَةِ الْكائِناتِ الْحَيَّةِ، وَالْعَوامِلِ الطَّبيعِيَّةِ الَّتي تُحافِظُ عَلى وُجودِها لِأَطْوَلِ فَتْرَةٍ زَمَنِيَّةٍ مُمْكِنَةٍ. التَّنْمِيَةُ الْمُسْتَدامَةُ: تَرْشيدُ اسْتِهْلاكِ الْمَوارِدِ الطَّبيعِيَّةِ وَتَقْليلُ كَمِّيَّةِ اسْتِخْدامِها وَتَوْفيرُها لِلْأَجْيالِ الْقادِمَةِ. وَما زالَ جَناحُ الِاسْتِدامَةِ في إِكْسْبو 2020 دُبَيَّ نَموذَجًا مُلْهِمًا لِلتَّصْميمِ وَالْمُمارَسَةِ الِابْتِكارِيَّةِ وَالْمُسْتَدامَةِ في الطّاقَةِ وَالْمِياهِ، وَمُكافَحَةِ التَّغَيُّرِ الْمُناخِيِّ وَالتَّلَوُّثِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الِاسْتِدامَةُ؟ وَما واجِبي تُجاهَ الْأَرْضِ الَّتي سَخَّرَها اللهُ لَنا؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أُحافِظُ عَلى الْأَرْضِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَوارِدُ الطَّبيعِيَّةُ · التَّرْشيدُ · الِاسْتِدامَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🕌 أَلْتَزِمُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "بِتَعاليمِ ديني", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "r