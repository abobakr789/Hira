, "w": 1172, "h": 108, "rv": 2, "text": "في بَيْتي: أُغْلِقُ الصُّنْبورَ أَثْناءَ تَنْظيفِ أَسْناني ← أُطْفِئُ الْأَنْوارَ ← أَفْصِلُ النُّفاياتِ لِلتَّدْويرِ.\nالنَّتيجَةُ: مَوارِدُ مَحْفوظَةٌ لي وَلِأَبْنائي في الْمُسْتَقْبَلِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 مِنْ سَنْعِ بِلادي أَتَعَلَّمُ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "«لا تُسْرِفْ لَوْ مِنَ الْبَحْرِ تَغْرِفْ.»", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "صَحيحٌ أَمْ خاطِئٌ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَوارِدُ الطَّبيعِيَّةُ · التَّرْشيدُ · الِاسْتِدامَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g3/SS-Y3-T1-L06/bin.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 31