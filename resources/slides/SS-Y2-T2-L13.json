 "w": 122, "h": 122, "emo": "🛂", "rv": 4}, {"k": "text", "x": 49, "y": 307, "w": 266, "h": 77, "rv": 4, "text": "جَوازُ السَّفَرِ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 49, "y": 390, "w": 266, "h": 109, "rv": 4, "text": "مُسْتَنَدٌ لِلسَّفَرِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «الْهُوِيَّةُ الْوَطَنِيَّةُ هِيَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْهُوِيَّةُ الْوَطَنِيَّةُ · مُسْتَنَداتٌ رَسْمِيَّةٌ · شَهادَةُ الْميلادِ · جَوازُ السَّفَرِ · خُلاصَةُ الْقَيْدِ · بِطاقَةُ الْهُوِيَّةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L13/class.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "الْمُعَلِّمَةُ: مَنْ يَقْرَأُ لي هٰذا الْخَبَرَ يا أَحِبّائي؟ راشِدٌ: أَنا سَأَقْرَأُ: «وَجَّهَ الشَّيْخُ خَليفَةُ بْنُ زايِدٍ آلِ نَهْيانَ - رَحِمَهُ اللهُ - بِجَعْلِ عامِ 2008م عامًا لِلْهُوِيَّةِ الْوَطَنِيَّةِ». وَماذا تَعْني الْهُوِيَّةُ الْوَطَنِيَّةُ يا مُعَلِّمَتي؟ الْمُعَلِّمَةُ: هِيَ الِانْتِماءُ لِلْأَرْضِ، وَحُبُّ الْوَطَنِ، وَالدِّفاعُ عَنْهُ، وَالِالْتِزامُ بِقَوانينِهِ، وَالتَّمَسُّكُ بِعاداتِهِ وَتَقاليدِهِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "راشِدٌ: نَعَمْ يا مُعَلِّمَتي، فَأَنا أُحِبُّ وَطَني دَوْلَةَ الْإِماراتِ. الْمُعَلِّمَةُ: أَحْسَنْتُمْ يا أَبْنائي، سَنَقومُ الْآنَ بِتَعَرُّفِ الْمُسْتَنَداتِ الرَّسْمِيَّةِ (وَهِيَ أَوْراقٌ رَسْمِيَّةٌ تُثْبِتُ هُوِيَّةَ الشَّخْصِ) لِدَوْلَةِ الْإِماراتِ: شَهادَةُ الْميلادِ: وَرَقَةٌ رَسْمِيَّةٌ تَصْدُرُ بَعْدَ الْوِلادَةِ. جَوازُ السَّفَرِ: مُسْتَنَدٌ رَسْمِيٌّ لِلسَّفَرِ. خُلاصَةُ الْقَيْدِ: تُعَدُّ سِجِلًّا لِلْأُسْرَةِ الْإِماراتِيَّةِ. بِطاقَةُ الْهُوِيَّةِ: تُثْبِتُ الشَّخْصِيَّةَ الْوَطَنِيَّةَ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْهُوِيَّةُ الْوَطَنِيَّةُ؟ وَما الْمُسْتَنَداتُ الرَّسْمِيَّةُ الْأَرْبَعَةُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مُسْتَنَداتي الرَّسْمِيَّةُ", "size": 46, "color": "1