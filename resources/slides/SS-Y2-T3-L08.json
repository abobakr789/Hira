لْآلاتِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «السَّرّودُ صِناعَةٌ … لِأَنَّ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 السَّرّودُ · الْحَصيرُ · صِناعاتٌ تَقْليدِيَّةٌ · صِناعاتٌ حَديثَةٌ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L08/dialog.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "راشِدٌ: ما اسْمُ هٰذِهِ الْقِطْعَةِ يا جَدّي؟ الْجَدُّ: اسْمُها السَّرّودُ. مَرْيَمُ: ما الْمادَّةُ الْمُسْتَخْدَمَةُ في صِناعَتِها؟ الْجَدُّ: تُصْنَعُ مِنْ سَعَفِ النَّخيلِ. راشِدٌ: مَنْ يَقومُ بِصِناعَتِها؟ الْجَدُّ: السَّرّودُ مِنَ الصِّناعاتِ الْقَديمَةِ الَّتي انْتَشَرَتْ في بِلادِنا الْحَبيبَةِ، وَكانَتِ الْأُمَّهاتُ تَصْنَعُ السَّرّودَ، وَيُسْتَخْدَمُ كَمَفارِشَ لِأَطْباقِ الطَّعامِ، أَوْ كَقِطَعٍ فَنِّيَّةٍ لِتَزْيينِ الْمَنْزِلِ، وَالْحَصيرُ سَجّادٌ يُفْرَشُ عَلى الْأَرْضِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "مَرْيَمُ: وَهَلْ هُناكَ صِناعاتٌ حَديثَةٌ في بِلادي؟ الْجَدُّ: نَعَمْ، تَهْتَمُّ دَوْلَةُ الْإِماراتِ بِالصِّناعَةِ، فَتَبْني الْمَصانِعَ الْحَديثَةَ؛ لِكَيْ تُواكِبَ الْعالَمِيَّةَ. راشِدٌ: كُلُّنا فَخْرٌ بِصِناعاتِ بِلادي الْإِماراتِ. وَمِنَ الصِّناعاتِ الْحَديثَةِ: صِناعَةُ الدَّواءِ، وَصِناعاتٌ بلاسْتيكِيَّةٌ، وَصِناعَةُ الْمَلابِسِ.", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 مِمَّ يُصْنَعُ السَّرّودُ؟ وَفيمَ يُسْتَخْدَمُ؟ اذْكُرْ صِناعَتَيْنِ حَديثَتَيْنِ.", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "تَقْليدِيَّةٌ أَمْ حَديثَةٌ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 السَّرّودُ · الْحَصيرُ · صِناعاتٌ تَقْليدِيَّةٌ · صِناعاتٌ حَديثَةٌ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 592,