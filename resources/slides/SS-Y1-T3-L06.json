: 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «أَضَعُ الزُّجاجَةَ الْبلاسْتيكِيَّةَ في حاوِيَةِ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 حاوِيَةٌ · إِعادَةُ التَّدْويرِ · الْفَرْزُ · رَجُلُ الْبيئَةِ الْأَوَّلُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g1/SS-Y1-T3-L06/bins.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "مَرْيَمُ: ما هٰذِهِ الْحاوِياتُ يا أَبي؟ الْأَبُ: حاوِياتٌ مُخَصَّصَةٌ لِجَمْعِ النُّفاياتِ كَيْ يُعادَ تَصْنيعُها بِأَشْكالٍ جَديدَةٍ، وَيُمْكِنُ اسْتِخْدامُها مِنْ جَديدٍ. راشِدٌ: واجِبٌ عَلَيْنا أَنْ نُحافِظَ عَلى ثَرَواتِ بِلادِنا. مَرْيَمُ: ما أَنْواعُ النُّفاياتِ يا أَبي؟ الْأَبُ: يوجَدُ الْعَديدُ مِنَ النُّفاياتِ مِثْلُ النُّفاياتِ الْوَرَقِيَّةِ وَالْبلاسْتيكِيَّةِ وَالزُّجاجِيَّةِ وَالَّتي يُمْكِنُ إِعادَةُ تَدْويرِها، وَالِاسْتِفادَةُ مِنْها.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "راشِدٌ: وَماذا يُقْصَدُ بِإِعادَةِ التَّدْويرِ؟ الْأَبُ: هِيَ عَمَلِيَّةُ إِعادَةِ تَصْنيعِ الْمَوادِّ الْمُسْتَخْدَمَةِ إِلى مُنْتَجاتٍ جَديدَةٍ وَمُفيدَةٍ. مَرْيَمُ: فَلْنُحافِظْ عَلى دَوْلَتِنا بِوَضْعِ النُّفاياتِ في الْأَماكِنِ الْمُخَصَّصَةِ لَها لِمُساعَدَةِ عامِلِ النَّظافَةِ في جَمْعِها وَالِاسْتِفادَةِ مِنْها مَرَّةً أُخْرى.", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما أَنْواعُ النُّفاياتِ الَّتي يُمْكِنُ تَدْويرُها؟ وَما مَعْنى إِعادَةِ التَّدْويرِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَفْرِزُ النُّفاياتِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 حاوِيَةٌ · إِعادَةُ التَّدْويرِ · الْفَرْزُ · رَجُلُ الْبيئَةِ الْأَوَّلُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "🔵 بلاسْتيكٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text