65, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "أَرْضٌ مُرْتَفِعَةٌ وَلَها قِمَّةٌ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "🐑", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "رَعْيُ الْأَغْنامِ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "حِرْفَةٌ يَقومُ بِها الرّاعي بِإِرْسالِ الْأَغْنامِ إِلى الْمَرْعى لِلْأَكْلِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «تَتَرَكَّزُ الْجِبالُ في بِلادي في …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْجِبالُ · رَعْيُ الْغَنَمِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L08/phys.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "عِنْدَما تُشاهِدُ خَريطَةَ دَوْلَةِ الْإِماراتِ تَرى أَلْوانًا مُخْتَلِفَةً، فَتُلاحِظُ أَنَّ اللَّوْنَ الْبُنِّيَّ قَدْ رُسِمَ في بَعْضِ الْأَماكِنِ. فَما الْمَقْصودُ بِاللَّوْنِ الْبُنِّيِّ عَلى الْخَريطَةِ؟ إِنَّهُ الْجَبَلُ: وَهُوَ أَرْضٌ مُرْتَفِعَةٌ وَلَها قِمَّةٌ. وَتَتَرَكَّزُ الْجِبالُ في دَوْلَةِ الْإِماراتِ في الْمَناطِقِ الشَّرْقِيَّةِ، مِثْلُ رَأْسِ الْخَيْمَةِ وَخورْفَكّانَ وَالْفُجَيْرَةِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "وَتَنْتَشِرُ في الْجِبالِ حِرَفٌ كَثيرَةٌ مِثْلُ حِرْفَةِ الزِّراعَةِ، وَرَعْيِ الْأَغْنامِ وَهِيَ حِرْفَةٌ يَقومُ بِها الرّاعي بِإِرْسالِ الْأَغْنامِ إِلى الْمَرْعى لِلْأَكْلِ. الْجِبالُ ذاتُ قيمَةٍ اقْتِصادِيَّةٍ كَبيرَةٍ، حَيْثُ تُعَدُّ الْجِبالُ مِنَ الْمَناطِقِ السِّياحِيَّةِ الْهامَّةِ في دَوْلَةِ الْإِماراتِ. حَقيقَةٌ مُذْهِلَةٌ: يَتَمَيَّزُ سُكّانُ الْجِبالِ بِقُوَّةِ التَّحَمُّلِ وَالصَّبْرِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْجَبَلُ؟ وَأَيْنَ تَتَرَكَّزُ الْجِبالُ في بِلادي؟ وَما حِرَفُ سُكّانِها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold"