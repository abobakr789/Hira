fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 315, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 369, "w": 358, "h": 261, "rv": 3, "text": "أُصَنِّفُ مُنْتَجاتِ الْحَيَواناتِ إِلى سِلَعٍ نَسْتَهْلِكُها.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[ناتج التعلّم ومعايير النجاح] اقرأ الهدف مع الطلاب، ووضّح ماذا يعني كل مستوى."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🔑 مفاتيح الدرس", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 6 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كَلِماتٌ جَديدَةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَلْبانُ · الْمَزْرَعَةُ · الدَّواجِنُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 352, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 1038, "y": 173, "w": 122, "h": 122, "emo": "🥛", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "الْأَلْبانُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "مُشْتَقّاتُ الْحَليبِ: الْأَجْبانُ وَالزُّبْدَةُ وَالسَّمْنُ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "🏡", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "الْمَزْرَعَةُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "مَكانٌ تُرَبّى فيهِ الْحَيَواناتُ وَالدَّواجِنُ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 352, "rv": 3, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 426, "y": 173, "w": 122, "h": 122, "emo": "🐔", "rv": 3}, {"k": "text", "x": 354, "y": 307, "w": 266, "h": 77, "rv": 3, "text": "الدَّواجِنُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 354, "y": 390, "w": 266, "h": 109, "rv": 3, "text": "الطُّيورُ الَّتي تُرَبّى عِنْدَ الْإِنْسانِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «نَأْخُذُ مِنَ الدَّواجِنِ … وَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَلْبانُ · الْمَزْرَعَةُ · الدَّواجِنُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L08/collage.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "تَتَنَوَّعُ الثَّرْوَةُ الْحَيَوانِيَّةُ في دَوْلَةِ الْإِماراتِ، وَتُشَكِّلُ أَهَمِّيَّةً كَبيرَةً بِالنِّسْبَةِ لِلْمُجْتَمَعِ، حَيْثُ يَعْتَمِدُ الْإِنْسانُ في غِذائِهِ الْأَساسِيِّ عَلى مُنْتَجاتِ الثَّرْوَةِ الْحَيَوانِيَّةِ الَّتي تُؤْخَذُ مِنَ الْإِبِلِ وَالْأَبْقارِ وَالْماعِزِ، وَيُفيدُ الْإِنْسانُ مِنْ لُحومِها وَحَليبِها، وَيَسْتَخْرِجُ مِنْ مُشْتَقّاتِ حَليبِها الْأَلْبانَ وَالْأَجْبانَ وَالزُّبْدَةَ وَالسَّمْنَ، وَيَأْخُذُ مِنَ الدَّواجِنِ الْبَيْضَ وَاللَّحْمَ. وَقَديمًا اسْتَخْدَمَ الْإِنْسانُ في تَنَقُّلاتِهِ الْحَيَواناتِ وَسيلَةً لِلْمُواصَلاتِ وَنَقْلِ الْبَضائِعِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "تَنْتَشِرُ في دَوْلَةِ الْإِماراتِ الْعَديدُ مِنْ مَزارِعِ الْحَيَواناتِ، مِنْها مَزارِعُ الْأَبْقارِ وَالْأَغْنامِ وَالدَّواجِنِ، وَالْمَزْرَعَةُ عِبارَةٌ عَنْ مَكانٍ تُرَبّى فيهِ الْحَيَواناتُ وَالدَّواجِنُ، وَالدَّواجِنُ هِيَ الطُّيورُ الَّتي تُرَبّى عِنْدَ الْإِنْسانِ. وَمِنْ أَنْواعِ الْحَيَواناتِ الَّتي تُرَبّى في بِلادي: الْإِبِلُ، وَالْأَبْقارُ، وَالْماعِزُ، وَالْأَغْنامُ، وَالدَّواجِنُ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْحَيَواناتُ الَّتي تُرَبّى في بِلادي؟ وَما الْمَزْرَعَةُ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "فَوائِدُ الْحَيَواناتِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْأَلْبانُ · الْمَزْرَعَةُ · الدَّواجِنُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🥩 مَصْدَرٌ لِلُّحومِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الْإِبِلُ وَالْأَغْنامُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "0EA5E9", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🥛 مَصْدَرٌ لِلْحَليبِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 650, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "وَالْأَجْبانِ وَالزُّبْدَةِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "EAB308", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 344, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🥚 الدَّواجِنُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 344, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "الْبَيْضُ وَاللَّحْمُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🐪 وَسيلَةٌ لِلتَّنَقُّلِ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "قَديمًا", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُتابِعُ رِحْلَةَ الْحَليبِ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "الْبَقَرَةُ في الْمَزْرَعَةِ ← الْحَليبُ ← الْمَصْنَعُ يَصْنَعُ الْجُبْنَ وَالزُّبْدَةَ\n← السّوقُ ← مائِدَتي. فَالْمُزارِعُ مُنْتِجٌ وَأَنا مُسْتَهْلِكٌ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y"