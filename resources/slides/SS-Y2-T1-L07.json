": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَوْقِعُ الْجُغْرافِيُّ · الْعالَمُ الْقَديمُ · الْوَطَنُ الْعَرَبِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T1-L07/arab.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "الْمَوْقِعُ الْجُغْرافِيُّ هُوَ مَوْقِعُ الْمَكانِ عَلى سَطْحِ الْأَرْضِ. تَنْتَمي بِلادي دَوْلَةُ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ لِقارَّةِ آسيا. وَعِنْدَما أَنْظُرُ إِلى خَريطَةِ الْعالَمِ فَإِنَّني أَرى أَنَّ اللهَ تَعالى وَهَبَ دَوْلَتَنا الْحَبيبَةَ مَوْقِعًا مُتَمَيِّزًا بَيْنَ قارّاتِ الْعالَمِ الْقَديمِ (آسيا - أوروبّا - أَفْريقيا)، وَجَعَلَها إِحْدى النِّقاطِ التِّجارِيَّةِ الْمُهِمَّةِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "وَعِنْدَما أُمْعِنُ النَّظَرَ أَكْثَرَ أُشاهِدُ أَنَّ بِلادي هِيَ امْتِدادٌ طَبيعِيٌّ لِلْوَطَنِ الْعَرَبِيِّ مِنْ جِهَةِ الشَّرْقِ. وَعِنْدَما أُوَجِّهُ نَظَري إِلى الْخَليجِ الْعَرَبِيِّ فَإِنّي أُشاهِدُ بِلادي تَقَعُ في قَلْبِ الْخَليجِ الْعَرَبِيِّ، وَتُجاوِرُها دُوَلٌ مِثْلُ الْمَمْلَكَةِ الْعَرَبِيَّةِ السُّعودِيَّةِ، وَسَلْطَنَةِ عُمانَ وَقَطَرَ.", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 إِلى أَيِّ قارَّةٍ تَنْتَمي بِلادي؟ وَما الدُّوَلُ الَّتي تُجاوِرُها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "ثَلاثُ خَرائِطَ… خُطْوَةً خُطْوَةً", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَوْقِعُ الْجُغْرافِيُّ · الْعالَمُ الْقَديمُ · الْوَطَنُ الْعَرَبِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "1 🌍 الْعالَمُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "آسيا · الْعالَمُ الْقَديمُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 446, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 446, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "2 🕌 الْوَطَنُ الْعَرَبِيُّ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 446, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "جِهَةُ الشَّرْقِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "0EA5E9", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "3 🇦🇪 الْخَليجُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 388, "h": 58, "rv": 1, "text": "في قَلْبِهِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُكَبِّرُ الْخَريطَةَ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "أَبْدَأُ بِالْعالَمِ: بِلادي في آسيا بَيْنَ آسيا وَأوروبّا وَأَفْريقيا ← ثُمَّ الْوَطَنُ الْعَرَبِيُّ: في الشَّرْقِ\n← ثُمَّ الْخَليجُ: في قَلْبِهِ، تُجاوِرُها السُّعودِيَّةُ وَعُمانُ وَقَطَرُ.", "size": 34, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 لِماذا مَوْقِعُها مُهِمٌّ؟", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "لِأَنَّها بَيْنَ قارّاتِ الْعالَمِ الْقَديمِ، فَأَصْبَح