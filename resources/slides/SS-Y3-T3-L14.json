C", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّجْرِبَةُ · الضَّوْءُ · الرُّؤْيَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L14/refrdiag.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "لاحَظَ ابْنُ الْهَيْثَمِ أَنَّ الضَّوْءَ يَمُرُّ عَبْرَ ثُقْبِ الْجِدارِ، فَاسْتَنْتَجَ أَنَّ الضَّوْءَ يَسيرُ في خَطٍّ مُسْتَقيمٍ. ضَمَّنَ الْحَسَنُ بْنُ الْهَيْثَمِ كُلَّ ما تَعَلَّمَهُ في كِتابٍ أَسْماهُ (الْمَناظِرَ). تَوَصَّلَ إِلى أَنَّ الْأَشِعَّةَ الضَّوْئِيَّةَ تَنْعَكِسُ عِنْدَما تَسْقُطُ عَلى سَطْحٍ لامِعٍ. تَأَكَّدَ أَنَّ الضَّوْءَ يَنْكَسِرُ عِنْدَما يَنْتَقِلُ مِنْ وَسَطٍ إِلى آخَرَ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "اسْتَنْتَجَ أَنَّ دُخولَ أَشِعَّةِ الضَّوْءِ إِلى الْعَيْنِ هُوَ الْخُطْوَةُ الْأولى إِلى الرُّؤْيَةِ وَتَعْقُبُها عَمَلِيّاتٌ أُخْرى. دَرَسَ ابْنُ الْهَيْثَمِ الْعَيْنَ، وَأَطْلَقَ عَلَيْها أَسْماءً جَديدَةً كَالْقَرَنِيَّةِ وَالْعَدَسَةِ. وَقَدِ اسْتَفادَ عُلَماءُ الْغَرْبِ مِنْ كِتاباتِ ابْنِ الْهَيْثَمِ الَّتي تُرْجِمَتْ مِنَ الْعَرَبِيَّةِ إِلى اللّاتينِيَّةِ. حَقيقَةٌ تاريخِيَّةٌ: عاشَ ابْنُ الْهَيْثَمِ في فَتْرَةٍ ذَهَبِيَّةٍ مِنَ الْحَضارَةِ الْإِسْلامِيَّةِ، وَوَصَلَتْ أَفْكارُهُ إِلى أوروبّا، وَسَمّاهُ أَهْلُها الْهازِنَ (AlHazen) وَهُوَ لَفْظٌ لاتينِيٌّ لِاسْمِهِ الْعَرَبِيِّ (الْحَسَنِ).", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 كَيْفَ يَسيرُ الضَّوْءُ؟ مَتى يَنْعَكِسُ وَمَتى يَنْكَسِرُ؟ ما اسْمُ كِتابِ ابْنِ الْهَيْثَمِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "اكْتِشافاتُ ابْنِ الْهَيْثَمِ في الضَّوْءِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 التَّجْرِبَةُ · الضَّوْءُ · الرُّؤْيَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "EAB308", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "➡️ الْمَسارُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "خُطوطٌ مُسْتَقيمَةٌ", "size": 25, "color": "FFFFFF", "bold": false, "align": "ce