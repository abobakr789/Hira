], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الرُّموزُ · سَلْطَنَةُ عُمانَ · الْمَمْلَكَةُ الْعَرَبِيَّةُ السُّعودِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L06/uaemap.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "هٰذِهِ خَريطَةُ وَطَنِكَ دَوْلَةِ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ، تَعالَ مَعي لِنُطَبِّقَ عَلَيْها ما دَرَسْناهُ في عَناصِرِ الْخَريطَةِ. الِاتِّجاهُ: يُحَدِّدُ الْجِهاتِ الْأَصْلِيَّةَ عَلى الْخَريطَةِ، يُشيرُ أَعْلى الْخَريطَةِ إِلى الشَّمالِ، وَأَسْفَلُ الْخَريطَةِ إِلى الْجَنوبِ، وَيَكونُ الشَّرْقُ إِلى يَمينِ الْخَريطَةِ، وَالْغَرْبُ إِلى يَسارِها. الْعُنْوانُ: مَوْضوعُ الْخَريطَةِ، هُوَ «مُدُنُ دَوْلَةِ الْإِماراتِ الْعَرَبِيَّةِ الْمُتَّحِدَةِ».", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الْمِفْتاحُ: تُوضَعُ فيهِ الرُّموزُ؛ الرَّمْزُ (◉) يَدُلُّ عَلى الْعاصِمَةِ، وَالرَّمْزُ (●) يَدُلُّ عَلى إِمارَةٍ، وَالرَّمْزُ (—) يَدُلُّ عَلى الْحُدودِ السِّياسِيَّةِ. وَكُلَّما تَغَيَّرَ الْمَوْضوعُ تَغَيَّرَتِ الرُّموزُ في مِفْتاحِ الْخَريطَةِ؛ فَهِيَ تُساعِدُنا عَلى قِراءَةِ مَعْلوماتِ الْخَريطَةِ وَفَهْمِها. وَتُجاوِرُ بِلادي: الْخَليجُ الْعَرَبِيُّ، وَسَلْطَنَةُ عُمانَ، وَالْمَمْلَكَةُ الْعَرَبِيَّةُ السُّعودِيَّةُ. حَقيقَةٌ جُغْرافِيَّةٌ: يَسْتَخْدِمُ التِّلْميذُ الْخَريطَةَ لِيَتَعَرَّفَ مَوْقِعَ بَيْتِهِ وَمَدْرَسَتِهِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا يَدُلُّ عَلَيْهِ أَعْلى الْخَريطَةِ؟ وَما رَمْزُ الْعاصِمَةِ؟ وَمَنْ جيرانُ بِلادي؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَقْرَأُ خَريطَةَ وَطَني", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الرُّموزُ · سَلْطَنَةُ عُمانَ · الْمَمْلَكَةُ الْعَرَبِيَّةُ السُّعودِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "⬆️ الِاتِّجاهُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "mid