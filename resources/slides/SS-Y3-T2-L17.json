a": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْقَنْصُ · الْحُبارى", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L17/falconer.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "تُعَدُّ رِياضَةُ الْقَنْصِ مِنْ أَشْهَرِ أَنْواعِ الرِّياضاتِ الَّتي عَرَفَها أَجْدادُنا، وَهِيَ هِوايَةٌ مُفَضَّلَةٌ لَدَيْهِمْ. مُنْذُ زَمَنٍ بَعيدٍ كانَ أَجْدادُنا يَعْتَمِدونَ عَلى الصُّقورِ في صَيْدِ الْحُبارى وَالْأَرانِبِ وَالْحَمامِ لِتَوْفيرِ الطَّعامِ أَوْ لِمُمارَسَتِها كَرِياضَةٍ وَهِوايَةٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "يَبْدَأُ مَوْسِمُ الْقَنْصِ في فَصْلِ الْخَريفِ وَمَعَ اعْتِدالِ الْمُناخِ في دَوْلَةِ الْإِماراتِ بِخُروجِ نَجْمِ سُهَيْلٍ، حَيْثُ تَبْدَأُ الطُّيورُ وَالْحُبارى (وَهُوَ نَوْعٌ مِنْ أَنْواعِ الطُّيورِ) بِالْهِجْرَةِ إِلى دَوْلَةِ الْإِماراتِ، حَيْثُ الْمُناخُ الدّافِئُ وَالْمُناسِبُ لَها، وَتَنْتَهي في شَهْرِ مارِسَ حَيْثُ تَبْدَأُ الْحَرارَةُ بِالِارْتِفاعِ. نَتَعَلَّمُ مِنْ صَيْدِ الصُّقورِ الصَّبْرَ وَالْقُوَّةَ. وَمِنْ قِيَمِنا: رِياضَةُ الصُّقورِ تُنَمّي فينا روحَ الْعِزَّةِ وَالتَّنافُسِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا كانَ الْأَجْدادُ يَصْطادونَ بِالصُّقورِ