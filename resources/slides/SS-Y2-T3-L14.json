"w": 266, "h": 109, "rv": 4, "text": "فَنُّ السَّفَرِ في الْبِحارِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «تُعْرَفُ جِلْفارُ الْيَوْمَ بِـ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 جِلْفارُ · الْخَليجُ الْعَرَبِيُّ · الْقَواسِمُ · الْمِلاحَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T3-L14/map.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "جِلْفارُ مَدينَةٌ عَريقَةٌ عُرِفَتْ عَبْرَ التّاريخِ، وَتُعْرَفُ الْيَوْمَ بِإِمارَةِ رَأْسِ الْخَيْمَةِ، وَاشْتَهَرَتْ قَديمًا كَميناءٍ مُهِمٍّ عَلى سَواحِلِ الْخَليجِ الْعَرَبِيِّ، وَهُوَ مُسَطَّحٌ مائِيٌّ تُحيطُ بِهِ الْيابِسَةُ مِنْ ثَلاثِ جِهاتٍ. كَما اشْتَهَرَتْ جِلْفارُ بِصَيْدِ الْأَسْماكِ، وَأَنَّها مَرْكَزٌ مُهِمٌّ لِلْغَوْصِ وَالْبَحْثِ عَنِ اللُّؤْلُؤِ. تَحْكُمُها مُنْذُ الْقِدَمِ قَبيلَةُ الْقَواسِمِ وَهِيَ قَبيلَةٌ عَرَبِيَّةٌ أَصيلَةٌ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "وَكانَ أَهْلُها يَعْتَمِدونَ عَلى الْبَحْرِ في رِزْقِهِمْ، فَيَصيدونَ السَّمَكَ، وَيَغوصونَ لِلْبَحْثِ عَنِ اللُّؤْلُؤِ، وَيُتاجِرونَ بِهِ مَعَ الدُّوَلِ الْقَريبَةِ مِنْهُمْ؛ حَتّى أَصْبَحَ أَهْلُها يَعْرِفونَ الْبَحْرَ مَعْرِفَةً جَيِّدَةً. أَصْبَحَ أَهْلُ جِلْفارَ ماهِرينَ في الْمِلاحَةِ وَهِيَ فَنُّ السَّفَرِ في الْبِحارِ، وَكانَ مِنْ أَبْرَزِ الْمَلّاحينَ الْماهِرينَ في الْقَرْنِ الْخامِسَ عَشَرَ، الْمَلّاحُ شِهابُ الدّينِ أَحْمَدُ بْنُ ماجِدٍ الَّذي وَرِثَ الْمِلاحَةَ أَبًا عَنْ جَدٍّ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 بِماذا اشْتَهَرَتْ جِلْفارُ؟ وَمَنْ أَشْهَرُ مَلّاحيها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "لِماذا «رَأْسُ الْخَيْمَةِ»؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 جِلْفارُ · الْخَليجُ الْعَرَبِيُّ · الْقَواسِمُ · الْمِلاحَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 16