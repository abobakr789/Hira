: "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْعَلَمُ · الِاسْتِقْلالُ · الشِّعارُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L11/firstflag.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "عَلَمُ بِلادي: رَمْزٌ وَطَنِيٌّ يَدُلُّ عَلى اسْتِقْلالِ الدَّوْلَةِ وَسِيادَتِها. أَوَّلُ مَنْ رَفَعَهُ الْمَغْفورُ لَهُ - بِإِذْنِ اللهِ - الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ. تَمَّ اعْتِمادُهُ في 2 مِنْ دِيسَمْبَرَ سَنَةَ 1971م. يُسْتَخْدَمُ في الْمُناسَباتِ الْوَطَنِيَّةِ وَالدّينِيَّةِ وَالِاجْتِماعِيَّةِ وَالرِّياضِيَّةِ. يَتَكَوَّنُ الْعَلَمُ مِنْ أَرْبَعَةِ أَلْوانٍ. مُصَمِّمُ عَلَمِ دَوْلَةِ الْإِماراتِ سَعادَةُ عَبْدِ اللهِ مُحَمَّدٍ الْمُعَيْنَةِ الْوَزيرُ الْمُفَوَّضُ بِوِزارَةِ الْخارِجِيَّةِ، بَدَأَ كَلامَهُ بِأَنَّ التّاريخَ سَجَّلَ بِأَحْرُفٍ مِنْ نورٍ يَوْمَ الثّاني مِنْ دِيسَمْبَرَ عِنْدَما رَفَعَ الْمَغْفورُ لَهُ الشَّيْخُ زايِدٌ بِيَدَيْهِ الْكَريمَتَيْنِ أَوَّلَ عَلَمٍ لِدَوْلَةِ الْإِماراتِ، مُعْلِنًا ميلادَ دَوْلَةٍ مُسْتَقِلَّةٍ ذاتِ سِيادَةٍ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "شِعارُ دَوْلَتي: الصَّقْرُ مِنْ أَهَمِّ الرُّموزِ الَّتي اعْتَمَدَتْها دَوْلَةُ الْإِماراتِ في تَصْميمِ شِعاراتِها، وَاسْتُخْدِمَ في شِعارِ الدَّوْلَةِ عِنْدَما اعْتَمَدَهُ الْمَجْلِسُ الْأَعْلى لِلِاتِّحادِ يَوْمَ 9 دِيسَمْبَرَ مِنَ الْعامِ 1971م، وَتَمَّ اخْتِيارُهُ مِنْ بَيْنِ مِئاتِ الرُّسومِ الْمُقَدَّمَةِ ضِمْنَ مُسابَقَةٍ. أَنا الشِّعارُ الْقَديمُ: الصَّقْرُ، في صَدْري قُرْصٌ أَحْمَرُ، يَظْهَرُ فيهِ سَفينَةُ الْبومِ الشِّراعِيَّةِ تَسيرُ عَلى مِياهِ الْخَليجِ الْعَرَبِيِّ. أَنا الشِّعارُ الْجَديدُ: أَحْمِلُ في صَدْري عَلَمَ الدَّوْلَةِ، وَعَلَيْهِ طَوْقٌ تُزَيِّنُهُ سَبْعُ نُجومٍ، تُمَثِّلُ الْإِماراتِ السَّبْعَ وَيَرْمُزُ لِلْوَحْدَةِ وَالتَّرابُطِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 مَنْ صَمَّمَ عَلَمَ بِلادي؟ وَما الْفَرْقُ بَيْنَ الشِّعارِ الْقَديمِ وَالْجَديدِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الشِّعارُ: قَديمًا وَحَديثًا", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْعَلَمُ · الِاسْتِقْلالُ · الشِّعارُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 134, "rv": 1, "fill": "DC2626", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 592, "h": 64, "rv": 1, "text": "⛵ الْقَديمُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "t