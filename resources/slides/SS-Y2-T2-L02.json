"va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمِياهُ الْجَوْفِيَّةُ · الْآبارُ · الْيَنابيعُ وَالْعُيونُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L02/aquifer.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "الْمِياهُ الْجَوْفِيَّةُ هِيَ الْمِياهُ الْمَخْزونَةُ في طَبَقاتِ الْأَرْضِ. مِنْ أَيْنَ تَأْتي؟ تَتَسَرَّبُ مِياهُ الْأَمْطارِ إِلى طَبَقاتِ الْأَرْضِ، وَتَتَنَقَّلُ بَيْنَ ذَرّاتِ التُّرابِ وَالرَّمْلِ وَالصُّخورِ حَتّى تَصِلَ إِلى عُمْقٍ مُعَيَّنٍ وَتَبْدَأَ بِالتَّجَمُّعِ لِتُشَكِّلَ طَبَقَةً مُشْبَعَةً بِالْماءِ (تَخَيَّلْ قِطْعَةً مِنَ الْإِسْفَنْجِ مُشْبَعَةً بِالْماءِ!).", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "تَخْرُجُ الْمِياهُ مِنْ باطِنِ الْأَرْضِ في بِلادي بِأَشْكالٍ مُخْتَلِفَةٍ: الْآبارُ (الطَّوِيُّ): تَكْثُرُ في دَوْلَةِ الْإِماراتِ، وَهِيَ الْوَسيلَةُ الشّائِعَةُ لِاسْتِخْراجِ الْمِياهِ الْجَوْفِيَّةِ. الْيَنابيعُ وَالْعُيونُ: هِيَ الْأَماكِنُ الَّتي تَظْهَرُ فيها الْمِياهُ الْجَوْفِيَّةُ عَلى سَطْحِ الْأَرْضِ ظُهورًا طَبيعِيًّا. وَلِلْمِياهِ أَهَمِّيَّةٌ في حَياتِنا: الشُّرْبُ، وَالزِّراعَةُ، وَازْدِهارُ السِّياحَةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 كَيْفَ تَتَكَوَّنُ الْمِياهُ الْجَوْفِيَّةُ؟ وَما الْفَرْقُ بَيْنَ الْبِئْرِ وَالْيَنْبوعِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رِحْلَةُ قَطْرَةِ الْمَطَرِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمِياهُ الْجَوْفِيَّةُ · الْآبارُ · الْيَنابيعُ وَالْعُيونُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "1 🌧️", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "تَسْقُطُ الْأَمْطارُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "2 ⬇️", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "m