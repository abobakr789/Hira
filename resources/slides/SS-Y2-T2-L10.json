"va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «وُلِدَ الشَّيْخُ زايِدٌ في … عامَ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْقِصَّةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 قَصْرُ الْحِصْنِ · الصَّحْراءُ · الْمَجالِسُ · الْعَيْنُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T2-L10/qasr.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "وُلِدَ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - في قَصْرِ الْحِصْنِ بِأَبوظَبي عامَ 1918م، وَالِدُهُ هُوَ الشَّيْخُ سُلْطانُ بْنُ زايِدٍ، وَأُمُّهُ الشَّيْخَةُ سَلامَةُ بِنْتُ بُطي. نَشَأَ في بيئَةٍ بَدَوِيَّةٍ بَيْنَ الصَّحْراءِ وَالصُّقورِ وَالْغِزْلانِ، فَتَعَلَّمَ الْحِكْمَةَ وَالصَّبْرَ وَالشَّجاعَةَ. في طُفولَتِهِ، بَدَأَ بِحِفْظِ الْقُرْآنِ الْكَريمِ، وَكانَ يُحِبُّ أَنْ يَجْلِسَ مَعَ الْكِبارِ في مَجالِسِهِمْ كَيْ يَتَعَلَّمَ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "انْتَقَلَ الشَّيْخُ زايِدٌ - رَحِمَهُ اللهُ - إِلى مِنْطَقَةِ الْعَيْنِ، فَقَضى شَبابَهُ فيها، وَأَصْبَحَ مُمَثِّلًا لِلْحاكِمِ في الْمِنْطَقَةِ الشَّرْقِيَّةِ عامَ 1946م مِمّا أَكْسَبَهُ خِبْرَةً في شُؤونِ الْحُكْمِ. وَاكْتَسَبَ حُبَّ أَبْناءِ الْقَبائِلِ وَاحْتِرامَهُمْ، إِذِ اهْتَمَّ بِنَهْضَةِ مِنْطَقَتِهِمْ. وَمِنْ إِنْجازاتِهِ في الْعَيْنِ: إِصْلاحُ الْأَفْلاجِ وَجَعْلُ الْمِياهِ مُتَوَفِّرَةً لِلْجَميعِ، وَتَشْجيعُ التَّعْليمِ وَالِاهْتِمامُ بِالْمَدْرَسَةِ النَّهْيانِيَّةِ، وَإِنْشاءُ أَوَّلِ سوقٍ تِجارِيٍّ في الْعَيْنِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا تَعَلَّمَ زايِدٌ مِنَ الصَّحْراءِ وَالْمَجالِسِ؟ اذْكُرْ إِنْجازَيْنِ لَهُ في الْعَيْنِ.", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "مَراحِلُ نَشْأَةِ زايِدٍ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 قَصْرُ الْحِصْنِ · الصَّحْراءُ · الْمَجالِسُ · الْعَيْنُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "l