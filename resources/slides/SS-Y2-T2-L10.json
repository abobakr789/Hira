"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُلَخِّصُ شَفَوِيًّا أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "في الْعَيْنِ: أَصْلَحَ زايِدٌ الْأَفْلاجَ فَتَوَفَّرَ الْماءُ لِلزِّراعَةِ، وَشَجَّعَ التَّعْليمَ،\nوَأَنْشَأَ أَوَّلَ سوقٍ تِجارِيٍّ… فَأَحَبَّهُ النّاسُ وَوَثِقوا بِهِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ تاريخِيَّةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "الْمَدْرَسَةُ النَّهْيانِيَّةُ: أَنْشَأَها الشَّيْخُ زايِدٌ - رَحِمَهُ اللهُ - عامَ 1959م، وَهِيَ أَوَّلُ مَدْرَسَةٍ في الْعَيْنِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "إِنْجازاتُهُ في الْعَيْنِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fil