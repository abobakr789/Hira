11, "h": 77, "text": "ماذا تَعَلَّمْتُ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمِياهُ الْعَذْبَةُ · الْمِياهُ الْمالِحَةُ · الْجَليدُ · الْأَفْلاجُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 160, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🪞 تَعَلَّمْتُ الْيَوْمَ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 88, "text": "أَنَّ الْمِياهَ عَذْبَةٌ (جَوْفِيَّةٌ وَأَنْهارٌ وَبُحَيْراتٌ وَجَليدٌ) وَمالِحَةٌ (بِحارٌ وَمُحيطاتٌ وَبُحَيْراتٌ مالِحَةٌ)، وَأَنَّ بِلادي تُواجِهُ الْمُلوحَةَ وَالتَّبَخُّرَ وَانْخِفاضَ الْمِياهِ الْجَوْفِيَّةِ، وَتَحُلُّها بِالتَّحْلِيَةِ وَالسُّدودِ وَالِاسْتِمْطارِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 335, "w": 1203, "h": 141, "rv": 1, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 343, "w": 1172, "h": 51, "rv": 1, "text": "❓ أَتَساءَلُ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 397, "w": 1172, "h": 69, "rv": 1, "text": "كَيْفَ يُؤَثِّرُ الْإِنْسانُ في الْبيئَةِ؟", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 493, "w": 1203, "h": 150, "rv": 2, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 500, "w": 1172, "h": 51, "rv": 2, "text": "🔬 أَرْبِطُ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 554, "w": 1172, "h": 78, "rv": 2, "text": "الْعُلومُ: تَسْعى دَوْلَةُ الْإِماراتِ إِلى التَّغَلُّبِ عَلى مُشْكِلَةِ قِلَّةِ الْأَمْطارِ بِعَمَلِ تَجْرِبَةِ الِاسْتِمْطارِ.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[غلق الدرس والتأمل] اطلب من ثلاثة طلاب إكمال الجمل شفويًّا."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🏠 رسالتي إلى البيت", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رِسالَتي إِلى الْبَيْتِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمِياهُ الْعَذْبَةُ · الْمِياهُ الْمالِحَةُ · الْجَليدُ · الْأَفْلاجُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 1203, "h": 243, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 168, "w": 1172, "h": 51, "text": "🏠 مَعَ أُسْرَتي", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 172, "text": "١) أَبْحَثُ: أَيْنَ تَقَعُ أَشْهَرُ السُّدودِ في دَوْلَةِ الْإِماراتِ؟\n٢) أُكْمِلُ كِتابي ص 18–20.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 420, "w": 1203, "h": 223, "rv": 1, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 428, "w": 1172, "h": 51, "rv": 1, "text": "🎯 مُهِمَّةُ أَداءٍ صَغيرَةٌ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 481, "w": 1172, "h": 151, "rv": 1, "text": "أَكْتُبُ مَعَ مَجْموعَتي «خُطَّةَ تَرْشيدِ الْماءِ في مَدْرَسَتي»: الْمُشْكِلَةُ، وَالدَّليلُ، وَثَلاثَةُ حُلولٍ،\nوَنَعْرِضُها عَلى إِدارَةِ الْمَدْرَسَةِ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[التكليف ومهمة الأداء] ذكّر الطلاب بالمهمة، وحدّد موعد عرض اللوحة."}]}