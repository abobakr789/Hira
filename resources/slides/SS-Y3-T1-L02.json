e, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 49, "y": 390, "w": 266, "h": 109, "rv": 4, "text": "قَنَواتٌ تُحْفَرُ عَلى سَطْحِ الْأَرْضِ لِتَجْميعِ الْمِياهِ الْجَوْفِيَّةِ لِلزِّراعَةِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «مِنْ حُلولِ مُشْكِلَةِ الْمِياهِ في بِلادي …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمِياهُ الْعَذْبَةُ · الْمِياهُ الْمالِحَةُ · الْجَليدُ · الْأَفْلاجُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L02/cycle.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "تُصَنَّفُ الْمِياهُ عَلى سَطْحِ الْأَرْضِ إِلى نَوْعَيْنِ رَئيسَيْنِ هُما: الْمِياهُ الْعَذْبَةُ وَالْمِياهُ الْمالِحَةُ. مِنْ أَهَمِّ مَصادِرِ الْمِياهِ الْعَذْبَةِ: الْمِياهُ الْجَوْفِيَّةُ، وَالْأَنْهارُ وَالْبُحَيْراتُ، وَالْكُتَلُ الْجَليدِيَّةُ. مَفْهومُ الْأَفْلاجِ: الْأَفْلاجُ هِيَ عِبارَةٌ عَنْ قَناةٍ تُحْفَرُ عَلى سَطْحِ الْأَرْضِ لِتَجْميعِ الْمِياهِ الْجَوْفِيَّةِ لِلزِّراعَةِ. وَمِنْ أَهَمِّ مَصادِرِ الْمِياهِ الْمالِحَةِ: الْبِحارُ وَالْمُحيطاتُ، وَالْبُحَيْراتُ الْمالِحَةُ. وَمِنَ الْمُشْكِلاتِ الْبيئِيَّةِ الَّتي تُعاني مِنْها دَوْلَةُ الْإِماراتِ: زِيادَةُ نِسْبَةِ الْمُلوحَةِ وَالتَّبَخُّرِ، وَانْخِفاضُ مَنْسوبِ الْمِياهِ الْجَوْفِيَّةِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "تَقَعُ دَوْلَةُ الْإِماراتِ في نِطاقِ الْمُناخِ الصَّحْراوِيِّ الَّذي يَتَمَيَّزُ بِالْحَرارَةِ الْعالِيَةِ وَقِلَّةِ الْأَمْطارِ مِمّا يُؤَدّي إِلى حُدوثِ جَفافٍ، وَعَلى الرَّغْمِ مِنْ ذٰلِكَ فَإِنَّ الدَّوْلَةَ تَسْعى إِلى حَلِّها. الْحُلولُ الَّتي تَعْتَمِدُها دَوْلَةُ الْإِماراتِ لِتَوْفيرِ الْمِياهِ لِلسُّكّانِ: 1. إِقامَةُ مَحَطّاتِ تَحْلِيَةِ مِياهِ الْبَحْرِ. 2. إِقامَةُ السُّدودِ لِلِاسْتِفادَةِ مِنْ مِياهِ الْأَمْطارِ. وَتَسْعى الدَّوْلَةُ إِلى التَّغَلُّبِ عَلى مُشْكِلَةِ قِلَّةِ الْأَمْطارِ بِعَمَلِ تَجْرِبَةِ الِاسْتِمْطارِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما مَصادِرُ الْمِياهِ الْعَذْبَةِ؟ وَما الْمُشْكِلاتُ وَالْحُلولُ في بِلادي؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text",