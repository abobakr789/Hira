"}, {"k": "text", "x": 54, "y": 221, "w": 1172, "h": 88, "text": "أَنَّ اللَّوْنَ الْأَخْضَرَ في خَريطَةِ بِلادي يَدُلُّ عَلى السُّهولِ السّاحِلِيَّةِ، وَهِيَ أَرْضٌ مُنْبَسِطَةٌ قَليلَةُ الِارْتِفاعِ مُطِلَّةٌ عَلى بَحْرِ عُمانَ وَالْخَليجِ الْعَرَبِيِّ، يُمارِسُ سُكّانُها الصَّيْدَ وَسِباقَ الزَّوارِقِ وَالسِّياحَةَ، وَأَنَّ لِلصَّحْراءِ الْأَصْفَرَ وَلِلْجِبالِ الْبُنِّيَّ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 335, "w": 1203, "h": 141, "rv": 1, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 343, "w": 1172, "h": 51, "rv": 1, "text": "❓ أَتَساءَلُ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 397, "w": 1172, "h": 69, "rv": 1, "text": "ما واجِباتي وَمَسْؤولِيّاتي تُجاهَ بِلادي؟", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 493, "w": 1203, "h": 150, "rv": 2, "fill": "FFFDF8", "line": "A35E24", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 500, "w": 1172, "h": 51, "rv": 2, "text": "🔬 أَرْبِطُ", "size": 27, "color": "A35E24", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 554, "w": 1172, "h": 78, "rv": 2, "text": "الْعُلومُ: الْبِحارُ مِياهٌ مالِحَةٌ تَعيشُ فيها أَسْماكٌ وَكائِناتٌ كَثيرَةٌ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[غلق الدرس والتأمل] اطلب من ثلاثة طلاب إكمال الجمل شفويًّا."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🏠 رسالتي إلى البيت", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رِسالَتي إِلى الْبَ