ddle"}, {"k": "text", "x": 49, "y": 390, "w": 266, "h": 109, "rv": 4, "text": "سوقٌ تَقْليدِيٌّ في الْفُجَيْرَةِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «أَسْكُنُ في إِمارَةِ … وَتَشْتَهِرُ بِـ …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 بُرْجُ خَليفَةَ · عاصِمَةُ الثَّقافَةِ · الْعاصِمَةُ الِاقْتِصادِيَّةُ · سوقُ الْجُمُعَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g2/SS-Y2-T1-L09/map.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "الْمُعَلِّمَةُ: ماذا تُشاهِدُ عَلى خَريطَةِ بِلادِكَ دَوْلَةِ الْإِماراتِ؟ مُحَمَّدٌ: مُدُنَ بِلادي وَمَعالِمَها الْمُهِمَّةَ. أَبوظَبي: هِيَ عاصِمَةُ دَوْلَةِ الْإِماراتِ، وَهِيَ الْأَكْبَرُ مِساحَةً، بِها مَقَرُّ رِئاسَةِ الدَّوْلَةِ. دُبَيُّ: الْمَدينَةُ الِاقْتِصادِيَّةُ الْأولى، وَهِيَ ثاني أَكْبَرِ إِمارَةٍ مِساحَةً. الشّارِقَةُ: عاصِمَةُ الثَّقافَةِ وَالْفَنِّ، تَهْتَمُّ بِالْعِمارَةِ الْإِسْلامِيَّةِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "عَجْمانُ: أَصْغَرُ الْإِماراتِ مِساحَةً، عُرِفَتْ قَديمًا بِصِناعَةِ الْقَوارِبِ التَّقْليدِيَّةِ. أُمُّ الْقَيْوَيْنِ: عُرِفَتْ بِصَيْدِ الْأَسْماكِ وَتِجارَةِ اللُّؤْلُؤِ، وَتَشْتَهِرُ بِتَرْبِيَةِ الْأَحْياءِ الْمائِيَّةِ. رَأْسُ الْخَيْمَةِ: فيها أَعْلى جَبَلٍ في الدَّوْلَةِ وَهُوَ جَبَلُ (جَيْسٍ)، وَتُعَدُّ وِجْهَةً سِياحِيَّةً. الْفُجَيْرَةُ: تُطِلُّ عَلى بَحْرِ عُمانَ، لَدَيْها ميناءٌ لِتَصْديرِ النِّفْطِ، وَبِها أَكْبَرُ الْأَسْواقِ التَّقْليدِيَّةِ (سوقُ الْجُمُعَةِ).", "size": 25, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما عاصِمَةُ بِلادي؟ وَما أَصْغَرُ الْإِماراتِ مِساحَةً؟ وَأَيْنَ أَعْلى جَبَلٍ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "طَبيعِيٌّ أَمْ صَنَعَهُ الْإِنْسانُ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 بُرْجُ خَليفَةَ · عاصِمَةُ الثَّقافَةِ · الْعاصِمَةُ الِاقْتِصادِيَّةُ · سوقُ الْجُمُعَةِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 650, "y": 160, "w": 592, "h": 134, "rv": 1, "fill": "16A34A", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 650, "y": 163, "w": 592, "h": 64, "rv": 1, "text": "⛰️ طَبيعِيٌّ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 650, "y": 227, "w": 592, "h": 58, "rv": 1, "text": "جَبَلُ جَيْسٍ · الْبَحْرُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 160, "w": 592, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 38, "y": 163, "w": 592, "h": 64, "rv": 1, "text": "🏙️ صَنَعَهُ الْإِنْسانُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 227, "w": 592, "h": 58, "rv": 1, "text": "بُرْجُ خَليفَةَ · الْمَسْجِدُ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "shape", "x": 38, "y": 314, "w": 1203, "h": 179, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 321, "w": 1172, "h": 51, "rv": 2, "text": "👩‍🏫 أُصَنِّفُ أَمامَكُمْ", "size": 27, "color": "0F6E72", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "أَسْأَلُ: هَلْ خَلَقَهُ اللهُ هٰكَذا أَمْ بَناهُ الْإِنْسانُ؟\nجَبَلُ جَيْسٍ ← طَبيعِيٌّ · بُرْجُ خَليفَةَ ← صَنَعَهُ الْإِنْسانُ.", "size": 34, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "tex