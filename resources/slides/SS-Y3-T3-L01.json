e": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ وَالْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الطَّقْسُ · الرِّياحُ · الرُّطوبَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T3-L01/icons.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "الطَّقْسُ: هُوَ حالَةُ الْجَوِّ في مِنْطَقَةٍ وَوَقْتٍ مُعَيَّنٍ لِفَتْرَةٍ قَصيرَةٍ. الرِّياحُ: هِيَ تَحَرُّكُ أَوِ انْتِقالُ الْكُتَلِ الْهَوائِيَّةِ في الِاتِّجاهِ الْأُفُقِيِّ مِنْ مَكانٍ لِآخَرَ. الرُّطوبَةُ: هِيَ كَمِّيَّةُ بُخارِ الْماءِ الْمَوْجودِ في الْهَواءِ. أَحْمَدُ: لِماذا الْجَوُّ حارٌّ الْيَوْمَ يا مُعَلِّمي؟ الْمُعَلِّمُ: لَقَدْ بَدَأَ فَصْلُ الصَّيْفِ في دَوْلَةِ الْإِماراتِ يا أَحْمَدُ. أَحْمَدُ: نَعَمْ يا مُعَلِّمي، تَمُرُّ دَوْلَةُ الْإِماراتِ بِالْفُصولِ كُلِّها: الشِّتاءِ، وَالرَّبيعِ، وَالصَّيْفِ، وَالْخَريفِ، إِلّا أَنَّ فَصْلَيِ الشِّتاءِ وَالصَّيْفِ هُما أَكْثَرُها وُضوحًا.", "size": 23, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "الْمُعَلِّمُ: أَحْسَنْتَ يا أَحْمَدُ، وَالْآنَ مَنْ مِنْكُمْ يُحَدِّثُنا عَنْ فَصْلِ الشِّتاءِ؟ عَلِيٌّ: يَبْدَأُ فَصْلُ الشِّتاءِ في دَوْلَةِ الْإِماراتِ في شَهْرِ دِيسَمْبَرَ، وَيَنْتَهي في شَهْرِ فِبْرايِرَ، حَيْثُ تَبْدَأُ دَرَجاتُ الْحَرارَةِ بِالِانْخِفاضِ وَتَسْقُطُ الْأَمْطارُ في هٰذا الْفَصْلِ وَتَتَمَيَّزُ بِقِلَّتِها. الْمُعَلِّمُ: وَالْآنَ مَنْ مِنْكُمْ يُحَدِّثُنا عَنْ فَصْلِ الصَّيْفِ؟ عَبْدُ اللهِ: فَصْلُ الصَّيْفِ يَبْدَأُ في شَهْرِ يونيو، وَيَنْتَهي في شَهْرِ أَغُسْطُسَ، وَيَكونُ الطَّقْسُ فيهِ حارًّا، وَيَتَّصِفُ هٰذا الْفَصْلُ بِالْجَفافِ وَارْتِفاعِ الرُّطوبَةِ عَلى السَّواحِلِ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الطَّقْسُ؟ مَتى يَبْدَأُ فَصْلُ الشِّتاءِ وَيَنْتَهي؟ وَما صِفاتُ فَصْلِ الصَّيْفِ في بِلادي؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الشِّتاءُ وَالصَّيْفُ في بِلادي", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الطَّقْسُ · الرِّياحُ · الرُّطوبَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "❄️ الشِّتاءُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 853, "y": 227, "w": 388, 