 "middle"}, {"k": "text", "x": 54, "y": 375, "w": 1172, "h": 108, "rv": 2, "text": "تَبْدو الْأَرْضُ مِنَ الْفَضاءِ زَرْقاءَ ← لِماذا؟\nلِأَنَّ الْماءَ يُغَطّي مُعْظَمَ مِساحَةِ سَطْحِ الْأَرْضِ، لِذٰلِكَ تُسَمّى الْكَوْكَبَ الْأَزْرَقَ.", "size": 34, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 508, "w": 1203, "h": 134, "rv": 3, "fill": "FFFDF8", "line": "B42318", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 516, "w": 1172, "h": 51, "rv": 3, "text": "💡 حَقيقَةٌ مُذْهِلَةٌ", "size": 27, "color": "B42318", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 570, "w": 1172, "h": 63, "rv": 3, "text": "تَتَكَوَّنُ الْيابِسَةُ مِنَ التُّرابِ وَالصُّخورِ، وَهِيَ مُقَسَّمَةٌ إِلى قارّاتٍ وَدُوَلٍ.", "size": 30, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[النمذجة: «أنا أطبّق»] عرّف بنفسك أمام الطلاب بالقالب نفسه، ثم اطلب من متطوّع."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🤝 نطبّق معًا", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَرْضي مِنْ قَريبٍ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْكُرَةُ الْأَرْضِيَّةُ · الْفَضاءُ · الْيابِسَةُ · الْماءُ · الْكائِناتُ الْحَيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 650, "y": 160, "w": 592, "h": 314, "rv": 1, "src": "resources/ss/g2/SS-Y2-T1-L01/cliff.webp", "rad": true}, {"k": "pic", "x": 38, "y": 160, "w": 592, "h": 314, "rv": 2, "src": "resources/ss/g2/SS-Y2-T1-L01/desert.webp", "rad": true}, {"k": "text", "x": 38, "y": 489, "w": 1203, "h": 77, "rv": 3, "text": "👆 مِمَّ يَتَكَوَّنُ كَوْكَبُ الْأَرْضِ في الصّورَةِ؟ وَما هٰذِهِ؟ (الْيابِسَةُ)", "size": 32, "color": "1E3A3F", "bold": true, "align": "center", "fill": "FFFDF8", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 576, "w": 1203, "h": 70, "rv": 4, "text": "📘 كِتابي ص 14–16: أُقارِنُ بَيْنَ الْكُرَةِ الْأَرْضِيَّةِ وَكُرَةِ الْقَدَمِ، وَأَتَتَبَّعُ الْيابِسَةَ وَأُلَوِّنُها، وَأُكْمِلُ الْبِطاقَةَ.", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[الممارسة الموجّهة: «نطبّق معًا»] اعرض الصورتين، وعُدّوا معًا. ثم نفّذوا نشاط الكتاب."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🚦 إشارة الانطلاق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 2 دقيقة", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "ما الَّذي يُشْبِهُ شَكْلَ الْأَرْضِ؟", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْكُرَةُ الْأَرْضِيَّةُ · الْفَضاءُ · الْيابِسَةُ · الْماءُ · الْكائِناتُ الْحَيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 701, "y": 160, "w": 490, "h": 294, "src": "resources/ss/g2/SS-Y2-T1-L01/globe.webp", "rad": true}, {"k": "text", "x": 650, "y": 454, "w": 592, "h": 58, "text": "(أ)", "size": 36, "color": "1E3A3F", "bold": true, "align": "center", "fill": null, "rad": false, "va": "mi