، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 إِعادَةُ التَّدْويرِ · الْهَيْئاتُ الدَّوْلِيَّةُ · قانونُ الْبِحارِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L05/pollution.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "الْمُعَلِّمُ: طُلّابي الْأَعِزّاءَ دَعونا نُفَكِّرُ مَعًا كَيْفَ نَحْمي بيئَتَنا؟ أَحْمَدُ: نُحافِظُ عَلى نَظافَةِ مَدينَتِنا مِنَ النُّفاياتِ. راشِدٌ: وَكَيْفَ نُحافِظُ عَلَيْها مِنَ النُّفاياتِ؟ سَيْفٌ: نَرْميها في الْحاوِياتِ الْمُخَصَّصَةِ لَها. سالِمٌ: نَحْرِصُ عَلى عَدَمِ تَلْويثِ شَواطِئِنا. غانِمٌ: نُشارِكُ في حَمَلاتِ التَّطَوُّعِ لِتَنْظيفِ مَدينَتِنا. خَلْفانُ: نُساهِمُ بِنَشْرِ الْوَعْيِ الْبيئِيِّ بَيْنَ سُكّانِ مَدينَتِنا. الْمُعَلِّمُ: أَحْسَنْتُمْ يا أَبْنائي لَدَيْكُمْ أَفْكارٌ وَمُقْتَرَحاتٌ رائِعَةٌ لِلْحِفاظِ عَلى مَدينَتِنا نَظيفَةً.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "تَتَنَوَّعُ الْأَعْمالُ الَّتي يُمْكِنُنا الْقِيامُ بِها لِحِمايَةِ بيئَتِنا مِنَ التَّلَوُّثِ: تَرْشيدُ اسْتِهْلاكِ الطّاقَةِ، وَاسْتِخْدامُ وَسائِلِ النَّقْلِ الْجَماعِيِّ، وَإِعادَةُ تَدْويرِ النُّفاياتِ. وَمِنَ الْمُؤَسَّساتِ وَالْهَيْئاتِ الَّتي تَسْعى لِحِمايَةِ الْبيئَةِ: الْعالَمِيَّةُ: ميثاقُ حِمايَةِ طَبَقَةِ الْأوزونِ، وَميثاقُ هَيْئَةِ الْأُمَمِ الْمُتَّحِدَةِ حَوْلَ قانونِ الْبِحارِ. الْمَحَلِّيَّةُ: جَمْعِيَّةُ أَصْدِقاءِ الْبيئَةِ، وَوِزارَةُ التَّغَيُّرِ الْمُناخِيِّ وَالْبيئَةِ. وَأَعْتَزُّ بِجُهودِ دَوْلَتي لِحِمايَةِ الْبيئَةِ: جائِزَةُ زايِدٍ الدَّوْلِيَّةُ لِلْبيئَةِ، وَجائِزَةُ الشّارِقَةِ لِلْوَعْيِ الْبيئِيِّ، وَجائِزَةُ الْإِماراتِ التَّقْديرِيَّةُ لِلْبيئَةِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الْأَعْمالُ الَّتي اقْتَرَحَها الطُّلّابُ؟ اذْكُرْ مُؤَسَّسَةً مَحَلِّيَّةً وَجائِزَةً إِماراتِيَّةً لِلْبيئَةِ.", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَعْمالٌ تَحْمي بيئَتي", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 إِعادَةُ التَّدْويرِ · الْهَيْئاتُ الدَّوْلِيَّةُ · قانونُ الْبِحارِ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "EAB308", "line": null, "rad": true, "oval": false, "lw": 1.5}