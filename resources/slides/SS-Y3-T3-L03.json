"h": 352, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 1038, "y": 173, "w": 122, "h": 122, "emo": "🌳", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "النَّباتاتُ الْمُعَمِّرَةُ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "النَّباتاتُ الَّتي تَعيشُ فَتْرَةً طَويلَةً، مِثْلُ السِّدْرِ وَالْغافِ وَالْأَشْخَرِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "🌱", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "النَّباتاتُ الْحَوْلِيَّةُ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "النَّباتاتُ الَّتي تَعيشُ فَتْرَةً قَصيرَةً بَعْدَ سُقوطِ الْمَطَرِ، مِثْلُ الْحُمَّيْضِ وَالْخُبَّيْزِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «شَجَرَةُ الْغافِ نَباتٌ … لِأَنَّها …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْحِوارِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 النَّباتاتُ الْمُعَمِّرَةُ · النَّباتاتُ الْحَوْلِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 422, "h": 384, "src": "resources/ss/g3/SS-Y3-T1-L03/zayed.webp", "rad": true}, {"k": "text", "x": 480, "y": 160, "w": 762, "h": 224, "rv": 1, "text": "في عَصْرِ يَوْمٍ مِنَ الْأَيّامِ جَلَسَ الشَّيْخُ زايِدُ بْنُ سُلْطانَ آلِ نَهْيانَ - رَحِمَهُ اللهُ - مَعَ الرِّجالِ تَحْتَ شَجَرَةِ غافٍ كَبيرَةٍ، فَسَأَلَهُ أَحَدُ مُرافِقيهِ: «أَيُّ فائِدَةٍ تُرْجى مِنْ هٰذِهِ الشَّجَرَةِ الْمَلْأى بِالْأَشْواكِ؟!». ابْتَسَمَ الشَّيْخُ زايِدٌ وَقالَ: «نَحْنُ نَسْتَفيدُ مِنْ هٰذِهِ الشَّجَرَةِ، فَظِلُّها يُؤْوي الْإِنْسانَ وَالْحَيَوانَ، وَأَوْراقُها عَلَفٌ لِلْأَنْعامِ، وَجُذوعُها الْيابِسَةُ تُسْتَخْدَمُ في صِناعَةِ الْفَحْمِ». ثُمَّ قالَ: لا تَكُنْ مُتَشائِمًا يا رَجُلُ! سَيَأْتي يَوْمٌ نُصْبِحُ فيهِ هٰذِهِ الْأَرْضُ خَضْراءَ، وَسَنَأْكُلُ مِنْ فَواكِهِ الْعَيْنِ وَثِمارِها. رَدَّ الْمُرافِقُ: إِنْ شاءَ اللهُ، لٰكِنْ كَيْفَ مَعَ قِلَّةِ الْمِياهِ هُنا؟ هَزَّ الشَّيْخُ زايِدٌ رَأْسَهُ بِابْتِسامَةِ الْواثِقِ مِنَ الْقُدْرَةِ عَلى تَحْقيقِ الْحُلْمِ.", "size": 20, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 480, "y": 397, "w": 762, "h": 173, "rv": 2, "text": "تَنْتَشِرُ في دَوْلَةِ الْإِماراتِ النَّباتاتُ الصَّحْراوِيَّةُ نَتيجَةَ ارْتِفاعِ دَرَجَةِ الْحَرارَةِ الشَّديدَةِ وَالْجَفافِ، وَانْتِشارِ التُّرْبَةِ الرَّمْلِيَّةِ، وَتَنْقَسِمُ النَّباتاتُ الصَّحْراوِيَّةُ إِلى نَوْعَيْنِ: نَباتاتٌ مُعَمِّرَةٌ: هِيَ النَّباتاتُ الَّتي تَعيشُ فَتْرَةً طَويلَةً مِثْلُ: السِّدْرِ وَالْغافِ وَالْأَشْخَرِ. نَباتاتٌ حَوْلِيَّةٌ: هِيَ النَّباتاتُ الَّتي تَعيشُ فَتْرَةً قَصيرَةً بَعْدَ سُقوطِ الْمَطَرِ مِثْلُ: الْحُمَّيْضِ وَالْخُبَّيْزِ. إِنَّ مَوْسِمَ ظُهورِ النَّباتاتِ الْبَرِّيَّةِ بَعْدَ سُقوطِ الْأَمْطارِ يُسَمّى (مَوْسِمَ الْحَيا) أَيْ أَنَّ الْأَرْضَ تَحْيا وَتَزْدانُ بِالْخُضارِ.", "size": 18, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما فَوائِدُ شَجَرَةِ الْغافِ كَما قالَ الشَّيْخُ زايِدٌ؟ وَما الْفَرْقُ بَيْنَ النَّباتاتِ الْمُعَمِّرَةِ وَالْحَوْلِيَّةِ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "النَّباتاتُ الصَّحْراوِيَّةُ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 النَّباتاتُ الْمُعَمِّرَةُ · النَّباتاتُ الْحَوْلِيَّةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "A35E24", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "🌳 مُعَمِّرَةٌ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "mi