a": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "سالِمٌ: وَماذا تَرْتَدي النِّساءُ؟ الْمُعَلِّمَةُ: تَرْتَدي النِّساءُ وَالْبَناتُ الْكَنْدورَةَ الْجَميلَةَ الْمُطَرَّزَةَ بِالْأَلْوانِ الزّاهِيَةِ الَّتي تَجْمَعُ بَيْنَ الْحِشْمَةِ وَالْأَناقَةِ، وَيُغَطّينَ الرَّأْسَ بِالْوِقايَةِ أَوِ الشَّيْلَةِ، وَيَرْتَدينَ الْعَباءَةَ عِنْدَ الْخُروجِ مِنَ الْمَنْزِلِ.", "size": 28, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ماذا يَلْبَسُ الرِّجالُ؟ وَماذا تَلْبَسُ النِّساءُ؟ وَمَتى نَلْبَسُ الْبِشْتَ؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "الزِّيُّ الْوَطَنِيُّ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الزِّيُّ الْوَطَنِيُّ · الْكَنْدورَةُ · الْغُتْرَةُ وَالْعِقالُ · الْبِشْتُ · الْوِقايَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "64748B", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "👘 الْكَنْدورَةُ", "size": 36, "color": "F