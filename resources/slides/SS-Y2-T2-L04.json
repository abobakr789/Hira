h": 173, "rv": 2, "text": "مِنْ دونِ الطّاقَةِ، يُصْبِحُ الْعالَمُ مُعْتِمًا وَبارِدًا. فَالطّاقَةُ تَتَسَبَّبُ في إِحْداثِ أَشْياءَ كَثيرَةٍ، فَهِيَ تَجْعَلُ النَّباتاتِ وَالْحَيَواناتِ تَعيشُ وَتَنْمو، وَيَسْتَخْدِمُها النّاسُ لِطَهْوِ الطَّعامِ، وَتَبْريدِ الْمَباني، وَتَشْغيلِ الْآلاتِ. فَالطّاقَةُ هِيَ الْقُدْرَةُ عَلى الْحَرَكَةِ وَالْقِيامِ بِعَمَلٍ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما الطّاقَةُ؟ وَماذا يَحْدُثُ لِلْعالَمِ مِنْ دونِها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "أَشْكالُ الطّاقَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الطّاقَةُ · خَلِيَّةٌ كَهْرَبائِيَّةٌ · الْوَقودُ · الضَّوْءُ · الْحَرَكَةُ · الْحَرارَةُ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 853, "y": 160, "w": 388, "h": 134, "rv": 1, "fill": "EAB308", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 853, "y": 163, "w": 388, "h": 64, "rv": 1, "text": "💡 الضَّوْئِيَّةُ", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": fa