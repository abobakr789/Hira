": 261, "rv": 2, "text": "أَذْكُرُ وَظائِفَ الْمَدْرَسَةِ وَواجِباتي نَحْوَها.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 38, "y": 307, "w": 388, "h": 333, "rv": 3, "fill": "FFFDF8", "line": "6B46A8", "rad": true, "oval": false, "lw": 2}, {"k": "text", "x": 54, "y": 315, "w": 358, "h": 51, "rv": 3, "text": "⭐⭐⭐ مُتَمَكِّنٌ", "size": 27, "color": "6B46A8", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 54, "y": 369, "w": 358, "h": 261, "rv": 3, "text": "أُحَلِّلُ دَوْرَ الْمَدْرَسَةِ وَالْمَسْجِدِ في بِناءِ الْمُجْتَمَعِ.", "size": 32, "color": "1E3A3F", "bold": false, "align": "right", "fill": null, "rad": false, "va": "top"}], "n": "[ناتج التعلّم ومعايير النجاح] اقرأ الهدف مع الطلاب، ووضّح ماذا يعني كل مستوى."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "🔑 مفاتيح الدرس", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 6 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "كَلِماتٌ جَديدَةٌ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَدْرَسَةُ · الْمَرافِقُ · عاداتٌ وَتَقاليدُ · التَّحْصيلُ الدِّراسِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 352, "rv": 1, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 1038, "y": 173, "w": 122, "h": 122, "emo": "🏫", "rv": 1}, {"k": "text", "x": 965, "y": 307, "w": 266, "h": 77, "rv": 1, "text": "الْمَدْرَسَةُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 965, "y": 390, "w": 266, "h": 109, "rv": 1, "text": "الْمَكانُ الَّذي أَتَعَلَّمُ فيهِ", "size": 27, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 650, "y": 160, "w": 286, "h": 352, "rv": 2, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 732, "y": 173, "w": 122, "h": 122, "emo": "🏛️", "rv": 2}, {"k": "text", "x": 660, "y": 307, "w": 266, "h": 77, "rv": 2, "text": "الْمَرافِقُ", "size": 43, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 660, "y": 390, "w": 266, "h": 109, "rv": 2, "text": "الصُّفوفُ وَالْمَلْعَبُ وَالسّاحَةُ وَالْإِدارَةُ وَالْمَكْتَبَةُ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "shape", "x": 344, "y": 160, "w": 286, "h": 352, "rv": 3, "fill": "FFFDF8", "line": "0F6E72", "rad": true, "oval": false, "lw": 2}, {"k": "img", "x": 426, "y": 173, "w": 122, "h": 122, "emo": "🎓", "rv": 3}, {"k": "text", "x": 354, "y": 307, "w": 266, "h": 77, "rv": 3, "text": "التَّحْصيلُ الدِّراسِيُّ", "size": 27, "color": "0F6E72", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 354, "y": 390, "w": 266, "h": 109, "rv": 3, "text": "ما يَتَعَلَّمُهُ الطّالِبُ وَيُنْجِزُهُ في دِراسَتِهِ", "size": 21, "color": "1E3A3F", "bold": false, "align": "center", "fill": null, "rad": false, "va": "top"}, {"k": "text", "x": 38, "y": 531, "w": 1203, "h": 109, "rv": 5, "text": "🗣️ أَقولُ: «مِنْ وَظائِفِ مَدْرَسَتي …».", "size": 30, "color": "1E3A3F", "bold": true, "align": "right", "fill": "FCE9DA", "rad": true, "va": "middle"}], "n": "[المفاهيم والمصطلحات] الكلمات الجديدة من الكتاب. اعرض الرمز، واطلب جملة شفوية بكل كلمة."}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "📖 ركن القصة", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 7 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "رُكْنُ الْمَعْرِفَةِ", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَدْرَسَةُ · الْمَرافِقُ · عاداتٌ وَتَقاليدُ · التَّحْصيلُ الدِّراسِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "pic", "x": 38, "y": 160, "w": 294, "h": 384, "src": "resources/ss/g3/SS-Y3-T2-L15/schoolc.webp", "rad": true}, {"k": "text", "x": 352, "y": 160, "w": 890, "h": 224, "rv": 1, "text": "أُشاهِدُ في الْحَيِّ مَدْرَسَتي. وَهِيَ الْمَكانُ الَّذي أَتَعَلَّمُ فيهِ. مَرافِقُ مَدْرَسَتي هامَّةٌ، وَهِيَ (الصُّفوفُ وَالْمَلْعَبُ وَالسّاحَةُ وَالْإِدارَةُ وَالْمَكْتَبَةُ). تَتَوَلّى مَدْرَسَتي وَظائِفَ هامَّةً، وَهِيَ: تَعْليمُ الْعُلومِ الْمُفيدَةِ، تَرْبِيَةُ الْأَخْلاقِ الْحَسَنَةِ، غَرْسُ حُبِّ الْوَطَنِ وَعاداتِ وَتَقاليدِ الْأَجْدادِ، وَتَنْمِيَةُ الْمَهاراتِ الْمُخْتَلِفَةِ لِلطُّلّابِ.", "size": 27, "color": "1E3A3F", "bold": false, "align": "right", "fill": "FFFDF8", "rad": true, "va": "top"}, {"k": "text", "x": 352, "y": 397, "w": 890, "h": 173, "rv": 2, "text": "لِذا يَجِبُ أَنْ أَكونَ تِلْميذًا صالِحًا وَمُجْتَهِدًا، أَلْتَزِمُ بِالْحُضورِ الْيَوْمِيِّ لِلْمَدْرَسَةِ، وَأَحْرِصُ عَلى مُتابَعَةِ دُروسي، وَأَحْتَرِمُ أَنْظِمَةَ الْمَدْرَسَةِ، وَأَتَّبِعُ تَعْليماتِها، وَأُشارِكُ في الْأَنْشِطَةِ، وَأَتَعاوَنُ مَعَ زُمَلائي. فَأَنا لا أَعْبَثُ بِمَرافِقِ مَدْرَسَتي، وَأُحافِظُ عَلى نَظافَتِها، وَأَحْتَرِمُ وَأُقَدِّرُ كُلَّ مَنْ في مَدْرَسَتي، وَأُحافِظُ عَلى مُمْتَلَكاتِها. حَقيقَةٌ وَطَنِيَّةٌ: التَّحْصيلُ الدِّراسِيُّ مُهِمٌّ، فَيَجِبُ أَنْ أَبْذُلَ جُهْدًا لِلتَّفَوُّقِ في دِراسَتي، وَالتَّسَلُّحِ بِالْمَعْرِفَةِ؛ لِأُساهِمَ في بِناءِ وَطَني حينَ أَكْبُرُ.", "size": 21, "color": "1E3A3F", "bold": false, "align": "right", "fill": "E2F0EF", "rad": true, "va": "top"}, {"k": "text", "x": 38, "y": 582, "w": 1203, "h": 64, "rv": 3, "text": "🔎 ما مَرافِقُ الْمَدْرَسَةِ؟ وَما وَظائِفُها؟ وَما واجِباتي نَحْوَها؟", "size": 27, "color": "6B46A8", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}], "n": "[استكشاف المصادر (نص الكتاب وصوره)] اقرأ النص قراءة معبّرة والطلاب يتابعون في الكتاب، ثم اسأل: من؟ كم عمره؟"}, {"bg": "FBF6EC", "els": [{"k": "text", "x": 410, "y": 13, "w": 461, "h": 49, "text": "👩‍🏫 شاهدني أطبّق", "size": 23, "color": "FFFFFF", "bold": true, "align": "center", "fill": "0F6E72", "rad": true, "va": "middle"}, {"k": "text", "x": 38, "y": 74, "w": 173, "h": 54, "text": "⏱ 5 دقائق", "size": 23, "color": "1E3A3F", "bold": true, "align": "center", "fill": "F2A93B", "rad": true, "va": "middle"}, {"k": "text", "x": 230, "y": 67, "w": 1011, "h": 77, "text": "وَظائِفُ مَدْرَسَتي", "size": 46, "color": "1E3A3F", "bold": true, "align": "right", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 38, "y": 662, "w": 1203, "h": 46, "text": "🎯 الْمَدْرَسَةُ · الْمَرافِقُ · عاداتٌ وَتَقاليدُ · التَّحْصيلُ الدِّراسِيُّ", "size": 21, "color": "0F6E72", "bold": true, "align": "center", "fill": "E2F0EF", "rad": true, "va": "middle"}, {"k": "shape", "x": 955, "y": 160, "w": 286, "h": 134, "rv": 1, "fill": "2563EB", "line": null, "rad": true, "oval": false, "lw": 1.5}, {"k": "text", "x": 955, "y": 163, "w": 286, "h": 64, "rv": 1, "text": "📚", "size": 36, "color": "FFFFFF", "bold": true, "align": "center", "fill": null, "rad": false, "va": "middle"}, {"k": "text", "x": 955, "y": 227, "w": 286, "h": 58, "rv": 1, "text": "تَعْليمُ الْعُلومِ الْمُفيدَةِ", "size": 25, "color": "FFFFFF", "bold": false, "align": "center"